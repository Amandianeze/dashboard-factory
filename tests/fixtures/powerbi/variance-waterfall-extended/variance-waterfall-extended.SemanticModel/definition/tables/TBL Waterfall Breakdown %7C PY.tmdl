table 'TBL Waterfall Breakdown | PY'
	lineageTag: 56d66d9f-a414-4dd7-a045-48c9e1debea7

	measure '_Waterfall By Customer Segment | Basic' = ```

		VAR __SelectedCategory =  SELECTEDVALUE ( 'TBL Waterfall Breakdown | PY'[Name Short])

		VAR __Breakdown_Scope_Check =       
		    ISINSCOPE ( 'TBL Customer Breakdown'[Name]) || 
		    ISINSCOPE ( 'TBL Customer Breakdown'[Name Alt] )

		VAR __Value_Variance =      [_Customer Var. PY | Breakdown Switch]
		VAR __Value_Actuals =       COALESCE ( [_Revenue AC], 0 )
		VAR __Value_Comparison =    COALESCE ( [_Revenue PY | Equalized], 0 )

		VAR __Result =
		    SWITCH (
		        __SelectedCategory,
		            "PY", 
		                IF (
		                    __Breakdown_Scope_Check, __Value_Variance * (-1),
		                    __Value_Comparison
		                ),
		            "AC", 
		                IF (
		                     __Breakdown_Scope_Check, IF ( ISBLANK ( __Value_Variance ), BLANK(), 0),
		                     __Value_Actuals
		                )
		    )

		RETURN __Result


		```
		formatStringDefinition = ```
			VAR __Breakdown_Scope_Check =       
			    ISINSCOPE ( 'TBL Customer Breakdown'[Name]) || 
			    ISINSCOPE ( 'TBL Customer Breakdown'[Name Alt] )

			VAR __Format_Variance = "+#,0,.0;-#,0,.0;0"
			VAR __Format_Standard = "#,0,.0;-#,0,.0;0"

			VAR __Result =
			    SWITCH (
			        TRUE(),
			            __Breakdown_Scope_Check, 
			            __Format_Variance,
			            __Format_Standard
			    )

			RETURN __Result
			```
