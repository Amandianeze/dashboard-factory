	measure '_Waterfall General | Basic | Variance Color' = ```


		VAR __Variance = [_Revenue Variance abs. PY]

		VAR __Sentiment_Color =
		    SWITCH (
		        TRUE(),
		            __Variance > 0 , [_Positive Variance color],
		            __Variance = 0 , [_Neutral Variance color],
		            __Variance < 0 , [_Negative Variance color]
		    )

		RETURN __Sentiment_Color
		```
		lineageTag: bfcbe1f4-bb74-4f84-aaf1-a2542690557a

	measure '_Waterfall by Customer Segment | Max Ceiling' = ```


		VAR __Comparative_Value = [_Revenue PY | Equalized]
		VAR __Value_Growing     = [_Customer YoY Var | Growing (YoY)]
		VAR __Value_New         = [_Customer Revenue | New (YoY)]

		VAR __Sum = __Comparative_Value + __Value_Growing + __Value_New

		VAR __Result = __Sum * 1.2

		RETURN __Result
		```
		lineageTag: e0bed78b-a638-41cd-ac8a-5e131696ef65

