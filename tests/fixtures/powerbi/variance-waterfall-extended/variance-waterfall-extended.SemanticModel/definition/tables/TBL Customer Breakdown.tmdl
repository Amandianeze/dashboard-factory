	measure '_Customer Var. PY | Breakdown Switch | Threshold' = ```


		VAR __Breakdown = SELECTEDVALUE ( 'TBL Customer Breakdown'[Name] )

		VAR __Result =
		    IF (
		        ISINSCOPE ( 'TBL Customer Breakdown'[Name]) || ISINSCOPE ( 'TBL Customer Breakdown'[Name Alt] ),
		            SWITCH (
		                __Breakdown,
		                    "New",          [_Customer Revenue | New (YoY)],
		                    "Growing",      [_Customer YoY Var | Growing (YoY) | Threshold],
		                    "Declining",    [_Customer YoY Var | Declining (YoY) | Threshold],
		                    "Stable",       [_Customer Revenue | Retained (YoY) | Threshold],
		                    "Lost",         [_Customer Revenue | Lost (YoY)]
		            ),
		        [_Revenue Variance abs. PY] // (To handle Table Totals)
		    )

		RETURN __Result
		```
		lineageTag: f807ce71-da25-4b23-a95f-3fea592207a5

	measure '_Revenue AC | Customer (YoY)' = ```


		VAR __Threshold          = 0.05
		VAR __Customer_Breakdown = VALUES ( 'TBL Customer Breakdown'[Name] )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_Name]),
		        "@Sales",   [_Revenue AC],
		        "@SalesPY", [_Revenue PY | Equalized]
		    )

		VAR __WithVariance =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@Variance", DIVIDE ( [@Sales] - [@SalesPY], [@SalesPY] )
		    )

		VAR __WithSegment =
		    ADDCOLUMNS (
		        __WithVariance,
		        "@Segment",
		            SWITCH (
		                TRUE (),
		                NOT ISBLANK ( [@Sales] ) && ISBLANK ( [@SalesPY] ),                                   "New",
		                ISBLANK ( [@Sales] )     && NOT ISBLANK ( [@SalesPY] ),                               "Lost",
		                NOT ISBLANK ( [@Sales] ) && NOT ISBLANK ( [@SalesPY] ) && [@Variance] >  __Threshold, "Growing",
		                NOT ISBLANK ( [@Sales] ) && NOT ISBLANK ( [@SalesPY] ) && [@Variance] < -__Threshold, "Declining",
		                NOT ISBLANK ( [@Sales] ) && NOT ISBLANK ( [@SalesPY] ),                               "Stable"
		            )
		    )

		VAR __FilteredTable =
		    FILTER (
		        __WithSegment,
		        [@Segment] IN __Customer_Breakdown
		    )

		VAR __Result =
		    SUMX ( __FilteredTable, [@Sales] )

		RETURN __Result
		```
		lineageTag: 19e76968-c00e-42fd-80ec-4fb41e7a1dd9

	measure '_Revenue PY Equalized | Customer (YoY)' = ```


		VAR __Threshold          = 0.05
		VAR __Customer_Breakdown = VALUES ( 'TBL Customer Breakdown'[Name] )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_Name]),
		        "@Sales",   [_Revenue AC],
		        "@SalesPY", [_Revenue PY | Equalized]
		    )

		VAR __WithVariance =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@Variance", DIVIDE ( [@Sales] - [@SalesPY], [@SalesPY] )
		    )

		VAR __WithSegment =
		    ADDCOLUMNS (
		        __WithVariance,
		        "@Segment",
		            SWITCH (
		                TRUE (),
		                NOT ISBLANK ( [@Sales] ) && ISBLANK ( [@SalesPY] ),                                   "New",
		                ISBLANK ( [@Sales] )     && NOT ISBLANK ( [@SalesPY] ),                               "Lost",
		                NOT ISBLANK ( [@Sales] ) && NOT ISBLANK ( [@SalesPY] ) && [@Variance] >  __Threshold, "Growing",
		                NOT ISBLANK ( [@Sales] ) && NOT ISBLANK ( [@SalesPY] ) && [@Variance] < -__Threshold, "Declining",
		                NOT ISBLANK ( [@Sales] ) && NOT ISBLANK ( [@SalesPY] ),                               "Stable"
		            )
		    )

		VAR __FilteredTable =
		    FILTER (
		        __WithSegment,
		        [@Segment] IN __Customer_Breakdown
		    )

		VAR __Result =
		    SUMX ( __FilteredTable, [@SalesPY] )

		RETURN __Result
		```
		lineageTag: 71633296-3271-4713-839a-288bed7772cb

	measure '_Revenue Nominal Variance | Customer (YoY)' = ```


		VAR __Actual        = [_Revenue AC | Customer (YoY)]
		VAR __Comparative   = [_Revenue PY Equalized | Customer (YoY)]

		VAR __Nominal_Variance = 
		    __Actual   - __Comparative 

		VAR __Result = __Nominal_Variance

		RETURN __Result
		```
		lineageTag: f896003a-cc50-4407-b57c-2e590321d758

