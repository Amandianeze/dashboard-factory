table 'TBL Customer Breakdown'
	lineageTag: fff96e8e-67f9-4781-8452-d9099ea44ae2

	measure '_Customer Count | Breakdown Switch' = ```


		VAR __Breakdown = SELECTEDVALUE ( 'TBL Customer Breakdown'[Name] )

		VAR __Result =
		    SWITCH (
		        __Breakdown,
		            "New",          [_Customer Count | New (YoY)],
		            "Growing",      [_Customer Count | Growing (YoY)],
		            "Declining",    [_Customer Count | Downsell (YoY)],
		            "Stable",       [_Customer Count | Retained (YoY)],
		            "Lost",         [_Customer Count | Lost (YoY)]
		    )

		RETURN __Result
		```
		formatString: 0
		lineageTag: 64b073d2-ac29-4a4f-ba32-c209544ec027

	measure '_Customer Var. PY | Breakdown Switch' = ```


		VAR __Breakdown = SELECTEDVALUE ( 'TBL Customer Breakdown'[Name] )

		VAR __Result =
		    IF (
		        ISINSCOPE ( 'TBL Customer Breakdown'[Name]) || ISINSCOPE ( 'TBL Customer Breakdown'[Name Alt] ),
		            SWITCH (
		                __Breakdown,
		                    "New",          [_Customer Revenue | New (YoY)],
		                    "Growing",      [_Customer YoY Var | Growing (YoY)],
		                    "Declining",    [_Customer YoY Var | Declining (YoY)],
		                    "Stable",        0,
		                    "Lost",         [_Customer Revenue | Lost (YoY)]
		            ),
		        [_Revenue Variance abs. PY] // (To handle Table Totals)
		    )

		RETURN __Result
		```
		lineageTag: 2e99716b-f838-41b5-bc2d-e8ceefacf3bb

	measure '_Customer Var. PY | FX Font Color' = ```


		VAR __Breakdown = SELECTEDVALUE ( 'TBL Customer Breakdown'[Type] )

		VAR __Sentiment_Color =
		    SWITCH (
		        __Breakdown,
		            "Positive", [_Positive Variance color],
		            "Negative", [_Negative Variance color], 
		            "Neutral",  [_Neutral Variance color]
		    )

		RETURN __Sentiment_Color


		```
