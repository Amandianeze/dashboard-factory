		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\LTM
		lineageTag: 0410c28e-1ce1-43a7-ba1c-d4be74f49aba

	measure '_Text KPI Section Header LTM' = ```


		VAR __SelectedDate =            MAX ( 'Dim_Calendar'[Start of Month] ) 

		VAR __LTM_Start_Date =          EOMONTH ( __SelectedDate, -12 ) + 1
		VAR __LTM_Start =               FORMAT ( __LTM_Start_Date, "mmm'yy" ) 
		VAR __LTM_End =                 FORMAT ( __SelectedDate, "mmm'yy" ) 

		VAR __LTM_Previous_Start_Date = EOMONTH ( __SelectedDate, -24 ) + 1
		VAR __LTM_Previous_End_Date =   EOMONTH ( __SelectedDate, -13 ) + 1

		VAR __LTM_Previous_Start =      FORMAT ( __LTM_Previous_Start_Date, "mmm'yy" ) 
		VAR __LTM_Previous_End =        FORMAT ( __LTM_Previous_End_Date, "mmm'yy" ) 

		VAR __Result = 
		    "𝗟𝗧𝗠 | " & 
		    __LTM_Start & " - " & __LTM_End & " vs " & 
		    __LTM_Previous_Start & " - " & __LTM_Previous_End 

		RETURN __Result

		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\LTM
		lineageTag: 80336337-d32a-4c05-a531-2f3f12ebe0a1

	measure '909. Subheader Text - Date Range Month' = ```


		VAR __Current_month_offset = 
		    MAX ( 'Dim_Calendar'[CurrMonthOffset] )

		VAR __LatestMonth = 
		    CALCULATE ( 
		        MAX ( 'Dim_Calendar'[mmm'yy] ),
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] = __Current_month_offset
		    )

		VAR __PreviousMonth = 
		    CALCULATE ( 
		        MAX ( 'Dim_Calendar'[mmm'yy] ),
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] = __Current_month_offset - 1
		    )

		VAR __Result =
		    "Latest month: " & __LatestMonth & " | " & "Prev. month: " & IF ( ISBLANK ( __PreviousMonth ), "N/A", __PreviousMonth )

		RETURN __Result
		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\MoM & QoQ & YoY
		lineageTag: 2611716b-5790-451c-9b61-ffabd2398a5f

	measure '909. Subheader Text - Date Range Quarter' = ```


		VAR __Current_Quarter_offset = 
		    MAX ( 'Dim_Calendar'[CurrQuarterOffset] )

		VAR __LatestQuarter = 
		    CALCULATE ( 
		        MAX ( 'Dim_Calendar'[qqyy] ),
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrQuarterOffset] = __Current_Quarter_offset
		    )

		VAR __PreviousQuarter = 
		    CALCULATE ( 
		        MAX ( 'Dim_Calendar'[qqyy] ),
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrQuarterOffset] = __Current_Quarter_offset - 1
		    )

		VAR __Result =
		    "Current  Quarter: " & __LatestQuarter & " | " & "Prev. Quarter: " & IF ( ISBLANK ( __PreviousQuarter ), "N/A", __PreviousQuarter )

		RETURN __Result
		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\MoM & QoQ & YoY
		lineageTag: 30562cbb-a574-4ca8-b69c-4429509060cc

	measure '909. Subheader Text - Date Range Year' = ```


		VAR __Current_Year_offset = 
		    MAX ( 'Dim_Calendar'[CurrYearOffset] )

		VAR __LatestYear = 
		    CALCULATE ( 
		        MAX ( 'Dim_Calendar'[year] ),
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrYearOffset] = __Current_Year_offset
		    )

		VAR __PreviousYear = 
		    CALCULATE ( 
		        MAX ( 'Dim_Calendar'[year] ),
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrYearOffset] = __Current_Year_offset - 1
		    )

		VAR __Result =
		    "Current Year: " & __LatestYear & " | " & "Prev. Year: " & IF ( ISBLANK ( __PreviousYear ), "N/A", __PreviousYear )

		RETURN __Result
		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\MoM & QoQ & YoY
		lineageTag: 41303924-119e-4c3a-b9c8-f95af5b26760

