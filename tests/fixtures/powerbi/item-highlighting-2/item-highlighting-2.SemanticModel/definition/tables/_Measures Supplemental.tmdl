	measure '_Matrix Totals check' = ```


		VAR __Is_In_Scope_Date = ISINSCOPE ( 'Dim_Calendar'[qq'yy with space] )
		VAR __Is_in_Scope_Country = ISINSCOPE ( DIM_Customers[Country] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            (__Is_in_Scope_Country && NOT ( __Is_In_Scope_Date ) ) ||
		            (__Is_in_Scope_Date && NOT __Is_in_Scope_Country) ||
		            (NOT __Is_in_Scope_Country && NOT __Is_in_Scope_Date),
		            "#,0"
		    )

		RETURN __Result

		```
		formatStringDefinition = [_Matrix Totals check] & ""
		displayFolder: Miscellaneous
		lineageTag: 39b55057-a2a3-46c5-8866-95c5cb4baf79

	measure '_Matrix Table' = ```

		VAR __Current_Country = SELECTEDVALUE ( DIM_Customers[Country] )
		VAR __Current_Date =    SELECTEDVALUE ( 'Dim_Calendar'[qq'yy with space] )

		VAR __Table =
		    CALCULATETABLE (
		        ADDCOLUMNS ( 
		            CROSSJOIN (
		                VALUES ( DIM_Customers[Country] ),
		                VALUES ( 'Dim_Calendar'[qq'yy with space] )
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        ALLSELECTED()
		    )
		        
		VAR __MinVal =  MIN ( MINX ( __Table, [@Revenue] ), 0 )
		VAR __MaxVal =  MAXX ( __Table, [@Revenue] )
		VAR __Span   =  __MaxVal - __MinVal

		VAR __Cost_Curr_Customer = 
		    SUMX ( 
		        FILTER ( 
		            __Table,  
		            DIM_Customers[Country]  = __Current_Country  && 
		            'Dim_Calendar'[qq'yy with space] = __Current_Date
		        ),
		        [@Revenue]
		    )

		VAR __NormValue = 
		    IF (
		        ISBLANK ( __Cost_Curr_Customer ),
		        BLANK(),
		        DIVIDE ( 
		            __Cost_Curr_Customer - __MinVal, 
		            __Span 
		        )
		    )

		VAR __Result =__NormValue

		RETURN __Result
		```
		displayFolder: Miscellaneous
		lineageTag: f7682e56-7b34-47d9-abd0-762e22f5690c

