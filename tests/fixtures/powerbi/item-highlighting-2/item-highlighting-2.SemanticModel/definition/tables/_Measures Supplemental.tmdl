	measure '_Text KPI Section Header YTD Short V2' = ```


		VAR __SelectedDate =    MAX ( 'Dim_Calendar'[Start of Month] ) 
		VAR __StartYTD =        MINX ( DATESYTD ( 'Dim_Calendar'[Start of Month] ) , 'Dim_Calendar'[Start of Month] ) 
		VAR __EndYTD =          __SelectedDate 

		VAR __YTD_SingleMonth =  __StartYTD = __EndYTD 

		VAR __YTD_Current = 
		    SWITCH ( 
		        TRUE (),  
		            __YTD_SingleMonth, FORMAT ( __EndYTD, "mmm'yy" ),  
		            FORMAT ( __StartYTD, "mmm'yy" ) & " - " & FORMAT ( __EndYTD, "mmm'yy" )  
		    ) 

		VAR __Result =  __YTD_Current 

		RETURN __Result

		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\YTD
		lineageTag: c2e137a8-1082-42c9-a216-336a6719f672

	measure '_Text KPI Section Header YTD Short' = ```


		VAR __SelectedDate =    MAX ( 'Dim_Calendar'[Start of Month] ) 
		VAR __StartYTD =        MINX ( DATESYTD ( 'Dim_Calendar'[Start of Month] ) , 'Dim_Calendar'[Start of Month] ) 
		VAR __EndYTD =          __SelectedDate 

		VAR __YTD_SingleMonth =  __StartYTD = __EndYTD 

		VAR __YTD_Current = 
		    SWITCH ( 
		        TRUE (),  
		            __YTD_SingleMonth, FORMAT ( __EndYTD, "mmm'yy" ),  
		            FORMAT ( __StartYTD, "mmm'yy" ) & " - " & FORMAT ( __EndYTD, "mmm'yy" )  
		    ) 

		VAR __Result =  "𝗬𝗧𝗗 | " & __YTD_Current 

		RETURN __Result

		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\YTD
		lineageTag: c2cfb9d8-1606-4412-b6e0-ce6533ade6c8

	measure '_Text KPI Section Header YTD' = ```


		VAR __SelectedDate = MAX ( 'Dim_Calendar'[Start of Month] ) 
		VAR __StartYTD =     MINX ( DATESYTD ( 'Dim_Calendar'[Start of Month] ) , 'Dim_Calendar'[Start of Month] ) 
		VAR __EndYTD =       __SelectedDate 

		VAR __StartYTD_Previous = EOMONTH ( __StartYTD, -12 ) 
		VAR __EndYTD_Previous =   EOMONTH ( __EndYTD, -12 ) 

		VAR __YTD_SingleMonth =         __StartYTD = __EndYTD 
		VAR __YTD_PreviousSingleMonth = __StartYTD_Previous = __EndYTD_Previous 

		VAR __YTD_Current = 
		    SWITCH ( 
		        TRUE (),  
		            __YTD_SingleMonth, FORMAT ( __EndYTD, "mmm'yy" ),  
		            FORMAT ( __StartYTD, "mmm'yy" ) & " - " & FORMAT ( __EndYTD, "mmm'yy" )  
		    ) 

		VAR __YTD_Previous = 
		    SWITCH ( 
		        TRUE (),  
		            __YTD_PreviousSingleMonth, FORMAT ( __EndYTD_Previous, "mmm'yy" ),  
		            FORMAT ( __StartYTD_Previous, "mmm'yy" ) & " - " & FORMAT ( __EndYTD_Previous, "mmm'yy" )  
		    ) 

		VAR __Result = 
		    "𝗬𝗧𝗗 | " & __YTD_Current 
		    & " vs " & __YTD_Previous 

		RETURN __Result

		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\YTD
		lineageTag: 8837c54b-aed3-4285-9b61-a2530dd0259b

	measure '_Text KPI Section Header Per Period Short V2' = ```


		VAR __SelectedDate =          MAX ( 'Dim_Calendar'[Start of Month] ) 
		VAR __SelectedDate_Format =   FORMAT ( __SelectedDate, "mmm'yy" ) 

		VAR __Result =  __SelectedDate_Format 

		RETURN __Result

