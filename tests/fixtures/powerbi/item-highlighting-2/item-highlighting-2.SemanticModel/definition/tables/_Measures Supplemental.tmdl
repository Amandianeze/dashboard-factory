	measure '_Date Information - Selected Range' = ```


		VAR __FmtShort =                "mmm'yy" 
		VAR __FmtLong  =                "dd mmm yy"

		VAR __MinDate =                 MIN ( 'Dim_Calendar'[Date] )
		VAR __MaxDate =                 MAX ( 'Dim_Calendar'[Date] )

		VAR __MinDate_F =               FORMAT ( __MinDate, __FmtLong  )
		VAR __MaxDate_F =               FORMAT ( __MaxDate, __FmtLong  )

		VAR __ShortMinDate_F =          FORMAT ( __MinDate, __FmtShort )
		VAR __ShortMaxDate_F =          FORMAT ( __MaxDate, __FmtShort )

		VAR __TotalDays =               DATEDIFF ( __MinDate, __MaxDate, DAY ) + 1
		VAR __SelectedDays =            COUNTROWS ( VALUES ( 'Dim_Calendar'[Date] ) )

		VAR __MinDateMonthStart =       EOMONTH ( __MinDate, -1 ) + 1
		VAR __MaxDateMonthEnd =         EOMONTH ( __MaxDate, 0 )

		VAR __CG_Period_Select =        SELECTEDVALUE ( 'CG Period Selector'[Period Selector Item] )
		VAR __Is_Supplemental_Cal =     ISCROSSFILTERED ( 'Dim Calendar Suppl'[Date] )

		VAR __MaxDate_Suppl =           MAX ( 'Dim Calendar Suppl'[Date] )
		VAR __ShortMaxDate_Suppl_F =    FORMAT ( __MaxDate_Suppl, __FmtShort )

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		        __CG_Period_Select = "In Period",                                   __ShortMaxDate_F,
		        __Is_Supplemental_Cal,                                              __ShortMaxDate_Suppl_F,
		        __MaxDate = __MinDate,                                              __MaxDate_F,
		        __TotalDays <> __SelectedDays,                                      "Multiple Date Ranges",
		        __MinDate = __MinDateMonthStart && __MaxDate = __MaxDateMonthEnd,   __ShortMinDate_F & " - " & __ShortMaxDate_F,
		        __MinDate_F & " - " & __MaxDate_F
		    )

		RETURN __RESULT

		```
		displayFolder: Texts\Date Ranges\01.Multi-Select Ranges
		lineageTag: 1a10611f-eaeb-46dc-8c18-c0838304bb02

	measure '_Rank Page ID | Hierarchy' = ```


		VAR __TableToRank_1st =
		    ALLSELECTED ( DIM_Pages[Category], DIM_Pages[Category Sort ID] )

		VAR __TableToRank_2nd =
		    ALLSELECTED ( DIM_Pages[Page Name], DIM_Pages[ID] )

		VAR __TableToRank_Overall =
		    ALLSELECTED ( DIM_Pages )



		VAR __Rank_1st_Level =
		    RANK (
		        DENSE,
		        __TableToRank_1st,
		        ORDERBY ( 
		            [_Page Category ID], ASC BLANKS LAST
		        ),
		        LAST,,
		    )

		VAR __Rank_2nd_Level =
		    RANK (
		        DENSE,
		        __TableToRank_2nd,
		        ORDERBY ( 
		            [_Page ID], ASC BLANKS LAST
		        ),
		        LAST
		    )

		VAR __Rank_Overall =
		    RANK (
		        DENSE,
		        __TableToRank_Overall ,
		        ORDERBY ( 
		            [_Page Category ID], ASC BLANKS LAST,
		            [_Page ID], ASC BLANKS LAST
		        ),
		        LAST
		    )

		VAR __1st_Level_Inscope = ISINSCOPE ( DIM_Pages[Category] )
		VAR __2nd_Level_Inscope = ISINSCOPE ( DIM_Pages[Page Name] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __1st_Level_Inscope && __2nd_Level_Inscope, __Rank_Overall ,
		            __2nd_Level_Inscope, __Rank_2nd_Level,
		            __1st_Level_Inscope, __Rank_1st_Level,
		            [_Page ID]
		    )

		RETURN __Result

		```
		formatString: 0
		displayFolder: Pages (List of exercises) - Navigation\02. Supplemental
		lineageTag: 25c25334-9359-4130-b6af-d3b2d06431a3

