	measure '_Standard Cal. Date Range | Multiple periods' = ```


		VAR __Min_date      =  MIN ( 'Dim_Calendar'[Date] )
		VAR __Max_date      =  MAX ( 'Dim_Calendar'[Date] )

		VAR __Min_date_F    =  FORMAT ( __Min_date , "mmm'yy")
		VAR __Max_date_F    =  FORMAT ( __Max_date, "mmm'yy")

		VAR __Total_months  =  DATEDIFF ( __Min_date, __Max_date, MONTH) + 1

		VAR __Selected_Months_Count =    
		    CALCULATE ( 
		        DISTINCTCOUNT ( 'Dim_Calendar'[CurrMonthOffset] ), 
		        KEEPFILTERS ( 'Dim_Calendar'[Date] <= __Max_date )
		    )
		        
		VAR __Result =
		        SWITCH(
		            TRUE(),
		                __Max_date_F = __Min_date_F, __Max_date_F,
		                __Total_months <> __Selected_Months_Count, "Multiple periods",
		                __Min_date_F & " - " & __Max_date_F
		        )

		RETURN __Result



		// VAR __Max_date      =  CALCULATE ( MAX ( 'Dim Calendar'[Date] ), KEEPFILTERS ( 'Dim Calendar'[_Is Closed Period] = 1 ) )
		// VAR __Max_date      =  [_Standard Cal. Max Date] -- Based on the Last Invoice Date // Optionally change to -> MAX ( 'Dim Calendar'[Date] )
