		            ALL ( DIM_Pages_Suppl[ID] ),
		            KEEPFILTERS ( DIM_Pages_Suppl[ID] > __CurrentID  )
		        )

		VAR __Result =
		    CALCULATE ( 
		        SELECTEDVALUE ( DIM_Pages_Suppl[Page Name] ),
		        DIM_Pages_Suppl[ID] = __Prev_ID 
