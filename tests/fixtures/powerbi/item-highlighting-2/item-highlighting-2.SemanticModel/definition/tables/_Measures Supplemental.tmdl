	measure '_Date Range | Multiple periods Incl. FCT table' = ```


		VAR __Min_date_cal =  MIN ('Dim_Calendar'[Date])
		VAR __Max_date_cal =  MAX ('Dim_Calendar'[Date])
		VAR __Min_date_fct =  MIN ( FCT_Summarized_Data[Date] )
		VAR __Max_date_fct =  MAX ( FCT_Summarized_Data[Date] )

		VAR __Min_Date =      MAX ( __Min_Date_Cal, __Min_Date_Fct )
		VAR __Max_date =      MIN ( __Max_date_cal, __Max_date_fct )
		VAR __Min_date_F =    FORMAT ( __Min_date , "mmm'yy")
		VAR __Max_date_F =    FORMAT ( __Max_date, "mmm'yy")

		VAR __Total_months =  DATEDIFF ( __Min_date_cal, __Max_date, MONTH) + 1

		VAR __Selected_Months_Count =    
		    CALCULATE ( 
		        DISTINCTCOUNT ( 'Dim_Calendar'[MonthnYear] ), 
		        KEEPFILTERS ( 'Dim_Calendar'[Date] <= __Max_date )
		    )
		        
		VAR __Selected_Year_Count =    
		    CALCULATE ( 
		        DISTINCTCOUNT ( 'Dim_Calendar'[Year] ) , 
		        KEEPFILTERS ( 'Dim_Calendar'[Date] <= __Max_date )
		    )

		VAR __Result =
		        SWITCH(
		            TRUE(),
		                __Max_date_F = __Min_date_F, __Max_date_F,
		                __Total_months <> __Selected_Months_Count, "Multiple periods",
		                __Min_date_F & " - " & __Max_date_F
		        )

		RETURN __Result
		```
		displayFolder: Texts\Date Ranges\01.Multi-Select Ranges
		lineageTag: 3cb9488d-d09e-4eab-9436-af07616b7d1a

