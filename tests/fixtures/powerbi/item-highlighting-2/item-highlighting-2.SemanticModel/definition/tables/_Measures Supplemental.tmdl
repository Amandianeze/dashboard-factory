	measure '_Date Range Basic' = ```

		VAR __MinDate = MIN('Dim_Calendar'[Date])
		VAR __MaxDate = MAX('Dim_Calendar'[Date])

		VAR __MinDateFormatted = FORMAT(__MinDate, "mmm'yy")
		VAR __MaxDateFormatted = FORMAT(__MaxDate, "mmm'yy")

		VAR __Result = 
		    SWITCH(
		        TRUE(),
		        __MinDateFormatted = __MaxDateFormatted, __MinDateFormatted,  
		        __MinDateFormatted & " - " & __MaxDateFormatted  
		    )

		RETURN __Result

		```
		displayFolder: Texts\Date Ranges\01.Multi-Select Ranges
		lineageTag: 43e7ca9b-8d82-4939-90eb-d08216677ecc

