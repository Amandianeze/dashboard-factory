	measure '_Text KPI Section Header Per Period' = ```


		VAR __SelectedDate =          MAX ( 'Dim_Calendar'[Start of Month] ) 
		VAR __SelectedDate_Format =   FORMAT ( __SelectedDate, "mmm'yy" ) 

		VAR __PreviousYearDate =      EOMONTH ( __SelectedDate, -12 ) 
		VAR __PreviousYearMonthYear = FORMAT ( __PreviousYearDate, "mmm'yy" ) 

		VAR __Result = 
		    "𝗣𝗲𝗿 𝗣𝗲𝗿𝗶𝗼𝗱 | " & __SelectedDate_Format 
		    & " vs " & __PreviousYearMonthYear 

		RETURN __Result

		```
		displayFolder: Texts\Date Ranges\02.Single-Select-Slicer\In Period
		lineageTag: 7be886f0-afdd-4386-ba4b-071ea5bae39a

	measure '_Text KPI Section Header LTM Short V2' = ```


		VAR __SelectedDate =            MAX ( 'Dim_Calendar'[Start of Month] ) 
		VAR __LTM_Start_Date =          EOMONTH ( __SelectedDate, -12 ) + 1
		VAR __LTM_Start =               FORMAT ( __LTM_Start_Date, "mmm'yy" ) 
