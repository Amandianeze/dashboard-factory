	measure '_Positive Variance color | Light' = ```


		VAR __Sentiment_Mode = SELECTEDVALUE ( 'TBL Sentiment Color Variant'[Mode] )

		VAR __Result =
		    SWITCH (
		        __Sentiment_Mode,
		            "Red/Green",        "#63D17F",
		            "Red/Blue",         "#89CDFF",
		            "Red/Green(IBCS)",  "#8CB400",
		            "#308C9A"
		    )

