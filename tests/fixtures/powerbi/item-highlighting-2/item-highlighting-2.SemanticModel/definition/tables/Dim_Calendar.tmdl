table Dim_Calendar
	dataCategory: Time
	lineageTag: 99a89571-eb01-4c63-a8e8-df772948ff42

	measure '_DateInt Max' = ```


		MAX ( 'Dim_Calendar'[DateInt] )
		```
		displayFolder: 01. Main
		lineageTag: 81e7999a-c63f-446d-9cc5-10249c26b09b

	measure '_Max Month Offset' = -8
		lineageTag: 3c84cc69-b45c-4ff2-8302-7aa28c1b8f0f

	measure '_Max Quarter Offset' = -2
		lineageTag: 37607a10-351a-4c79-94e3-59ba6c380664

	measure '_Date Slicer Filter' = ```


		VAR __Granularity = SELECTEDVALUE ( 'TBL Granularity'[Name Short] )
		VAR __Min_Offset = -100

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            __Granularity = "M"  
		            && MAX ( 'Dim_Calendar'[CurrMonthOffset] ) >= __Min_Offset
		            && MAX ( 'Dim_Calendar'[CurrMonthOffset] ) <= [_Max Month Offset]
		            && NOT ( ISBLANK ( MAX ( 'Dim_Calendar'[CurrMonthOffset] ) ) ), 
		            1,

		            __Granularity = "Q"  
		            && MAX ( 'Dim_Calendar'[CurrQuarterOffset] ) >= __Min_Offset
		            && MAX ( 'Dim_Calendar'[CurrQuarterOffset] ) <= [_Max Quarter Offset]
		            && NOT ( ISBLANK ( MAX ( 'Dim_Calendar'[CurrQuarterOffset] ) ) ), 
		            1,

		            __Granularity = "Y"  
		            && MAX ( 'Dim_Calendar'[CurrYearOffset] ) >= __Min_Offset
		            && MAX ( 'Dim_Calendar'[CurrYearOffset] ) <= 0
		            && NOT ( ISBLANK ( MAX ( 'Dim_Calendar'[CurrYearOffset] ) ) ), 
		            1
		    )

		RETURN __Result


		     
		```
		lineageTag: 41074342-1032-416c-9a6c-73e161ef7752

	measure '_Month Short Slicer Order Alt. 3x4 Grid' = ```


		VAR __Month_Number = MAX ( 'Dim_Calendar'[Month] )

		VAR __Result =
		    SWITCH (
		       __Month_Number,
		            1, 1, 
		            2, 4, 
		            3, 7, 
		            4, 10, 
		            5, 2, 
		            6, 5, 
		            7, 8,
		            8, 11, 
		            9, 3,
		            10, 6, 
		            11, 9, 
		            12, 12
		    )

		RETURN __Result
		```
		displayFolder: 01. Main
		lineageTag: a716d74f-6c8b-4a2a-a21c-b38b64032b36

	measure '_Month Short Slicer Order Alt. 4x3 Grid' = ```


		VAR __Month_Number = MAX ( 'Dim_Calendar'[Month] )

		VAR __Result =
		    SWITCH (
		       __Month_Number,
		            1, 1, 
		            2, 5, 
		            3, 9, 
		            4, 2,  
		            5, 6, 
		            6, 10, 
		            7, 3,
		            8, 7, 
		            9, 11,
		            10, 4, 
		            11, 8, 
		            12, 12
		    )

		RETURN __Result
		```
		displayFolder: 01. Main
		lineageTag: 9300ccca-5da3-4021-89fc-4ace7da210f0

