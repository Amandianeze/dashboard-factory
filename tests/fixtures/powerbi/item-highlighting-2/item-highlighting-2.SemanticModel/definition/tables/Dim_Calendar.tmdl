	partition Dim_Calendar = m
		mode: import
		source = ```
			let
			    //-------------------------------------------------------------------------
			    //  ⬛  SOURCE CALENDAR
			    //-------------------------------------------------------------------------
			    sourceCalendar =
			        CalendarQuery ( #date(2023, 1, 1), #date(2025, 12, 31), null, null, null ),


			    //-------------------------------------------------------------------------
			    //  ⬛  BASIC COLUMNS
			    //-------------------------------------------------------------------------
			    basicColumns =
			        Table.SelectColumns (
			            sourceCalendar,
			            {
			                "Date", 
			                "DateInt", "CurrDayOffset",
			                "Year", "CurrYearOffset",
			                "Quarter Number", "Quarter", "Start of Quarter", "Quarter & Year", "QuarternYear", "CurrQuarterOffset",
			                "Month", "Start of Month", "Month & Year", "MonthnYear", "CurrMonthOffset",
			                "Month Name", "Month Short", "Month Initial",
			                "Week Number", "Start of Week", "End of Week", "Week & Year", "WeeknYear", "CurrWeekOffset",
			                "Day of Month", "Day of Week Number", "Day of Week Name", "Day of Week Initial", "Day Type",
			                "IsAfterToday"
			            }
			        ),

			    addStartOfYear =
			        Table.AddColumn ( basicColumns, "Start of Year", each Date.StartOfYear ( [Date] ), type date ),


			    //-------------------------------------------------------------------------
			    //  ⬛  TEXT-FORMAT COLUMNS (YEAR / MONTH / QUARTER)
			    //-------------------------------------------------------------------------
			    addYearText =
			        Table.AddColumn ( addStartOfYear, "Year Text", each Text.From ( Date.Year ( [Date] ) ) ),

			    addMonthYearShort =
			        Table.AddColumn (
			            addYearText, "mmm'yy",
			            each Text.Combine (
			                {
			                    Date.ToText ( [Date], "MMM" ),
			                    "'",
			                    Text.End ( Text.From ( Date.Year ( [Date] ) ), 2 )
			                }
			            )
			        ),

			    addQuarterYearShort =
			        Table.AddColumn (
			            addMonthYearShort, "qq'yy",
			            each
			                Text.From ( Date.QuarterOfYear ( [Date] ) )
			                & "Q'"
			                & Text.End ( Text.From ( Date.Year ( [Date] ) ), 2 )
			        ),

			    addQuarterYearLong =
			        Table.AddColumn (
			            addQuarterYearShort, "qq'yyyy",
			            each
			                Text.From ( Date.QuarterOfYear ( [Date] ) )
			                & "Q'"
			                & Text.From ( Date.Year ( [Date] ) )
			        ),

			    addMonthYearLong =
			        Table.AddColumn (
			            addQuarterYearLong, "mmm'yyyy",
			            each Date.ToText ( [Date], "MMM" ) & "'" & Text.From ( Date.Year ( [Date] ) )
			        ),


			    //-------------------------------------------------------------------------
			    //  ⬛  WEEK / QUARTER TEXT TRANSFORMATIONS
			    //-------------------------------------------------------------------------
			    addQuarterLabel =
			        Table.AddColumn (
			            addMonthYearLong, "Quarter of Year",
			            each "Q" & Text.From ( Date.QuarterOfYear ( [Date] ) )
			        ),

			    addWeekYear =
			    Table.AddColumn (
			        addQuarterLabel, "Week and Year",
			        each
			            "W"
			            & Text.PadStart( Text.From( Number.Mod( [WeeknYear], 100 ) ), 2, "0" )
			            & " "
			            & Text.From( Number.IntegerDivide( [WeeknYear], 100 ) )
			    ),

			    addWeekLabel =
			    Table.AddColumn (
			        addWeekYear, "Week of Year",
			        each "W" & Text.PadStart( Text.From( Number.Mod( [WeeknYear], 100 ) ), 2, "0" )
			    ),
			    
			    addWeekID =
			    Table.AddColumn (
			        addWeekLabel, "Week of Year ID",
			        each Number.Mod( [WeeknYear], 100 ),
			        Int64.Type
			    ),


			    //-------------------------------------------------------------------------
			    //  ⬛  DAY-OF-WEEK VARIANTS
			    //-------------------------------------------------------------------------
			    addDayOfWeekAlt =
			        Table.AddColumn (
			            addWeekID, "Day of Week Alt.",
			            each let d = Date.DayOfWeek ( [Date] ) in if d = 0 then 7 else d,
			            Int64.Type
			        ),

			    addDayNameShort =
			        Table.AddColumn (
			            addDayOfWeekAlt, "Day Name Short",
			            each Text.Start ( [Day of Week Name], 3 )
			        ),


			    //-------------------------------------------------------------------------
			    //  ⬛  EXTRA “SPACE” COLUMNS (FOR PRETTY HEADERS)
			    //-------------------------------------------------------------------------
			    addWeekShort =
			        Table.AddColumn (
			            addDayNameShort, "Week of Year Short",
			            each
			                Text.BeforeDelimiter ( [Week and Year], " " )
			                & "'"
			                & Text.End ( Text.From ( Text.AfterDelimiter ( [Week and Year], " " ) ), 2 )
			        ),

			    addWeekShortPadded =
			        Table.AddColumn (
			            addWeekShort, "Week of Year with space",
			            each Text.Repeat ( Character.FromNumber ( 160 ), 8 ) & [Week of Year Short]
			        ),

			    addYearPadded =
			        Table.AddColumn (
			            addWeekShortPadded, "Year with space",
			            each Text.Repeat ( Character.FromNumber ( 160 ), 10 ) & [Year Text]
			        ),

			    addMonthYearPadded =
			        Table.AddColumn (
			            addYearPadded, "mmm'yy with space",
			            each Text.Repeat ( Character.FromNumber ( 160 ), 8 ) & [#"mmm'yy"]
			        ),

			    addQuarterYearPadded =
			        Table.AddColumn (
			            addMonthYearPadded, "qq'yy with space",
			            each Text.Repeat ( Character.FromNumber ( 160 ), 10 ) & [#"qq'yy"]
			        ),


			    //-------------------------------------------------------------------------
			    //  ⬛  OTHER SUPPLEMENTAL COLUMNS
			    //-------------------------------------------------------------------------
			    addMonthInQuarter =
			        Table.AddColumn (
			            addQuarterYearPadded, "Month In Quarter",
			            each Number.Mod ( Date.Month ( [Date] ) - 1, 3 ) + 1,
			            Int64.Type
			        ),
			    
			    addYearLabel =
			        Table.AddColumn ( 
			            addMonthInQuarter, "Year Display", 
			            each if [#"CurrYearOffset"] = 0 
			                then "Current Year" 
			                else Text.From ( [Year] ), 
			            type text
			        ),

			    addAllFlag =
			        Table.AddColumn(
			            addYearLabel,
			            "All",
			            each "All",
			            type text     
			    ),


			    //-------------------------------------------------------------------------
			    RESULT = addAllFlag,
			    #"Renamed Columns" = Table.RenameColumns(RESULT,{{"qq'yy", "qqyy"}})
			in
