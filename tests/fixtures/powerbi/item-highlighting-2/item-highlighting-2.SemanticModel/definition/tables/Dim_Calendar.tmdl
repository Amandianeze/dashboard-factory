	column 'Year Slicer Display' = ```


		VAR __Result = 
		    SWITCH (
		        TRUE (),
		        'Dim_Calendar'[CurrYearOffset] = 0, "Current Year",
		        'Dim_Calendar'[Year Text]
		    )

		RETURN __Result
		```
