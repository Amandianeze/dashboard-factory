table 'TBL Item Highlighting'
	lineageTag: 86ff96bf-7cd7-407b-b134-ee71540cc548

	measure '_Revenue | Item Highlighting' = ```


		VAR __Selected_Mode_ID =
		    SELECTEDVALUE ( 'TBL Item Highlighting'[ID] )

		VAR __Customer_Dimension_Is_Filtered =
		    ISCROSSFILTERED ( 'DIM_Customers_Supplemental alt'[Customer_ID] )

		VAR __Selected_Customers =
		    VALUES ( 'DIM_Customers_Supplemental alt'[Customer_ID] )

		VAR __Customer_Table =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Customer_ID] ),
		        "@Highlighting_Mode_ID",
		            SWITCH (
		                TRUE(),
		                    NOT __Customer_Dimension_Is_Filtered,               1,
		                    DIM_Customers[Customer_ID] IN __Selected_Customers, 1,
		                    2
		            )
		    )

		VAR __Customer_Table_Filtered =
		    FILTER (
		        __Customer_Table,
		        ISBLANK ( __Selected_Mode_ID ) || [@Highlighting_Mode_ID] = __Selected_Mode_ID
		    )

		VAR __Customer_Filter =
		    SELECTCOLUMNS (
		        __Customer_Table_Filtered,
		        "@Customer_Filter_ID", DIM_Customers[Customer_ID]
		    )

		VAR __Result =
		    CALCULATE (
		        [_Revenue],
		        KEEPFILTERS (
		            TREATAS (
		                __Customer_Filter,
		                DIM_Customers[Customer_ID]
		            )
		        )
		    )

		RETURN __Result

		```
		formatString: #,0;-#,0;0
		displayFolder: 02. Selected vs Unselected via Measure\01. Variant I
		lineageTag: ec5f55e3-8566-4b35-8337-c1eb5be07e76

