	measure '_Revenue | Item Highlighting | Tabular Variant' = ```


		VAR __Selected_Mode_ID =
		    SELECTEDVALUE ( 'TBL Item Highlighting'[ID] )

		VAR __Customer_Is_Filtered =
		    ISCROSSFILTERED ( 'DIM_Customers_Supplemental alt'[Customer_ID] )

		VAR __Selected_Customers =
		    SELECTCOLUMNS (
		        VALUES ( 'DIM_Customers_Supplemental alt'[Customer_ID] ),
		        "Customer_ID", 'DIM_Customers_Supplemental alt'[Customer_ID]
		    )

		VAR __Customer_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Revenue", [_Revenue]
		    )

		VAR __Customer_Table_Classified =
		    ADDCOLUMNS (
		        __Customer_Table,
		        "@Highlighting_Mode_ID",
		            SWITCH (
		                TRUE(),
		                    NOT __Customer_Is_Filtered,                     1,
		                    CONTAINS (
		                        __Selected_Customers,
		                        [Customer_ID], DIM_Customers[Customer_ID]
		                    ),                                              1,
		                    2
		            )
		    )

		VAR __Customer_Table_Filtered =
		    FILTER (
		        __Customer_Table_Classified,
		        ISBLANK ( __Selected_Mode_ID ) || [@Highlighting_Mode_ID] = __Selected_Mode_ID
		    )

		VAR __Result =
		    SUMX ( __Customer_Table_Filtered, [@Revenue] )

		RETURN __Result
		```
		displayFolder: 02. Selected vs Unselected via Measure\02. Variant II
		lineageTag: ebef3db0-a5d3-48e2-976d-4e2ebb68d6d5

	measure '_Gross Margin % Perc | Item Highlighting | Tabular Variant' = ```


		VAR __Selected_Mode_ID =
		    SELECTEDVALUE ( 'TBL Item Highlighting'[ID] )

		VAR __Customer_Is_Filtered =
		    ISCROSSFILTERED ( 'DIM_Customers_Supplemental alt'[Customer_ID] )

		VAR __Selected_Customers =
		    SELECTCOLUMNS (
		        VALUES ( 'DIM_Customers_Supplemental alt'[Customer_ID] ),
		        "Customer_ID", 'DIM_Customers_Supplemental alt'[Customer_ID]
		    )

		VAR __Customer_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Revenue",     [_Revenue],
		        "@GrossProfit", [_Gross Profit]
		    )

		VAR __Customer_Table_Classified =
		    ADDCOLUMNS (
		        __Customer_Table,
		        "@Highlighting_Mode_ID",
		            SWITCH (
		                TRUE(),
		                    NOT __Customer_Is_Filtered,                     1,
		                    CONTAINS (
		                        __Selected_Customers,
		                        [Customer_ID], DIM_Customers[Customer_ID]
		                    ),                                              1,
		                                                                    2
		            )
		    )

		VAR __Customer_Table_Filtered =
		    FILTER (
		        __Customer_Table_Classified,
		        ISBLANK ( __Selected_Mode_ID ) || [@Highlighting_Mode_ID] = __Selected_Mode_ID
		    )

		VAR __Revenue       = SUMX ( __Customer_Table_Filtered, [@Revenue] )
		VAR __GrossProfit   = SUMX ( __Customer_Table_Filtered, [@GrossProfit] )
		VAR __Result        = DIVIDE ( __GrossProfit, __Revenue )

		RETURN __Result
		```
		formatString: 0.0%;-0.0%;0%
		displayFolder: 02. Selected vs Unselected via Measure\02. Variant II
