	measure '_Item Highlighting | Tag' = ```


		VAR __HighlightingModeID =
		    SELECTEDVALUE ( 'TBL Item Highlighting'[ID] )

		VAR __Customer_Is_Filtered =
		    ISCROSSFILTERED ( 'DIM_Customers_Supplemental alt'[Customer_ID] )

		VAR __Is_Matched =
		    NOT ISEMPTY (
		        INTERSECT (
		            VALUES ( 'DIM_Customers_Supplemental alt'[Customer_ID] ),
		            VALUES ( DIM_Customers[Customer_ID] )
		        )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __HighlightingModeID = 1 && NOT __Customer_Is_Filtered,  1,
		            __HighlightingModeID = 1 && __Is_Matched,                1,
		            __HighlightingModeID = 2 && NOT __Is_Matched,            1,
		            BLANK()
		    )

		RETURN __Result



