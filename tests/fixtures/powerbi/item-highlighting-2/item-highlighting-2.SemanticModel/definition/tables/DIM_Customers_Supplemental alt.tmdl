	measure '_Customer Highlighting | Filter Tag | Basic' = ```

		      
		VAR __Customer_Dimension_Is_Filtered =
		    ISCROSSFILTERED ( 'DIM_Customers_Supplemental alt'[Customer_ID] )

		VAR __Is_Matched =
