	measure '_Revenue LTM Based on Offset | with zeros alt.' = ```


		VAR __Selected_Month = MAX ( 'Dim_Calendar'[CurrMonthOffset]  )
		VAR __Period_Window_ToDisplay =  12

		VAR __StartMonth = ( __Selected_Month - __Period_Window_ToDisplay ) + 1

		VAR __LTM_Calculation =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonth &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		VAR __LTM_Calculation_ALL =
		CALCULATE (
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonth &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    ),
		    ALLSELECTED ( 'Dim Calendar Suppl')
		)

		VAR __Empty_Values =
		    SWITCH (
		        TRUE(),
		           ISBLANK ( __LTM_Calculation ) && NOT ( ISBLANK ( __LTM_Calculation_ALL ) ),
		           0,
		           BLANK()
		    )

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            SELECTEDVALUE ( 'Dim Calendar Suppl'[CurrMonthOffset] ) >=  __StartMonth &&
		            SELECTEDVALUE ( 'Dim Calendar Suppl'[CurrMonthOffset] ) <= __Selected_Month,
		            COALESCE ( __LTM_Calculation, __Empty_Values ),
		            __LTM_Calculation
		    )

		RETURN  __Result

		```
		formatString: #,0;-#,0;0
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\01.AC
		lineageTag: 508dbb08-dc21-44e0-a98f-3380a63245a3

