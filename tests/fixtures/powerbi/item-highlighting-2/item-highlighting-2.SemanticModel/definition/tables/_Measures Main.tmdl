	measure '_Revenue Avg Value - Monthly' = ```


		VAR __Months =
		    CALCULATETABLE (                    
		        FILTER (
		            ADDCOLUMNS (
		                VALUES ( 'Dim_Calendar'[Start of Month] ),
		                "@Rev", [_Revenue]
		            ),
		            NOT ISBLANK ( [@Rev] )
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __MinMonth   = MINX ( __Months, [Start of Month] )
		VAR __MaxMonth   = MAXX ( __Months, [Start of Month] )
		VAR __AvgRevenue = AVERAGEX ( __Months, [@Rev] )

		VAR __CurMonth   = MIN ( 'Dim_Calendar'[Start of Month] )
		VAR __InScope    = ISINSCOPE ( 'Dim_Calendar'[Start of Month] )

		VAR __Result =
		    IF (
		        NOT __InScope,                           
		        __AvgRevenue,
		        IF (
		            __CurMonth >= __MinMonth &&
		            __CurMonth <= __MaxMonth,     
		            __AvgRevenue
		        )
		    )

		RETURN __Result
		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\05. Avg
		lineageTag: 184a8ae5-cc89-450f-8250-74b039263c7c

	measure '_Revenue Avg Threshold Highlighting' = ```

		VAR __Breakdown  =  SELECTEDVALUE ( 'TBL Below/Above Threshold'[Name] )
		VAR __Revenue =     [_Revenue]                       
		VAR __AvgRev  =     [_Revenue Avg Value | Basic | Simple]      

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            __Breakdown = "Above" && 
		            __Revenue >= __AvgRev,
		            __Revenue - __AvgRev ,  
		            
		            __Breakdown = "Below" && 
		            __Revenue >= __AvgRev,
		            __AvgRev,

		            __Breakdown = "Above" && 
		            __Revenue < __AvgRev,
		            BLANK(),

		            __Revenue 
		    )

		RETURN __Result
		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\05. Avg
		lineageTag: 2212548a-f86f-4d47-ad9d-d9346a16a915

