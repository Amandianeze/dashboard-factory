	measure '_Revenue Dynamic Rank Number Alt. | Structure' = ```

		VAR __CurrentCustomer   =   SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Category          =   SELECTEDVALUE('TBL Top & Other Simple'[Name Display])
		VAR __IsCustomer        =   ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __TOPn_Bin          =   [NR Values 1-20 | Ranking 01 | Value]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID]
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		//***RANKING***//
		VAR __BaseTable_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",  
		                RANK (
		                    DENSE, 
		                    __BaseTable,
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		                )
		    )

		VAR __Ranking =
		     MAXX ( FILTER ( __BaseTable_With_Ranking, DIM_Customers[Customer_Name] = __CurrentCustomer ),  [@Rank] ) 
		    
		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    FILTER ( __BaseTable_With_Ranking, [@Rank] <= __TOPn_Bin )

		VAR __CustomerInTopN = 
		    CONTAINS ( __TopN_Customers,  DIM_Customers[Customer_Name], __CurrentCustomer )

		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __IsCustomer && __Category = "Top"    && __CustomerInTopN ,     __Ranking, 
		            __IsCustomer && __Category = "Others" && NOT __CustomerInTopN , __Ranking, 
		            NOT ( __IsCustomer ) && __Category = "Top",     1,
		            NOT ( __IsCustomer ) && __Category = "Others",  2,
		            BLANK()
		    )

		RETURN __Result


		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\01. Core
		lineageTag: 4e955fdb-05aa-4b2f-8eb5-0e612a23dbfe

	measure '_Pareto Tag | By Customer' = ```

		VAR __Current_Customer  = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Is_Customer       = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Category_Bin      = SELECTEDVALUE ( 'TBL Segment | Pareto '[Name Display] )

		// Classification percentages
		VAR __Percentage = [Parameter Pareto Dynamic Range | Value]  

		// Cumulative thresholds
		VAR __CumThreshold = __Percentage        

		VAR __Total = 
		    CALCULATE (
		        [_revenue],
		        REMOVEFILTERS (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] )
		    )
		        
		VAR __AllCustomers =
		    FILTER (
		        ADDCOLUMNS (
		            ALL (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Revenue", [_revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )
		        
		VAR __WithCumulative =
		    ADDCOLUMNS(
		        __AllCustomers,
		            "@CumPercent", 
		                DIVIDE (
		                    SUMX (
		                        WINDOW (
		                            1, ABS,
		                            0, REL,
		                            __AllCustomers,
		                            ORDERBY([@Revenue], DESC)
		                        ),
		                        [@Revenue]
		                    ),
		                    __Total
		                )
		            )
		        
		// Find minimum differences
		VAR __MinDiffA = MINX ( __WithCumulative, ABS([@CumPercent] - __CumThreshold))

		// Find actual thresholds
		VAR __ThresholdA = 
		    MINX (
		        __WithCumulative,
		            IF(
		                ABS ([@CumPercent] - __CumThreshold) = __MinDiffA,
		                [@CumPercent]
		            )
		        )
		        
		// Calculate current customer's cumulative %
		VAR __Current_Revenue = 
		    MAXX (
		        FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer ), 
		        [@Revenue]
		    )

		VAR __CurrentCumPercent = 
		    MAXX (
		        FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer  ),
		        [@CumPercent]
		    )
		        
		// Classify customer
		VAR __CustomerClass = 
		    SWITCH (
		        TRUE(),
		            __CurrentCumPercent <= __ThresholdA, "Pareto",
		            "Others"
		        )
		    
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            NOT __Is_Customer || ISBLANK (__Current_Revenue ), BLANK(),
		            __CustomerClass = __Category_Bin, 1,
		            BLANK()
		     )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\02. Pareto
		lineageTag: 2bca09f1-0ada-41b7-b163-92d022953127

	measure '_Pareto Ranking | By Customer' = ```

		VAR __CurrentCustomer   =   SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Category          =   SELECTEDVALUE ('TBL Segment | Pareto '[Name Display])
		VAR __IsCustomer        =   ISINSCOPE ( DIM_Customers[Customer_Name] )

		/***BASE TABLE***/

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID]
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		//***RANKING***//
		VAR __BaseTable_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",  
		                RANK (
		                    DENSE, 
		                    __BaseTable,
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		                )
		    )

		VAR __Ranking =
		     MAXX ( FILTER ( __BaseTable_With_Ranking, DIM_Customers[Customer_Name] = __CurrentCustomer ), [@Rank] ) 
		    
		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __IsCustomer, __Ranking, 
		            NOT ( __IsCustomer ) && __Category = "Pareto",  1,
		            NOT ( __IsCustomer ) && __Category = "Others",  2,
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: Segmentation & Ranking\02. Pareto
		lineageTag: 97a3f06d-f86c-4da3-ad57-e1fd3ea07fe3

	measure '_Pareto Revenue | By Customer' = ```


		VAR __Base_Table =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID]),
		        "@Revenue", [_revenue]
		    )
		    
		VAR __Totals =
		    SUMX ( __Base_Table, [@Revenue] )

		VAR __IfFiltered =
		    SUMX ( FILTER ( __Base_Table, [_Pareto Tag | By Customer] = 1), [@Revenue] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISFILTERED ( DIM_Customers[Customer_Name] ) || 
		            ISFILTERED ( 'TBL Segment | Pareto '[Name Display] ), 
		            __IfFiltered,
		           __Totals
		    )

		RETURN __Result

