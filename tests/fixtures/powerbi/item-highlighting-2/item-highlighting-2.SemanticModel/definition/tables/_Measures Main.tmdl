		dataCategory: ImageUrl
		lineageTag: ba5d7b33-33f8-4e1f-8e8c-4348835d542e

	measure '_Revenue | Relative Delta | SVG | Pin' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( 'DIM_Geo'[Country name - adjusted] )

		VAR __Relative_Variance =
		    [_Revenue Variance rel. PY]

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Variance_Value", [_Revenue Variance rel. PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Variance_Value] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw    = MAXX ( __BaseTable_Filtered, [@Variance_Value] )
		VAR __MinRaw    = MINX ( __BaseTable_Filtered, [@Variance_Value] )
		VAR __ScaleMin  = MIN ( __MinRaw, 0 )
		VAR __ScaleMax  = MAX ( __MaxRaw, 0 )
		VAR __Span      = MAX ( __ScaleMax - __ScaleMin, 1 )

		//______________________________________________________________________________________
		VAR __W          = 200
		VAR __H          = 25
		VAR __BarX       = 15
		VAR __TrackW     = __W - __BarX - 10

		VAR __PinY       = __H / 2
		VAR __PinStrokeW = 3
		VAR __HeadSize   = 8
		VAR __CircleR    = 4

		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Act =
		    __BarX
		        + DIVIDE ( __Relative_Variance - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __PinStart  = __X_Zero
		VAR __PinEnd    = __X_Act
		VAR __HeadX     = __X_Act - __HeadSize / 2
		VAR __HeadY     = __PinY - __HeadSize / 2

		//______________________________________________________________________________________
		VAR __ColorPos      = [_Positive Variance color]
		VAR __ColorNeg      = [_Negative Variance color]
		VAR __ColorPin      = IF ( __Relative_Variance >= 0, __ColorPos, __ColorNeg )
		VAR __ColorAC       = "#47627F"
		VAR __ColorMarker   = __ColorAC
		VAR __ColorBaseline = "Black"

		//______________________________________________________________________________________
		VAR __SortShift  = 1000
		VAR __SortKeyNum = __Relative_Variance + __SortShift
		VAR __SortKey    = FORMAT ( __SortKeyNum, "00000000.0000000000" )

		VAR __SVG_Prefix =
		    "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  sort='"   & __SortKey & "'
		>"

		VAR __SVG_Hammer =
		    IF (
		        __Span > 0 && __Relative_Variance <> 0,
		"  <rect
		    x='"             & __HeadX       & "'
		    y='"             & __HeadY       & "'
		    width='"         & __HeadSize    & "'
		    height='"        & __HeadSize    & "'
		    fill='"          & __ColorMarker & "'
		    stroke='"        & __ColorMarker & "'
		    stroke-width='1'
		  />",
		        ""
		    )

		VAR __SVG_Circle =
		    IF (
		        __Span > 0 && __Relative_Variance <> 0,
		"  <circle
		    cx='"            & __X_Act       & "'
		    cy='"            & __PinY        & "'
		    r='"             & __CircleR     & "'
		    fill='"          & __ColorMarker & "'
		    stroke='"        & __ColorMarker & "'
		    stroke-width='1'
		  />",
		        ""
		    )

		VAR __SVG_Pin =
		    IF (
		        __Span > 0 && __Relative_Variance <> 0,
		"  <line
		    x1='"            & __PinStart    & "'
		    y1='"            & __PinY        & "'
		    x2='"            & __PinEnd      & "'
		    y2='"            & __PinY        & "'
		    stroke='"        & __ColorPin    & "'
		    stroke-width='"  & __PinStrokeW  & "'
		    stroke-linecap='butt'
		  />",
		        ""
		    )

		VAR __SVG_Baseline =
		"  <line
		    x1='"            & __X_Zero                & "'
		    y1='2'
		    x2='"            & __X_Zero                & "'
		    y2='"            & ( __H - 2 )             & "'
		    stroke='"        & __ColorBaseline         & "'
		    stroke-opacity='0.6'
		    stroke-width='1.5'
		  />"

		VAR __SVG_Close =
		"</svg>"

		//______________________________________________________________________________________
		VAR __SVG_Marker =
		      //  __SVG_Hammer          // Comment given Variable to select preferred Market Type
		   __SVG_Circle                 // Comment given Variable to select preferred Market Type

		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Marker
		    &   __SVG_Pin
		    &   __SVG_Baseline
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),    // Can be either hidden or shown, but requires to add logic (code) to address the scalling for total level
		            ISBLANK ( __Relative_Variance ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\05. Relative Variance
		dataCategory: ImageUrl
		lineageTag: 8900c734-5259-4be8-aa27-53a2855253ab

	measure '_Revenue AC & PY | SVG | Clustered non-overlaped' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		VAR __Actual      = [_Revenue]
		VAR __Comparison  = [_Revenue PY]

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Actual",      [_Revenue],
		            "@Comparison",  [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparison] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw =
		    MAXX (
		        __BaseTable_Filtered,
		        MAX (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __MinRaw =
		    MINX (
		        __BaseTable_Filtered,
		        MIN (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __ScaleMin = MIN ( __MinRaw, 0 )
		VAR __ScaleMax = MAX ( __MaxRaw, 0 )
		VAR __Span     = MAX ( __ScaleMax - __ScaleMin, 1 )

		//______________________________________________________________________________________
		VAR __W      = 200
		VAR __H      = 25
		VAR __BarX   = 15
		VAR __TrackW = __W - __BarX - 10

		VAR __BarH   = 9
		VAR __Gap    = 2
		VAR __AC_Y   = 2.5
		VAR __Comparison_Y   = __AC_Y + __BarH + __Gap

		VAR __AxisY1 = MIN ( __AC_Y, __Comparison_Y ) - 1.5
		VAR __AxisY2 = MAX ( __AC_Y, __Comparison_Y ) + __BarH + 1.5

		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Act =
		    __BarX
		        + DIVIDE ( __Actual - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_PY =
		    __BarX
		        + DIVIDE ( __Comparison - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __ActualStart       = MIN ( __X_Zero, __X_Act )
		VAR __ComparisonStart   = MIN ( __X_Zero, __X_PY )
		VAR __ActualW           = ABS ( __X_Act - __X_Zero )
		VAR __ComparisonW       = ABS ( __X_PY  - __X_Zero )

		VAR __ColorPY           = "#D9E1E8"
		VAR __ColorPYBorder     = "#B2BBCB"
		VAR __ColorAC           = "#47627F"
		VAR __ColorAxis         = "#47627F"

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Actual + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  sort='"   & __SortKey & "'
		>"

		VAR __SVG_PY_Rect =
		    IF (
		        __ComparisonW > 0,
		"  <rect
		    x=               '"  & __ComparisonStart    & "'
		    y=               '"  & __Comparison_Y       & "'
		    width=           '"  & __ComparisonW        & "'
		    height=          '"  & __BarH               & "'
		    fill=            '"  & __ColorPY            & "'
		    stroke=          '"  & __ColorPYBorder      & "'
		    stroke-width=    '1'
		  />",
		        ""
		    )

		VAR __SVG_AC_Rect =
		    IF (
		        __ActualW > 0,
		"  <rect
		    x=              '"  & __ActualStart & "'
		    y=              '"  & __AC_Y        & "'
		    width=          '"  & __ActualW     & "'
		    height=         '"  & __BarH        & "'
		    fill=           '"  & __ColorAC     & "'
		    stroke=         '"  & __ColorAC     & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_YAxis =
		"  <line
		    x1=             '"  & __X_Zero    & "'
		    y1=             '"  & __AxisY1    & "'
		    x2=             '"  & __X_Zero    & "'
		    y2=             '"  & __AxisY2    & "'
		    stroke=         '"  & __ColorAxis & "'
		    stroke-width=   '1.5'
		  />"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_PY_Rect
		    &   __SVG_AC_Rect
		    &   __SVG_YAxis
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparison ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\02. Actuals and Comparative Metric
		dataCategory: ImageUrl
		lineageTag: e58d4156-be83-4f77-9f0e-e7c7fda4b6c2

	measure '_Revenue | SVG Data Bar | Delta TG | Scaled to AC TG' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Country] )
		        || ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		VAR __Act   = [_Revenue]
		VAR __PY    = [_Revenue PY]
		VAR __Delta = __Act - __PY

		VAR __BaseRaw =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@AC", [_Revenue],
		            "@TG", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        __BaseRaw,
		        "@Delta", [@AC] - [@TG],
		        "@MaxBase",
		            MAX (
		                COALESCE ( [@AC], 0 ),
		                COALESCE ( [@TG], 0 )
		            ),
		        "@MinBase",
		            MIN (
		                COALESCE ( [@AC], 0 ),
		                COALESCE ( [@TG], 0 )
		            )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@AC] )
		            || NOT ISBLANK ( [@TG] )
		    )

		VAR __MaxBase = MAXX ( __BaseTable_Filtered, [@MaxBase] )
		VAR __MinBase = MINX ( __BaseTable_Filtered, [@MinBase] )

		VAR __MaxDeltaPos = MAX ( 0, MAXX ( __BaseTable_Filtered, [@Delta] ) )
		VAR __MinDeltaNeg = MIN ( 0, MINX ( __BaseTable_Filtered, [@Delta] ) )

		VAR __MaxDeltaNegAbs  = ABS ( __MinDeltaNeg )
		VAR __BaseSpan        = MAX ( __MaxBase - __MinBase, 0 )
		VAR __DeltaSpanNeeded = __MaxDeltaPos + __MaxDeltaNegAbs

		VAR __ScaleMax =
		    MAX (
		        MAX ( __BaseSpan, __DeltaSpanNeeded ),
		        1
		    )

		VAR __W      = 200
		VAR __H      = 25
		VAR __BarX   = 15
		VAR __BarY   = 2.5
		VAR __BarH   = 20
		VAR __TrackW = __W - __BarX - 10

		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( __MaxDeltaNegAbs, __ScaleMax, 0 ) * __TrackW

		VAR __X_Delta =
		    __X_Zero
		        + DIVIDE ( __Delta, __ScaleMax, 0 ) * __TrackW

		VAR __BarStart = MIN ( __X_Zero, __X_Delta )
		VAR __BarW     = ABS ( __X_Delta - __X_Zero )

		VAR __ColorPos      = [_Positive Variance color]
		VAR __ColorNeg      = [_Negative Variance color]
		VAR __ColorActual   = IF ( __Delta >= 0, __ColorPos, __ColorNeg )
		VAR __ColorBaseline = "Black"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Delta + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  sort='"   & __SortKey & "'
		>"

		VAR __SVG_Actual =
		    IF (
		        __BarW > 0,
		"  <rect
		    x='"             & __BarStart    & "'
		    y='"             & __BarY        & "'
		    width='"         & __BarW        & "'
		    height='"        & __BarH        & "'
		    fill='"          & __ColorActual & "'
		    fill-opacity='1'
		  />",
		        ""
		    )

		VAR __SVG_Baseline =
		"  <line
		    x1='"            & __X_Zero                & "'
		    y1='"            & ( __BarY - 4 )          & "'
		    x2='"            & __X_Zero                & "'
		    y2='"            & ( __BarY + __BarH + 4 ) & "'
		    stroke='"        & __ColorBaseline         & "'
		    stroke-opacity='0.6'
		    stroke-width='1.5'
		  />"

		VAR __SVG_Close = "</svg>"

		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Actual
		    &   __SVG_Baseline
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Act ) && ISBLANK ( __PY ), BLANK(),
		            __ResultSVG
		    )

		RETURN
		    __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\09. Others
		dataCategory: ImageUrl
		lineageTag: 2e733d6c-db80-4b72-bff3-806b04162e3d

	measure '_Revenue AC & PY | SVG | Clustered overlaped' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		VAR __Actual        = [_Revenue]
		VAR __Comparison    = [_Revenue PY]

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Actual",      [_Revenue],
		            "@Comparison",  [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparison] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw =
		    MAXX (
		        __BaseTable_Filtered,
		        MAX (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __MinRaw =
		    MINX (
		        __BaseTable_Filtered,
		        MIN (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __ScaleMin = MIN ( __MinRaw, 0 )
		VAR __ScaleMax = MAX ( __MaxRaw, 0 )
		VAR __Span     = MAX ( __ScaleMax - __ScaleMin, 1 )

		//______________________________________________________________________________________
		VAR __W      = 200
		VAR __H      = 25
		VAR __BarX   = 15
		VAR __TrackW = __W - __BarX - 10

		VAR __BarH   = 12
		VAR __AC_Y   = 3
		VAR __Comparison_Y   = 9

		VAR __AxisY1 = MIN ( __AC_Y, __Comparison_Y ) - 1.5
		VAR __AxisY2 = MAX ( __AC_Y, __Comparison_Y ) + __BarH + 1.5

		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Act =
		    __BarX
		        + DIVIDE ( __Actual - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_PY =
		    __BarX
		        + DIVIDE ( __Comparison - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __ActualStart       = MIN ( __X_Zero, __X_Act )
		VAR __ComparisonStart   = MIN ( __X_Zero, __X_PY )
		VAR __ActualW           = ABS ( __X_Act - __X_Zero )
		VAR __ComparisonW       = ABS ( __X_PY  - __X_Zero )

		VAR __ColorPY           = "#D9E1E8"
		VAR __ColorPYBorder     = "#B2BBCB"
		VAR __ColorAC           = "#47627F"
		VAR __ColorAxis         = "#47627F"

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Actual + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  sort='"   & __SortKey & "'
		>"

		VAR __SVG_PY_Rect =
		    IF (
		        __ComparisonW > 0,
		"  <rect
		    x=              '"  & __ComparisonStart & "'
		    y=              '"  & __Comparison_Y    & "'
		    width=          '"  & __ComparisonW     & "'
		    height=         '"  & __BarH            & "'
		    fill=           '"  & __ColorPY         & "'
		    stroke=         '"  & __ColorPYBorder   & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_AC_Rect =
		    IF (
		        __ActualW > 0,
		"  <rect
		    x=              '"  & __ActualStart & "'
		    y=              '"  & __AC_Y        & "'
		    width=          '"  & __ActualW     & "'
		    height=         '"  & __BarH        & "'
		    fill=           '"  & __ColorAC     & "'
		    stroke=         '"  & __ColorAC     & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_YAxis =
		"  <line
		    x1=             '"  & __X_Zero    & "'
		    y1=             '"  & __AxisY1    & "'
		    x2=             '"  & __X_Zero    & "'
		    y2=             '"  & __AxisY2    & "'
		    stroke=         '"  & __ColorAxis & "'
		    stroke-width=   '1.5'
		  />"

		//______________________________________________________________________________________
		VAR __SVG_Close = "</svg>"

		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_PY_Rect
		    &   __SVG_AC_Rect
		    &   __SVG_YAxis
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparison ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
