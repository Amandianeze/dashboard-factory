	measure '_Filters | Active Dimensions | Segment | Multi | Cutoff' = ```


		VAR __Is_Filtered_Check = 
		    ISFILTERED ( DIM_Customers[Segment] ) 
		    // || Add more conditions if needed

		VAR __Items =
		    CONCATENATEX (
		        VALUES ( DIM_Customers[Segment] ),
		        DIM_Customers[Segment], ", ",
		        DIM_Customers[Segment],
		        ASC
		    )

		VAR __Text_Length_Cap =  75
		VAR __Ellipsis        = "..."

		VAR __Truncated_List_of_Items  =
		    LEFT ( __Items, __Text_Length_Cap - LEN ( __Ellipsis ) ) & __Ellipsis

		VAR __List_of_Items =
		    IF (
		        LEN ( __Items ) > __Text_Length_Cap,
		        __Truncated_List_of_Items,
		        __Items
		    )

		VAR __Result =
		    IF (
		        __Is_Filtered_Check, 
		            "Segment(s) filtered: " & __List_of_Items, 
		            "Segment(s) filtered: all available"
		    )

		RETURN __Result
		```
		displayFolder: Filter Display\02. Basic Variant V1
		lineageTag: 1a2c5307-d9b7-46fb-9c11-54fee555686b

	measure '_Filters | Active Dimensions | Segment | Multi | Cutoff Complex' = ```


		VAR __Is_Filtered_Check  = ISFILTERED ( DIM_Customers[Segment] )
		VAR __Table_Items        = VALUES ( DIM_Customers[Segment] )
		VAR __Total_Count        = COUNTROWS ( __Table_Items )

		VAR __Text_Length_Cap = 75

		VAR __Full_Text =
		    CONCATENATEX ( __Table_Items, DIM_Customers[Segment], ", ", DIM_Customers[Segment], ASC )

		VAR __Visible_Items =
		    FILTER (
		        ADDCOLUMNS (
		            __Table_Items,
		            "@Item_Start_Position", SEARCH ( DIM_Customers[Segment], __Full_Text, 1, 0 )
		        ),
		        [@Item_Start_Position] + LEN ( DIM_Customers[Segment] ) - 1 <= __Text_Length_Cap
		    )

		VAR __Visible_Items_Count   = COUNTROWS ( __Visible_Items )
		VAR __Truncated_Items_Count = __Total_Count - __Visible_Items_Count

		VAR __Visible_Text =
		    CONCATENATEX (
		        __Visible_Items,
		        DIM_Customers[Segment], ", ",
		        DIM_Customers[Segment], ASC
		    )

		VAR __Suffix =
		    IF ( 
		        __Truncated_Items_Count > 0, 
		        " and " & __Truncated_Items_Count & " more",
		        ""
		    )

		VAR __Result =
		    IF (
		        __Is_Filtered_Check,
		        "Filtered segment(s): " & __Visible_Text & __Suffix,
		        "Filtered segment(s) all available"
		    )

		RETURN __Result
		```
		displayFolder: Filter Display\02. Basic Variant V1
		lineageTag: aa05b17a-617e-4ada-840e-a61bca736c57

	measure '_Dot Scale | Rel Var PY | SVG | Capped' = ```


		VAR __Metric     = [_Revenue Variance rel. PY]
		VAR __Show       = NOT ISBLANK ( __Metric )

		VAR __ColorPos   = "#4DA6A2"
		VAR __ColorNeg   = "#B94D4D"
		VAR __ColorZero  = "#D0D6DC"
		VAR __ColorArrow = "#FFFFFF"

		VAR __Rmin       = 2
		VAR __Rmax       = 10

		VAR __CapPos     = 10
		VAR __CapNeg     = -10

		VAR __IsCapPos   = __Metric > __CapPos
		VAR __IsCapNeg   = __Metric < __CapNeg

		VAR __MetricClipped =
		    MIN (
		        MAX ( __Metric , __CapNeg ),
		        __CapPos
		    )

		VAR __ScaleAbsMax =
		    MAX ( __CapPos , ABS ( __CapNeg ) )

		VAR __Radius =
		    __Rmin
		        + DIVIDE ( ABS ( __MetricClipped ), __ScaleAbsMax, 0 )
		            * ( __Rmax - __Rmin )

		VAR __Fill =
		    SWITCH (
		        TRUE(),
		            __Metric > 0 , __ColorPos,
		            __Metric < 0 , __ColorNeg,
		            __ColorZero
		    )

		VAR __W          = 24
		VAR __H          = 24

		VAR __Shift      = 1000
		VAR __SortKeyNum = __Metric + __Shift
		VAR __SortKey    = FORMAT ( __SortKeyNum , "00000000.0000000000" )

		VAR __SvgPrefix  = "data:image/svg+xml;utf8,"

		VAR __SvgOpen =
		"<svg
		  xmlns=       'http://www.w3.org/2000/svg'
		  width=       '" & __W & "'
		  height=      '" & __H & "'
		  viewBox=     '0 0 " & __W & " " & __H & "'
		  sort=        '" & __SortKey & "'
		>"

		VAR __SvgCircle =
		"<circle
		  cx=          '12'
		  cy=          '12'
		  r=           '" & ROUND ( __Radius, 0 ) & "'
		  fill=        '" & __Fill & "'
		  stroke=      '" & __Fill & "'
		  stroke-width='1'
		/>"

		VAR __SvgArrowUp =
		"<line
		  x1=          '12'
		  y1=          '17'
		  x2=          '12'
		  y2=          '7'
		  stroke=      '" & __ColorArrow & "'
		  stroke-width='2.6'
		  stroke-linecap='butt'
		/>
		<polygon
		  points=      '12,4.5 7.5,9.5 16.5,9.5'
		  fill=        '" & __ColorArrow & "'
		/>"

		VAR __SvgArrowDown =
		"<line
		  x1=          '12'
		  y1=          '7'
		  x2=          '12'
		  y2=          '17'
		  stroke=      '" & __ColorArrow & "'
		  stroke-width='2.6'
		  stroke-linecap='butt'
		/>
		<polygon
		  points=      '7.5,14.5 16.5,14.5 12,19.5'
		  fill=        '" & __ColorArrow & "'
		/>"

		VAR __SvgMarker =
		    SWITCH (
		        TRUE(),
		            __IsCapPos, __SvgCircle & __SvgArrowUp,
		            __IsCapNeg, __SvgCircle & __SvgArrowDown,
		            __SvgCircle
		    )

		VAR __SvgClose   = "</svg>"

		VAR __Result =
		    IF (
		        __Show,
		        __SvgPrefix & __SvgOpen & __SvgMarker & __SvgClose
		    )

		RETURN __Result
		```
		displayFolder: Geo\03. Actions Dots & Flags\02. SVG
		dataCategory: ImageUrl
		lineageTag: 8a692e8e-3ae6-4f86-81b7-26972cd9923c

	measure '_Revenue | Relative Delta | SVG | Capped Dot Scale' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( 'DIM_Geo'[Country name - adjusted] )
		    
		VAR __Relative_Variance =
		    [_Revenue Variance rel. PY]

		VAR __BaseRaw =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Value", [_Revenue Variance rel. PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __CapPos =  1.0               //  e.g. 1 = 100%
		VAR __CapNeg = __CapPos * -1    //  e.g -1 = -100%

		VAR __IsCapPos = __Relative_Variance > __CapPos
		VAR __IsCapNeg = __Relative_Variance < __CapNeg

		VAR __Relative_VarianceClipped =
		    MIN (
		        MAX ( __Relative_Variance, __CapNeg ),
		        __CapPos
		    )

		VAR __Base =
		    ADDCOLUMNS (
		        __BaseRaw,
		        "@ValueClipped",
		            MIN (
		                MAX ( [@Value], __CapNeg ),
		                __CapPos
		            )
		    )

		VAR __BaseFiltered =
		    FILTER (
		        __Base,
		        NOT ISBLANK ( [@Value] )
		    )

		//______________________________________________________________________________________
		VAR __MinV   = MINX ( __BaseFiltered, [@ValueClipped] )
		VAR __MaxV   = MAXX ( __BaseFiltered, [@ValueClipped] )
		VAR __AbsMax = MAX ( MAX ( ABS ( __MinV ), ABS ( __MaxV ) ), 0.000001 )

		//______________________________________________________________________________________
		VAR __Rmin = 2
		VAR __Rmax = 10
		VAR __W    = 24
		VAR __H    = 24
		VAR __CX   = DIVIDE ( __W, 2 )
		VAR __CY   = DIVIDE ( __H, 2 )

		VAR __ColorPos   = SUBSTITUTE ( [_Positive Variance color], "#", "%23" )    //% to %23 to display as "Icon section"
		VAR __ColorNeg   = SUBSTITUTE ( [_Negative Variance color], "#", "%23" )    //% to %23 to display as "Icon section"
		VAR __ColorZero  = SUBSTITUTE ( "#D0D6DC", "#", "%23" )                     //% to %23 to display as "Icon section"
		VAR __ColorArrow = SUBSTITUTE ( "#FFFFFF", "#", "%23" )                     //% to %23 to display as "Icon section"

		//______________________________________________________________________________________
		VAR __RadiusRaw =
		    __Rmin
		        + DIVIDE ( ABS ( __Relative_VarianceClipped ), __AbsMax, 0 )
		            * ( __Rmax - __Rmin )

		VAR __Radius =
		    MIN (
		        __Rmax,
		        MAX ( __Rmin, __RadiusRaw )
		    )

		VAR __Fill =
		    SWITCH (
		        TRUE(),
		            __Relative_Variance > 0, __ColorPos,
		            __Relative_Variance < 0, __ColorNeg,
		            __ColorZero
		    )

		//______________________________________________________________________________________
		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( ( __Relative_Variance + __SortShift ) * 1000000, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000000" )

		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"<svg
		  xmlns=       'http://www.w3.org/2000/svg'
		  width=       '" & __W & "'
		  height=      '" & __H & "'
		  viewBox=     '0 0 " & __W & " " & __H & "'
		  sort=        '" & __SortKey & "'
		>"

		VAR __SVG_Circle =
		"<circle
		  cx=          '" & __CX & "'
		  cy=          '" & __CY & "'
		  r=           '" & ROUND ( __Radius, 0 ) & "'
		  fill=        '" & __Fill & "'
		  stroke=      '" & __Fill & "'
		  stroke-width='1'
		/>"

		VAR __SVG_ArrowUp =
		"<line
		  x1=               '" & __CX & "'
		  y1=               '18'
		  x2=               '" & __CX & "'
		  y2=               '8'
		  stroke=           '" & __ColorArrow & "'
		  stroke-width=     '2.6'
		  stroke-linecap=   'butt'
		/>
		<polygon
		  points=           '" & __CX & ",4.5 7.5,9.5 16.5,9.5'
		  fill=             '" & __ColorArrow & "'
		/>"

		VAR __SVG_ArrowDown =
		"<line
		  x1=               '" & __CX & "'
		  y1=               '6'
		  x2=               '" & __CX & "'
		  y2=               '16'
		  stroke=           '" & __ColorArrow & "'
		  stroke-width=     '2.6'
		  stroke-linecap=   'butt'
		/>
		<polygon
		  points=           '7.5,14.5 16.5,14.5 " & __CX & ",19.5'
		  fill=             '" & __ColorArrow & "'
		/>"

		VAR __SVG_Marker =
		    SWITCH (
		        TRUE(),
		            __IsCapPos, __SVG_Circle & __SVG_ArrowUp,
		            __IsCapNeg, __SVG_Circle & __SVG_ArrowDown,
		            __SVG_Circle
		    )

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),    // Can be either hidden or shown, but requires to add logic (code) to address the scalling for total level
		            ISBLANK ( __Relative_Variance ), BLANK(),
		            __SVG_Prefix & __SVG_Open & __SVG_Marker & __SVG_Close
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\05. Relative Variance
		dataCategory: ImageUrl
		lineageTag: 8cd3c6a5-8679-4ed3-8319-87dcc89e85ee

	measure '_Revenue | Nominal Delta | SVG | Integrated Data Bar' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Segment] )

		VAR __Actual      = [_Revenue]
		VAR __Comparison  = [_Revenue PY]
		VAR __VarianceAbs = __Actual - __Comparison

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Segment] ),
		            "@Actuals",    [_Revenue],
		            "@Comparison", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Segment] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actuals] ) || NOT ISBLANK ( [@Comparison] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw =
		    MAXX (
		        __BaseTable_Filtered,
		        COALESCE (
		            MAX ( [@Actuals], [@Comparison] ),
		            [@Actuals],
		            [@Comparison]
		        )
		    )

		VAR __MinRaw =
		    MIN (
		        MINX (
		            __BaseTable_Filtered,
		            COALESCE (
		                MIN ( [@Actuals], [@Comparison] ),
		                [@Actuals],
		                [@Comparison]
		            )
		        ),
		        0
		    )

		VAR __Span = MAX ( __MaxRaw - __MinRaw, 1 )

		//______________________________________________________________________________________
		VAR __W      = 180
		VAR __H      = 30
		VAR __BarX   = 18
		VAR __BarH   = 18

		//______________________________________________________________________________________
		VAR __TrackW = __W - __BarX - 10
		VAR __BarY              = DIVIDE ( __H - __BarH, 2 )
		VAR __AxisLineExtension = 4
		VAR __AxisY1            = MAX ( 0, __BarY - __AxisLineExtension )
		VAR __AxisY2            = MIN ( __H, __BarY + __BarH + __AxisLineExtension )

		VAR __X_Actual          = __BarX + DIVIDE ( __Actual - __MinRaw,     __Span, 0 ) * __TrackW
		VAR __X_Comparison      = __BarX + DIVIDE ( __Comparison - __MinRaw, __Span, 0 ) * __TrackW
		VAR __X_Zero            = __BarX + DIVIDE ( 0 - __MinRaw,            __Span, 0 ) * __TrackW

		VAR __ActualStart       = MIN ( __X_Zero, __X_Actual )
		VAR __ActualW           = ABS ( __X_Actual - __X_Zero )

		VAR __DiffStart         = MIN ( __X_Actual, __X_Comparison )
		VAR __DiffW             = ABS ( __X_Actual - __X_Comparison )
		VAR __DiffH             = __BarH * 0.6
		VAR __DiffY             = __BarY

		//______________________________________________________________________________________

		VAR __TriangleW         = 20
		VAR __TriangleH         = 15
		VAR __TriangleX         = __X_Comparison
		VAR __TriangleY         = __BarY + 4

		VAR __ColorBg            = "#F2F2F2"
		VAR __ColorBgBorder      = "#D9D9D9"
		VAR __ColorActual        = "#47627F"

		VAR __ColorVarPos        = [_Positive Variance color | Light]
		VAR __ColorVarNeg        = [_Negative Variance color]
		VAR __ColorDiff          = IF ( __VarianceAbs >= 0, __ColorVarPos, __ColorVarNeg )

		VAR __ColorMarkerFill    = "#83909F"
		VAR __ColorMarkerOutline = "#FFFFFF"

		//______________________________________________________________________________________
		VAR __SortMode   = 1   // 1 = sort by Actual, 2 = sort by Variance
		VAR __SortMetric =
		    SWITCH (
		        TRUE(),
		            __SortMode = 1, __Actual,
		            __SortMode = 2, __VarianceAbs,
		            __Actual
		    )

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __SortMetric + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & __SortKey & "'
		>
		"

		VAR __SVG_Track =
		"
		  <rect
		    x=              '"  & __BarX           & "'
		    y=              '"  & __BarY           & "'
		    width=          '"  & __TrackW         & "'
		    height=         '"  & __BarH           & "'
		    fill=           '"  & __ColorBg        & "'
		    stroke=         '"  & __ColorBgBorder  & "'
		    fill-opacity=   '0.0'
		    stroke-opacity= '0.0'
		    stroke-width=   '1'
		  />
		"

		VAR __SVG_Actual =
		    IF (
		        __ActualW > 0,
		"
		  <rect
		    x=              '"  & __ActualStart    & "'
		    y=              '"  & __BarY           & "'
		    width=          '"  & __ActualW        & "'
		    height=         '"  & __BarH           & "'
		    fill=           '"  & __ColorActual    & "'
		    fill-opacity=   '1'
		  />
		",
		        ""
		    )

		VAR __SVG_Variance =
		    IF (
		        __DiffW > 0,
		"
		  <rect
		    x=              '"  & __DiffStart      & "'
		    y=              '"  & __DiffY          & "'
		    width=          '"  & __DiffW          & "'
		    height=         '"  & __DiffH          & "'
		    fill=           '"  & __ColorDiff      & "'
		  />
		",
		        ""
		    )

		VAR __SVG_Baseline =
		"
		  <line
		    x1=             '"  & __X_Zero         & "'
		    y1=             '"  & __AxisY1         & "'
		    x2=             '"  & __X_Zero         & "'
		    y2=             '"  & __AxisY2         & "'
		    stroke=         '"  & __ColorActual    & "'
		    stroke-opacity= '0.5'
		    stroke-width=   '1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Triangle =
		"
		  <polygon
		    points='"
		        & ( __TriangleX - __TriangleW / 2 ) & "," & ( __TriangleY - __TriangleH ) & " "
		        & ( __TriangleX + __TriangleW / 2 ) & "," & ( __TriangleY - __TriangleH ) & " "
		        &   __TriangleX                     & "," &   __TriangleY
		    & "'
		    fill='"               & __ColorMarkerFill    & "'
		    stroke='"             & __ColorMarkerOutline & "'
		    stroke-width='1.5'
		    stroke-linejoin='round'
		  />
		"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Variance      // Deactivate this part to hide variances (optionally)
		    &   __SVG_Baseline
		    &   __SVG_Triangle      // Deactivate this part to hide comparative scenario (optionally)
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparison ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\04. Integrated Nominal Variance
		dataCategory: ImageUrl
		lineageTag: 47a8907f-158a-4321-ae0b-e3df9e43e2e9

	measure '_Revenue | Nominal Delta | SVG | Data Bar' = ```


		VAR __Is_At_Item_Level = ISINSCOPE ( 'DIM_Geo'[Country name - adjusted] )

		VAR __Variance_Value = 
		    [_Revenue Variance abs. PY]

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Variance_Value", [_Revenue Variance abs. PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )
		    
		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Variance_Value] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw   = MAXX ( __BaseTable_Filtered, [@Variance_Value] )
		VAR __MinRaw   = MINX ( __BaseTable_Filtered, [@Variance_Value] )

		VAR __ScaleMin = MIN ( __MinRaw, 0 )
		VAR __ScaleMax = MAX ( __MaxRaw, 0 )
		VAR __Span     = __ScaleMax - __ScaleMin

		//______________________________________________________________________________________
		VAR __W         = 200
		VAR __H         = 25
		VAR __BarX      = 15                 
		VAR __BarY      = 2.5                
		VAR __BarH      = 20                 
		VAR __TrackW    = __W - __BarX - 10   

		VAR __X_Zero    = __BarX + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW
		VAR __X_Act     = __BarX + DIVIDE ( __Variance_Value - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __BarStart  = MIN ( __X_Zero, __X_Act )
		VAR __BarW      = ABS ( __X_Act - __X_Zero )

		VAR __ColorBg        = "#F2F2F2"
		VAR __ColorBgBorder  = "#D9D9D9"
		VAR __ColorPos       = [_Positive Variance color]
		VAR __ColorNeg       = [_Negative Variance color]
		VAR __ColorActual    = IF ( __Variance_Value >= 0, __ColorPos, __ColorNeg )
		VAR __ColorBaseline  = "Black"

		//______________________________________________________________________________________
		// E) SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Variance_Value + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  sort='"   & __SortKey & "'
		>"

		VAR __SVG_Track =
		"  <rect
		    x=              '"  & __BarX        & "'
		    y=              '"  & __BarY        & "'
		    width=          '"  & __TrackW      & "'
		    height=         '"  & __BarH        & "'
		    fill=           '"  & __ColorBg       & "'
		    stroke=         '"  & __ColorBgBorder & "'
		    fill-opacity=   '0.0'
		    stroke-opacity= '0.0'
		    stroke-width=   '1'
		  />"

		VAR __SVG_Actual =
		    IF ( __BarW > 0,
		"  <rect
		    x=              '"  & __BarStart      & "'
		    y=              '"  & __BarY          & "'
		    width=          '"  & __BarW          & "'
		    height=         '"  & __BarH          & "'
		    fill=           '"  & __ColorActual   & "'
		    fill-opacity=   '1'
		  />",
		"" )

		VAR __SVG_Baseline =
		"  <line
		    x1=             '" & __X_Zero               & "'
		    y1=             '" & ( __BarY - 4 )         & "'
		    x2=             '" & __X_Zero               & "'
		    y2=             '" & ( __BarY + __BarH + 4) & "'
		    stroke=         '" & __ColorBaseline        & "'
		    stroke-opacity= '0.6'
		    stroke-width=   '1.5'
		  />"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		      __SVG_Prefix
		    & __SVG_Open
		    & __SVG_Track
		    & __SVG_Actual
		    & __SVG_Baseline
		    & __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        NOT __Is_At_Item_Level,         BLANK(),  
		        ISBLANK ( __Variance_Value ),   BLANK(),   
		        __ResultSVG
		    )

		RETURN __Result
		```
