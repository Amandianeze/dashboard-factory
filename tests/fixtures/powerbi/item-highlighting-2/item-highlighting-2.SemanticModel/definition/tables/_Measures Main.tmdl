		            )
		        
		// Find minimum differences
		VAR __MinDiffA = MINX ( __WithCumulative, ABS([@CumPercent] - __CumThresholdA))
		VAR __MinDiffB = MINX ( __WithCumulative, ABS([@CumPercent] - __CumThresholdB))

		// Find actual thresholds
		VAR __ThresholdA = 
		    MINX (
		        __WithCumulative,
		            IF(
		                ABS ([@CumPercent] - __CumThresholdA) = __MinDiffA,
		                [@CumPercent]
		            )
		        )

		VAR __ThresholdB = 
		    MINX (
		        __WithCumulative,
		            IF(
		                ABS ([@CumPercent] - __CumThresholdB) = __MinDiffB,
		                [@CumPercent]
		            )
