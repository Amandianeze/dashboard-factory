	measure '_Gross Margin % Perc Max x multiplier per item' = ```


		VAR __MAX_Per_Item =
		    MAXX (
		        ALLSELECTED ( DIM_Customers[Customer_Name]),
		        [_Gross Margin % Perc]
		    )

		VAR __Multiplier = 1.15

		VAR __Result = __MAX_Per_Item * __Multiplier

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\04. Quadrant\01. Components (avg/medians per item)\02. Margin %
		lineageTag: e5fa38cb-9ecb-4c07-90eb-4122e89ba0d9

	measure '_Gross Margin % Perc Median per item' = ```


		VAR __Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_Name] ),
		        "@GM%", [_Gross Margin % Perc]
		    )

		VAR __Median = MEDIANX ( __Table, [@GM%] ) 

		RETURN __Median 

