	measure '_Revenue Dynamic Rank Number Alt.' = ```

		VAR __IsOtherRow        =      SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] ) = "Others"
		VAR __CurrentCustomer   =      SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __TOPn_Bin          =      [NR Values 1-20 | Ranking 01 | Value]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		//***RANKING***//
		VAR __BaseTable_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",  
		                RANK (
		                    DENSE, 
		                    __BaseTable,
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		                )
		    )

		VAR __Ranking =
		     MAXX ( FILTER ( __BaseTable_With_Ranking, DIM_Customers_Supplemental[Customer] = __CurrentCustomer ),  [@Rank] ) 
		    
		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    FILTER ( __BaseTable_With_Ranking, [@Rank] <= __TOPn_Bin )

		/***COUTNS & CONDITIONS & CHECKS***/
		VAR __Count_of_Topn_Customers   = COUNTROWS ( __TopN_Customers )
		VAR __Count_of_Other_Customers  = COUNTROWS ( EXCEPT ( __BaseTable_With_Ranking , __TopN_Customers ) )

		VAR __CustomerInTopN            = CONTAINS ( __TopN_Customers,  DIM_Customers_Supplemental[Customer], __CurrentCustomer )
		VAR __Has_Others                = __Count_of_Other_Customers > 0

		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __IsOtherRow && __Has_Others, __Count_of_Topn_Customers + 1,
		            __CustomerInTopN, __Ranking, 
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\01. Core
		lineageTag: c7e4cd78-f0a3-4fbf-ab81-02c233b4f3e9

	measure '_Revenue Dynamic Rank Value Perc of Total Format Alt.' = ```


		/***INPUTS***/
		VAR __TopBin           = [NR Values 1-20 | Ranking 01 | Value]
		VAR __CurrentCustomer  = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __AtCustomerLevel  = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    TOPN (
		        __TopBin ,
		        __BaseTable ,
		        [@Revenue] ,
		        DESC,
		        DIM_Customers_Supplemental[Customer_Sort_ID], ASC
		    )

		/***REVENUE CALCULATION***/
		VAR __AllRevenue_Total      = SUMX ( __BaseTable , [@Revenue] )
		VAR __TopNRevenue_Total     = SUMX ( __TopN_Customers , [@Revenue] )
		VAR __TopNRevenue_Customer  = SUMX ( FILTER ( __TopN_Customers , DIM_Customers_Supplemental[Customer] = __CurrentCustomer ), [@Revenue] )

		VAR __OthersRevenue         = __AllRevenue_Total - __TopNRevenue_Total
		VAR __TopN_Perc_of_Total    =  DIVIDE ( __TopNRevenue_Customer, __AllRevenue_Total )
		VAR __Others_Perc_of_Total  =  DIVIDE ( __OthersRevenue, __AllRevenue_Total )

		/***CONDITIONS & CHECKS***/
		VAR __IsOtherRow        = __CurrentCustomer = "Others"

		VAR __CustomerInTopN    = CONTAINS ( __TopN_Customers, DIM_Customers_Supplemental[Customer],   __CurrentCustomer )

		/***RESULT***/
		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            __IsOtherRow   ,    FORMAT ( __Others_Perc_of_Total, "0.0%;-0.0%;0%" ),
		            __CustomerInTopN,   FORMAT (__TopN_Perc_of_Total , "0.0%;-0.0%;0%" ),
		            BLANK ()
		    )

		RETURN __Result

		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\01. Core
		lineageTag: cc44e68e-ce48-4237-bcce-bd9440800e2b

