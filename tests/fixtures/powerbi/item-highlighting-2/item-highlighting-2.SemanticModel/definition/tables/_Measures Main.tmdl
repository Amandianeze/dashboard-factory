		VAR __TotalOther  = COALESCE ( SUMX ( __Others,     [@Actual] ), 0 )
		VAR __Total       =
		    SUMX (
		        FILTER ( __SegmentedTable, [@Segment] IN __SelectedCategories ),
		        [@Actual]
		    )

		//RESULT ───────────────────────────────────────────────────────────────────
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Level_Customer && NOT __Is_At_Level_Segment,
		                __Total,

		            NOT __Is_At_Level_Customer,
