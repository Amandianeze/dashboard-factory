		//         ),
		//         NOT ISBLANK ( [@Rev_Global] )
		//     )

		// VAR __TopN_Customers_Global =
		//     TOPN (
		//         __TopBin,
		//         __BaseTable_Global,
		//         [@Rev_Global], DESC,
		//         DIM_Customers_Supplemental[Customer_Sort_ID], ASC
		//     )

		// VAR __TopCustomerList =
		//     SELECTCOLUMNS (
		//         __TopN_Customers_Global,
		//         "Customer", DIM_Customers_Supplemental[Customer]
		//     )

		// VAR __AllRevenue_Total =
		//     CALCULATE (
		//         [_Revenue],
		//         ALLSELECTED ( DIM_Customers_Supplemental[Customer] )
		//     )

		// VAR __TopNRevenue_Total =
		//     CALCULATE (
		//         [_Revenue],
		//         KEEPFILTERS ( TREATAS ( __TopCustomerList, DIM_Customers_Supplemental[Customer] ) )
		//     )

		// VAR __TopNRevenue_Customer =
		//     CALCULATE (
		//         [_Revenue],
		//         KEEPFILTERS ( TREATAS ( __TopCustomerList, DIM_Customers_Supplemental[Customer] ) )
		//     )

		// VAR __OthersRevenue =
		//     __AllRevenue_Total - __TopNRevenue_Total

		// VAR __HasOthers =
