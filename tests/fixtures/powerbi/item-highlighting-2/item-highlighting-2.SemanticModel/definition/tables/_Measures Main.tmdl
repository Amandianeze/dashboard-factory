	measure '_Revenue Progress Bar vs PY % of Tot | BL | SVG' = ```


		// A) DATA PER ROW
		VAR __Act    = [_Revenue]
		VAR __Tgt    = [_Revenue PY]
		VAR __Pct    = DIVIDE ( __Act , __Tgt )        -- realization %
		VAR __IsPos  = __Pct >= 1                      -- ≥ 100 % ?

		// B) CONTEXT SCALE  –– % versus target
		VAR __PctRow =                         --  current row realization
		    DIVIDE ( __Act , __Tgt , BLANK() )

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            FILTER (
		                VALUES ( DIM_Customers[Business_Line] ),
		                NOT ISBLANK ( [_Revenue] ) || NOT ISBLANK ( [_Revenue PY] )
		            ),
		            "@Pct",  DIVIDE ( [_Revenue] , [_Revenue PY] )
		        ),
		        ALLSELECTED ( DIM_Customers )
		    )

		VAR __MaxPctRaw =                      --  highest realization in filter context
		    MAXX ( __BaseTable , [@Pct] )

		/*  final right‑hand scale:
		    • if any row exceeds target ( > 1 ), leave a 20 % head‑room above that value  
		    • otherwise fix the scale at 120 % of target ( 1.2 )                    */
		VAR __MaxScale =
		    IF ( __MaxPctRaw > 1 , __MaxPctRaw * 1.2 , 1.2 )

		//  C) LAYOUT & CO‑ORDINATES
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __PctRow , __MaxScale , 0 ) * __TrackW
		VAR __X_Tgt    = __BarX + DIVIDE ( 1        , __MaxScale , 0 ) * __TrackW   -- always 100 %
		VAR __MainW    = MAX ( __X_Act - __BarX , 0 )

		// D) COLORS
		VAR __ColorBg        = "#F2F2F2"   -- track background
		VAR __ColorBgBorder  = "#D9D9D9"   -- track border
		VAR __ColorPos       = "#63D17F"   -- ≥ 100 % -- "#2461C4"
		VAR __ColorNeg       = "#DD3939"   -- < 100 % -- "#B34E4E"
		VAR __ColorActual    = IF ( __IsPos , __ColorPos , __ColorNeg )
		  
		//   E) INDIVIDUAL SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"
		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Pct , "0.00000" ) & "'
		>
		"

		VAR __SVG_Track =
		"
		  <rect
		    x='"                & __BarX        & "'
		    y='"                & __BarY        & "'
		    width='"            & __TrackW      & "'
		    height='"           & __BarH        & "'
		    fill='"             & __ColorBg       & "'
		    stroke='"           & __ColorBgBorder & "'
		    fill-opacity=       '"   & 0.5 & "'
		    stroke-opacity=     '"   & 0.7 & "'       
		    stroke-width=       '1'
		    rx='5' 
		    ry='5'
		  />
		"

		VAR __SVG_Actual =
		"
		  <rect
		    x='"             & __BarX       & "'
		    y='"             & __BarY       & "'
		    width='"         & __MainW      & "'
		    height='"        & __BarH       & "'
		    fill='"          & __ColorActual  & "'
		    rx='5' 
		    ry='5'
		  />
		"

		VAR __SVG_Target =
		"
		  <line
		    x1='"            & __X_Tgt                 & "'
		    y1='"            & ( __BarY - 4 )          & "'
		    x2='"            & __X_Tgt                 & "'
		    y2='"            & ( __BarY + __BarH + 4 ) & "'
		    stroke='#4C4C4C'
		    stroke-width='1.5'
		  />
		"

		VAR __SVG_Close = "</svg>"

		//  F) CONCATENATION
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &  __SVG_Track
		    &  __SVG_Actual
		    &  __SVG_Target
		    &  __SVG_Close

		// G) RESULT
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ) , BLANK(),
		        __ResultSVG
		    )

		RETURN __Result


		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\02. Context: Business Line
		lineageTag: 5dabc92a-6a26-4c22-9797-8e46140ecff8

	measure '_Revenue Progress Bar vs PY % of Tot | General | SVG' = ```

		// Data Bars intentionally not synchronized across busisiness lines! (individual scales)

		// A) DATA PER ROW
		VAR __Act    = [_Revenue]
		VAR __Tgt    = [_Revenue PY]
		VAR __Pct    = DIVIDE ( __Act , __Tgt )        -- realization %
		VAR __IsPos  = __Pct >= 1                      -- ≥ 100 % ?

		// B) CONTEXT SCALE  –– % versus target
		VAR __PctRow =                         --  current row realization
		    DIVIDE ( __Act , __Tgt , BLANK() )

		/*Total Level*/
		VAR __MaxPctRaw = __PctRow
		    
		/*  final right‑hand scale:
		    • if any row exceeds target ( > 1 ), leave a 20 % head‑room above that value  
		    • otherwise fix the scale at 120 % of target ( 1.2 )                    */
		VAR __MaxScale =
		    IF ( __MaxPctRaw > 1 , __MaxPctRaw * 1.2 , 1.2 )

		//  C) LAYOUT & CO‑ORDINATES
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __PctRow , __MaxScale , 0 ) * __TrackW
		VAR __X_Tgt    = __BarX + DIVIDE ( 1        , __MaxScale , 0 ) * __TrackW   -- always 100 %
		VAR __MainW    = MAX ( __X_Act - __BarX , 0 )

		// D) COLORS
		VAR __ColorBg        = "#F2F2F2"   -- track background
		VAR __ColorBgBorder  = "#D9D9D9"   -- track border
		VAR __ColorPos       = "#63D17F"   -- ≥ 100 % -- "#2461C4"
		VAR __ColorNeg       = "#DD3939"   -- < 100 % -- "#B34E4E"
		VAR __ColorActual    = IF ( __IsPos , __ColorPos , __ColorNeg )
		  
		//   E) INDIVIDUAL SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"
		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Pct , "0.00000" ) & "'
		>
		"

		VAR __SVG_Track =
		"
		  <rect
		    x='"                & __BarX        & "'
		    y='"                & __BarY        & "'
		    width='"            & __TrackW      & "'
		    height='"           & __BarH        & "'
		    fill='"             & __ColorBg       & "'
		    stroke='"           & __ColorBgBorder & "'
		    fill-opacity=       '"   & 0.5 & "'
		    stroke-opacity=     '"   & 0.7 & "'       
		    stroke-width=       '1'
		    rx='5' 
		    ry='5'
		  />
		"

		VAR __SVG_Actual =
		"
		  <rect
		    x='"             & __BarX       & "'
		    y='"             & __BarY       & "'
		    width='"         & __MainW      & "'
		    height='"        & __BarH       & "'
		    fill='"          & __ColorActual  & "'
		    rx='5' 
		    ry='5'
		  />
		"

		VAR __SVG_Target =
		"
		  <line
		    x1='"            & __X_Tgt                 & "'
		    y1='"            & ( __BarY - 4 )          & "'
		    x2='"            & __X_Tgt                 & "'
		    y2='"            & ( __BarY + __BarH + 4 ) & "'
		    stroke='#4C4C4C'
		    stroke-width='1.5'
		  />
		"

		VAR __SVG_Close = "</svg>"

		//  F) CONCATENATION
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &  __SVG_Track
		    &  __SVG_Actual
		    &  __SVG_Target
		    &  __SVG_Close

		// G) RESULT
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ) , BLANK(),
		        __ResultSVG
		    )

		RETURN __Result


