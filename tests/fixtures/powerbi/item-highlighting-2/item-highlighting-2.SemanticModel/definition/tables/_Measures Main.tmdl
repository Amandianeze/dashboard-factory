	measure '_Revenue AC & PY | SVG | Synced | Clustered Non-overlaped' = ```

		// !! This Formula Sync Actual and Comparative and Delta !!

		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Country] )|| ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		VAR __Actual        = [_Revenue]
		VAR __Comparative   = [_Revenue PY]

		VAR __BaseRaw       =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Actual",       [_Revenue],
		            "@Comparative",  [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        __BaseRaw,
		        "@Delta", [@Actual] - [@Comparative],
		        "@MaxBase",
		            MAX (
		                COALESCE ( [@Actual], 0 ),
		                COALESCE ( [@Comparative], 0 )
		            ),
		        "@MinBase",
		            MIN (
		                COALESCE ( [@Actual], 0 ),
		                COALESCE ( [@Comparative], 0 )
		            )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparative] )
		    )

		//______________________________________________________________________________________
		VAR __MaxBaseRaw    = MAXX ( __BaseTable_Filtered, [@MaxBase] )
		VAR __MinBaseRaw    = MINX ( __BaseTable_Filtered, [@MinBase] )
		VAR __ScaleMinBase  = MIN ( __MinBaseRaw, 0 )
		VAR __ScaleMaxBase  = MAX ( __MaxBaseRaw, 0 )
		VAR __BaseSpan      = MAX ( __ScaleMaxBase - __ScaleMinBase, 0 )

		VAR __MaxDeltaPos   = MAX ( 0, MAXX ( __BaseTable_Filtered, [@Delta] ) )
		VAR __MinDeltaNeg   = MIN ( 0, MINX ( __BaseTable_Filtered, [@Delta] ) )
		VAR __DeltaSpan     = __MaxDeltaPos + ABS ( __MinDeltaNeg )

		VAR __SyncSpan      = MAX ( MAX ( __BaseSpan, __DeltaSpan ), 1 )

		VAR __ScaleMin =
		    IF (
		        __ScaleMaxBase <= 0,
		        __ScaleMaxBase - __SyncSpan,
		        __ScaleMinBase
		    )

		VAR __ScaleMax  = __ScaleMin + __SyncSpan
		VAR __Span      = __SyncSpan

		//______________________________________________________________________________________
		VAR __W         = 200
		VAR __H         = 25
		VAR __BarX      = 15
		VAR __TrackW    = __W - __BarX - 10

		VAR __BarH      = 9
		VAR __Gap       = 2
		VAR __AC_Y      = 2.5
		VAR __Comparative_Y   = __AC_Y + __BarH + __Gap

		VAR __AxisY1    = MIN ( __AC_Y, __Comparative_Y ) - 1.5
		VAR __AxisY2    = MAX ( __AC_Y, __Comparative_Y ) + __BarH + 1.5

		VAR __X_Zero    =
		    __BarX
		        + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Act =
		    __BarX
		        + DIVIDE ( __Actual - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_PY =
		    __BarX
		        + DIVIDE ( __Comparative - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __ActualStart       = MIN ( __X_Zero, __X_Act )
		VAR __ComparativeStart  = MIN ( __X_Zero, __X_PY )
		VAR __ActualW           = ABS ( __X_Act - __X_Zero )
		VAR __ComparativeW      = ABS ( __X_PY - __X_Zero )

		VAR __ColorPY           = "#D9E1E8"
		VAR __ColorPYBorder     = "#B2BBCB"
		VAR __ColorAC           = "#47627F"
		VAR __ColorAxis         = "#47627F"

		//______________________________________________________________________________________
		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Actual + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width=    '" & __W & "'
		  height=   '" & __H & "'
		  sort=     '" & __SortKey & "'
		>"

		VAR __SVG_PY_Rect =
		    IF (
		        __ComparativeW > 0,
		"  <rect
		    x=              '"  & __ComparativeStart    & "'
		    y=              '"  & __Comparative_Y       & "'
		    width=          '"  & __ComparativeW        & "'
		    height=         '"  & __BarH                & "'
		    fill=           '"  & __ColorPY             & "'
		    stroke=         '"  & __ColorPYBorder       & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_AC_Rect =
		    IF (
		        __ActualW > 0,
		"  <rect
		    x=              '"  & __ActualStart & "'
		    y=              '"  & __AC_Y     & "'
		    width=          '"  & __ActualW     & "'
		    height=         '"  & __BarH     & "'
		    fill=           '"  & __ColorAC  & "'
		    stroke=         '"  & __ColorAC  & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_YAxis =
		"  <line
		    x1=             '"  & __X_Zero    & "'
		    y1=             '"  & __AxisY1    & "'
		    x2=             '"  & __X_Zero    & "'
		    y2=             '"  & __AxisY2    & "'
		    stroke=         '"  & __ColorAxis & "'
		    stroke-width=   '1.5'
		  />"

		//______________________________________________________________________________________
		VAR __SVG_Close = "</svg>"

		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_PY_Rect
		    &   __SVG_AC_Rect
		    &   __SVG_YAxis
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparative ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\02. Actuals and Comparative Metric
		dataCategory: ImageUrl
		lineageTag: 85d353a7-3599-48b0-b7c7-dcdd02195494

	measure '_Revenue | Nominal Delta | SVG | Synced | Data Bar' = ```

		// !! This Formula Sync Actual and Comparative and Delta !!

		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		VAR __Actual        = [_Revenue]
		VAR __Comparison    = [_Revenue PY]
		VAR __Delta         = __Actual - __Comparison

		VAR __BaseRaw =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Actual",      [_Revenue],
		            "@Comparison",  [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        __BaseRaw,
		        "@Delta", [@Actual] - [@Comparison],
		        "@MaxBase",
		            MAX (
		                COALESCE ( [@Actual], 0 ),
		                COALESCE ( [@Comparison], 0 )
		            ),
		        "@MinBase",
		            MIN (
		                COALESCE ( [@Actual], 0 ),
		                COALESCE ( [@Comparison], 0 )
		            )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparison] )
		    )

		//______________________________________________________________________________________
		VAR __MaxBaseRaw    = MAXX ( __BaseTable_Filtered, [@MaxBase] )
		VAR __MinBaseRaw    = MINX ( __BaseTable_Filtered, [@MinBase] )
		VAR __ScaleMinBase  = MIN ( __MinBaseRaw, 0 )
		VAR __ScaleMaxBase  = MAX ( __MaxBaseRaw, 0 )
		VAR __BaseSpan      = MAX ( __ScaleMaxBase - __ScaleMinBase, 0 )

		VAR __MaxDeltaPos   = MAX ( 0, MAXX ( __BaseTable_Filtered, [@Delta] ) )
		VAR __MinDeltaNeg   = MIN ( 0, MINX ( __BaseTable_Filtered, [@Delta] ) )
		VAR __DeltaNegAbs   = ABS ( __MinDeltaNeg )
		VAR __DeltaSpan     = __MaxDeltaPos + __DeltaNegAbs

		VAR __SyncSpan      = MAX ( MAX ( __BaseSpan, __DeltaSpan ), 1 )

		//______________________________________________________________________________________
		VAR __W             = 200
		VAR __H             = 25
		VAR __BarX          = 15
		VAR __BarY          = 2.5
		VAR __BarH          = 20
		VAR __TrackW        = __W - __BarX - 10

		//______________________________________________________________________________________
		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( __DeltaNegAbs, __SyncSpan, 0 ) * __TrackW

		VAR __X_Delta =
		    __X_Zero
		        + DIVIDE ( __Delta, __SyncSpan, 0 ) * __TrackW

		VAR __BarStart      = MIN ( __X_Zero, __X_Delta )
		VAR __BarW          = ABS ( __X_Delta - __X_Zero )

		VAR __ColorPos      = [_Positive Variance color]
		VAR __ColorNeg      = [_Negative Variance color]
		VAR __ColorActual   = IF ( __Delta >= 0, __ColorPos, __ColorNeg )
		VAR __ColorBaseline = "Black"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Delta + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width=    '" & __W        & "'
		  height=   '" & __H        & "'
		  sort=     '" & __SortKey  & "'
		>"

		VAR __SVG_Actual =
		    IF (
		        __BarW > 0,
		"  <rect
		    x=              '"  & __BarStart    & "'
		    y=              '"  & __BarY        & "'
		    width=          '"  & __BarW        & "'
		    height=         '"  & __BarH        & "'
		    fill=           '"  & __ColorActual & "'
		    fill-opacity=   '1'
		  />",
		        ""
		    )

		VAR __SVG_Baseline =
		"  <line
		    x1=             '"  & __X_Zero                & "'
		    y1=             '"  & ( __BarY - 4 )          & "'
		    x2=             '"  & __X_Zero                & "'
		    y2=             '"  & ( __BarY + __BarH + 4 ) & "'
		    stroke=         '"  & __ColorBaseline         & "'
		    stroke-opacity= '0.6'
		    stroke-width=   '1.5'
		  />"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Actual
		    &   __SVG_Baseline
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),          
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparison ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\03. Nominal Variance
		dataCategory: ImageUrl
		lineageTag: 8ae44bb1-cb28-42d6-8933-d506b49a4727

	measure '_Revenue | % of Realization | SVG | Progress Bar | 3-step' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Segment] )

		VAR __Actual                = [_Revenue]
		VAR __Comparison            = [_Revenue PY]
		VAR __VarianceAbs           = __Actual - __Comparison
		VAR __Perc_Realization      = DIVIDE ( __Actual, __Comparison, BLANK() )

		VAR __TargetValue           = 1        // 100%
		VAR __NearTargetThreshold   = 0.9      // 90% 
		// VAR __NearTargetThreshold   = __TargetValue * __NearTargetFactor

		VAR __BaseRaw =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Segment] ),
		            "@Actual",     [_Revenue],
		            "@Comparison", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Segment] )
		    )

		VAR __BaseRaw_Filtered =
		    FILTER (
		        __BaseRaw,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparison] )
		    )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        __BaseRaw_Filtered,
		        "@Perc_Realization", DIVIDE ( [@Actual], [@Comparison], BLANK() )
		    )

		//______________________________________________________________________________________
		VAR __MaxPerc_Realization_Raw = MAXX ( __BaseTable, [@Perc_Realization] )

		VAR __ScaleReference =
		    MAX ( __MaxPerc_Realization_Raw, __TargetValue )

		VAR __MaxScale =
		    __ScaleReference * 1.1

		//______________________________________________________________________________________
		VAR __W      = 180
		VAR __H      = 30
		VAR __BarX   = 18
		VAR __BarH   = 18
		VAR __TrackW = __W - __BarX - 10

		VAR __BarY                = DIVIDE ( __H - __BarH, 2 )
		VAR __TargetLineExtension = 4
		VAR __TargetY1            = __BarY - __TargetLineExtension
		VAR __TargetY2            = __BarY + __BarH + __TargetLineExtension

		VAR __X_Actual =
		    __BarX
		        + DIVIDE ( __Perc_Realization, __MaxScale, 0 ) * __TrackW

		VAR __X_Target =
		    __BarX
		        + DIVIDE ( __TargetValue, __MaxScale, 0 ) * __TrackW

		VAR __ActualW = MAX ( __X_Actual - __BarX, 0 )

		VAR __ColorBg           = "#F2F2F2"
		VAR __ColorBgBorder     = "#D9D9D9"
		VAR __ColorBelowTarget  = [_Negative Variance color]
		VAR __ColorNearTarget   = "#CDAF85"//"#D8A03D"
		VAR __ColorOnTarget     = [_Positive Variance color]
		VAR __ColorTarget       = "#4C4C4C"

		VAR __ColorActual =
		    SWITCH (
		        TRUE(),
		            __Perc_Realization >= __TargetValue,         __ColorOnTarget,
		            __Perc_Realization >= __NearTargetThreshold, __ColorNearTarget,
		            __ColorBelowTarget
		    )

		//______________________________________________________________________________________
		VAR __SortMode = 2   // 1 = sort by Actual, 2 = sort by % Realization, 3 = sort by Variance

		VAR __SortMetric =
		    SWITCH (
		        TRUE(),
		            __SortMode = 1, __Actual,
		            __SortMode = 2, __Perc_Realization,
		            __SortMode = 3, __VarianceAbs,
		            __Perc_Realization
		    )

		VAR __SortKeyNum =
		    SWITCH (
		        TRUE(),
		            __SortMode = 2, ROUND ( ( __SortMetric + 1000 ) * 1000000, 0 ),
		            ROUND ( __SortMetric + 1000000000000, 0 )
		    )

		VAR __SortKey = FORMAT ( __SortKeyNum, "000000000000000000" )

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & __SortKey & "'
		>
		"

		VAR __SVG_Track =
		"
		  <rect
		    x=              '"  & __BarX          & "'
		    y=              '"  & __BarY          & "'
		    width=          '"  & __TrackW        & "'
		    height=         '"  & __BarH          & "'
		    fill=           '"  & __ColorBg       & "'
		    stroke=         '"  & __ColorBgBorder & "'
		    fill-opacity=   '0.5'
		    stroke-opacity= '0.7'
		    stroke-width=   '1'
		    rx=             '3'
		    ry=             '3'
		  />
		"

		VAR __SVG_Actual =
		    IF (
		        __ActualW > 0,
		"
		  <rect
		    x=              '"  & __BarX          & "'
		    y=              '"  & __BarY          & "'
		    width=          '"  & __ActualW       & "'
		    height=         '"  & __BarH          & "'
		    fill=           '"  & __ColorActual   & "'
		    rx=             '3'
		    ry=             '3'
		  />
		",
		        ""
		    )

		VAR __SVG_Target =
		"
		  <line
		    x1=             '"  & __X_Target      & "'
		    y1=             '"  & __TargetY1      & "'
		    x2=             '"  & __X_Target      & "'
		    y2=             '"  & __TargetY2      & "'
		    stroke=         '"  & __ColorTarget   & "'
		    stroke-width=   '1.5'
		  />
		"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Target
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            // NOT __Is_At_Item_Level, BLANK(),   // Hide/Show bar on Total Level
		            ISBLANK ( __Perc_Realization ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\06. % of Realization
		dataCategory: ImageUrl
		lineageTag: 7fdf9c90-f6a8-4973-b27f-a9ed932b39cf

	measure '_Revenue AC & PY | SVG | Clustered overlaped | Total Scaled' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		VAR __Actual        = [_Revenue]
		VAR __Comparison    = [_Revenue PY]

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Actual",      [_Revenue],
		            "@Comparison",  [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparison] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw =
		    MAXX (
		        __BaseTable_Filtered,
		        MAX (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __MinRaw =
		    MINX (
		        __BaseTable_Filtered,
		        MIN (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __ScaleMin_Rows = MIN ( __MinRaw, 0 )
		VAR __ScaleMax_Rows = MAX ( __MaxRaw, 0 )
		VAR __Span_Rows     = MAX ( __ScaleMax_Rows - __ScaleMin_Rows, 1 )

		VAR __TotalMaxRaw =
		    MAX (
		        COALESCE ( __Actual, 0 ),
		        COALESCE ( __Comparison, 0 )
		    )

		VAR __TotalMinRaw =
		    MIN (
		        COALESCE ( __Actual, 0 ),
		        COALESCE ( __Comparison, 0 )
		    )

		VAR __ScaleMin_Total = MIN ( __TotalMinRaw, 0 )
		VAR __ScaleMax_Total = MAX ( __TotalMaxRaw, 0 )
		VAR __Span_Total     = MAX ( __ScaleMax_Total - __ScaleMin_Total, 1 )

		VAR __ScaleMin =
		    IF (
		        __Is_At_Item_Level,
		        __ScaleMin_Rows,
		        __ScaleMin_Total
		    )

		VAR __Span =
		    IF (
		        __Is_At_Item_Level,
		        __Span_Rows,
		        __Span_Total
		    )

		//______________________________________________________________________________________
		VAR __W      = 200
		VAR __H      = 25
		VAR __BarX   = 15
		VAR __TrackW = __W - __BarX - 10

		VAR __BarH          = 12
		VAR __Actual_Y      = 3
		VAR __Comparison_Y  = 9

		VAR __AxisY1 = MIN ( __Actual_Y, __Comparison_Y ) - 1.5
		VAR __AxisY2 = MAX ( __Actual_Y, __Comparison_Y ) + __BarH + 1.5

		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Actual =
		    __BarX
		        + DIVIDE ( __Actual - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Comparison =
		    __BarX
		        + DIVIDE ( __Comparison - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __ActualStart       = MIN ( __X_Zero, __X_Actual )
		VAR __ComparisonStart   = MIN ( __X_Zero, __X_Comparison )
		VAR __ActualW           = ABS ( __X_Actual - __X_Zero )
		VAR __ComparisonW       = ABS ( __X_Comparison - __X_Zero )

		VAR __ColorPY           = "#D9E1E8"
		VAR __ColorPYBorder     = "#B2BBCB"
		VAR __ColorAC           = "#47627F"
		VAR __ColorAxis         = "#47627F"

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Actual + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  sort='"   & __SortKey & "'
		>"

		VAR __SVG_PY_Rect =
		    IF (
		        __ComparisonW > 0,
		"  <rect
		    x=              '"  & __ComparisonStart & "'
		    y=              '"  & __Comparison_Y    & "'
		    width=          '"  & __ComparisonW     & "'
		    height=         '"  & __BarH            & "'
		    fill=           '"  & __ColorPY         & "'
		    stroke=         '"  & __ColorPYBorder   & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_AC_Rect =
		    IF (
		        __ActualW > 0,
		"  <rect
		    x=              '"  & __ActualStart & "'
		    y=              '"  & __Actual_Y    & "'
		    width=          '"  & __ActualW     & "'
		    height=         '"  & __BarH        & "'
		    fill=           '"  & __ColorAC     & "'
		    stroke=         '"  & __ColorAC     & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_YAxis =
		"  <line
		    x1=             '"  & __X_Zero    & "'
		    y1=             '"  & __AxisY1    & "'
		    x2=             '"  & __X_Zero    & "'
		    y2=             '"  & __AxisY2    & "'
		    stroke=         '"  & __ColorAxis & "'
		    stroke-width=   '1.5'
		  />"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_PY_Rect
		    &   __SVG_AC_Rect
		    &   __SVG_YAxis
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparison ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\02. Actuals and Comparative Metric
		dataCategory: ImageUrl
		lineageTag: 8e1c96f5-39e3-456d-8771-bd454370c34b

	measure '_Revenue AC | SVG | Data Bar | Avg Line' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		VAR __Main_Value =
		    [_Revenue]

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Value", [_Revenue]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Value] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw   = MAXX ( __BaseTable_Filtered, [@Value] )
		VAR __MinRaw   = MINX ( __BaseTable_Filtered, [@Value] )
		VAR __AvgValue = AVERAGEX ( __BaseTable_Filtered, [@Value] )

		VAR __ScaleMin = MIN ( __MinRaw, 0 )
		VAR __ScaleMax = MAX ( __MaxRaw, 0 )
		VAR __Span     = MAX ( __ScaleMax - __ScaleMin, 1 )

		//______________________________________________________________________________________
		VAR __W                  = 200
		VAR __H                  = 25
		VAR __BarX               = 15
		VAR __BarH_Ratio         = 0.8
		//______________________________________________________________________________________
		VAR __BarH               = __H * __BarH_Ratio
		VAR __BarY               = DIVIDE ( __H - __BarH, 2 )
		VAR __TrackW             = __W - __BarX - 10

		VAR __AxisLineExtension  = 4
		VAR __AxisY1             = MAX ( 0, __BarY - __AxisLineExtension )
		VAR __AxisY2             = MIN ( __H, __BarY + __BarH + __AxisLineExtension )

		VAR __AvgLineY1          = 0
		VAR __AvgLineY2          = __H

		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Act =
		    __BarX
		        + DIVIDE ( __Main_Value - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Avg =
		    __BarX
		        + DIVIDE ( __AvgValue - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __BarStart = MIN ( __X_Zero, __X_Act )
		VAR __BarW     = ABS ( __X_Act - __X_Zero )

		//______________________________________________________________________________________
		VAR __ColorPos      = "#47627F"
		VAR __ColorNeg      = "#B94D4D"
		VAR __ColorActual   = IF ( __Main_Value >= 0, __ColorPos, __ColorNeg )
		VAR __ColorBaseline = "#47627F"
		VAR __ColorAvgLine  = "#1F2B39"// "#8CC0F8"//"#E3A14B"
		VAR __AvgDash       = "0"//"4 1.5"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Main_Value + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width=        '" & __W & "'
		  height=       '" & __H & "'
		  sort=         '" & __SortKey & "'
		>"

		VAR __SVG_AC_Rect =
		    IF (
		        __BarW > 0,
		"  <rect
		    x=              '"  & __BarStart    & "'
		    y=              '"  & __BarY        & "'
		    width=          '"  & __BarW        & "'
		    height=         '"  & __BarH        & "'
		    fill=           '"  & __ColorActual & "'
		    stroke=         '"  & __ColorActual & "'
		    stroke-width=   '1'
		  />",
		        ""
		    )

		VAR __SVG_Baseline =
		"  <line
		    x1=             '"  & __X_Zero        & "'
		    y1=             '"  & __AxisY1        & "'
		    x2=             '"  & __X_Zero        & "'
		    y2=             '"  & __AxisY2        & "'
		    stroke=         '"  & __ColorBaseline & "'
		    stroke-opacity= '0.6'
		    stroke-width=   '1.5'
		  />"

		VAR __SVG_AvgLine =
		    IF (
		        NOT ISBLANK ( __AvgValue ),
		"  <line
		    x1=             '"  & __X_Avg         & "'
		    y1=             '"  & __AvgLineY1     & "'
		    x2=             '"  & __X_Avg         & "'
		    y2=             '"  & __AvgLineY2     & "'
		    stroke=         '"  & __ColorAvgLine  & "'
		    stroke-opacity= '0.95'
		    stroke-width=   '1.25'
		    stroke-dasharray='" & __AvgDash & "'
		  />",
		        ""
		    )

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_AC_Rect
		    &   __SVG_Baseline
		    &   __SVG_AvgLine
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Main_Value ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\01. Only Actuals
		dataCategory: ImageUrl
		lineageTag: 0c224db2-2093-47e3-b342-cb37f7d7307e

	measure '_Revenue | Nominal Delta | SVG | Integrated Data Bar | Hidden' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Segment] )

		VAR __Actual      = [_Revenue]
		VAR __Comparison  = [_Revenue PY]
		VAR __VarianceAbs = __Actual - __Comparison

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Segment] ),
		            "@Actuals",    [_Revenue],
		            "@Comparison", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Segment] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actuals] ) || NOT ISBLANK ( [@Comparison] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw =
		    MAXX (
		        __BaseTable_Filtered,
		        COALESCE (
		            MAX ( [@Actuals], [@Comparison] ),
		            [@Actuals],
		            [@Comparison]
		        )
		    )

		VAR __MinRaw =
		    MIN (
		        MINX (
		            __BaseTable_Filtered,
		            COALESCE (
		                MIN ( [@Actuals], [@Comparison] ),
		                [@Actuals],
		                [@Comparison]
		            )
		        ),
		        0
		    )

		VAR __Span = MAX ( __MaxRaw - __MinRaw, 1 )

		//______________________________________________________________________________________
		VAR __W      = 180
		VAR __H      = 30
		VAR __BarX   = 18
		VAR __BarH   = 18

		//______________________________________________________________________________________
		VAR __TrackW = __W - __BarX - 10
		VAR __BarY              = DIVIDE ( __H - __BarH, 2 )
		VAR __AxisLineExtension = 4
		VAR __AxisY1            = MAX ( 0, __BarY - __AxisLineExtension )
		VAR __AxisY2            = MIN ( __H, __BarY + __BarH + __AxisLineExtension )

		VAR __X_Actual          = __BarX + DIVIDE ( __Actual - __MinRaw,     __Span, 0 ) * __TrackW
		VAR __X_Comparison      = __BarX + DIVIDE ( __Comparison - __MinRaw, __Span, 0 ) * __TrackW
		VAR __X_Zero            = __BarX + DIVIDE ( 0 - __MinRaw,            __Span, 0 ) * __TrackW

		VAR __ActualStart       = MIN ( __X_Zero, __X_Actual )
		VAR __ActualW           = ABS ( __X_Actual - __X_Zero )

		VAR __DiffStart         = MIN ( __X_Actual, __X_Comparison )
		VAR __DiffW             = ABS ( __X_Actual - __X_Comparison )
		VAR __DiffH             = __BarH * 0.6
		VAR __DiffY             = __BarY

		//______________________________________________________________________________________

		VAR __TriangleW         = 20
		VAR __TriangleH         = 15
		VAR __TriangleX         = __X_Comparison
		VAR __TriangleY         = __BarY + 4

		VAR __ColorBg            = "#F2F2F2"
		VAR __ColorBgBorder      = "#D9D9D9"
		VAR __ColorActual        = "#47627F"

		VAR __ColorVarPos        = [_Positive Variance color | Light]
		VAR __ColorVarNeg        = [_Negative Variance color]
		VAR __ColorDiff          = IF ( __VarianceAbs >= 0, __ColorVarPos, __ColorVarNeg )

		VAR __ColorMarkerFill    = "#83909F"
		VAR __ColorMarkerOutline = "#FFFFFF"

		//______________________________________________________________________________________
		VAR __SortMode   = 1   // 1 = sort by Actual, 2 = sort by Variance, 3 = sort by Comparison
		VAR __SortMetric =
		    SWITCH (
		        TRUE(),
		            __SortMode = 1, __Actual,
		            __SortMode = 2, __VarianceAbs,
		            __SortMode = 3, __Comparison,
		            __Actual
		    )

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __SortMetric + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & __SortKey & "'
		>
		"

		VAR __SVG_Track =
		"
		  <rect
		    x=              '"  & __BarX           & "'
		    y=              '"  & __BarY           & "'
		    width=          '"  & __TrackW         & "'
		    height=         '"  & __BarH           & "'
		    fill=           '"  & __ColorBg        & "'
		    stroke=         '"  & __ColorBgBorder  & "'
		    fill-opacity=   '0.0'
		    stroke-opacity= '0.0'
		    stroke-width=   '1'
		  />
		"

		VAR __SVG_Actual =
		    IF (
		        __ActualW > 0,
		"
		  <rect
		    x=              '"  & __ActualStart    & "'
		    y=              '"  & __BarY           & "'
		    width=          '"  & __ActualW        & "'
		    height=         '"  & __BarH           & "'
		    fill=           '"  & __ColorActual    & "'
		    fill-opacity=   '1'
		  />
		",
		        ""
		    )

		VAR __SVG_Variance =
		    IF (
		        __DiffW > 0,
		"
		  <rect
		    x=              '"  & __DiffStart      & "'
		    y=              '"  & __DiffY          & "'
		    width=          '"  & __DiffW          & "'
		    height=         '"  & __DiffH          & "'
		    fill=           '"  & __ColorDiff      & "'
		  />
		",
		        ""
		    )

		VAR __SVG_Baseline =
		"
		  <line
		    x1=             '"  & __X_Zero         & "'
		    y1=             '"  & __AxisY1         & "'
		    x2=             '"  & __X_Zero         & "'
		    y2=             '"  & __AxisY2         & "'
		    stroke=         '"  & __ColorActual    & "'
		    stroke-opacity= '0.5'
		    stroke-width=   '1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Triangle =
		"
		  <polygon
		    points='"
		        & ( __TriangleX - __TriangleW / 2 ) & "," & ( __TriangleY - __TriangleH ) & " "
		        & ( __TriangleX + __TriangleW / 2 ) & "," & ( __TriangleY - __TriangleH ) & " "
		        &   __TriangleX                     & "," &   __TriangleY
		    & "'
		    fill='"               & __ColorMarkerFill    & "'
		    stroke='"             & __ColorMarkerOutline & "'
		    stroke-width='1.5'
		    stroke-linejoin='round'
		  />
		"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    //&   __SVG_Variance      // Deactivate this part to hide variances (optionally)
		    &   __SVG_Baseline
		    &   __SVG_Triangle      // Deactivate this part to hide comparative scenario (optionally)
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparison ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\04. Integrated Nominal Variance
		dataCategory: ImageUrl
		lineageTag: 97ffcc4e-1434-4d5c-8289-3adea99eed8f

	measure '_Revenue Variance abs. PY FX Color | Font' = ```


		VAR __Variance = [_Revenue Variance abs. PY]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Variance < 0, [_Negative Variance color]
		    ) & ""

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances
		lineageTag: 75f28a50-4800-48c3-a5c7-d47176b375b2

	measure '_Data Points | Monthly Gran. | FX Marker Color' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim_Calendar'[CurrMonthOffset] ),
		                "@Value", [_Revenue]
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Min_Date =    MINX ( __Table, 'Dim_Calendar'[CurrMonthOffset] )  // First Date Point
		VAR __Max_Date =    MAXX ( __Table, 'Dim_Calendar'[CurrMonthOffset] )  // Last Date Point
		VAR __Min_Val  =    MINX ( __Table, [@Value] )                         // Min Value
		VAR __Max_Val  =    MAXX ( __Table, [@Value] )                         // Max Value

		VAR __Xaxis_Date =  SELECTEDVALUE ( 'Dim_Calendar'[CurrMonthOffset] )  // Current X-axis Date Point
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim_Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Date IN { __Min_Date, __Max_Date }, "#32465C", // It can also reference to other measure with hex
		            __Xaxis_Val  IN { __Max_Val },              "#308C9A", // It can also reference to other measure with hex
		            __Xaxis_Val  IN { __Min_Val },              "#C64A4A", // It can also reference to other measure with hex
		            "#00000000"
		    )

		RETURN __Result

		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\01. Mixed & General
		lineageTag: 88f71c4e-ad91-4450-8cb5-301cd85202fd

	measure '_Data Points | Monthly Gran. | Marker Legend' = ```


		VAR __Xaxis_Date    = SELECTEDVALUE ( 'Dim_Calendar'[CurrMonthOffset] )        // Legend Breakdown
		VAR __Selected_Mode = SELECTEDVALUE ( 'TBL Data Points'[Data point] )          // Current X-axis Date Point

		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim_Calendar'[CurrMonthOffset] ),
		                "@Value", [_Revenue]                                           // Main Metric which we want to display
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Min_Date =    MINX ( __Table, 'Dim_Calendar'[CurrMonthOffset] )          // First Date Point
		VAR __Max_Date =    MAXX ( __Table, 'Dim_Calendar'[CurrMonthOffset] )          // Last Date Point
		VAR __Min_Val  =    MINX ( FILTER ( __Table, [@Value] <> 0 ), [@Value] )       // Min Value
		VAR __Max_Val  =    MAXX ( __Table, [@Value] )                                 // Max Value
		                         
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim_Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )  // Retrieving value

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT ISINSCOPE ( 'TBL Data Points'[Data point] ), __Xaxis_Val,      // IF we won't use "Data-point" Legend

		            __Selected_Mode    = "Value"                                     ||
		            ( __Selected_Mode  = "First" && __Xaxis_Date IN { __Min_Date } ) ||
		            ( __Selected_Mode  = "Last"  && __Xaxis_Date IN { __Max_Date } ) ||
		            ( __Selected_Mode  = "Max"   && __Xaxis_Val  IN { __Max_Val }  ) ||
		            ( __Selected_Mode  = "Min"   && __Xaxis_Val  IN { __Min_Val }  ), 
		            __Xaxis_Val,
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\01. Mixed & General
		lineageTag: f57a1540-7d06-45c4-af44-ec5803d6f115

