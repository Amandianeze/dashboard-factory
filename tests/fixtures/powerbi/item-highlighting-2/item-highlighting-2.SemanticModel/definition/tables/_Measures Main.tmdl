	measure '_Revenue Dynamic Rank Value' = ```

		/***INPUTS***/
		VAR __TopBin           = [NR Values 1-20 | Ranking 01 | Value]
		VAR __CurrentCustomer  = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __AtCustomerLevel  = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",         [_Revenue],
		                "@Revenue_Global",  CALCULATE ( [_Revenue], REMOVEFILTERS ( DIM_Customers[Business_Line], DIM_Customers[Segment] ) )
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    TOPN (
		        __TopBin ,
		        __BaseTable ,
		        [@Revenue] , DESC,
		        DIM_Customers_Supplemental[Customer_Sort_ID], ASC
		    )

		/***REVENUE CALCULATION***/
		VAR __AllRevenue_Total      = SUMX ( __BaseTable , [@Revenue] )
		VAR __TopNRevenue_Total     = SUMX ( __TopN_Customers , [@Revenue] )
		VAR __TopNRevenue_Customer  = SUMX ( FILTER ( __TopN_Customers , DIM_Customers_Supplemental[Customer] = __CurrentCustomer ), [@Revenue] )

		VAR __OthersRevenue         = __AllRevenue_Total - __TopNRevenue_Total

		/***CONDITIONS & CHECKS***/
		VAR __HasOthers         = 
		    COUNTROWS ( EXCEPT ( __BaseTable , __TopN_Customers ) ) > 0

		VAR __IsOtherRow        = 
		    __CurrentCustomer = "Others"

		VAR __CustomerInTopN    = 
		    CONTAINS ( __TopN_Customers, DIM_Customers_Supplemental[Customer],   __CurrentCustomer )

		/***RESULT***/
		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            __IsOtherRow  && __HasOthers  , __OthersRevenue ,
		            __CustomerInTopN              , __TopNRevenue_Customer ,
		            NOT __AtCustomerLevel         , __AllRevenue_Total ,
		            BLANK ()
		    )

		RETURN __Result


		// VAR __TopBin          = [NR Values 1-20 | Ranking 01 | Value]
