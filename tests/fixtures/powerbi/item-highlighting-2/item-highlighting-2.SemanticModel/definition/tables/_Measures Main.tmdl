	measure '_Filters | Active Filters Text' = ```


		VAR __FilterCap     = 5     // Increase or Decrease number
		VAR __TextLengthCap = 220   // Increase or Decrease number
		VAR __FilterCounter = [_Active Filters Count Number]
		VAR __Active_Items  = [_Active Items] // This variable is optional

		VAR _FilterList =
		    FILTER (
		        ADDCOLUMNS (
		            UNION (
		                ROW ( "Filter", [_Filters | Group Items Business Unit] ),
		                ROW ( "Filter", [_Filters | Group Items Segment] ),
		                ROW ( "Filter", [_Filters | Group Items Country] ),
		                ROW ( "Filter", [_Filters | Group Items Customer] )
		                -- Add more dimensions here if needed
		            ),
		            "@Filter_Active", [Filter] <> BLANK ()
		        ),
		        [@Filter_Active] = TRUE
		    )

		VAR __Concatenated_Items    = CONCATENATEX ( _FilterList, [Filter], " | " )
		VAR __Text_Length           = LEN ( __Concatenated_Items ) 

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        __FilterCounter = 0 || ISBLANK ( __FilterCounter ), 
		        "No Active Filters",

		        __Active_Items = 0, 
		        "No data available for the current filter selection. 
		        Adjust your filters to display results.", 

		        __Text_Length >= __TextLengthCap,                    
		        "Multiple selections: " & __FilterCounter & " active filter(s)",                   
		        
		        __FilterCounter <= __FilterCap, __Concatenated_Items,
		        "Multiple Active Filters"
		    )


		RETURN __Result
		```
		displayFolder: Filter Display\03. Advanced Variant Lvl. I (horizontal)
		lineageTag: 3f809f8f-6021-4476-9ae3-99fb8528b417

