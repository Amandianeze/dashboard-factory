		VAR __Is_At_Level_Segment       = ISINSCOPE ( 'TBL Top & Bottom & Others Simple'[Name Display] )
		VAR __CurrentRow                = SELECTEDVALUE ( DIM_Customers[Customer_ID] )

		//BASE TABLE ───────────────────────────────────────────────────────────────
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Customer_ID],
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Delta", [_Revenue Variance abs. PY]
		        ),
		        NOT ISBLANK ( [@Delta] )
		    )

		//RANK ─────────────────────────────────────────────────────────────────────
		VAR __RankedTable =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@RankDesc", RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], DESC BLANKS LAST ), LAST ),
		        "@RankAsc",  RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], ASC  BLANKS LAST ), LAST )
		    )

		//BINS ──────────────────────────────────────────────────────────────────────
		VAR __TopOnly       = FILTER ( __RankedTable, [@RankDesc] <= __TopN )
		VAR __BottomOnly    = FILTER ( __RankedTable, [@RankAsc]  <= __TopN && [@RankDesc] > __TopN )
		VAR __Others        = FILTER ( __RankedTable, [@RankDesc] > __TopN && [@RankAsc]  > __TopN )

		//RANK PER ROW ─────────────────────────────────────────────────────────────
		VAR __RankTop       = MAXX ( FILTER ( __TopOnly,    DIM_Customers[Customer_ID] = __CurrentRow ), [@RankDesc] )
		VAR __RankBottom    = MAXX ( FILTER ( __BottomOnly, DIM_Customers[Customer_ID] = __CurrentRow ), [@RankDesc] )
		VAR __RankOther     = MAXX ( FILTER ( __Others,     DIM_Customers[Customer_ID] = __CurrentRow ), [@RankDesc] )

		//RESULT ───────────────────────────────────────────────────────────────────
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Level_Customer && NOT __Is_At_Level_Segment, BLANK(),
		            NOT __Is_At_Level_Customer, __CategoryID,
		            __CategoryID = 1, __RankTop,
		            __CategoryID = 2, __RankOther,
		            __CategoryID = 3, __RankBottom,
		            BLANK()
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		lineageTag: 7ea4fc7f-9b89-4c6e-abee-155e9ff5ac2e

	measure '3. Top Bottom N Dynamic (delta AC-PY) Rank Revenue | One-side Split | without visual filter' = ```


		VAR __CategoryID                = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __SelectedCategories        = VALUES ( 'TBL Top & Bottom & Others Simple'[ID] )

		VAR __TopN                      = SELECTEDVALUE ( 'NR Values 1-20 | Ranking 01'[Ranking Dynamic Parameter], 10 )

		VAR __Is_At_Level_Customer      = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Is_At_Level_Segment       = ISINSCOPE ( 'TBL Top & Bottom & Others Simple'[Name Display] )
		VAR __CurrentRow                = SELECTEDVALUE ( DIM_Customers[Customer_ID] )

		//BASE TABLE ───────────────────────────────────────────────────────────────
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Customer_ID],
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Delta",  [_Revenue Variance abs. PY],
		            "@Actual", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Delta] )
		    )

		//RANK ─────────────────────────────────────────────────────────────────────
		VAR __RankedTable =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@RankDesc", RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], DESC BLANKS LAST ), LAST ),
		        "@RankAsc",  RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], ASC  BLANKS LAST ), LAST ),

		        "@RankDesc_AC", RANK ( DENSE, FILTER ( __BaseTable, NOT ISBLANK ( [@Actual] ) ), ORDERBY ( [@Actual], DESC BLANKS LAST ), LAST ),
		        "@RankAsc_AC",  RANK ( DENSE, FILTER ( __BaseTable, NOT ISBLANK ( [@Actual] ) ), ORDERBY ( [@Actual], ASC  BLANKS LAST ), LAST )
		    )

		//BINS ──────────────────────────────────────────────────────────────────────
		VAR __TopOnly       = FILTER ( __RankedTable, [@RankDesc] <= __TopN )
		VAR __BottomOnly    = FILTER ( __RankedTable, [@RankAsc]  <= __TopN && [@RankDesc] > __TopN )
		VAR __Others        = FILTER ( __RankedTable, [@RankDesc] > __TopN && [@RankAsc]  > __TopN )

		//RANK PER ROW ─────────────────────────────────────────────────────────────
		VAR __RankTop       = MAXX ( FILTER ( __TopOnly,    DIM_Customers[Customer_ID] = __CurrentRow ), [@RankDesc_AC] )
		VAR __RankBottom    = MAXX ( FILTER ( __BottomOnly, DIM_Customers[Customer_ID] = __CurrentRow ), [@RankDesc_AC] )
		VAR __RankOther     = MAXX ( FILTER ( __Others,     DIM_Customers[Customer_ID] = __CurrentRow ), [@RankDesc_AC] )

		//RESULT ───────────────────────────────────────────────────────────────────
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Level_Customer && NOT __Is_At_Level_Segment, BLANK(),
		            NOT __Is_At_Level_Customer, __CategoryID,
		            __CategoryID = 1, __RankTop,
		            __CategoryID = 2, __RankOther,
		            __CategoryID = 3, __RankBottom,
		            BLANK()
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		lineageTag: 2cf5e07a-2863-40a3-861b-92687ffc98fc

