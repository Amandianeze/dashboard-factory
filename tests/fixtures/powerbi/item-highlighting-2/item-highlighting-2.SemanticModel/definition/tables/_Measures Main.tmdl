		        ADDCOLUMNS (
		            ALLSELECTED ( 'Dim_Calendar'[Start of Month], 'Dim_Calendar'[mmm'yy], 'Dim_Calendar'[CurrMonthOffset] ),
		            "@X", 'Dim_Calendar'[Start of Month],
		            "@Y", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Y] ) 
		    )

		VAR __Table_With_Index =
		    ADDCOLUMNS (
		         __DataTable,
		            "@Idx",
		                RANK (
		                    DENSE,
		                    __DataTable ,  
		                    ORDERBY ( [@X], ASC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __Point_Count   = COUNTROWS ( __Table_With_Index )
		VAR __LinRegParams  = LINESTX ( __Table_With_Index, [@Y], [@Idx])
		VAR __Slope         = MAXX ( __LinRegParams, [Slope1] )
		VAR __Intercept     = MAXX ( __LinRegParams, [Intercept] )

		VAR __X_Current =
		    SELECTEDVALUE ( 'Dim_Calendar'[Start of Month] )

		VAR __Idx_Current =
		    MAXX (
		        FILTER (
		            __Table_With_Index ,
		            'Dim_Calendar'[Start of Month] = __X_Current
		        ),
		        [@Idx] 
		    )

		VAR __Trend_Line_Display =
		    IF (
		        NOT ISBLANK ( __Displayed_Metric ),
		        __Intercept + __Slope * __Idx_Current
		    )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Point_Count < 2,    BLANK(),
		            __Slope       < 0,    BLANK(),
		            __Trend_Line_Display
		    )

		RETURN __Result
		```
		displayFolder: Trendlines\09. Alternative Calculations
		lineageTag: d588422e-87ff-4fd2-9f82-92873d24ce52

