	measure '_Revenue Dynamic Rank Top Value Breakdown Alt.' = ```


		VAR __CategoryID   = SELECTEDVALUE ( 'TBL Top & Other Simple'[ID] )
		VAR __IsCustomer   = ISINSCOPE ( DIM_Customers[Customer_Name] )

		VAR __Base =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID]  ),
		        "@Rev", [_Revenue]
		    )
		VAR __BaseFiltered = FILTER ( __Base, NOT ISBLANK ( [@Rev] ) )

		VAR __RankCalc =
		    IF (
		        __IsCustomer,
		        RANK (
		            DENSE,
		            __BaseFiltered,
		            ORDERBY ( [@Rev], DESC BLANKS LAST )
		        )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __IsCustomer,  __RankCalc,
		        __CategoryID = 1, 1,
		        __CategoryID = 2, 2,
		        BLANK ()
		    )

		RETURN __Result
		```
		formatString: 0
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\01. Core - Alternative
		lineageTag: 05b079fb-6bca-45a2-9108-5ecc62f0c4a1

	measure '_Revenue Variance Rank 3 Levels' = ```

		VAR __CategoryID = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __IsCustomer = ISINSCOPE ( DIM_Customers[Customer_Name] )

		VAR __Base =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID]  ),
		        "@Variance",  [_Revenue Variance abs. PY]
		    )

		VAR __Filtered = FILTER ( __Base, NOT ISBLANK ( [@Variance] ) )

		VAR __RankDesc =
		    IF (
		        __IsCustomer,
		        RANK ( DENSE, __Filtered, ORDERBY ( [@Variance], DESC BLANKS LAST ) )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __IsCustomer,  __RankDesc,
		        __CategoryID = 1, 1,
		        __CategoryID = 2, 2,
		        __CategoryID = 3, 3,
		        BLANK ()
		    )
		    
		RETURN __Result
		```
		formatString: 0
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		lineageTag: 8ce3b61d-0f0c-460e-98e0-7954d1f8ec29

	measure '_Revenue Variance Rank 3 Levels Filter' = ```


		VAR __CategoryID     = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __TopN           = SELECTEDVALUE ( 'NR Values 1-20 | Ranking 01'[Ranking Dynamic Parameter], 10 )
		VAR __IsCustomerRow  = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __RankDesc       = [_Revenue Variance Rank 3 Levels]

		VAR __CustomerList =
		    FILTER (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID]  ),
		        NOT ISBLANK ( [_Revenue Variance abs. PY] )
		    )
		VAR __TotalCust      = COUNTROWS ( __CustomerList )
		VAR __RankAsc        = IF ( __IsCustomerRow, __TotalCust - __RankDesc + 1 )

		VAR __InTop          = __RankDesc <= __TopN
		VAR __InBottom       = __RankAsc  <= __TopN && NOT __InTop   
		VAR __InOthers       = NOT __InTop && NOT __InBottom

		VAR __Result =
		    IF (
		        NOT __IsCustomerRow
		        || ( __CategoryID = 1 && __InTop    )
		        || ( __CategoryID = 2 && __InOthers )
		        || ( __CategoryID = 3 && __InBottom ),
		        1
		    )

		RETURN __Result
		```
		formatString: 0
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		isHidden
		lineageTag: 116c65bc-f230-4ee0-bca5-698365d28bca

