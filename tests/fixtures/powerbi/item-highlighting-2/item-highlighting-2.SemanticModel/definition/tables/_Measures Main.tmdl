	measure '_PY Variance Normalized with Revenue | Normalized | Segment' = ```

		VAR __Current_Segment= SELECTEDVALUE ( DIM_Customers[Segment] )
		VAR __Table =
		CALCULATETABLE(
		    FILTER (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Segment] ),
		            "@Revenue", [_Revenue],
		            "@Variance",[_Revenue Variance abs. PY]
		        ),
		        NOT ISBLANK ( [@Revenue] ) || NOT ISBLANK ( [@Variance] )
		    ),
		    ALLSELECTED()
		)
		    
		VAR __MinVal =
		    MINX (
		        __Table,
		        VAR _Rev = [@Revenue]
		        VAR _Var = [@Variance]
		        RETURN COALESCE ( MIN ( _Rev, _Var ), _Rev, _Var )   
		    )
		 
		VAR __MaxVal =
		    MAXX (
		        __Table,
		        VAR _Rev = [@Revenue]
		        VAR _Var = [@Variance]
		        RETURN COALESCE ( MAX ( _Rev, _Var ), _Rev, _Var )       
		    )

		// VAR __Span                  = __MaxVal - __MinVal
		VAR __AbsMax =
		    MAX ( ABS ( __MinVal ), ABS ( __MaxVal ) )

		VAR __Variance_Curr_Segment =  
		    MAXX ( FILTER ( __Table, DIM_Customers[Segment] = __Current_Segment), [@Variance])

		VAR __NormValue = 
		    DIVIDE ( 
		         __Variance_Curr_Segment, 
		         __AbsMax 
		    )

		VAR __Result = __NormValue

		RETURN __Result

		```
		displayFolder: Normalization\Normalized Metrics
		lineageTag: 263be983-3bfb-495a-bd53-2ddef9eecb1d

	measure '_Revenue Normalized with PY Variance | Segment' = ```

		VAR __Current_Segment= SELECTEDVALUE ( DIM_Customers[Segment] )
		VAR __Table =
		CALCULATETABLE(
		    FILTER (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Segment] ),
		            "@Revenue",  [_Revenue],
		            "@Variance", [_Revenue Variance abs. PY]
		        ),
		        NOT ISBLANK ( [@Revenue] ) || NOT ISBLANK ( [@Variance] )
		    ),
		    ALLSELECTED()
		)
		    
		VAR __MinVal =
		    MINX (
		        __Table,
		        VAR _Rev = [@Revenue]
		        VAR _Var = [@Variance]
		        RETURN COALESCE ( MIN ( _Rev, _Var ), _Rev, _Var )   
		    )
		 
		VAR __MaxVal =
		    MAXX (
		        __Table,
		        VAR _Rev = [@Revenue]
		        VAR _Var = [@Variance]
		        RETURN COALESCE ( MAX ( _Rev, _Var ), _Rev, _Var )       
		    )

		// VAR __Span                  = __MaxVal - __MinVal
		VAR __AbsMax =
		    MAX ( ABS ( __MinVal ), ABS ( __MaxVal ) )

		VAR __Revenue_Curr_Segment =  
		    MAXX ( FILTER ( __Table, DIM_Customers[Segment] = __Current_Segment), [@Revenue])

		VAR __NormValue = 
		    DIVIDE ( 
		         __Revenue_Curr_Segment,
		         __AbsMax
		    )

		VAR __Result = __NormValue

		RETURN __Result

		```
		displayFolder: Normalization\Normalized Metrics
		lineageTag: dce5127e-829d-42cc-95b7-72e37fa69cee

	measure '_Data Points | Monthly Gran.' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim_Calendar'[CurrMonthOffset] ),
		                "@Value", [_Revenue]
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Min_Date =    MINX ( __Table, 'Dim_Calendar'[CurrMonthOffset] )  // First Date Point
		VAR __Max_Date =    MAXX ( __Table, 'Dim_Calendar'[CurrMonthOffset] )  // Last Date Point
		VAR __Min_Val  =    MINX ( __Table, [@Value] )                         // Min Value
		VAR __Max_Val  =    MAXX ( __Table, [@Value] )                         // Max Value

		VAR __Xaxis_Date =  SELECTEDVALUE ( 'Dim_Calendar'[CurrMonthOffset] ) // Current X-axis Date Point
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim_Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Date IN { __Min_Date, __Max_Date } ||
		            __Xaxis_Val  IN { __Min_Val, __Max_Val },
		            __Xaxis_Val,
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\01. Mixed & General
		lineageTag: cac6911b-eeda-4dd9-a434-ec18c97ced88

	measure '_Quadrant Per Customer Suppl Alt. Color' = ```


		VAR __X_Axis_metric = [_Revenue DIM Suppl]
		VAR __Y_Axis_metric = [_Margin % Perc DIM Suppl]

		VAR __X_Axis_Avg_metric = [_Revenue Average per item]
		VAR __Y_Axis_Avg_metric = [_Gross Margin % Perc Average per item]


		VAR __SCENARIO_HH =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 

		VAR __SCENARIO_LH =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 
		 
		VAR __SCENARIO_LL =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 

		VAR __SCENARIO_HL =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 


		VAR __Customer_Is_in_scope = ISINSCOPE ( 'DIM_Customers_Supplemental alt'[Customer_Name] )
		VAR __Result =
		        SWITCH(
		            TRUE(),
		                NOT ( __Customer_Is_in_scope ), "ffffffff",
		                __SCENARIO_HH,"#018CF9", 
		                __SCENARIO_LH,"#707B97",
		                __SCENARIO_LL,"#F0A032",
		                __SCENARIO_HL,"#A4B6DF",
		                "#C7CAD0"
		                )
		Return
		    __Result
		```
		displayFolder: Segmentation & Ranking\04. Quadrant\04. Quadrant Logic - Extended (Based on Suppl Dim)
		lineageTag: 67b4da34-efa7-4c5b-81f1-bb78155f8c0c

