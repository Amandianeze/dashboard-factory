	measure '_Revenue Normalized' = ```


		VAR __Table =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[Start of Month],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)

		VAR __Value =        
		    SUMX (
		        FILTER (
		            __Table,
		            'Dim_Calendar'[Start of Month] = SELECTEDVALUE ( 'Dim_Calendar'[Start of Month] ) && 
		             DIM_Customers[Customer_Name] = SELECTEDVALUE  (DIM_Customers[Customer_Name] ) 
		        ),
		        [@Revenue]
		    )

		VAR __Min =          MINX ( __Table, [@Revenue] )
		VAR __Min_with_0 =   MIN ( __Min , 0 )
		VAR __Max =          MAXX ( __Table, [@Revenue] )

		VAR __Span = __Max - __Min_with_0

		VAR __Norm =
		    DIVIDE ( 
		        [_Revenue] - __Min_with_0,
		        __Span
		    )

		VAR __Result = __Norm

		RETURN __Result




		```
		displayFolder: Normalization\Normalized Metrics
		lineageTag: 1ea77d83-e8c4-4322-bb29-7760afbbb015

	measure '_Revenue Normalized Customer' = ```


		VAR __Current_Customer = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Table =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Revenue", [_Revenue],
		            "@Cost"   , [_Direct Costs]
		        ),
		        NOT ISBLANK ( [@Revenue] ) || NOT ISBLANK ( [@Cost] )
		    )

		VAR __MinVal =
		    MIN (
		        MINX (
		            __Table,
		            VAR r = [@Revenue]
		            VAR c = [@Cost]
		            RETURN COALESCE ( MIN ( r, c ), r, c )   
		        ),
		        0                                            
		    )

		VAR __MaxVal =
		    MAXX (
		        __Table,
		        VAR r = [@Revenue]
		        VAR c = [@Cost]
		        RETURN COALESCE ( MAX ( r, c ), r, c )       --
		    )
		    
		VAR __Span   = __MaxVal - __MinVal

		VAR __Revenue_Curr_Customer = 
		    SUMX ( 
		        FILTER ( __Table, DIM_Customers[Customer_Name] = __Current_Customer ),
		        [@Revenue]
		        )

		VAR __NormValue = 
		    IF (
		        ISBLANK ( __Revenue_Curr_Customer ),
		        BLANK(),
		        DIVIDE ( 
		            __Revenue_Curr_Customer - __MinVal, 
		            __Span 
		        )
		    )

		VAR __Result = __NormValue

		RETURN __Result


		// Alternative way of calculating Min and Max value across two metrics, Variable "__Table" remains the same
		// VAR __Table_Column =
		//     UNION (
		//         SELECTCOLUMNS ( __Table, "@Value", [@Revenue] ),
		//         SELECTCOLUMNS ( __Table, "@Value", [@Cost] )
		//     )

		// VAR __MinVal = MIN ( MINX ( __Table_Column, [@Value] ), 0 )
		// VAR __MaxVal = MAXX ( __Table_Column, [@Value] )
		// VAR __Span   = __MaxVal - __MinVal


		```
		displayFolder: Normalization\Normalized Metrics
		lineageTag: f86d0e5c-86c2-4990-b300-320acdcf7573

	measure '_Direct Cost Normalized Customer' = ```


		VAR __Current_Customer = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Table =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Revenue", [_Revenue],
		            "@Cost"   , [_Direct Costs]
		        ),
		        NOT ISBLANK ( [@Revenue] ) || NOT ISBLANK ( [@Cost] )
		    )

		VAR __MinVal =
		    MIN (
		        MINX (
		            __Table,
		            VAR r = [@Revenue]
		            VAR c = [@Cost]
		            RETURN COALESCE ( MIN ( r, c ), r, c )   
		        ),
		        0                                            
		    )

		VAR __MaxVal =
		    MAXX (
		        __Table,
		        VAR r = [@Revenue]
		        VAR c = [@Cost]
		        RETURN COALESCE ( MAX ( r, c ), r, c )       
		    )

		VAR __Span   = __MaxVal - __MinVal

		VAR __Cost_Curr_Customer = 
		    SUMX ( 
		        FILTER ( __Table, DIM_Customers[Customer_Name] = __Current_Customer ),
		        [@Cost]
		        )

		VAR __NormValue = 
		    IF (
		        ISBLANK ( __Cost_Curr_Customer ),
		        BLANK(),
		        DIVIDE ( 
		            __Cost_Curr_Customer - __MinVal, 
		            __Span 
		        )
		    )

		VAR __Result = -1 * __NormValue

		RETURN __Result




		```
		displayFolder: Normalization\Normalized Metrics
		lineageTag: 1133043a-b131-46e8-b042-2439f5941ee0

	measure '_Revenue | Nominal Delta | SVG | Integrated Data Bar | Line' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Segment] )

		VAR __Actual      = [_Revenue]
		VAR __Comparison  = [_Revenue PY]
		VAR __VarianceAbs = __Actual - __Comparison

		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Segment] ),
		            "@Actual",     [_Revenue],
		            "@Comparison", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Segment] )
		    )

		VAR __BaseTable_Filtered =
		    FILTER (
		        __BaseTable,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparison] )
		    )

		//______________________________________________________________________________________
		VAR __MaxRaw =
		    MAXX (
		        __BaseTable_Filtered,
		        MAX (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __MinRaw =
		    MINX (
		        __BaseTable_Filtered,
		        MIN (
		            COALESCE ( [@Actual], 0 ),
		            COALESCE ( [@Comparison], 0 )
		        )
		    )

		VAR __ScaleMin = MIN ( __MinRaw, 0 )
		VAR __ScaleMax = MAX ( __MaxRaw, 0 )
		VAR __Span     = MAX ( __ScaleMax - __ScaleMin, 1 )

		//______________________________________________________________________________________
		VAR __W      = 180
		VAR __H      = 35
		VAR __BarX   = 18
		VAR __BarY   = 8
		VAR __BarH   = 18
		VAR __TrackW = __W - __BarX - 10

		VAR __X_Zero =
		    __BarX
		        + DIVIDE ( 0 - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Actual =
		    __BarX
		        + DIVIDE ( __Actual - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __X_Comparison =
		    __BarX
		        + DIVIDE ( __Comparison - __ScaleMin, __Span, 0 ) * __TrackW

		VAR __ActualStart = MIN ( __X_Zero, __X_Actual )
		VAR __ActualW     = ABS ( __X_Actual - __X_Zero )

		VAR __DiffStart   = MIN ( __X_Actual, __X_Comparison )
		VAR __DiffW       = ABS ( __X_Actual - __X_Comparison )
		VAR __DiffH       = __BarH * 0.6
		VAR __DiffY       = __BarY

		VAR __ColorBg        = "#F2F2F2"
		VAR __ColorBgBorder  = "#D9D9D9"
		VAR __ColorActual    = "#47627F"

		VAR __ColorVarPos    = [_Positive Variance color | Light]
		VAR __ColorVarNeg    = [_Negative Variance color]
		VAR __ColorDiff      = IF ( __VarianceAbs >= 0, __ColorVarPos, __ColorVarNeg )

		VAR __ColorBaseline  = "#47627F"
		VAR __ColorTarget    = "#4C4C4C"

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( __Actual + __SortShift, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000" )

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & __SortKey & "'
		>
		"

		VAR __SVG_Track =
		"
		  <rect
		    x=              '"  & __BarX          & "'
		    y=              '"  & __BarY          & "'
		    width=          '"  & __TrackW        & "'
		    height=         '"  & __BarH          & "'
		    fill=           '"  & __ColorBg       & "'
		    stroke=         '"  & __ColorBgBorder & "'
		    fill-opacity=   '0.0'
		    stroke-opacity= '0.0'
		    stroke-width=   '1'
		  />
		"

		VAR __SVG_Actual =
		    IF (
		        __ActualW > 0,
		"
		  <rect
		    x=              '"  & __ActualStart   & "'
		    y=              '"  & __BarY          & "'
		    width=          '"  & __ActualW       & "'
		    height=         '"  & __BarH          & "'
		    fill=           '"  & __ColorActual   & "'
		  />
		",
		        ""
		    )

		VAR __SVG_Variance =
		    IF (
		        __DiffW > 0,
		"
		  <rect
		    x=              '"  & __DiffStart     & "'
		    y=              '"  & __DiffY         & "'
		    width=          '"  & __DiffW         & "'
		    height=         '"  & __DiffH         & "'
		    fill=           '"  & __ColorDiff     & "'
		  />
		",
		        ""
		    )

		VAR __SVG_Baseline =
		"
		  <line
		    x1=             '"  & __X_Zero                & "'
		    y1=             '"  & ( __BarY - 4 )          & "'
		    x2=             '"  & __X_Zero                & "'
		    y2=             '"  & ( __BarY + __BarH + 4 ) & "'
		    stroke=         '"  & __ColorBaseline         & "'
		    stroke-opacity= '0.5'
		    stroke-width=   '1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Target =
		"
		  <line
		    x1=             '"  & __X_Comparison          & "'
		    y1=             '"  & ( __BarY - 4 )          & "'
		    x2=             '"  & __X_Comparison          & "'
		    y2=             '"  & ( __BarY + __BarH + 4 ) & "'
		    stroke=         '"  & __ColorTarget           & "'
		    stroke-width=   '1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Variance      // Deactivate this part to hide variances (optionally)
		    &   __SVG_Baseline
		    &   __SVG_Target        // Deactivate this part to hide scenario marker (optionally)
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),
		            ISBLANK ( __Actual ) && ISBLANK ( __Comparison ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\04. Integrated Nominal Variance
		dataCategory: ImageUrl
		lineageTag: 9442fe8f-c6b2-4e55-8ebe-226399c19508

	measure '_Revenue | % of Realization | SVG | Progress Bar' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( DIM_Customers[Segment] )

		VAR __Actual           = [_Revenue]
		VAR __Comparison       = [_Revenue PY]
		VAR __VarianceAbs      = __Actual - __Comparison
		VAR __Perc_Realization = DIVIDE ( __Actual, __Comparison, BLANK() )
		VAR __IsPositive       = __Perc_Realization >= 1

		VAR __BaseRaw =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Segment] ),
		            "@Actual",     [_Revenue],
		            "@Comparison", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Segment] )
		    )

		VAR __BaseRaw_Filtered =
		    FILTER (
		        __BaseRaw,
		        NOT ISBLANK ( [@Actual] ) || NOT ISBLANK ( [@Comparison] )
		    )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        __BaseRaw_Filtered,
		        "@Perc_Realization", DIVIDE ( [@Actual], [@Comparison], BLANK() )
		    )

		//______________________________________________________________________________________
		VAR __MaxPerc_Realization_Raw = MAXX ( __BaseTable, [@Perc_Realization] )

		VAR __MaxScale =
		    IF ( __MaxPerc_Realization_Raw > 1, __MaxPerc_Realization_Raw * 1.1, 1.1 )

		//______________________________________________________________________________________
		VAR __W      = 180
		VAR __H      = 30
		VAR __BarX   = 18
		VAR __BarH   = 18
		VAR __TrackW = __W - __BarX - 10

		VAR __BarY                = DIVIDE ( __H - __BarH, 2 )
		VAR __TargetLineExtension = 4
		VAR __TargetY1            = __BarY - __TargetLineExtension
		VAR __TargetY2            = __BarY + __BarH + __TargetLineExtension

		VAR __X_Actual =
		    __BarX
		        + DIVIDE ( __Perc_Realization, __MaxScale, 0 ) * __TrackW

		VAR __X_Target =
		    __BarX
		        + DIVIDE ( 1, __MaxScale, 0 ) * __TrackW

		VAR __ActualW = MAX ( __X_Actual - __BarX, 0 )

		VAR __ColorBg        = "#F2F2F2"
		VAR __ColorBgBorder  = "#D9D9D9"
		VAR __ColorPos       = [_Positive Variance color]
		VAR __ColorNeg       = [_Negative Variance color]
		VAR __ColorActual    = IF ( __IsPositive, __ColorPos, __ColorNeg )
		VAR __ColorTarget    = "#4C4C4C"

		//______________________________________________________________________________________
		VAR __SortMode = 2   // 1 = sort by Actual, 2 = sort by % Realization, 3 = sort by Variance

		VAR __SortMetric =
		    SWITCH (
		        TRUE(),
		            __SortMode = 1, __Actual,
		            __SortMode = 2, __Perc_Realization,
		            __SortMode = 3, __VarianceAbs,
		            __Perc_Realization
		    )

		VAR __SortKeyNum =
		    SWITCH (
		        TRUE(),
		            __SortMode = 2, ROUND ( ( __SortMetric + 1000 ) * 1000000, 0 ),
		            ROUND ( __SortMetric + 1000000000000, 0 )
		    )

		VAR __SortKey = FORMAT ( __SortKeyNum, "000000000000000000" )

		//______________________________________________________________________________________
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & __SortKey & "'
		>
		"

		VAR __SVG_Track =
		"
		  <rect
		    x=              '"  & __BarX          & "'
		    y=              '"  & __BarY          & "'
		    width=          '"  & __TrackW        & "'
		    height=         '"  & __BarH          & "'
		    fill=           '"  & __ColorBg       & "'
		    stroke=         '"  & __ColorBgBorder & "'
		    fill-opacity=   '0.5'
		    stroke-opacity= '0.7'
		    stroke-width=   '1'
		    rx=             '3'
		    ry=             '3'
		  />
		"

		VAR __SVG_Actual =
		    IF (
		        __ActualW > 0,
		"
		  <rect
		    x=              '"  & __BarX          & "'
		    y=              '"  & __BarY          & "'
		    width=          '"  & __ActualW       & "'
		    height=         '"  & __BarH          & "'
		    fill=           '"  & __ColorActual   & "'
		    rx=             '3'
		    ry=             '3'
		  />
		",
		        ""
		    )

		VAR __SVG_Target =
		"
		  <line
		    x1=             '"  & __X_Target      & "'
		    y1=             '"  & __TargetY1      & "'
		    x2=             '"  & __X_Target      & "'
		    y2=             '"  & __TargetY2      & "'
		    stroke=         '"  & __ColorTarget   & "'
		    stroke-width=   '1.5'
		  />
		"

		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Target
		    &   __SVG_Close

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            // NOT __Is_At_Item_Level, BLANK(),   // Hide/Show bar on Total Level
		            ISBLANK ( __Perc_Realization ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\06. % of Realization
		dataCategory: ImageUrl
		lineageTag: 79c87aa0-d741-49e6-87f4-439727b75eae

	measure '_Revenue Realization % PY' = ```


		VAR __Current =         [_Revenue]
		VAR __Previous_Year =   [_Revenue PY]
		VAR __Result =          DIVIDE ( __Current, __Previous_Year )

		RETURN __Result
