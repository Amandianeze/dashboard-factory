	measure '_Revenue Only Min Val' = ```


		VAR __BaseTable = 
		    CALCULATETABLE (
		        FILTER ( 
		            ADDCOLUMNS (
		                VALUES ( 'Dim_Calendar'[Start of Month] ),
		                "@Value", [_Revenue]
		            ),
		            NOT ISBLANK ( [@Value]) || [@Value] <> 0
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Min_Value         = MINX ( __BaseTable, [@Value] )
		VAR __X_Axis            = SELECTEDVALUE ( 'Dim_Calendar'[Start of Month] )
		VAR __Data_Point_Value  = MAXX ( FILTER ( __BaseTable, 'Dim_Calendar'[Start of Month] = __X_Axis),  [@Value] )

		VAR __Result = 
		    IF (
		        __Data_Point_Value  = __MIN_Value,  
		        __Data_Point_Value ,
		        BLANK()
		    )
		            
		RETURN __Result





		```
		formatString: #,0.0;-#,0.0;
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\03. Min
		lineageTag: 7c1e0618-6b93-4e4f-a746-9c7f310b1307

	measure '_Revenue Only Max Val' = ```


		VAR __BaseTable = 
		    CALCULATETABLE ( 
		        ADDCOLUMNS (
		            VALUES ( 'Dim_Calendar'[Start of Month] ),
		            "@Value", [_Revenue]
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Max_Value         = MAXX ( __BaseTable, [@Value] )
		VAR __X_Axis            = SELECTEDVALUE ( 'Dim_Calendar'[Start of Month] )
		VAR __Data_Point_Value  = MAXX ( FILTER ( __BaseTable, 'Dim_Calendar'[Start of Month] = __X_Axis),  [@Value] )

		VAR __Result = 
		    IF (
		        __Data_Point_Value  = __MAX_Value,  
		        __Data_Point_Value ,
		        BLANK()
		    )
		            
		RETURN __Result




		```
		formatString: #,0.0;-#,0.0;
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\02. Max
		lineageTag: ad5e8e9a-a6c9-4e98-985c-42aec01c4311

