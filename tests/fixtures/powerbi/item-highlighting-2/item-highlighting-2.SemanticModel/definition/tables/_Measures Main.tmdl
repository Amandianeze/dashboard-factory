	measure '_Revenue Dynamic Rank Value | Structure' = ```


		/***INPUTS***/
		VAR __TopBin           = [NR Values 1-20 | Ranking 01 | Value]
		VAR __CurrentCustomer  = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __AtCustomerLevel  = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Category         = SELECTEDVALUE ( 'TBL Top & Other Simple'[Name Display] )
		VAR __At_CategoryLevel = ISINSCOPE ( 'TBL Top & Other Simple'[Name Display] )
		VAR __IsTop_Bin        = __Category = "Top"
		VAR __IsOther_Bin      = __Category = "Others"

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    TOPN (
		        __TopBin ,
		        __BaseTable ,
		        [@Revenue] ,
		        DESC,
		        DIM_Customers[Sort ID], ASC
		    )

		VAR __Other_Customers =
		    EXCEPT ( __BaseTable, __TopN_Customers )

		/***REVENUE CALCULATION***/
		VAR __AllRevenue_Total      = SUMX ( __BaseTable , [@Revenue] )
		VAR __TopNRevenue_Total     = SUMX ( __TopN_Customers , [@Revenue] )
		VAR __OtherRevenue_Total    = SUMX ( __Other_Customers, [@Revenue] )
		VAR __Revenue_Customer      = SUMX ( FILTER ( __BaseTable , DIM_Customers[Customer_Name] = __CurrentCustomer ), [@Revenue] )

		/***CONDITIONS & CHECKS***/
		VAR __Has_Others        = COUNTROWS ( __Other_Customers  ) > 0
		VAR __CustomerInTopN    = CONTAINS ( __TopN_Customers, DIM_Customers[Customer_Name] , __CurrentCustomer )

		/***RESULT***/
		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            __AtCustomerLevel && __CustomerInTopN           && __IsTop_Bin,            __Revenue_Customer,
		            __AtCustomerLevel && NOT ( __CustomerInTopN )   && __IsOther_Bin ,         __Revenue_Customer,
		            NOT ( __AtCustomerLevel ),
		                SWITCH (
		                    TRUE(),
		                        __IsTop_Bin,                                                    __TopNRevenue_Total,
		                        __IsOther_Bin,                                                  __OtherRevenue_Total,   
		                        NOT ( __At_CategoryLevel ),                                     __AllRevenue_Total
		                ),
		                BLANK()
		    )
		  
		RETURN __Result




		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\01. Core
		lineageTag: c8134577-1e57-47d6-ad75-71e0ef9e6920

	measure '_Gross Profit Dynamic Rank Value | Structure' = ```


		/***INPUTS***/
		VAR __TopBin           = [NR Values 1-20 | Ranking 01 | Value]
		VAR __CurrentCustomer  = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __AtCustomerLevel  = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Category         = SELECTEDVALUE ( 'TBL Top & Other Simple'[Name Display] )
		VAR __At_CategoryLevel = ISINSCOPE ( 'TBL Top & Other Simple'[Name Display] )
		VAR __IsTop_Bin        = __Category = "Top"
		VAR __IsOther_Bin      = __Category = "Others"

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID] 
		            ),
		                "@Revenue", [_Revenue],
		                "@GP",      [_Gross Profit]
		        ),
		        NOT ISBLANK ( [@Revenue] ) ||
		        NOT ISBLANK ( [@GP] )
		    )

		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    TOPN (
		        __TopBin ,
		        __BaseTable ,
		        [@Revenue] ,
		        DESC,
		        DIM_Customers[Sort ID], ASC
		    )

		/***REVENUE CALCULATION***/
		VAR __AllGP_Total      = SUMX ( __BaseTable , [@GP] )
		VAR __TopNGP_Total     = SUMX ( __TopN_Customers , [@GP] )
		VAR __OtherGP          = SUMX ( EXCEPT ( __BaseTable, __TopN_Customers ), [@GP] )
		VAR __GP_Customer      = SUMX ( FILTER ( __BaseTable , DIM_Customers[Customer_Name] = __CurrentCustomer ), [@Revenue] )

		/***CONDITIONS & CHECKS***/
		VAR __Has_Others        = COUNTROWS ( EXCEPT ( __BaseTable , __TopN_Customers ) ) > 0
		VAR __CustomerInTopN    = CONTAINS ( __TopN_Customers, DIM_Customers[Customer_Name] , __CurrentCustomer )

		/***RESULT***/
		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            __AtCustomerLevel,
		                SWITCH (
		                    TRUE(),
		                        __CustomerInTopN && __IsTop_Bin ,                               __GP_Customer,                       
		                        NOT ( __CustomerInTopN  ) && __Has_Others && __IsOther_Bin,     __GP_Customer
		                ),
		            NOT ( __AtCustomerLevel ),
		                SWITCH (
		                    TRUE(),
		                        __IsTop_Bin,                                                    __TopNGP_Total,
		                        __IsOther_Bin,                                                  __OtherGP,   
		                        NOT ( __At_CategoryLevel ),                                     __AllGP_Total
		                ),
		            BLANK()
		    )
		  
		RETURN __Result




		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\01. Core
		lineageTag: bbd526ea-1def-4a6e-8080-45fe1f9cf66c

