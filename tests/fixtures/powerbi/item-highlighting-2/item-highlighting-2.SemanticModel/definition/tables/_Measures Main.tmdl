	measure '_Quadrant Revenue | Suppl' = ```


		VAR __MidX            = [_Revenue Average per item]
		VAR __MidY            = [_Gross Margin % Perc Average per item]
		VAR __ChosenQuads     = VALUES ( 'TBL Segment | Quadrant | Short'[ID] )

		VAR __Base_table =
		    ADDCOLUMNS (
		        VALUES ( 'DIM_Customers_Supplemental alt'[Customer_Name] ),
		        "@Revenue" , [_Revenue DIM Suppl],
		        "@Margin" ,  [_Margin % Perc DIM Suppl]
		    )

		VAR __Quadrant_table =
		    ADDCOLUMNS (
		        __Base_table,
		        "@Quadrant",
		            SWITCH (
		                TRUE(),
		                [@Revenue] >=  __MidX && [@Margin] >= __MidY , 1,
		                [@Revenue] <   __MidX && [@Margin] >= __MidY , 2,
		                [@Revenue] <   __MidX && [@Margin] <  __MidY , 3,
		                [@Revenue] >=  __MidX && [@Margin] <  __MidY , 4
		            )
		    )

		VAR __Filtered_table =
		    FILTER (
		        __Quadrant_table,
		        [@Quadrant] IN __ChosenQuads
		    )

		VAR __Tot_Revenue_Value = SUMX ( __Filtered_table, [@Revenue] )

		VAR __Result = __Tot_Revenue_Value

		RETURN __Result




		```
		displayFolder: Segmentation & Ranking\05. Quadrant\04. Quadrant Logic - Extended (Based on Suppl Dim & Legend)
		lineageTag: b1368d0b-b548-4f47-b4ff-264a247673c6

	measure '_Quadrant Gross Margin | Suppl' = ```


		VAR __MidX            = [_Revenue Average per item]
		VAR __MidY            = [_Gross Margin % Perc Average per item]
		VAR __ChosenQuads     = VALUES ( 'TBL Segment | Quadrant | Short'[ID] )

		VAR __Base_table =
		    ADDCOLUMNS (
		        VALUES ( 'DIM_Customers_Supplemental alt'[Customer_Name] ),
		        "@Revenue" , [_Revenue DIM Suppl],
		        "@Margin" ,  [_Margin % Perc DIM Suppl],
		        "@Profit" ,  [_Gross Profit DIM Suppl]
		    )

		VAR __Quadrant_table =
		    ADDCOLUMNS (
		        __Base_table,
		        "@Quadrant",
		            SWITCH (
		                TRUE(),
		                [@Revenue] >=  __MidX && [@Margin] >= __MidY , 1,
		                [@Revenue] <   __MidX && [@Margin] >= __MidY , 2,
		                [@Revenue] <   __MidX && [@Margin] <  __MidY , 3,
		                [@Revenue] >=  __MidX && [@Margin] <  __MidY , 4
		            )
		    )

		VAR __Filtered_table =
		    FILTER (
		        __Quadrant_table,
		        [@Quadrant] IN __ChosenQuads
		    )

		VAR __Tot_Revenue_Value     =   SUMX ( __Filtered_table, [@Revenue] )
		VAR __Tot_GrossProfit_Value =   SUMX ( __Filtered_table, [@Profit] )
		VAR __Tot_GrossMargin_Value =   DIVIDE ( __Tot_GrossProfit_Value , __Tot_Revenue_Value )

		VAR __Result = __Tot_GrossMargin_Value

		RETURN __Result




		```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Segmentation & Ranking\05. Quadrant\04. Quadrant Logic - Extended (Based on Suppl Dim & Legend)
		lineageTag: 7a01e223-cf16-446e-963f-1886822cf360

	measure '_Quadrant Count of Customers | Suppl' = ```


		VAR __MidX            = [_Revenue Average per item]
		VAR __MidY            = [_Gross Margin % Perc Average per item]
		VAR __ChosenQuads     = VALUES ( 'TBL Segment | Quadrant | Short'[ID] )

		VAR __Base_table =
		    ADDCOLUMNS (
		        VALUES ( 'DIM_Customers_Supplemental alt'[Customer_Name] ),
		        "@Revenue" , [_Revenue DIM Suppl],
		        "@Margin" ,  [_Margin % Perc DIM Suppl]
		    )

		VAR __Quadrant_table =
		    ADDCOLUMNS (
		        __Base_table,
		        "@Quadrant",
		            SWITCH (
		                TRUE(),
		                [@Revenue] >=  __MidX && [@Margin] >= __MidY , 1,
		                [@Revenue] <   __MidX && [@Margin] >= __MidY , 2,
		                [@Revenue] <   __MidX && [@Margin] <  __MidY , 3,
		                [@Revenue] >=  __MidX && [@Margin] <  __MidY , 4
		            )
		    )

		VAR __Filtered_table =
		    FILTER (
		        __Quadrant_table,
		        [@Quadrant] IN __ChosenQuads
		    )

		VAR __Tot_Count_Of_Customers =   COUNTROWS ( __Filtered_table )

		VAR __Result = __Tot_Count_Of_Customers 

		RETURN __Result




		```
		displayFolder: Segmentation & Ranking\05. Quadrant\04. Quadrant Logic - Extended (Based on Suppl Dim & Legend)
		lineageTag: 3a3e8778-0a85-40d0-b26c-997094b75f2f

	measure '_Revenue Dynamic Rank Value | Structure v2' = ```

		/*** inputs ***/
		VAR __TopBin          = [NR Values 1-20 | Ranking 01 | Value]
		VAR __CurrCustomerID  = SELECTEDVALUE ( DIM_Customers[Customer_ID] )
		VAR __AtCustomerLevel = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __ChosenCategory  = SELECTEDVALUE ( 'TBL Top & Other Simple'[Name Display] )  -- "Top" / "Others" / BLANK

		/*** base table (single revenue reference) ***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Customer_ID],
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		/*** Top / Others as single-column ID sets ***/
		VAR __TopIDs =
		    SUMMARIZE (
		        TOPN ( __TopBin, __BaseTable, [@Revenue], DESC, DIM_Customers[Sort ID], ASC ),
		        DIM_Customers[Customer_ID]
		    )

		VAR __AllIDs   = SUMMARIZE ( __BaseTable, DIM_Customers[Customer_ID] )
		VAR __OtherIDs = EXCEPT ( __AllIDs, __TopIDs )

		/*** totals by bin (membership tested on the static base table) ***/
		VAR __AllRevenue_Total =
		    SUMX ( __BaseTable, [@Revenue] )

		VAR __TopRevenue_Total =
		    SUMX (
		        FILTER ( __BaseTable, CONTAINSROW ( __TopIDs, DIM_Customers[Customer_ID] ) ),
		        [@Revenue]
		    )

		VAR __OtherRevenue_Total =
		    SUMX (
		        FILTER ( __BaseTable, CONTAINSROW ( __OtherIDs, DIM_Customers[Customer_ID] ) ),
		        [@Revenue]
		    )

		/*** row value ***/
		VAR __RowRevenue =
		    SUMX (
		        FILTER ( __BaseTable, DIM_Customers[Customer_ID] = __CurrCustomerID ),
		        [@Revenue]
		    )

		/*** row bin check (for conditional show when category is selected) ***/
		VAR __CurrIsTop   = CONTAINSROW ( __TopIDs,   __CurrCustomerID )
		VAR __CurrBinName = IF ( __CurrIsTop, "Top", "Others" )
		VAR __CategoryOK  = ISBLANK ( __ChosenCategory ) || __ChosenCategory = __CurrBinName

		/*** result ***/
		VAR __Result =
		    IF (
		        __AtCustomerLevel,
		            IF ( __CategoryOK, __RowRevenue ),
		            SWITCH (
		                TRUE(),
		                __ChosenCategory = "Top",    __TopRevenue_Total,
		                __ChosenCategory = "Others", __OtherRevenue_Total,
		                __AllRevenue_Total
		            )
		    )

		RETURN __Result

		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\01. Core
		lineageTag: 3cb0389f-bc5f-4908-88cf-2b51f8323ab6

	measure '_Revenue Dynamic Rank Value | Structure | Card' = ```


		VAR __Is_Customer_Filtered  = ISFILTERED ( DIM_Customers[Customer_Name] )
		VAR __Is_Bin_Filtered       = ISFILTERED ( 'TBL Top & Other Simple'[Name Display] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Is_Customer_Filtered  && __Is_Bin_Filtered, [_Revenue],
		            [_Revenue Dynamic Rank Value | Structure]
		    )

		RETURN __Result



		```
