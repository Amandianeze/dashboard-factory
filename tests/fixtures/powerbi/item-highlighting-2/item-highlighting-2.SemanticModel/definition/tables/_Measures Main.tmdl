		    )

		//BINS ─────────────────────────────────────────────────────────────────────
		VAR __TopOnly    = FILTER ( __SegmentedTable, [@Segment] = 1 )
		VAR __BottomOnly = FILTER ( __SegmentedTable, [@Segment] = 3 )
		VAR __Others     = FILTER ( __SegmentedTable, [@Segment] = 2 )

