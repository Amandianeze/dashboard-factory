	measure '_Revenue | Customized Period | Time Preset Window' = ```


		VAR __Preset    = SELECTEDVALUE ( 'TBL Time Presets'[Name], "ALL" )
		VAR __EndPeriod = MAX ( 'Dim_Calendar'[CurrMonthOffset] )
		VAR __Year      = MAX ( 'Dim_Calendar'[Year] )

		VAR __AllStartOff =
		    CALCULATE (
		        MIN ( 'Dim_Calendar'[CurrMonthOffset] ),
		        ALL ( 'Dim_Calendar' )
		    )

		VAR __YearStartOff =
		    CALCULATE (
		        MIN ( 'Dim_Calendar'[CurrMonthOffset] ),
		        ALL ( 'Dim_Calendar' ),
		        'Dim_Calendar'[Year] = __Year
		    )

		VAR __YearEndOff =
		    CALCULATE (
		        MAX ( 'Dim_Calendar'[CurrMonthOffset] ),
		        ALL ( 'Dim_Calendar' ),
		        'Dim_Calendar'[Year] = __Year
		    )

		// Start offset depending on preset
		VAR __StartOff =
		    SWITCH (
		        __Preset,
		        "YTD", __YearStartOff,
		        "FY",  __YearStartOff,
		        "LTM", __EndPeriod - 11,
		        "ALL", __AllStartOff,
		        __YearStartOff
		    )

		// End offset depending on preset
		VAR __EndOff =
		    SWITCH (
		        __Preset,
		        "YTD", __EndPeriod,
		        "FY",  __YearEndOff,
		        "LTM", __EndPeriod,
		        "ALL", __EndPeriod,
		        __YearEndOff
		    )

		// Final calculation
		VAR __Result =
		        CALCULATE (
		            [_Revenue],
		            REMOVEFILTERS ( 'Dim_Calendar' ),
		            'Dim Calendar Suppl'[CurrMonthOffset] >= __StartOff &&
		            'Dim Calendar Suppl'[CurrMonthOffset] <= __EndOff,
		            USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		        )
		    
		RETURN __Result
		```
		formatString: #,0;-#,0;0
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\09.Other Calculations
		lineageTag: 4130e929-a016-48a0-9e0f-10ff11bcdb01

	measure '_Revenue Last N Based on Offset | Preset' = ```


		VAR __Selected_MonthID  = MAX ( 'Dim_Calendar'[CurrMonthOffset]  )
		VAR __Period_Window     = SELECTEDVALUE ( 'TBL Time Presets (Number)'[Numeric Value], 12 )

		VAR __StartMonthID =
		    __Selected_MonthID - __Period_Window + 1

		VAR __Result =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonthID &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_MonthID,
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		RETURN  __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\04.Last N
		lineageTag: f1a1823e-7dd3-4a14-959a-bbd8565cb4f0

	measure '_Revenue Last 13 Periods by Grain' = ```


		VAR __Grain = SELECTEDVALUE ( 'TBL Granularity'[Name Short], "M" )   -- "M","Q","Y"

		-- anchor from the main calendar (single-select mmm'yy)
		VAR __EndPeriod =
		    SWITCH (
		        __Grain,
		        "M", MAX ( 'Dim_Calendar'[CurrMonthOffset] ),
		        "Q", MAX ( 'Dim_Calendar'[CurrQuarterOffset] ),
		        "Y", MAX ( 'Dim_Calendar'[CurrYearOffset] )
		    )

		VAR __Period_Window_ToDisplay =  13

		VAR __StartPeriod = ( __EndPeriod - __Period_Window_ToDisplay ) + 1

		//____Result values____
		VAR __Result_Monthly_Grain =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartPeriod &&
		        'Dim_Calendar'[CurrMonthOffset] <= __EndPeriod,
		        USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __Result_Quarterly_Grain =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrQuarterOffset] >= __StartPeriod &&
		        'Dim_Calendar'[CurrQuarterOffset] <= __EndPeriod,
		        USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __Result_Yearly_Grain =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrYearOffset] >= __StartPeriod &&
		        'Dim_Calendar'[CurrYearOffset] <= __EndPeriod,
		        USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __Result =
		    SWITCH (
		        __Grain,
		        "M", __Result_Monthly_Grain,
		        "Q", __Result_Quarterly_Grain,
		        "Y", __Result_Yearly_Grain
