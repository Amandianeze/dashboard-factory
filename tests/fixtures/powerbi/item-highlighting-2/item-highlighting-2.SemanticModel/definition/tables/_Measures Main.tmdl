	measure '_Revenue Trend Line | Slope Tag' = ```


		VAR __Displayed_Metric = [_Revenue]

		VAR __DataTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( 'Dim_Calendar'[Start of Month], 'Dim_Calendar'[mmm'yy] ),
		            "@X", 'Dim_Calendar'[Start of Month],
		            "@Y", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Y] ) 
		    )

		VAR __Point_Count   = COUNTROWS ( __DataTable )
		VAR __LinRegParams  = LINESTX ( __DataTable, [@Y], [@X])
		VAR __Slope         = MAXX ( __LinRegParams, [Slope1] )

		VAR __Result =
		     SWITCH (
		        TRUE(),
		            ISBLANK( __Displayed_Metric ), BLANK(),
		            __Point_Count <  2, 0, 
		            __Slope       >= 0, 1,
		            __Slope       <  0, 2
		    )

