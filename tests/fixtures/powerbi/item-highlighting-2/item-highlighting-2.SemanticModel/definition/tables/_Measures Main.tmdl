	measure '_Revenue Progress Bar vs PY | SVG Col. Breakdown' = ```


		// A) DATA PER ROW
		VAR __Act     = [_Revenue]
		VAR __Tgt     = [_Revenue PY]
		VAR __VarAbs  = __Act - __Tgt

		// B) CONTEXT SCALE
		VAR __BaseTable =
		    CALCULATETABLE ( 
		        ADDCOLUMNS ( 
		            FILTER (
		                CROSSJOIN ( 
		                    VALUES ( DIM_Customers[Segment] ),
		                    VALUES ( DIM_Customers[Business_Line] )
		                ),
		                NOT ISBLANK ( [_Revenue] ) || NOT ISBLANK ( [_Revenue PY] )
		            ),
		            "@Act", [_Revenue] ,
		            "@Tar", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers )
		    )

		VAR __MaxRaw =
		    MAXX (
		        __BaseTable,
		        COALESCE ( MAX ( [@Act], [@Tar] ), [@Act], [@Tar] )
		    )

		VAR __MinRaw =
		    MIN (
		        MINX (
		            __BaseTable,
		            COALESCE ( MIN ( [@Act], [@Tar] ), [@Act], [@Tar] )
		        ),
		        0
		    )

		VAR __Span   = __MaxRaw - __MinRaw

		// C) LAYOUT & CO‑ORDINATES
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __Act - __MinRaw , __Span , 0 ) * __TrackW
		VAR __X_Tar    = __BarX + DIVIDE ( __Tgt - __MinRaw , __Span , 0 ) * __TrackW
		VAR __MainW    = MAX ( __X_Act - __BarX , 0 )

		VAR __DiffStart = MIN ( __X_Act , __X_Tar )
		VAR __DiffW     = ABS ( __X_Act - __X_Tar )
		VAR __DiffH     = __BarH * 0.6
		VAR __DiffY     = __BarY

		// D) COLORS
		VAR __ColorBg        = "#F2F2F2"   -- track background
		VAR __ColorBgBorder  = "#D9D9D9"   -- track border
		VAR __ColorActual    = "#5A6A81"   -- actual bar // "#B2CEFB"   --"#A9ADB1"   

		VAR __ColorVarPos    = "#63D17F"   -- positive Variance // "#2461C4" --Blue 
		VAR __ColorVarNeg    = "#DD3939"   -- negative variance // "#B34E4E"   
		VAR __ColorDiff      = IF ( __VarAbs >= 0 , __ColorVarPos , __ColorVarNeg )

		// E) INDIVIDUAL SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"
		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Act , "00000000000" ) & "'
		>
		"

		VAR __SVG_Track =
		"
		  <!-- track -->
		  <rect
		    x='"                & __BarX        & "'
		    y='"                & __BarY        & "'
		    width='"            & __TrackW      & "'
		    height='"           & __BarH        & "'
		    fill='"             & __ColorBg       & "'    
		    stroke='"           & __ColorBgBorder & "'  
		    fill-opacity=       '"   & 0 & "'
		    stroke-opacity=     '"   & 0 & "'       
		    stroke-width=       '1'
		  />
		"

		VAR __SVG_Actual =
		"
		  <!-- actual -->
		  <rect
		    x='"                & __BarX       & "'
		    y='"                & __BarY       & "'
		    width='"            & __MainW      & "'
		    height='"           & __BarH       & "'
		    fill='"             & __ColorActual  & "'
		  />
		"

		VAR __SVG_Variance =
		    IF ( __DiffW > 0 ,
		"
		  <!-- variance -->
		  <rect
		    x='"                & __DiffStart  & "'
		    y='"                & __DiffY      & "'
		    width='"            & __DiffW      & "'
		    height='"           & __DiffH      & "'
		    fill='"             & __ColorDiff    & "'
		  />
		", "" )

		VAR __SVG_Target =
		"
		  <!-- target -->
		  <line
		    x1='"            & __X_Tar                 & "'
		    y1='"            & ( __BarY - 4 )          & "'
		    x2='"            & __X_Tar                 & "'
		    y2='"            & ( __BarY + __BarH + 4 ) & "'
		    stroke='#4C4C4C'
		    stroke-width='1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Close = "</svg>"

		// F) CONCATENATION
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Variance
		    &   __SVG_Target
		    &   __SVG_Close

		// G) RESULT
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ),     BLANK(),
		            NOT ISINSCOPE ( DIM_Customers[Segment] ),   BLANK(),
		        __ResultSVG
		    )

		RETURN __Result



		//Additional Conditions to be added in the top formula section to enable Triangle (Marker) display
		// VAR __TriH     = 8  -- triangle height (px)
		// VAR __TriOff   = 5  -- triangle top offset (px)

		//Additional Triangle (Marker) Placed on top of a target line (to be copied/pasted into the Target line section//
		//   <!-- triangle (pointing down) -->
		//   <polygon
		//    points='
		//       " &  __X_Tar                     & "," & ( __BarY - 2       + __TriOff ) & " " &  -- apex
		//       ( __X_Tar - __TriH/2 )           & "," & ( __BarY - 2 - __TriH + __TriOff ) & " " &  -- left base
		//       ( __X_Tar + __TriH/2 )           & "," & ( __BarY - 2 - __TriH + __TriOff ) & "'
		//     fill='#4C4C4C'
		//   />


		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\09. Others
