	measure '_Customer Pareto | Basic Filter' = ```

		VAR __CustomerInScope =
		    ISINSCOPE ( 'DIM_Customers'[Customer_ID] )

		VAR __Class =
		    SELECTEDVALUE ( 'TBL Segment | Pareto '[Name Display] )  

		VAR __CumuPerc =
		    [_Pareto Cumulative Value % Perc]

		VAR __Threshold =
		    [Parameter Pareto Dynamic Range | Value]

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            ( __Class  = "Pareto" && __CumuPerc <= __Threshold ) || 
		            ( __Class  = "Others" && __CumuPerc > __Threshold ),
		            1,
		            0
		    )

		RETURN __Result
		    
