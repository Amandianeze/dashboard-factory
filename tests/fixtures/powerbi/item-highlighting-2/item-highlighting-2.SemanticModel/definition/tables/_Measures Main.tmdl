	measure '_Revenue Max Value First Point Label' = ```

		VAR __Value = 
		    CALCULATE ( 
		        [_Revenue],
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Value_All = 
		    CALCULATE ( 
		        [_Revenue],
		        ALLSELECTED ( 'Dim_Calendar' ),
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] )
		    )

		Var __Value_Percentage_of_total = 
		    DIVIDE (
		        __Value,
		        __Value_All
		    )

		VAR __Format_Default    = "#,0,.0K;-#,0,.0K"
		VAR __Format_Percentage = "0.0%;-0.0%;0%"

		VAR __Result = 
		   IF (
		        NOT ISBLANK ( __Value ), 
		        FORMAT (__Value, __Format_Default) &  " | " &  FORMAT (__Value_Percentage_of_total, __Format_Percentage) & "" 
		   )

		RETURN  __Result

		```
		displayFolder: Markers & Data Points & Factors\04. Reference Labels
		lineageTag: 6cb611fd-9490-4e61-8221-3f29bde35cd9

	measure '_Revenue Max Value First Point Label Average' = ```

		VAR __Value_Average = 
		    CALCULATE (
		        AVERAGEX (
		            VALUES ('Dim_Calendar'[Start of Month]),
		            [_Revenue]
		        ),
		        ALLSELECTED ( 'Dim_Calendar')
		)

		VAR __Is_First_Label = [_Revenue Max value *1.25 First Point | Month & Customer]

		VAR __Format_Default    = "#,0,.0K;-#,0,.0K"

		VAR __Result = 
		   SWITCH (
		       TRUE(),
		            ISBLANK ( __Value_Average ) || ISBLANK ( __Is_First_Label ), BLANK(),
		            " mAvg: " & FORMAT (__Value_Average, __Format_Default )  
		   )

		RETURN __Result
		```
		displayFolder: Markers & Data Points & Factors\04. Reference Labels
		lineageTag: 9f4117a2-308d-4f89-976a-fae3fee8c9e6

