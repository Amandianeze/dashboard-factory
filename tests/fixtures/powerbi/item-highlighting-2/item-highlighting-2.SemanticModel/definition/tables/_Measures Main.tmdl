	measure '_Revenue Rank 3 Levels' = ```

		VAR __CategoryID = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __IsCustomer = ISINSCOPE ( DIM_Customers[Customer_Name] )

		VAR __Base =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID]  ),
		        "@Rev",     [_Revenue],
		        "@Rev PY",  [_Revenue PY]
