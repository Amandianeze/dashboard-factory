	measure '_Revenue AC % of Total | SVG | Pie Chart' = ```


		// A) DATA
		VAR __Main_Metric = 
		    [_Revenue]

		VAR __TotalValue =
		    CALCULATE (
		        [_Revenue],
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )
		//______________________________________________________________________________________
		VAR __ShareRaw =
		    DIVIDE ( __Main_Metric , __TotalValue )

		VAR __Share =
		    IF (
		        ISBLANK ( __ShareRaw ),
		        BLANK(),
		        MIN ( MAX ( __ShareRaw , 0 ) , 1 )
		    )
		//______________________________________________________________________________________
		// B) LAYOUT
		VAR __W        = 25                             // Canva Size
		VAR __H        = 25                             // Canva Size
		VAR __CX       = DIVIDE ( __W , 2 )             // Center X
		VAR __CY       = DIVIDE ( __H , 2 )             // Center Y
		VAR __R        = 6      //7//6                  // Radius of the circle pat
		VAR __StrokeW  = 11     //5//11                 // Stroke width. When large relative to the radius, the chart looks like a filled pie chart.

		// C) CIRCUMFERENCE FOR DASH
		VAR __Circ     = 2 * PI() * __R                 // Full circumference of the circle.
		VAR __DashOn   = __Circ * __Share               // Length of the visible arc segment representing the value's share of total.
		VAR __DashOff  = __Circ                         // Length of the hidden/gap part after the visible arc.

		VAR __DashOnStr  = SUBSTITUTE ( FORMAT ( __DashOn , "0.###" ) , "," , "." )     // Visible arc length converted to text with a decimal dot required by SVG
		VAR __DashOffStr = SUBSTITUTE ( FORMAT ( __DashOff, "0.###" ) , "," , "." )     // Hidden arc length converted to text with a decimal dot required by SVG

		// D) COLORS
		VAR __ColorBg    = "%23E5E5E5"
		VAR __ColorSlice = "%233D5671"//"%234D4D4D"

		//______________________________________________________________________________________
		// E) SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  sort='"   & FORMAT ( __ShareRaw , "0.00000" ) & "'
		>
		"

		VAR __SVG_Background =
		"
		  <circle
		    cx='"           & __CX & "'
		    cy='"           & __CY & "'
		    r='"            & __R  & "'
		    fill=           'none'
		    stroke=         '" & __ColorBg & "'
		    stroke-width=   '" & __StrokeW & "'
		    stroke-linecap= 'butt'
		  />
		"

		VAR __SVG_Slice =
		"
		  <circle
		    cx=                 '" & __CX & "'
		    cy=                 '" & __CY & "'
		    r=                  '" & __R  & "'
		    fill=               'none'
		    stroke=             '" & __ColorSlice & "'
		    stroke-width=       '" & __StrokeW & "'
		    stroke-linecap=     'butt'
		    stroke-dasharray=   '" & __DashOnStr & " " & __DashOffStr & "'
		    transform=          'rotate(-90 " & __CX & " " & __CY & ")'
		  />
		"

		VAR __SVG_FullSlice =
		"
		  <circle
		    cx=                 '" & __CX & "'
		    cy=                 '" & __CY & "'
		    r=                  '" & __R  & "'
		    fill=               'none'
		    stroke=             '" & __ColorSlice & "'
		    stroke-width=       '" & __StrokeW & "'
		    stroke-linecap=     'butt'
		  />
		"
		VAR __SVG_Close = "</svg>"

		//______________________________________________________________________________________
		VAR __SVG_Content =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Share ) , __SVG_Background,              // no data
		            __Share <= 0        , __SVG_Background,              // 0%
		            __Share >= 0.999    , __SVG_FullSlice,               // ~100%
		            __SVG_Background & __SVG_Slice                       // partial pie
		    )

		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Content
		    &   __SVG_Close

		VAR __Result =
		    IF ( ISBLANK ( __Main_Metric ), BLANK(), __ResultSVG )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\01. Only Actuals
		dataCategory: ImageUrl
		lineageTag: 40a0d5b4-ac3c-456f-8327-d1e3beaa1dec

	measure '_Revenue ΔPY | SVG' = ```


		// A) DATA PER ROW
		VAR __Act    = [_Revenue]
		VAR __PY     = [_Revenue PY]
		VAR __Delta  = __Act - __PY

		VAR __IsDetailRow =
		    ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] ) 

		// B) CONTEXT SCALE – max abs(ΔPY) in current filter context
		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Delta", [_Revenue] - [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __MaxAbsDeltaRaw =
		    MAXX ( __BaseTable , ABS ( [@Delta] ) )

		VAR __MaxAbsDelta =
		    IF ( __MaxAbsDeltaRaw = 0 , 1 , __MaxAbsDeltaRaw )

		/* bar width as fraction of total width:
		   • |Δ| scaled by max |Δ|
		   • /2 because we only use half of the width on each side
		   • *0.7 to leave headroom for labels                                */
		VAR __WidthFrac =
		        DIVIDE ( ABS ( __Delta ) , __MaxAbsDelta , 0 )
		    /   2
		    *   0.5

		VAR __WidthPct =
		    FORMAT ( __WidthFrac , "0.0%" )

		// C) LAYOUT & CO-ORDINATES
		VAR __W          = 200
		VAR __H          = 30

		VAR __AxisXFrac  = 0.5           -- 50% baseline (Δ = 0)

		// vertical positioning
		VAR __BarY       = "36%"
		VAR __BarH       = "36%"
		VAR __LabelY     = "64%"

		// x position of the bar
		VAR __X_Bar =
		    IF (
		        __Delta >= 0 ,
		        "50%" ,                                -- positive: start at axis
		        FORMAT ( __AxisXFrac - __WidthFrac , "0%" )   -- negative: to the left
		    )

		// x position of the label (end of bar)
		VAR __X_Label =
		    IF (
		        __Delta >= 0 ,
		        FORMAT ( __AxisXFrac + __WidthFrac , "0%" ) ,
		        __X_Bar
		    )

		VAR __Anchor =
		    IF ( __Delta >= 0 , "start" , "end" )

		VAR __DX =
		    IF ( __Delta >= 0 , 6 , -6 )

		// D) LABEL TEXT
		VAR __LabelText =
		    FORMAT ( __Delta , "+#,0,.0;-#,0,.0;0" )

		// E) COLORS
		VAR __ColorAxis = "#47627F"//"#C0C0C0"
		VAR __ColorPos  = "#308C9A"
		VAR __ColorNeg  = "#B34E4E"
		VAR __BarColor  = IF ( __Delta > 0 , __ColorPos , __ColorNeg )

		// F) COMMON SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Delta , "00000000000" ) & "'
		>
		"

		VAR __SVG_Axis =
		"
		  <line
		    x1='50%'
		    y1='8%'
		    x2='50%'
		    y2='92%'
		    stroke='"       & __ColorAxis & "'
		    stroke-width='1'
		  />
		"

		// G) DETAIL ROW – axis + bar + label
		VAR __SVG_Bar_And_Label =
		"
		  <rect
		    x='"        & __X_Bar    & "'
		    y='"        & __BarY     & "'
		    width='"    & __WidthPct & "'
		    height='"   & __BarH     & "'
		    fill='"     & __BarColor & "'
		  />
		  <text
		    x='"        & __X_Label  & "'
		    dx='"       & __DX       & "'
		    y='"        & __LabelY   & "'
		    fill='"     & __BarColor & "'
		    font-size='17'
		    font-family='Calibri, Segoe UI, Arial, sans-serif'
		    text-anchor='" & __Anchor & "'
		  >" & __LabelText & "</text>
		"

		VAR __SVG_Detail =
		        __SVG_Open
		    &   __SVG_Axis
		    &   __SVG_Bar_And_Label
		    &   "</svg>"

		// zero delta on detail row – axis only
		VAR __SVG_Zero =
		        __SVG_Open
		    &   __SVG_Axis
		    &   "</svg>"

		// H) TOTAL ROW – no axis, only centered bold label
		VAR __SVG_Total =
		        __SVG_Open
		    & "
		  <text
		    x='50%'
		    dx='0'
		    y='"        & __LabelY & "'
		    fill='"     & IF ( __Delta >= 0 , __ColorPos , __ColorNeg ) & "'
		    font-size='17'
		    font-weight='bold'
		    font-family='Calibri, Segoe UI, Arial, sans-serif'
		    text-anchor='middle'
		  >" & __LabelText & "</text>
		</svg>
		"

		// I) PICK SVG BODY
		VAR __SVG_Body =
		    SWITCH (
		        TRUE(),
		            NOT __IsDetailRow , __SVG_Total,
		            __Delta = 0       , __SVG_Zero,
		            __SVG_Detail
		    )

		// J) RESULT
		VAR __Result =
		        __SVG_Prefix
		    &   __SVG_Body

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\09. Others
		dataCategory: ImageUrl
		lineageTag: 7ea6421e-46ca-4a58-8a39-0ef8ce297eda

	measure '_Revenue AC & PY | SVG' = ```


		// A) DATA
		VAR __Act = [_Revenue]
		VAR __PY  = [_Revenue PY]

		// detail row vs total
		VAR __IsDetailRow =
		    ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] )

		// B) CONTEXT SCALE – max AC/PY in context + headroom for labels
		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@MaxBase",
		                VAR __A = [_Revenue]
		                VAR __P = [_Revenue PY]
		                RETURN MAX ( __A , __P )
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __MaxBaseRaw    = MAXX ( __BaseTable , [@MaxBase] )
		VAR __MaxBase       = IF ( __MaxBaseRaw = 0 , 1 , __MaxBaseRaw )

		// leave ~30% width for labels (bars max ~70%)
		VAR __ScaleMax      = __MaxBase / 0.7

		VAR __WidthAC       = FORMAT ( DIVIDE ( __Act , __ScaleMax ) , "0%" )
		VAR __WidthPY       = FORMAT ( DIVIDE ( __PY  , __ScaleMax ) , "0%" )

		// C) LAYOUT – canvas (px), positions (%)
		VAR __W = 200
		VAR __H = 25

		// both bars: same height
		VAR __H_Bar   = "36%"

		// PY higher, AC lower
		VAR __Y_PY    = "22%"    // PY top
		VAR __Y_AC    = "36%"    // AC top

		// AC span: 36%..72% → mid ~54%; label slightly below mid
		VAR __Y_Label = "64%"

		// vertical 0-axis
		VAR __X_Axis  = "0%"

		// D) LABEL TEXT
		VAR __LabelText =
		    FORMAT ( __Act , "#,0,.0;#,0,.0;0" )

		// label padding from end of AC bar
		VAR __LabelDx = 10

		// E) COLORS
		VAR __ColorPY        = "#D9E1E8"
		VAR __ColorPYBorder  = "#B2BBCB"
		VAR __ColorAC        = "#47627F"
		VAR __ColorLabel     = "#47627F"
		VAR __ColorAxis      = "#47627F"//"#C0C0C0"

		// F) COMMON SVG PARTS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"

		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Act , "00000000000" ) & "'
		>
		"

		// vertical 0-axis
		VAR __SVG_YAxis =
		"
		  <line
		    x1='"           & __X_Axis & "'
		    y1='8%'
		    x2='"           & __X_Axis & "'
		    y2='92%'
		    stroke='"       & __ColorAxis & "'
		    stroke-width='1.5'
		  />
		"

		// G) DETAIL ROW – PY + AC + label
		VAR __SVG_PY_Rect =
		"
		  <rect
		    x='0%'
		    y='"        & __Y_PY & "'
		    width='"    & __WidthPY & "'
		    height='"   & __H_Bar & "'
		    fill='"     & __ColorPY & "'
		    stroke='"   & __ColorPYBorder & "'
		    stroke-width='1'
		  />
		"

		VAR __SVG_AC_Rect =
		"
		  <rect
		    x='0%'
		    y='"        & __Y_AC & "'
		    width='"    & __WidthAC & "'
		    height='"   & __H_Bar & "'
		    fill='"     & __ColorAC & "'
		    stroke='"   & __ColorAC & "'
		    stroke-width='1'
		  />
		"

		VAR __SVG_Label_Detail =
		"
		  <text
		    x='"                   & __WidthAC & "'
		    dx='"                  & __LabelDx & "'
		    y='"                   & __Y_Label & "'
		    fill='"                & __ColorLabel & "'
		    font-size='17'
		    font-family='Calibri, Segoe UI, Arial, sans-serif'
		    text-anchor='start'
		  >" & __LabelText & "</text>
		"

		VAR __SVG_Detail =
		        __SVG_Open
		    &   __SVG_PY_Rect
		    &   __SVG_AC_Rect
		    &   __SVG_YAxis
		    &   __SVG_Label_Detail
		    &   "</svg>"

		// H) TOTAL ROW – label only, bold, fully left aligned
		VAR __SVG_Label_Total =
		"
		  <text
		    x='"                   & __X_Axis & "'
		    dx='0'
		    y='"                   & __Y_Label & "'
		    fill='"                & __ColorLabel & "'
		    font-size='17'
		    font-weight='bold'
		    font-family='Calibri, Segoe UI, Arial, sans-serif'
		    text-anchor='start'
		  >" & __LabelText & "</text>
		"

		VAR __SVG_Total =
		        __SVG_Open
		    &   __SVG_Label_Total
		    &   "</svg>"

		// I) PICK VARIANT
		VAR __SVG_Body =
		    SWITCH (
		        TRUE(),
		            NOT __IsDetailRow , __SVG_Total,
		            __SVG_Detail
		    )

		// J) RESULT
		VAR __Result =
		    IF (
		        ISBLANK ( __Act ) && ISBLANK ( __PY ),
		        BLANK(),
		        __SVG_Prefix & __SVG_Body
		    )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\09. Others
		dataCategory: ImageUrl
		lineageTag: b007a4e2-a69b-4fc5-8d3d-f8ecedfd0478

	measure '_Revenue Ranking Basic | Customer | Alt.' = ```


		VAR __CurrentCustomer   =   SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( DIM_Customers ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		VAR __BaseTable_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",  
		                RANK (
		                    DENSE, 
		                    __BaseTable,
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		                )
		    )

		VAR __Ranking =
		     MAXX ( FILTER ( __BaseTable_With_Ranking, DIM_Customers[Customer_Name] = __CurrentCustomer ), [@Rank] ) 
		    
		VAR __Result = __Ranking 

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue
