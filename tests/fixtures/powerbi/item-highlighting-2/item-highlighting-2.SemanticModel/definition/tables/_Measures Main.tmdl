	measure '_Revenue Dynamic Rank Top Value Breakdown' = ```

		VAR __Category =    SELECTEDVALUE ( 'TBL Top & Other Simple'[Name Display] )
		VAR __IsTop =       __Category = "Top"
		VAR __IsOther =     __Category = "Others"
		VAR __IsCustomer =  ISINSCOPE ( DIM_Customers[Customer_Name] )

		VAR __TableToRank =
		    FILTER (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		        NOT ISBLANK ( [_Revenue] )
		    )

		VAR __Rank =
		    RANK (
		        DENSE,
		        __TableToRank,
		        ORDERBY ( [_Revenue], DESC BLANKS LAST ),
		        LAST
		    )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __IsCustomer,   __Rank,
		            __IsTop,        1,
		            __IsOther,      2,
		            BLANK()
		        )

		RETURN __Result
		```
		formatString: 0
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\01. Core - Alternative
		lineageTag: 1ffaa3d0-d021-424a-9d19-07ccc69f7f05

	measure '_Revenue Dynamic Rank Top Filter Breakdown' = ```

		VAR __Category =    SELECTEDVALUE ( 'TBL Top & Other Simple'[Name] )
		VAR __IsCustomer =  ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __TOPn_Bin =    SELECTEDVALUE ( 'NR Values 1-20 | Ranking 01'[Ranking Dynamic Parameter], 10 )
		VAR __Ranking =     [_Revenue Dynamic Rank Top Value Breakdown]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Category = "Top"    && __Ranking <= __TOPn_Bin,  1,
		            __Category = "Others" && __Ranking >  __TOPn_Bin,  1,
		            0
		    )

		RETURN __Result
		```
		formatString: 0
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\01. Core - Alternative
		lineageTag: e9ff888f-21d8-48c7-80cf-fc704bac9d11

