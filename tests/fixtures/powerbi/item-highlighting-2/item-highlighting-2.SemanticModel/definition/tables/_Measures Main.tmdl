	measure '_Revenue Dynamic Top Value | Card' = ```


		VAR __TopBin  = [NR Values 1-20 | Ranking 01 | Value] // Can be Dynamic of Static 

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
