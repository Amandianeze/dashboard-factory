	measure '_Gross Profit Value LTM | Dynamic Switch' = ```


		VAR __TopBin            = [NR Values 1-20 | Ranking 01 | Value]
		VAR __AtCustomerLevel   = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )
		VAR __CurrentCustomer   = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __IsOtherRow        = __CurrentCustomer = "Others"
		VAR __Other_Mode        = SELECTEDVALUE ( 'TBL Type of Other Bin Aggregation'[ID] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue],
		                "@GrossProfit_LTM", [_Gross Profit LTM Based on Date | Datesinperiod]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers    = FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers   = FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		VAR __TopNRevenue_Total = SUMX ( __TopN_Customers ,     [@GrossProfit_LTM] )
		VAR __AllRevenue_Total  = SUMX ( __Table_With_Ranking , [@GrossProfit_LTM] )

		VAR __OthersRevenue_Med = MEDIANX ( __Other_Customers, [@Revenue])
		VAR __OthersRevenue_Sum = __AllRevenue_Total - __TopNRevenue_Total

		VAR __TopNRevenue_Per_Row =
		    SUMX (
		        FILTER (
		            __TopN_Customers,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@GrossProfit_LTM]
		    )

		VAR __Revenue_Per_Row =
		    SUMX (
		        FILTER (
		            __BaseTable,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@GrossProfit_LTM]
		    )

		VAR __Top_Items_Switch =
		    IF ( 
		        __Other_Mode = 4, __Revenue_Per_Row,                        // If all items visible
		        __TopNRevenue_Per_Row                                       // Otherwise (take into account the TopN prefiltered table)
		    )

		 VAR __Others_Items_Switch = 
		    SWITCH (
		        __Other_Mode,
		            1, COALESCE ( __OthersRevenue_Sum, 0 ),                 // if others as sum (retrieving 0 is optional)
		            2, COALESCE ( __OthersRevenue_Med, 0),                  // if others as median (retrieving 0 is optional)
		            BLANK()                                                 // of other modes it should be blank
		    )   

		 VAR __Total_Items_Switch =                                         // total row
		    SWITCH (
		        __Other_Mode,
		            1, __AllRevenue_Total,                                  // Show total value
		            2, BLANK(),                                             // if others are show as median - do not show
		            3, __TopNRevenue_Total,                                 // if only TopN items are visible - show total for these items
		            4, __AllRevenue_Total                                   // if all items are visible - show grand total (all items)
		    )

		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            NOT __AtCustomerLevel,  __Total_Items_Switch,           // outcome for total row
		            __IsOtherRow  ,         __Others_Items_Switch ,         // outcome for others row
		                                    __Top_Items_Switch              // else (for non-total row and not for Others row)
		    )

		RETURN __Result


		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\03. Others as Sum or Median (Switch)
		lineageTag: f77ba3a1-c5ff-4c56-bf83-78550169b3c4

	measure '_Gross Margin Value LTM | Dynamic Switch' = ```


		VAR __TopBin            = [NR Values 1-20 | Ranking 01 | Value]
		VAR __AtCustomerLevel   = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )
		VAR __CurrentCustomer   = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __IsOtherRow        = __CurrentCustomer = "Others"
		VAR __Other_Mode        = SELECTEDVALUE ( 'TBL Type of Other Bin Aggregation'[ID] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",         [_Revenue],
		                "@Revenues_LTM",    [_Revenue LTM Based on Date | Datesinperiod],
		                "@GrossProfit_LTM", [_Gross Profit LTM Based on Date | Datesinperiod],
		                "@GrossMargin_LTM", [_Gross Margin % LTM Based on Date | Datesinperiod]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers    =       FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers   =       FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		VAR __TopNRevenue_Total =       SUMX ( __TopN_Customers ,     [@Revenues_LTM] )
		VAR __OthersRevenue_Total =     SUMX ( __Other_Customers ,    [@Revenues_LTM] )
		VAR __AllRevenue_Total  =       SUMX ( __Table_With_Ranking , [@Revenues_LTM] )

		VAR __TopNGrossProfit_Total =   SUMX ( __TopN_Customers ,     [@GrossProfit_LTM] )
		VAR __OthersGrossProfit_Total = SUMX ( __Other_Customers ,    [@GrossProfit_LTM] )
		VAR __AllGrossProfit_Total  =   SUMX ( __Table_With_Ranking , [@GrossProfit_LTM] )

		VAR __TopNMargin_Total =        DIVIDE ( __TopNGrossProfit_Total, __TopNRevenue_Total )
		VAR __OthersMargin_Total =      DIVIDE ( __OthersGrossProfit_Total, __OthersRevenue_Total )
		VAR __AllMargin_Total =         DIVIDE ( __AllGrossProfit_Total, __AllRevenue_Total )

		VAR __OthersGrossMargin_Med =   MEDIANX ( __Other_Customers, [@GrossMargin_LTM])

		VAR __TopNGrossMargin_Per_Row =
		    MAXX (
		        FILTER (
		            __TopN_Customers,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@GrossMargin_LTM]
		    )

		VAR __GrossMargin_Per_Row =
		    MAXX (
		        FILTER (
		            __BaseTable,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@GrossMargin_LTM]
		    )

		VAR __Top_Items_Switch =
		    IF ( 
		        __Other_Mode = 4, __GrossMargin_Per_Row,                        // If all items visible
		        __TopNGrossMargin_Per_Row                                       // Otherwise (take into account the TopN prefiltered table)
		    )

		 VAR __Others_Items_Switch = 
		    SWITCH (
		        __Other_Mode,
		            1, COALESCE ( __OthersMargin_Total, 0 ),                // if others as sum (retrieving 0 is optional)
		            2, COALESCE ( __OthersGrossMargin_Med, 0),              // if others as median (retrieving 0 is optional)
		            BLANK()                                                 // of other modes it should be blank
		    )   

		 VAR __Total_Items_Switch =                                         // total row
		    SWITCH (
		        __Other_Mode,
		            1, __AllMargin_Total,                                   // Show total value
		            2, BLANK(),                                             // if others are show as median - do not show
		            3, __TopNMargin_Total,                                  // if only TopN items are visible - show total for these items
		            4, __AllMargin_Total                                    // if all items are visible - show grand total (all items)
		    )

		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            NOT __AtCustomerLevel,  __Total_Items_Switch,           // outcome for total row
		            __IsOtherRow  ,         __Others_Items_Switch ,         // outcome for others row
		                                    __Top_Items_Switch              // else (for non-total row and not for Others row)
		    )

		RETURN __Result


		```
