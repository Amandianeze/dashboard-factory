	measure '_Revenue Value Date Context' = ```

		/***INPUTS***/
		VAR __TopBin           = [NR Values 1-20 | Ranking 01 | Value]
		VAR __CurrentCustomer  = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __AtCustomerLevel  = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",             [_Revenue],
		                "@Revenue_All_Dates" ,  CALCULATE ( [_Revenue] , ALLSELECTED ( 'Dim_Calendar' ) )

		        ),
		        NOT ISBLANK ( [@Revenue_All_Dates] )
		    )

		/***TOP-N TABLE ***/
		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue_All_Dates], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers =  FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers = FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		/***REVENUE CALCULATION***/
		VAR __TopNRevenue   =  SUMX ( __TopN_Customers , [@Revenue] )
		VAR __AllRevenue    =  SUMX ( __BaseTable , [@Revenue] )
		VAR __OthersRevenue =  ROUND ( __AllRevenue - __TopNRevenue, 0 )

		/***CONDITIONS & CHECKS***/
		VAR __IsInTop =    CONTAINS (  __TopN_Customers,  DIM_Customers_Supplemental[Customer], __CurrentCustomer )
		VAR __HasOthers =  COUNTROWS ( __Other_Customers ) > 0
		VAR __IsOtherRow = __CurrentCustomer = "Others"

		VAR __TopNRevenue_Per_Row =
		    MAXX (
		        FILTER (
		            __TopN_Customers,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@Revenue]
		    )

		/***RESULT***/
		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            NOT __AtCustomerLevel,          __AllRevenue ,
		            __IsOtherRow  && __HasOthers ,  __OthersRevenue ,
		            __IsInTop,                      __TopNRevenue_Per_Row ,
		            BLANK ()
		    )

		RETURN  __Result

		        
		            



		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\04. Top in the Date Context | Global TopN
		lineageTag: 1d7b5e28-8aba-4c3b-94b2-883738120677

	measure '_Revenue Rank Number Date Context' = ```

		VAR __IsOtherSelected =      SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] ) = "Others"
		VAR __CurrentCustomer =      SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __Distincount =          DISTINCTCOUNT ( DIM_Customers_Supplemental[Customer] )
		VAR __Is_at_Customer_Level = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )
		VAR __TopBin =               [NR Values 1-20 | Ranking 01 | Value]
		VAR __Main_Metric =          [_Revenue]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",             [_Revenue],
		                "@Revenue_All_Dates" ,  CALCULATE ( [_Revenue] , ALLSELECTED ( 'Dim_Calendar' ) )

		        ),
		        NOT ISBLANK ( [@Revenue_All_Dates] )
		    )

		/***TOP-N TABLE ***/
		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue_All_Dates], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers =  FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers = FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		/***REVENUE CALCULATION***/
		VAR __TopNRevenue   =  SUMX ( __TopN_Customers , [@Revenue] )
		VAR __AllRevenue    =  SUMX ( __BaseTable , [@Revenue] )
		VAR __OthersRevenue =  ROUND ( __AllRevenue - __TopNRevenue, 0 )
		VAR __AllRevenue_Invert = __AllRevenue * -1

		/***CONDITIONS & CHECKS***/
		VAR __IsInTop =                 COUNTROWS ( __TopN_Customers ) > 0
		VAR __HasOthers =               COUNTROWS ( __Other_Customers ) > 0
		VAR __Count_of_Topn_Customers = COUNTROWS ( __TopN_Customers )
		VAR __IsOtherRow = __CurrentCustomer = "Others"


		VAR __Ranking =
		    MAXX (
		        FILTER (
		            __TopN_Customers ,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@Rank] 
		    )

		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __AllRevenue ), BLANK(),
		            NOT ( __Is_at_Customer_Level ), __AllRevenue_Invert,
		            __IsOtherRow && __HasOthers, __Count_of_Topn_Customers + 1,
		            __IsInTop, __Ranking, 
		            BLANK()
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\04. Top in the Date Context | Global TopN
		lineageTag: d4141071-edd4-4222-ae6e-6a63a179063a

	measure '_Revenue Value Date Context Timeseries' = ```

		/***INPUTS***/
		VAR __TopBin           = [NR Values 1-20 | Ranking 01 | Value]
		VAR __Top_Other_Split  = SELECTEDVALUE ( 'TBL Top & Other Simple'[Name] )

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",             [_Revenue],
		                "@Revenue_All_Dates" ,  CALCULATE ( [_Revenue] , ALLSELECTED ( 'Dim_Calendar' ) )

		        ),
		        NOT ISBLANK ( [@Revenue_All_Dates] )
		    )

		/***TOP-N TABLE ***/
		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue_All_Dates], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers = FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )

		/***REVENUE CALCULATION***/
		VAR __TopNRevenue   =  SUMX ( __TopN_Customers , [@Revenue] )
		VAR __AllRevenue    =  SUMX ( __BaseTable , [@Revenue] )
		VAR __OthersRevenue = __AllRevenue - __TopNRevenue

		/***RESULT***/
		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            __Top_Other_Split = "Top",     __TopNRevenue,
		            __Top_Other_Split = "Others",  __OthersRevenue
		    )

		RETURN __Result

