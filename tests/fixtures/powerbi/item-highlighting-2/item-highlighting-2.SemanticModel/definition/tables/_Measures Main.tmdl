	measure '_Revenue Max value per Customer *1.25' = ```


		VAR __Max_Value = 
		    CALCULATE(
		        MAXX(
		            FILTER ( 
		                CROSSJOIN(
		                    DISTINCT( 'Dim_Calendar'[Start of Month]), 
		                    DISTINCT( DIM_Customers[Customer_Name] )
		                ),
		            NOT ( ISBLANK ( [_Revenue] ) )
		            ),
		            [_Revenue]
		        ),
		        ALLSELECTED()
		    )

		VAR __Result = 
		    SWITCH(
		        TRUE(),
		        ISBLANK( __Max_Value ), BLANK(),
		        __Max_Value * 1.25
		    )

		RETURN __Result
		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\02. Max
		lineageTag: 27d551fc-ab9b-45a0-8e3a-d6b9f8d2f5a6

	measure '_Revenue Max value *1.25 First Point | Month & Customer' = ```


		VAR __BaseTable =
		    CALCULATETABLE (
		        FILTER ( 
		            SUMMARIZECOLUMNS ( 
		                'Dim_Calendar'[Start of Month],
		                DIM_Customers[Customer_Name],
		                "@Revenue", [_Revenue]
		            ),
		            NOT ISBLANK ( [@Revenue] )
		        ),
		        ALLSELECTED ( 'Dim_Calendar' ),
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] )
		    )

		VAR __Date_Point         =   SELECTEDVALUE ( 'Dim_Calendar'[Start of Month] )
		VAR __Customer           =   SELECTEDVALUE ( DIM_Customers[Customer_Name] )

		VAR __First_Data_Point   =   MINX ( __BaseTable, 'Dim_Calendar'[Start of Month] )
		VAR __Max_Value_Global   =   MAXX ( __BaseTable, [@Revenue] )
		VAR __Max_Value_Customer =   MAXX ( FILTER ( __BaseTable, DIM_Customers[Customer_Name] = __Customer ), [@Revenue] )

		VAR __Result = 
		    IF (
		        NOT ISBLANK ( __Max_Value_Global ) && NOT ISBLANK ( __Max_Value_Customer ) &&  __Date_Point = __First_Data_Point,
		        __Max_Value_Global * 1.25
		    )

		RETURN __Result

		```
		displayFolder: Markers & Data Points & Factors\03. Factors\01. Max
		lineageTag: b3d54bea-803f-438e-b253-5d8f66692bb2

	measure '_Revenue Max value *1.25 Last Point | Month & Customer' = ```


		VAR __BaseTable =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[Start of Month],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)

		VAR __Last_NonBlank_Data_Point =   
		    MAXX ( __BaseTable, 'Dim_Calendar'[Start of Month] )

		VAR __Max_Value =                   
		    MAXX ( __BaseTable, [@Revenue] )

		VAR __Date_Point = 
		    SELECTEDVALUE ( 'Dim_Calendar'[Start of Month] )

		VAR __Result = 
		    SWITCH(
		        TRUE(),
		            ISBLANK ( __Max_Value ) ||  __Date_Point <> __Last_NonBlank_Data_Point, BLANK(),
		            __Max_Value * 1.25
		    )

		RETURN __Result


