	measure '_Customer Count DIM Suppl' = ```


		// CALCULATE ( 
		//     [_Customer Count],
		//     TREATAS ( 
		//         VALUES ( 'DIM_Customers_Supplemental alt'[Customer_ID]),
		//         DIM_Customers[Customer_ID]
		//     ),
		//     FILTER (
		//         ALLSELECTED ( 'DIM_Customers' ),
		//         NOT ISBLANK ( [_Revenue] )
		//     )
		// )

		VAR __Table =
		    ADDCOLUMNS (
		        CALCULATETABLE (                                 
		            VALUES ( DIM_Customers[Customer_ID] ),
		            TREATAS (
		                VALUES ( 'DIM_Customers_Supplemental alt'[Customer_ID] ),
		                DIM_Customers[Customer_ID]
		            )
		        ),
		        "@Rev AC", [_Revenue]                            
		    )

		VAR __Result =
		    COUNTROWS ( FILTER ( __Table, NOT ISBLANK ( [@Rev AC] ) ) )

		RETURN __Result
		```
		displayFolder: 03. Metrics Based on Customer Suppl DIM
		lineageTag: 1ed20308-571f-448e-ae40-97c2e7a03298

