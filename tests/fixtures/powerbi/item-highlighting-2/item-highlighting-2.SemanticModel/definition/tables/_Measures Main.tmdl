	measure '_General LTM Period Tag' = ```

		VAR __SelectedMonth =
		    CALCULATE (
		        MAX ( 'Dim_Calendar'[CurrMonthOffset] ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __StartMonth = __SelectedMonth - 11

		VAR __ThisRowMonth =
		    MAX ( 'Dim Calendar Suppl'[CurrMonthOffset] )

		VAR __Result =
		    IF (
		        __ThisRowMonth >= __StartMonth &&
		        __ThisRowMonth <= __SelectedMonth,
		        1
		    )

		RETURN __Result
		```
		formatString: 0✔;-0;
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\01.AC
		lineageTag: 1ec4effb-16b1-49dc-851c-7ba78d95d841

	measure '_Revenue Last 12 Months Based on Date | Treatas' = ```

		VAR EndDate   = MAX ('Dim_Calendar'[Date] )       
		VAR StartDate = EOMONTH ( EndDate , -12 ) + 1              

		VAR TreatedDates =
		    SELECTCOLUMNS (                                  
		        FILTER (
		            'Dim Calendar Suppl',
		            'Dim Calendar Suppl'[Date] >= StartDate && 
		            'Dim Calendar Suppl'[Date] <= EndDate
		        ),
		        "MatchDate", 'Dim Calendar Suppl'[Date]
		    )

		VAR __Result = 
		    CALCULATE (
		        [_Revenue],                                        
		        TREATAS ( TreatedDates , 'Dim_Calendar'[Date] )        
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\01.AC
		lineageTag: 50680dc8-13e3-4d07-a783-6680674d651c

