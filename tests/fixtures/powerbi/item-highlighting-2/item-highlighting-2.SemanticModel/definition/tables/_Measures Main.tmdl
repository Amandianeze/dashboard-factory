	measure '_Revenue Dynamic Rank Filter Alt. | Structure' = ```


		VAR __Category              =  SELECTEDVALUE ( 'TBL Top & Other Simple'[Name Display] )
		VAR __IsAt_Customer_Level   =  ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __CurrentCustomer       =  SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __IsTop_Bin             =  __Category = "Top"
		VAR __IsOther_Bin           =  __Category = "Others"
		VAR __TOPn_Bin              =  [NR Values 1-20 | Ranking 01 | Value]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		//***RANKING***//
		VAR __BaseTable_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",  
		                RANK (
		                    DENSE, 
		                    __BaseTable,
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		                )
		    )

		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    FILTER ( __BaseTable_With_Ranking, [@Rank] <= __TOPn_Bin )

		VAR __CustomerInTopN  = 
		    CONTAINS ( __TopN_Customers, DIM_Customers[Customer_Name] , __CurrentCustomer )

		VAR __Has_Others  = 
		    COUNTROWS ( EXCEPT ( __BaseTable_With_Ranking , __TopN_Customers ) ) > 0

		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __CustomerInTopN && __IsTop_Bin , 1,
		            NOT ( __CustomerInTopN  ) && __Has_Others && __IsOther_Bin, 1,
		            BLANK()
		    )

		RETURN __Result



		```
