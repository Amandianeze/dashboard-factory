	measure '_Revenue PY KPI Card Alt. | Perc of realization' = ```


		VAR __Act        = [_Revenue]
		VAR __Tgt        = [_Revenue PY]
		VAR __Pct        = DIVIDE ( __Act , __Tgt ) -- realization %
		VAR __Metric_abs = __Act - __Tgt 

		VAR __Format_Pct =  "0%;-0%;0%"
		VAR __Format_Abs =  "+#,0,K;-#,0,K;0" // Fixed as Thousands without decimals

		VAR __Local_Format = "en-US"

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )
		VAR __Formatted_Pct     = FORMAT ( __Pct,        __Format_Pct, __Local_Format )

		VAR __Icon_Up       =  ""--"▲ "
		VAR __Icon_Down     =  ""--"▼ "
		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "
		VAR __Icon          =  __Space & SWITCH ( TRUE (), __Metric_abs > 0 , __Icon_Up,  __Icon_Down )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                         
		        ISBLANK ( __Format_Pct ), __Space & __Formatted_Abs & __Icon,         
		        __Space & __Formatted_Pct & __Divider &__Formatted_Abs & __Icon     
		    )

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: f723e9ee-fa4b-4a73-be4d-2baa7ea9c8bb

	measure '_Revenue Progress Bar vs PY | BL | SVG' = ```


		// A) DATA PER ROW
		VAR __Act     = [_Revenue]
		VAR __Tgt     = [_Revenue PY]
		VAR __VarAbs  = __Act - __Tgt

		// B) CONTEXT SCALE
		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            FILTER (
		                VALUES ( DIM_Customers[Business_Line] ),
		                NOT ISBLANK ( [_Revenue] ) || NOT ISBLANK ( [_Revenue PY] )
		            ),
		            "@Act", [_Revenue] ,
		            "@Tar", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers )
		    )
		        
		VAR __MaxRaw =
		    MAXX (
		        __BaseTable,
		        COALESCE ( MAX ( [@Act], [@Tar] ), [@Act], [@Tar] )
		    )

		VAR __MinRaw =
		    MIN (
		        MINX (
		            __BaseTable,
		            COALESCE ( MIN ( [@Act], [@Tar] ), [@Act], [@Tar] )
		        ),
		        0
		    )

		VAR __Span   = __MaxRaw - __MinRaw

		// C) LAYOUT & CO‑ORDINATES
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __Act - __MinRaw , __Span , 0 ) * __TrackW
		VAR __X_Tar    = __BarX + DIVIDE ( __Tgt - __MinRaw , __Span , 0 ) * __TrackW
		VAR __MainW    = MAX ( __X_Act - __BarX , 0 )

		VAR __DiffStart = MIN ( __X_Act , __X_Tar )
		VAR __DiffW     = ABS ( __X_Act - __X_Tar )
		VAR __DiffH     = __BarH * 0.6
		VAR __DiffY     = __BarY

		// D) COLORS
		VAR __ColorBg        = "#F2F2F2"   -- track background
		VAR __ColorBgBorder  = "#D9D9D9"   -- track border
		VAR __ColorActual    = "#5A6A81"   -- actual bar // "#B2CEFB"   --"#A9ADB1"   

		VAR __ColorVarPos    = "#63D17F"   -- positive Variance // "#2461C4" --Blue 
		VAR __ColorVarNeg    = "#DD3939"   -- negative variance // "#B34E4E"   
		VAR __ColorDiff      = IF ( __VarAbs >= 0 , __ColorVarPos , __ColorVarNeg )

		// E) INDIVIDUAL SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"
		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Act , "00000000000" ) & "'
		>
		"

		VAR __SVG_Track =
		"
		  <!-- track -->
		  <rect
		    x='"                & __BarX        & "'
		    y='"                & __BarY        & "'
		    width='"            & __TrackW      & "'
		    height='"           & __BarH        & "'
		    fill='"             & __ColorBg       & "'    
		    stroke='"           & __ColorBgBorder & "'  
		    fill-opacity=       '"   & 0 & "'
		    stroke-opacity=     '"   & 0 & "'       
		    stroke-width=       '1'
		  />
		"

		VAR __SVG_Actual =
		"
		  <!-- actual -->
		  <rect
		    x='"                & __BarX       & "'
		    y='"                & __BarY       & "'
		    width='"            & __MainW      & "'
		    height='"           & __BarH       & "'
		    fill='"             & __ColorActual  & "'
		  />
		"

		VAR __SVG_Variance =
		    IF ( __DiffW > 0 ,
		"
		  <!-- variance -->
		  <rect
		    x='"                & __DiffStart  & "'
		    y='"                & __DiffY      & "'
		    width='"            & __DiffW      & "'
		    height='"           & __DiffH      & "'
		    fill='"             & __ColorDiff    & "'
		  />
		", "" )

		VAR __SVG_Target =
		"
		  <!-- target -->
		  <line
		    x1='"            & __X_Tar                 & "'
		    y1='"            & ( __BarY - 4 )          & "'
		    x2='"            & __X_Tar                 & "'
		    y2='"            & ( __BarY + __BarH + 4 ) & "'
		    stroke='#4C4C4C'
		    stroke-width='1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Close = "</svg>"

		// F) CONCATENATION
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Variance
		    &   __SVG_Target
		    &   __SVG_Close


		//G) RESULT
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\02. Context: Business Line
		dataCategory: ImageUrl
		lineageTag: 6ab8e027-7d20-4343-ae31-0f442963ec93

	measure '_Revenue Progress Bar vs PY | BL | SVG | With Total' = ```


		// A) DATA PER ROW
		VAR __Act     = [_Revenue]
		VAR __Tgt     = [_Revenue PY]
		VAR __VarAbs  = __Act - __Tgt

		// B) CONTEXT SCALE
		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            FILTER (
		                VALUES ( DIM_Customers[Business_Line] ),
		                NOT ISBLANK ( [_Revenue] ) || NOT ISBLANK ( [_Revenue PY] )
		            ),
		            "@Act", [_Revenue] ,
		            "@Tar", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers )
		    )


		/*Segment Level)*/
		VAR __MaxRaw_Row_Level =
		    MAXX (
		        __BaseTable,
		        COALESCE ( MAX ( [@Act], [@Tar] ), [@Act], [@Tar] )
		    )

		VAR __MinRaw_Row_Level =
		    MIN (
		        MINX (
		            __BaseTable,
		            COALESCE ( MIN ( [@Act], [@Tar] ), [@Act], [@Tar] )
		        ),
		        0
		    )

		/*Total Level*/
		VAR __MinRaw_Total  = MIN ( 0 , COALESCE ( MIN ( __Act , __Tgt ), __Act, __Tgt ) )
		VAR __MaxRaw_Total  = COALESCE ( MAX ( __Act , __Tgt ), __Act, __Tgt )

		/*Switched Level*/
		VAR __IsTotal = NOT ISINSCOPE ( DIM_Customers[Business_Line] )
		VAR __MinRaw  = IF ( __IsTotal , __MinRaw_Total , __MinRaw_Row_Level )
		VAR __MaxRaw  = IF ( __IsTotal , __MaxRaw_Total , __MaxRaw_Row_Level )
		VAR __Span    = __MaxRaw - __MinRaw

		// C) LAYOUT & CO‑ORDINATES
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __Act - __MinRaw , __Span , 0 ) * __TrackW
		VAR __X_Tar    = __BarX + DIVIDE ( __Tgt - __MinRaw , __Span , 0 ) * __TrackW
		VAR __MainW    = MAX ( __X_Act - __BarX , 0 )

		VAR __DiffStart = MIN ( __X_Act , __X_Tar )
		VAR __DiffW     = ABS ( __X_Act - __X_Tar )
		VAR __DiffH     = __BarH * 0.6
		VAR __DiffY     = __BarY

		// D) COLORS
		VAR __ColorBg        = "#F2F2F2"   -- track background
		VAR __ColorBgBorder  = "#D9D9D9"   -- track border
		VAR __ColorActual    = "#5A6A81"   -- "#B2CEFB"   --"#A9ADB1"   -- actual bar

		VAR __ColorVarPos    = "#62BDC0"   -- "#2461C4"   -- positive Variance: Blue || Change to: "#308C9A" to show green
		VAR __ColorVarNeg    = "#BF6A6A"   -- "#B34E4E"   -- negative variance
		VAR __ColorDiff      = IF ( __VarAbs >= 0 , __ColorVarPos , __ColorVarNeg )

		// E) INDIVIDUAL SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"
		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Act , "00000000000" ) & "'
		>
		"

		VAR __SVG_Track =
		"
		  <!-- track -->
		  <rect
		    x='"                & __BarX        & "'
		    y='"                & __BarY        & "'
		    width='"            & __TrackW      & "'
		    height='"           & __BarH        & "'
		    fill='"             & __ColorBg       & "'    
		    stroke='"           & __ColorBgBorder & "'  
		    fill-opacity=       '"   & 0 & "'
		    stroke-opacity=     '"   & 0 & "'       
		    stroke-width=       '1'
		  />
		"

		VAR __SVG_Actual =
		"
		  <!-- actual -->
		  <rect
		    x='"                & __BarX       & "'
		    y='"                & __BarY       & "'
		    width='"            & __MainW      & "'
		    height='"           & __BarH       & "'
		    fill='"             & __ColorActual  & "'
		  />
		"

		VAR __SVG_Variance =
		    IF ( __DiffW > 0 ,
		"
		  <!-- variance -->
		  <rect
		    x='"                & __DiffStart  & "'
		    y='"                & __DiffY      & "'
		    width='"            & __DiffW      & "'
		    height='"           & __DiffH      & "'
		    fill='"             & __ColorDiff    & "'
		  />
		", "" )

		VAR __SVG_Target =
		"
		  <!-- target -->
		  <line
		    x1='"            & __X_Tar                 & "'
		    y1='"            & ( __BarY - 4 )          & "'
		    x2='"            & __X_Tar                 & "'
		    y2='"            & ( __BarY + __BarH + 4 ) & "'
		    stroke='#4C4C4C'
		    stroke-width='1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Close = "</svg>"

		// F) CONCATENATION
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Variance
		    &   __SVG_Target
		    &   __SVG_Close


		// G) RESULT
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ),     BLANK(),
		            // NOT ISINSCOPE ( [DIM_Customers[Business_Line]] ),   BLANK(),
		        __ResultSVG
		    )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\02. Context: Business Line
		dataCategory: ImageUrl
		lineageTag: abba45ab-9ad8-4700-b939-9d0f14cd1028

	measure '_Revenue PY KPI Card Alt. | Perc of realization Alt.' = ```


		VAR __Act        = [_Revenue]
		VAR __Tgt        = [_Revenue PY]
		VAR __Pct        = DIVIDE ( __Act , __Tgt ) -- realization %

		VAR __Format_Pct =      "0%;-0%;0%"
		VAR __Formatted_Pct =   FORMAT ( __Pct, __Format_Pct )
		VAR __Space  =          " "

		VAR __Result =
		    SWITCH (
		        TRUE(),                                    
		        ISBLANK ( __Format_Pct ), "n/a",         
		        __Space & __Formatted_Pct & __Space    
		    )

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: 1ce15fe6-5f84-407b-bef4-923bd69cd705

	measure '_Revenue PY KPI Card | Only abs' = ```


		VAR __Metric_abs     = [_Revenue Variance abs. PY]
		VAR __Format_Abs     =  "+#,0,K;-#,0,K;0" // Fixed as Thousands without decimals

		VAR __Local_Format   = "en-US"
		VAR __Formatted_Abs  = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )

		VAR __Icon_Up       =  "▲ "
		VAR __Icon_Down     =  "▼ "
		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "
		VAR __Icon          =  __Space & SWITCH ( TRUE (), __Metric_abs > 0 , __Icon_Up,  __Icon_Down )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                         
		        __Divider & __Formatted_Abs & __Icon         
		    )

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: 82f1b7d6-0624-4d57-9693-e276928edc26

	measure '_Icon Image Flag | Grayscale | SVG' = ```


		VAR __UrlRaw =          SELECTEDVALUE ( DIM_Geo[Image URL (round) Base64] )
		VAR __Inscope_Check =   ISINSCOPE ( DIM_Geo[Country name - adjusted] )
		VAR __Metric =          [_Revenue]

		VAR __Show =
		    __Inscope_Check
		        && NOT ISBLANK ( __Metric )
		        && NOT ISBLANK ( __UrlRaw )

		/* geometry */
		VAR __W = 25
		VAR __H = 25

		/* grayscale: 0 = full grayscale, 1 = color */
		VAR __Grey = 0

		/* SVG blocks */
		VAR __SvgPrefix = "data:image/svg+xml;utf8,"
		VAR __SvgOpen =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  xmlns:xlink='http://www.w3.org/1999/xlink'
		  width='"  & __W & "'
		  height='" & __H & "'
		  viewBox='0 0 " & __W & " " & __H & "'
		>"
		VAR __SvgDefs =
		"
		  <defs>
		    <filter id='grayscale'>
		      <feColorMatrix type='saturate' values='" & __Grey & "'/>
		    </filter>
		  </defs>
		"
		VAR __SvgImage =
		"
		  <image
		    x='0' y='0'
		    width='"  & __W & "'
		    height='" & __H & "'
		    href='" & __UrlRaw & "'
		    xlink:href='" & __UrlRaw & "'
		    filter='url(%23grayscale)'
		  />
		"
		VAR __SvgClose = "</svg>"

		VAR __Result =
		    IF (
		        __Show,
		        __SvgPrefix & __SvgOpen & __SvgDefs & __SvgImage & __SvgClose
		    )

		RETURN __Result

