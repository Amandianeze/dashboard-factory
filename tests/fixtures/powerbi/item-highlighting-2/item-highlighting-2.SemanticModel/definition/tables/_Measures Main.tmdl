	measure '_Revenue Max Value Factor Last 13 Months' = ```

		VAR __Value = 
		    CALCULATE ( 
		        MAXX (
		            VALUES ( 'Dim Calendar Suppl'[CurrMonthOffset] ),
		            [_Revenue L13M Based on Offset]
		        ),
