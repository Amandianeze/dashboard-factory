	measure '_Revenue Max Value Last Point Label' = ```


		VAR __Value =
		    CALCULATE (
		        COALESCE ( [_Revenue], 0 ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Value_All =
		    CALCULATE (
		        [_Revenue],
		        ALLSELECTED ( 'Dim_Calendar' ),
		        ALLSELECTED (
		            DIM_Customers[Customer_Name],
		            DIM_Customers[Sort ID]
		        )
		    )

		VAR __Value_Percentage_of_Total =
		    DIVIDE (
		        __Value,
		        __Value_All
		    )

		VAR __Format_Default    = "#,0,.0K;-#,0,.0K"
		VAR __Format_Percentage = "0.0%;-0.0%;0%"

		VAR __Label =
		    FORMAT ( __Value, __Format_Default ) &
		    " | " &
		    FORMAT ( __Value_Percentage_of_Total, __Format_Percentage )
		    

		VAR __Result =
		    IF (
		        NOT ISBLANK ( __Value ),
		        __Label
		    )  

		RETURN __Label
		```
		displayFolder: Markers & Data Points & Factors\04. Reference Labels
		lineageTag: e976e941-f74d-422f-9bd3-334ff578a893

