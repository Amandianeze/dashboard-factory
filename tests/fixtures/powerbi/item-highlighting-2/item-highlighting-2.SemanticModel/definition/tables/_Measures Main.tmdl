	measure '_Pareto Tag | Basic | By Customer' = ```

		VAR __Current_Customer  = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Is_Customer       = ISINSCOPE ( DIM_Customers[Customer_Name] )

		// Classification percentages
		VAR __Percentage = [Parameter Pareto Dynamic Range | Value]  

		// Cumulative thresholds
		VAR __CumThreshold = __Percentage        

		VAR __Total = 
		    CALCULATE (
		        [_revenue],
		        REMOVEFILTERS (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] )
		    )
		        
		VAR __AllCustomers =
		    FILTER (
		        ADDCOLUMNS (
		            ALL (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Revenue", [_revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )
		        
		VAR __WithCumulative =
		    ADDCOLUMNS(
		        __AllCustomers,
		            "@CumPercent", 
		                DIVIDE (
		                    SUMX (
		                        WINDOW (
		                            1, ABS,
		                            0, REL,
		                            __AllCustomers,
		                            ORDERBY([@Revenue], DESC)
		                        ),
		                        [@Revenue]
		                    ),
		                    __Total
		                )
		            )
		        
		// Find minimum differences
		VAR __MinDiffA = MINX ( __WithCumulative, ABS([@CumPercent] - __CumThreshold))

		// Find actual thresholds
		VAR __ThresholdA = 
		    MINX (
		        __WithCumulative,
		            IF(
		                ABS ([@CumPercent] - __CumThreshold) = __MinDiffA,
		                [@CumPercent]
		            )
		        )
		        
		// Calculate current customer's cumulative %
		VAR __Current_Revenue = 
		    MAXX (
		        FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer ), 
		        [@Revenue]
		    )

		VAR __CurrentCumPercent = 
		    MAXX (
		        FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer  ),
		        [@CumPercent]
		    )
		        
		// Classify customer
		VAR __Is_In_Threshold = 
		        __CurrentCumPercent <= __ThresholdA
		    
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            NOT __Is_Customer || ISBLANK (__Current_Revenue ), BLANK(),
		            __Is_In_Threshold, 1,
		            BLANK()
		     )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\02. Pareto
		lineageTag: 254c0d55-bbed-4c8e-842a-920c67eb0f37

	measure '_Pareto Cut off Point Fixed on 80% | By Customer' = ```

		VAR __Current_Customer  = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Is_Customer       = ISINSCOPE ( DIM_Customers[Customer_Name] )

		// Classification percentages
		VAR __Percentage = 0.8

		// Cumulative thresholds
		VAR __CumThreshold = __Percentage        

		VAR __Total = 
		    CALCULATE (
		        [_revenue],
		        REMOVEFILTERS (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] )
		    )
		        
		VAR __AllCustomers =
		    FILTER (
		        ADDCOLUMNS (
		            ALL (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Revenue", [_revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )
		        
		VAR __WithCumulative =
		    ADDCOLUMNS(
		        __AllCustomers,
		            "@CumPercent", 
		                DIVIDE (
		                    SUMX (
		                        WINDOW (
		                            1, ABS,
		                            0, REL,
		                            __AllCustomers,
		                            ORDERBY([@Revenue], DESC)
		                        ),
		                        [@Revenue]
		                    ),
		                    __Total
		                )
		            )

		VAR __Only_Lower_than_Threshold = 
		    FILTER ( __WithCumulative, [@CumPercent] <= __CumThreshold )

		// Find minimum differences
		VAR __MinDiffA = MINX ( __Only_Lower_than_Threshold, ABS([@CumPercent] - __CumThreshold))

		// Find actual thresholds
		VAR __ThresholdA = 
		    MINX (
		        __WithCumulative,
		            IF(
		                ABS ([@CumPercent] - __CumThreshold) = __MinDiffA,
		                [@CumPercent]
		            )
		        )
		        
		// Calculate current customer's cumulative %
		VAR __Current_Revenue   =  MAXX ( FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer ),  [@Revenue] )
		VAR __CurrentCumPercent =  MAXX ( FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer  ), [@CumPercent] )
		        
		// Classify customer
		VAR __Is_equal_to_Threshold =  __CurrentCumPercent = __ThresholdA
		    
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            NOT __Is_Customer || ISBLANK (__Current_Revenue ), BLANK(),
		            __Is_equal_to_Threshold, __ThresholdA,
		            BLANK()
		     )

		RETURN __Result 
		```
		formatString: 0%;-0%;0%
		displayFolder: Segmentation & Ranking\02. Pareto
		lineageTag: bf6a292d-0b60-48fb-85cc-2d05904ac81b

	measure '_Customer Count | New' = ```

