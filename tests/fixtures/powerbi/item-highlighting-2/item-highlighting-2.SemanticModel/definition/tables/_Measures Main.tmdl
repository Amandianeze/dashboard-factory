	measure '_Revenue Trend Line | Negative' = ```


		VAR __Displayed_Metric = [_Revenue]

		VAR __DataTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( 'Dim_Calendar'[Start of Month], 'Dim_Calendar'[mmm'yy] ),
		            "@X", 'Dim_Calendar'[Start of Month],
		            "@Y", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Y] ) 
		    )

		VAR __Point_Count   = COUNTROWS ( __DataTable )
		VAR __LinRegParams  = LINESTX ( __DataTable, [@Y], [@X])
		VAR __Slope         = MAXX ( __LinRegParams, [Slope1] )
		VAR __Intercept     = MAXX ( __LinRegParams, [Intercept] )

		VAR __X_Current = SELECTEDVALUE ( 'Dim_Calendar'[Start of Month] )

		VAR __Trend_Line_Display =
		    IF (
		        NOT ISBLANK ( __Displayed_Metric ),
		        __Intercept + __Slope * __X_Current
		    )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Point_Count < 2,    BLANK(),
		            __Slope       >= 0,   BLANK(),
		            __Trend_Line_Display
		    )

		RETURN __Result
		```
		displayFolder: Trendlines\01. Initial Calculations
		lineageTag: 22966dcd-d5e9-4c28-b896-a80d18db2880

