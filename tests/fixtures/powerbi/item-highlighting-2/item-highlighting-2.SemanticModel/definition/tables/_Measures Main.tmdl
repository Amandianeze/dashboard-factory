	measure '_Revenue Max Value Matrix Customer | Dynamic Granularity' = ```


		VAR __Table_Monthly =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[Start of Month],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)

		VAR __Table_Quarterly =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[Start of Quarter],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)

		VAR __Table_Yearly =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[Year],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)

		VAR __Max_Monthly =     MAXX ( __Table_Monthly,   [@Revenue] )
		VAR __Max_Quarterly =   MAXX ( __Table_Quarterly, [@Revenue] )
		VAR __Max_Yearly =      MAXX ( __Table_Yearly,    [@Revenue] )

		VAR __Granularity = SELECTEDVALUE ( 'TBL Granularity'[Name Short], "M" )

		VAR __Result =
		    SWITCH (
		        __Granularity,
		            "M", __Max_Monthly, 
		            "Q", __Max_Quarterly, 
		            "Y", __Max_Yearly
		    )

		RETURN __Result


		```
