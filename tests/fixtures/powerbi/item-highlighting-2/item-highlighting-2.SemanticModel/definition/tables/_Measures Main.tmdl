	measure '_Revenue Value Max * Factor' = ```


		VAR __BaseTable = 
		    CALCULATETABLE ( 
		        ADDCOLUMNS (
		            VALUES ( 'Dim_Calendar'[MonthnYear] ),
		            "@AC", [_Revenue],
		            "@PY", [_Revenue PY]
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Max_Value =  MAXX ( __BaseTable, MAX ( [@AC], [@PY] ) )
		VAR __Max_Date  =  MAXX ( __BaseTable, 'Dim_Calendar'[MonthnYear] )
		VAR __Min_Date  =  MINX ( __BaseTable, 'Dim_Calendar'[MonthnYear] )
		VAR __X_Axis    =  SELECTEDVALUE ( 'Dim_Calendar'[MonthnYear]  )

		VAR __Result = 
		    IF (
		        __X_Axis >= __Min_Date && __X_Axis <= __Max_Date,
		        __Max_Value * 1.2
		    )
		    
		RETURN __Max_Value * 1.3




