	measure '_ABC Tag' = ```

		VAR __Current_Customer  = SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __Is_Customer       = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Category_Bin      = SELECTEDVALUE ( 'TBL Segment | ABC'[Name Display] )

		// Classification percentages
		VAR __PercentageA = 0.8  
		VAR __PercentageB = 0.15  

		// Cumulative thresholds
		VAR __CumThresholdA = __PercentageA 
		VAR __CumThresholdB = __PercentageA  + __PercentageB

		VAR __Total = 
		    CALCULATE (
		        [_revenue],
		        REMOVEFILTERS (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] )
		    )
		        
		VAR __AllCustomers =
		    FILTER (
		        ADDCOLUMNS (
		            ALL (DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Revenue", [_revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )
		        
		VAR __WithCumulative =
		    ADDCOLUMNS(
		        __AllCustomers,
		            "@CumPercent", 
		                DIVIDE (
		                    SUMX (
		                        WINDOW (
		                            1, ABS,
		                            0, REL,
		                            __AllCustomers,
		                            ORDERBY([@Revenue], DESC)
		                        ),
		                        [@Revenue]
		                    ),
		                    __Total
		                )
		            )
		        
		// Find minimum differences
		VAR __MinDiffA = MINX ( __WithCumulative, ABS([@CumPercent] - __CumThresholdA))
		VAR __MinDiffB = MINX ( __WithCumulative, ABS([@CumPercent] - __CumThresholdB))

		// Find actual thresholds
		VAR __ThresholdA = 
		    MINX (
		        __WithCumulative,
		            IF(
		                ABS ([@CumPercent] - __CumThresholdA) = __MinDiffA,
		                [@CumPercent]
		            )
		        )

		VAR __ThresholdB = 
		    MINX (
		        __WithCumulative,
		            IF(
		                ABS ([@CumPercent] - __CumThresholdB) = __MinDiffB,
		                [@CumPercent]
		            )
		        )
		    
		// Calculate current customer's cumulative %
		VAR __Current_Revenue = 
		    MAXX (
		        FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer ), 
		        [@Revenue]
		    )

		VAR __CurrentCumPercent = 
		    MAXX (
		        FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer ),
		        [@CumPercent]
		    )
		        
		// Classify customer
		VAR __CustomerClass = 
		    SWITCH (
		        TRUE(),
		            __CurrentCumPercent <= __ThresholdA, "A",
		            __CurrentCumPercent <= __ThresholdB, "B",
		            "C"

		        )
		    
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            NOT __Is_Customer || ISBLANK (__Current_Revenue ), BLANK(),
		            __CustomerClass = __Category_Bin, 1,
		            BLANK()
		     )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\03. ABC
		lineageTag: bab1d4c0-f0ca-4894-be0e-a1ab21565fcf

