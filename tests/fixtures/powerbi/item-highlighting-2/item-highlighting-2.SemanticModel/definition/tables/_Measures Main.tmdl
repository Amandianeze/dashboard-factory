	measure '_Data Points Markers | Min and Max | Color Highlighting' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim_Calendar'[CurrMonthOffset] ),
		                "@Value", [_Revenue]
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Min_Val =     MINX ( FILTER ( __Table, [@Value] <> 0 ), [@Value] )
		VAR __Max_Val =     MAXX ( __Table, [@Value] )                         // Max Value

		VAR __Xaxis_Date =  SELECTEDVALUE ( 'Dim_Calendar'[CurrMonthOffset] ) // Current X-axis Date Point
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim_Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Val = __Min_Val, [_Negative Variance color],
		            __Xaxis_Val = __Max_Val, [_Positive Variance color],
		            "#DBDDE3" // Light-Grey
		    ) & ""

		RETURN __Result

		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\01. Mixed & General
		lineageTag: 47a39a66-c2b5-48f5-839f-7acabd8aec6a

	measure '_Data Points Markers | Avg | Color Highlighting' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        ADDCOLUMNS ( 
		            VALUES ( 'Dim_Calendar'[CurrMonthOffset] ),
		            "@Value", [_Revenue]
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __Avg_Val =     AVERAGEX ( __Table, [@Value] )                    // Max Value

		VAR __Xaxis_Date =  SELECTEDVALUE ( 'Dim_Calendar'[CurrMonthOffset] ) // Current X-axis Date Point
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim_Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Val  >= __Avg_Val,
		            [_Positive Variance color]
		    ) & ""

		RETURN __Result

		```
