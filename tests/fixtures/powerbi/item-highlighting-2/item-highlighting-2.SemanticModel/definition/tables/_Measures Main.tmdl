	measure '_Revenue | Customer Segm x qq''yy | Heatmap Font Color' = ```


		//Calculation specifcally for breakdown: Customer Segment x Quarter & Year // <-- input your fields here as a comment

		VAR __Value                 = [_Revenue]                                   // <-- choose your measure

		VAR __Threshold             = 0.70                                         // <-- choose your threshold
		VAR __DefaultFontColor      = "#243140"                                    // <-- Color for cells below the threshold
		VAR __HighlightedFontColor  = "#FFFFFF"                                    // <-- Color for cells equal or above the threshold
		 
		//_____________________________________________________________________________

		VAR __Table =
		    CALCULATETABLE (
		        SUMMARIZECOLUMNS (
		             Dim_Calendar[qqyy],
		             DIM_Customers[Segment],
		            "@Value", [_Revenue]
		        ),
		        ALLSELECTED ()
		    )

		//_____________________________________________________________________________
		VAR __MinValue  = MIN ( 0, MINX ( __Table, [@Value] ) )
		VAR __MaxValue  = MAXX ( __Table, [@Value] )
		VAR __Span      = __MaxValue - __MinValue

		VAR __Scale =
		    DIVIDE (
		        __Value - __MinValue,
		        __Span
		    )

		//_____________________________________________________________________________
		VAR __Result =
		    SWITCH (
		        TRUE (),
		            ISBLANK ( __Value ),        BLANK (),
		            __Scale < __Threshold,      __DefaultFontColor      & "",
		                                        __HighlightedFontColor  & ""
		    )

		RETURN __Result


		```
		displayFolder: 02. Base Variants\01.Revenue\08. Heat-map Structure
		lineageTag: c5a09760-0913-47e3-aa85-77fb76202524

	measure '_Revenue Dynamic Heatmap Mode Check | Single Row Table' = ```


		VAR __Heatmap_On = ISCROSSFILTERED ( 'TBL Switch On Off Single Row'[Name] )
		VAR __Metric = [_Revenue]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Metric ), BLANK(),
		            __Heatmap_On, 1, 
		            2
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\08. Heat-map Structure
		lineageTag: d00eded0-dbb5-444b-95b6-68373a1bafeb

