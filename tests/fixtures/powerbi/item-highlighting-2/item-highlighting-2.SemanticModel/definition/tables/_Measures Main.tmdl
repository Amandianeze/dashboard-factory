	measure '_Revenue PY Dynamic Rank Value Alt. No Filter' = ```

		//RANKED BY REVENUE, AGGREGATED BY REVENUE PY
		/***INPUTS***/
		VAR __TopBin           = [NR Values 1-20 | Ranking 01 | Value]
		VAR __CurrentCustomer  = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __AtCustomerLevel  = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",     [_Revenue],
		                "@Revenue_PY" , [_Revenue PY] 
		        ),
		        NOT ISBLANK ( [@Revenue] ) ||
		        NOT ISBLANK ( [@Revenue_PY] )
		    )

		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    TOPN (
		        __TopBin ,
		        __BaseTable ,
		        [@Revenue] ,
		        DESC,
		        DIM_Customers_Supplemental[Customer_Sort_ID], ASC
		    )

		/***REVENUE CALCULATION***/
		VAR __TopNRevenue =
		    SUMX ( __TopN_Customers , [@Revenue_PY] )

		VAR __AllRevenue =
		    CALCULATE ( 
		        [_Revenue PY] , 
		        REMOVEFILTERS ( 
		            DIM_Customers_Supplemental[Customer], 
		            DIM_Customers_Supplemental[Customer_Sort_ID] 
		        ) 
		    )

		VAR __OthersRevenue =
		    __AllRevenue - __TopNRevenue

		/***CONDITIONS & CHECKS***/
		VAR __HasOthers =
		    COUNTROWS ( EXCEPT ( __BaseTable , __TopN_Customers ) ) > 0

		VAR __IsOtherRow =
		    __CurrentCustomer = "Others"

		VAR __CustomerInTopN =
		    CONTAINS (                      
		        __TopN_Customers,
		        DIM_Customers_Supplemental[Customer],   __CurrentCustomer
		    )

		/***RESULT***/
		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            __IsOtherRow  && __HasOthers  , __OthersRevenue ,
		            __CustomerInTopN              , [_Revenue PY] ,
		            NOT __AtCustomerLevel         , __AllRevenue ,
		            BLANK ()
		    )

		RETURN __Result


		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\04. Top in the Date Context | Global TopN
		lineageTag: 79a76f71-2f80-4694-8e73-5ed713f2a9a3

