	measure '_Revenue Avg Value Dynamic Granularity' = ```

		VAR __Granularity =
		    SELECTEDVALUE ( 'TBL Granularity'[Name Short], "M" )

		VAR __Periods =
		    CALCULATETABLE (
		        FILTER (
		            ADDCOLUMNS (
		                SELECTCOLUMNS (
		                    'Dim_Calendar',
		                    "@M", 'Dim_Calendar'[Start of Month]   ,
		                    "@Q", 'Dim_Calendar'[Start of Quarter] ,
		                    "@Y", 'Dim_Calendar'[Year]
		                ),
		                "@R", [_Revenue]
		            ),
		            NOT ISBLANK ( [@R] )
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )

		VAR __MinMonth   = MINX ( __Periods, [@M] )
		VAR __MaxMonth   = MAXX ( __Periods, [@M] )
		VAR __MinQuarter = MINX ( __Periods, [@Q] )
		VAR __MaxQuarter = MAXX ( __Periods, [@Q] )
		VAR __MinYear    = MINX ( __Periods, [@Y] )
		VAR __MaxYear    = MAXX ( __Periods, [@Y] )

		VAR __MinPeriod = SWITCH ( __Granularity, "M", __MinMonth, "Q", __MinQuarter, "Y", __MinYear )
		VAR __MaxPeriod = SWITCH ( __Granularity, "M", __MaxMonth, "Q", __MaxQuarter, "Y", __MaxYear )

		VAR __Average_Monthly =     CALCULATE ( AVERAGEX ( VALUES ( 'Dim_Calendar'[Start of Month] ),   [_Revenue] ), ALLSELECTED ( 'Dim_Calendar')  )
		VAR __Average_Quarterly =   CALCULATE ( AVERAGEX ( VALUES ( 'Dim_Calendar'[Start of Quarter] ), [_Revenue] ), ALLSELECTED ( 'Dim_Calendar')  )
		VAR __Average_Yearly =      CALCULATE ( AVERAGEX ( VALUES ( 'Dim_Calendar'[Year] ),             [_Revenue] ), ALLSELECTED ( 'Dim_Calendar')  )

		VAR __Avg_Value =
		    SWITCH (
		        __Granularity,
		            "M", __Average_Monthly, 
		            "Q", __Average_Quarterly, 
		            "Y", __Average_Yearly
		    )

		VAR __Current_Period =
		    SWITCH (
		        __Granularity,
		            "M", MIN ( 'Dim_Calendar'[Start of Month] ), 
		            "Q", MIN ( 'Dim_Calendar'[Start of Quarter] ), 
		            "Y", MIN ( 'Dim_Calendar'[Year] )
		    )

		VAR __Is_Period_In_Scope = 
		    ISINSCOPE ( 'Dim_Calendar'[Start of Month] ) || 
		    ISINSCOPE ( 'Dim_Calendar'[Start of Quarter] ) || 
		    ISINSCOPE ( 'Dim_Calendar'[Year] ) 

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT ( __Is_Period_In_Scope ), 
		            __Avg_Value,

		            __Current_Period >= __MinPeriod && 
		            __Current_Period <= __MaxPeriod,
		            __Avg_Value
		    )
		RETURN __Result



		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\05. Avg
		lineageTag: e7af0546-4c0f-43b4-a761-9c96d001b330

	measure '_Revenue Avg Value Dynamic Granularity Alt.' = ```


		VAR __Granularity =         SELECTEDVALUE ( 'TBL Granularity'[Name Short], "M" )

		VAR __Average_Monthly =     AVERAGEX (  ALLSELECTED ( 'Dim_Calendar'[Start of Month] ),   [_Revenue] )
		VAR __Average_Quarterly =   AVERAGEX (  ALLSELECTED ( 'Dim_Calendar'[Start of Quarter] ), [_Revenue] )
		VAR __Average_Yearly =      AVERAGEX (  ALLSELECTED ( 'Dim_Calendar'[Year], 'Dim_Calendar'[Year Text] ), [_Revenue] )

		VAR __Result =
		    SWITCH (
		        __Granularity,
		            "M", __Average_Monthly, 
		            "Q", __Average_Quarterly, 
		            "Y", __Average_Yearly
		    )

		RETURN __Result


		```
