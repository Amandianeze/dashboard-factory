	measure '_Revenue Dynamic Others Value | Card' = ```


		VAR __TopBin  = [NR Values 1-20 | Ranking 01 | Value] // Can be Dynamic of Static 

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID]
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __TopN_Customers =
		    TOPN (
		        __TopBin ,
		        __BaseTable ,
		        [@Revenue] , DESC,
		        DIM_Customers[Sort ID], ASC // Optional
		    )

		VAR __AllRevenue_Total      = SUMX ( __BaseTable , [@Revenue] )
		VAR __TopNRevenue_Total     = SUMX ( __TopN_Customers , [@Revenue] )
		VAR __OthersRevenue         = MROUND ( __AllRevenue_Total - __TopNRevenue_Total, 1)

		VAR __Result =  __OthersRevenue 

		    
		RETURN __Result





		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\03.General & Totals\Aggregated & Totals
