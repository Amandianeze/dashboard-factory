	measure '_Revenue LTM Based On Date | DatesInPeriod | Suppl Cal. | With Zeros' = ```

		VAR __EndMonth =
		    MAX ( 'Dim_Calendar'[Date] )

		VAR __StartDate =
		    EDATE ( __EndMonth, -11 )

		VAR __LTM_Calculation =
		    CALCULATE (
		        [_Revenue],
		        DATESINPERIOD (
		            'Dim_Calendar'[Date],
		            __EndMonth,
		            -12,
		            MONTH
		        ),
		        USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __xAxisDate =
		    SELECTEDVALUE ( 'Dim Calendar Suppl'[Date] )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        NOT ISBLANK ( __xAxisDate )
		            && __xAxisDate >= __StartDate
		            && __xAxisDate <= __EndMonth,
		            COALESCE ( __LTM_Calculation, 0 ),
		        __LTM_Calculation
		    )

		RETURN
		    __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\01.AC
		lineageTag: 607be1db-c103-46e9-93df-fe06650d254b

	measure '_Data Label Density - Continuous axis Start of month' = ```


		VAR __DensityParameter = 100
		VAR __Main_Value = [_Revenue]

		// Count total rows (months) in current filter context
		VAR __TotalRows = 
		    COUNTX(
		        ALLSELECTED('Dim_Calendar'[mmm'yy], 'Dim_Calendar'[Start of Month], 'Dim_Calendar'[Year]),
		        'Dim_Calendar'[Start of Month]
		    )

		// Calculate desired number of labels based on density percentage
		// Example: 80% density × 12 months = 9.6 → rounds to 10 labels
		// Reserve 2 for endpoints
		VAR __DesiredCount = ROUND(__TotalRows * __DensityParameter, 0) - 2

		// Split desired count equally: top half and bottom half
		// When odd number: top gets 1 more label than bottom (using ROUNDUP)
		VAR __MaxDesiredCount = MAX(0, __DesiredCount)
		VAR __TopCount = ROUNDUP(__MaxDesiredCount / 2, 0)
		VAR __BottomCount = __MaxDesiredCount - __TopCount

		VAR __Row_Number = 
		    COUNTX(
		        FILTER(
		            ALLSELECTED('Dim_Calendar'[mmm'yy], 'Dim_Calendar'[Start of Month], 'Dim_Calendar'[Year]),
		            'Dim_Calendar'[Start of Month] <= MAX('Dim_Calendar'[Start of Month])
		        ),
		        'Dim_Calendar'[Start of Month]
		    )

		VAR __Rank_Desc = 
		    RANKX(
		        ALLSELECTED('Dim_Calendar'[mmm'yy], 'Dim_Calendar'[Start of Month], 'Dim_Calendar'[Year]),
		        [_Revenue],,DESC
		    )

		VAR __Rank_Asc = 
		    RANKX(
		        ALLSELECTED('Dim_Calendar'[mmm'yy], 'Dim_Calendar'[Start of Month], 'Dim_Calendar'[Year]),
		        [_Revenue],,ASC
		    )

		VAR __Result = 
		    SWITCH(
		        TRUE(),
		        __Row_Number = 1, __Main_Value,
		        __Row_Number = __TotalRows, __Main_Value,
		        __Rank_Desc <= __TopCount, __Main_Value,
		        __Rank_Asc <= __BottomCount, __Main_Value,
		        BLANK()
		    )

		RETURN __Result
		```
		displayFolder: ZZ. Other & Supplemental
		lineageTag: 5e6379de-10b1-402e-ad56-2defbca517ec

	measure '3. Top Bottom N Dynamic (delta AC-PY) | One-side Split | without visual filter' = ```


		VAR __CategoryID                = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __SelectedCategories        = VALUES ( 'TBL Top & Bottom & Others Simple'[ID] )

		VAR __TopN                      = SELECTEDVALUE ( 'NR Values 1-20 | Ranking 01'[Ranking Dynamic Parameter], 10 )

		VAR __Is_At_Level_Customer      = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Is_At_Level_Segment       = ISINSCOPE ( 'TBL Top & Bottom & Others Simple'[Name Display] )
		VAR __CurrentRow                = SELECTEDVALUE ( DIM_Customers[Customer_ID] )

		//BASE TABLE ───────────────────────────────────────────────────────────────
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Customer_ID],
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Delta", [_Revenue Variance abs. PY]
		        ),
		        NOT ISBLANK ( [@Delta] )
		    )

		//RANK ─────────────────────────────────────────────────────────────────────
		VAR __RankedTable =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@RankDesc", RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], DESC BLANKS LAST ), LAST ),
		        "@RankAsc",  RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], ASC  BLANKS LAST ), LAST )
		    )

		//BINS ──────────────────────────────────────────────────────────────────────
		VAR __TopOnly       = FILTER ( __RankedTable, [@RankDesc] <= __TopN )
		VAR __BottomOnly    = FILTER ( __RankedTable, [@RankAsc]  <= __TopN && [@RankDesc] > __TopN )
		VAR __Others        = FILTER ( __RankedTable, [@RankDesc]  > __TopN && [@RankAsc]  > __TopN )

		//CHECKS ───────────────────────────────────────────────────────────────────
		VAR __IsTop         = CONTAINS ( __TopOnly,    DIM_Customers[Customer_ID], __CurrentRow )
		VAR __IsBottom      = CONTAINS ( __BottomOnly, DIM_Customers[Customer_ID], __CurrentRow )
		VAR __IsOther       = CONTAINS ( __Others,     DIM_Customers[Customer_ID], __CurrentRow )

		//VALUE PER ROW ─────────────────────────────────────────────────────────────
		VAR __ValueTop      = SUMX ( FILTER ( __TopOnly,    DIM_Customers[Customer_ID] = __CurrentRow ), [@Delta] )
		VAR __ValueBottom   = SUMX ( FILTER ( __BottomOnly, DIM_Customers[Customer_ID] = __CurrentRow ), [@Delta] )
		VAR __ValueOther    = SUMX ( FILTER ( __Others,     DIM_Customers[Customer_ID] = __CurrentRow ), [@Delta] )

		//SUBTOTAL & TOTAL VALUES ───────────────────────────────────────────────────────────
		VAR __TotalTop      = COALESCE ( SUMX ( __TopOnly,    [@Delta] ), 0 )
		VAR __TotalBottom   = COALESCE ( SUMX ( __BottomOnly, [@Delta] ), 0 )
		VAR __TotalOther    = COALESCE ( SUMX ( __Others,     [@Delta] ), 0 )
		VAR __Total = 
		    SUMX (
		        FILTER (
		            __RankedTable,
		            ( 1 IN __SelectedCategories && [@RankDesc] <= __TopN )                          ||
		            ( 2 IN __SelectedCategories && [@RankDesc] > __TopN  && [@RankAsc] > __TopN )   ||
		            ( 3 IN __SelectedCategories && [@RankAsc]  <= __TopN && [@RankDesc] > __TopN )
		        ),
		        [@Delta]
		    )

		//RESULT ───────────────────────────────────────────────────────────────────
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Level_Customer && NOT ( __Is_At_Level_Segment ),
		                __Total ,

		            NOT __Is_At_Level_Customer,
		                SWITCH (
		                    __CategoryID,
		                    1, __TotalTop,
		                    2, __TotalOther,
		                    3, __TotalBottom,
		                    BLANK()
		                ),
		                
		            __CategoryID = 1 && __IsTop,    __ValueTop,
		            __CategoryID = 2 && __IsOther,  __ValueOther,
		            __CategoryID = 3 && __IsBottom, __ValueBottom,
		            BLANK()
		    )

		RETURN __Result
		```
		formatString: +#,0;-#,0;0
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		lineageTag: 437d17a8-b20b-4599-aabf-0050d1e34af0

	measure '3. Top Bottom N Dynamic (delta AC-PY) | One-side Split | Alt without visual filter' = ```


		VAR __CategoryID                = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __SelectedCategories        = VALUES ( 'TBL Top & Bottom & Others Simple'[ID] )

		VAR __TopN                      = SELECTEDVALUE ( 'NR Values 1-20 | Ranking 01'[Ranking Dynamic Parameter], 10 )

		VAR __Is_At_Level_Customer      = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Is_At_Level_Segment       = ISINSCOPE ( 'TBL Top & Bottom & Others Simple'[Name Display] )
		VAR __CurrentRow                = SELECTEDVALUE ( DIM_Customers[Customer_ID] )

		//BASE TABLE ───────────────────────────────────────────────────────────────
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Customer_ID],
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Delta", [_Revenue Variance abs. PY]
		        ),
		        NOT ISBLANK ( [@Delta] )
		    )

		//RANK + SEGMENT ───────────────────────────────────────────────────────────
		VAR __RankedTable =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@RankDesc", RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], DESC BLANKS LAST ), LAST ),
		        "@RankAsc",  RANK ( DENSE, __BaseTable, ORDERBY ( [@Delta], ASC  BLANKS LAST ), LAST )
		    )

		VAR __SegmentedTable =
		    ADDCOLUMNS (
		        __RankedTable,
		        "@Segment",
		            SWITCH (
		                TRUE(),
		                [@RankDesc] <= __TopN,                           1,
		                [@RankAsc]  <= __TopN && [@RankDesc] > __TopN,   3,
		                                                                 2
		            )
		    )

		//BINS ─────────────────────────────────────────────────────────────────────
		VAR __TopOnly    = FILTER ( __SegmentedTable, [@Segment] = 1 )
		VAR __BottomOnly = FILTER ( __SegmentedTable, [@Segment] = 3 )
		VAR __Others     = FILTER ( __SegmentedTable, [@Segment] = 2 )

		//CHECKS ───────────────────────────────────────────────────────────────────
		VAR __IsTop    = CONTAINS ( __TopOnly,    DIM_Customers[Customer_ID], __CurrentRow )
		VAR __IsBottom = CONTAINS ( __BottomOnly, DIM_Customers[Customer_ID], __CurrentRow )
		VAR __IsOther  = CONTAINS ( __Others,     DIM_Customers[Customer_ID], __CurrentRow )

		//VALUE PER ROW ────────────────────────────────────────────────────────────
		VAR __ValueTop    = SUMX ( FILTER ( __TopOnly,    DIM_Customers[Customer_ID] = __CurrentRow ), [@Delta] )
		VAR __ValueBottom = SUMX ( FILTER ( __BottomOnly, DIM_Customers[Customer_ID] = __CurrentRow ), [@Delta] )
		VAR __ValueOther  = SUMX ( FILTER ( __Others,     DIM_Customers[Customer_ID] = __CurrentRow ), [@Delta] )

		//SUBTOTALS & TOTAL ────────────────────────────────────────────────────────
		VAR __TotalTop    = COALESCE ( SUMX ( __TopOnly,    [@Delta] ), 0 )
		VAR __TotalBottom = COALESCE ( SUMX ( __BottomOnly, [@Delta] ), 0 )
		VAR __TotalOther  = COALESCE ( SUMX ( __Others,     [@Delta] ), 0 )
		VAR __Total       =
		    SUMX (
		        FILTER ( __SegmentedTable, [@Segment] IN __SelectedCategories ),
		        [@Delta]
		    )

		//RESULT ───────────────────────────────────────────────────────────────────
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT __Is_At_Level_Customer && NOT __Is_At_Level_Segment,
		                __Total,

		            NOT __Is_At_Level_Customer,
		                SWITCH (
		                    __CategoryID,
		                    1, __TotalTop,
		                    2, __TotalOther,
		                    3, __TotalBottom,
		                    BLANK()
		                ),

		            __CategoryID = 1 && __IsTop,    __ValueTop,
		            __CategoryID = 2 && __IsOther,  __ValueOther,
		            __CategoryID = 3 && __IsBottom, __ValueBottom,
		            BLANK()
		    )

		RETURN __Result
		```
		formatString: +#,0;-#,0;0
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		lineageTag: f1a6692f-8ef1-47e0-82d5-e2307ff53cef

