	measure '_Revenue Customized Periods | Year CF Flag' = ```


		VAR __Granularity_Selected =    SELECTEDVALUE ( 'TBL Granularity'[Name Short] )
		VAR __Slicer_Year_Selected =    SELECTEDVALUE ( 'Dim_Calendar'[Year] )
		VAR __Display_Year_Selection =  SELECTEDVALUE ( 'Dim Calendar Suppl'[Year] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Granularity_Selected <> "Y", 2, 
		            __Granularity_Selected = "Y" && __Slicer_Year_Selected = __Display_Year_Selection,
		            1,
		            0
		    )

		RETURN  __Result

		```
