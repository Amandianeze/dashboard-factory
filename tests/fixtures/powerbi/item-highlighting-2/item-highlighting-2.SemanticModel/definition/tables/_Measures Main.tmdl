	measure '_Metric Scale Synchro | SM | Max | Slicer-based | Alt.' = ```


		VAR __Y_Axis_Mode = SELECTEDVALUE ( 'TBL Y-Axis Scale | Unification'[Name Key] )

		VAR __Table =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            FILTER (
		                CROSSJOIN (
		                    VALUES ( 'Dim_Calendar'[Start of Month] ),
		                    VALUES ( DIM_Customers[Country] )
		                ),
		                NOT ISBLANK ( [_Revenue] )
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        ALLSELECTED()
		    )

		VAR __Max_Value =               MAXX ( __Table, [@Revenue] )
		VAR __Max_Value_Synchronized =  __Max_Value * 1.2

		VAR __Result =
		    IF (
		       __Y_Axis_Mode = "Unified", __Max_Value_Synchronized,
		       BLANK()  // Considered as "Auto"
		    )
		    
		RETURN __Result


