	measure '_Revenue First and Last data point' = ```


		VAR __Table =
		    CALCULATETABLE (
		        ADDCOLUMNS ( 
		            FILTER (
		                CROSSJOIN ( 
		                    VALUES ( 'Dim_Calendar'[Start of Month] ),
		                    VALUES ( DIM_Customers[Business_Line] )
		                ),
		                NOT ISBLANK ( [_Revenue] )
		            ),
		            "@Revenue", [_Revenue] 
		        ),
		        ALLSELECTED ( 'Dim_Calendar' )
		    )


		VAR __Xaxis_Date =      SELECTEDVALUE ( 'Dim_Calendar'[Start of Month]  )
		VAR __Min_Date =        MINX ( __Table, 'Dim_Calendar'[Start of Month]  )
		VAR __Max_Date =        MAXX ( __Table, 'Dim_Calendar'[Start of Month]  )
		VAR __Value_Display =   MAXX ( FILTER ( __Table, 'Dim_Calendar'[Start of Month]  = __Xaxis_Date  ), [@Revenue] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Date = __Min_Date || __Xaxis_Date = __Max_Date,
		            __Value_Display,
		            BLANK()
		    )

		RETURN __Result






