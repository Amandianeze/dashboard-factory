	measure '_Revenue Variance PY Heatmap Dynamic Threshold | Font Color | Customer' = ```


		VAR __Value =
		    [_Revenue Variance abs. PY]

		VAR __Table =
		    CALCULATETABLE (
		        FILTER (
		            SUMMARIZECOLUMNS (
		                'Dim_Calendar'[qqyy],
		                DIM_Customers[Customer_Name],
		                "@Variance_PY", [_Revenue Variance abs. PY]
		            ),
		            NOT ISBLANK ( [@Variance_PY] )
		        ),
		        ALLSELECTED ()
		    )

		VAR __MaxPos    = MAXX ( FILTER ( __Table, [@Variance_PY] > 0 ), [@Variance_PY] )
		VAR __MinNeg    = MINX ( FILTER ( __Table, [@Variance_PY] < 0 ), [@Variance_PY] )

		VAR __Scale =
		    SWITCH (
		        TRUE (),
		        __Value > 0, DIVIDE ( __Value, __MaxPos ),
		        __Value < 0, DIVIDE ( __Value, ABS ( __MinNeg ) ),
		        0
		    )

		VAR __Threshold = 0.7

		VAR __Default_Font_Colour     = "#3D5671"
		VAR __Highlighted_Font_Colour = "#FFFFFF"

		VAR __Result =
		    IF (
		        ABS ( __Scale ) >= __Threshold,
		        __Highlighted_Font_Colour,
		        __Default_Font_Colour
		    )

		RETURN __Result 


		// VAR __Value =
		//     [_Revenue Variance abs. PY]

		// VAR __Table =
