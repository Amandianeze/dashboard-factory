	measure '_Action Flag | Non-SVG' = ```


		VAR __Metric =  [_Gross Margin % Perc]

		VAR __Icon_Red_Strong =    MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Negative Strong" ), 'TBL Threshold Flags'[Icon Flag] )
		VAR __Icon_Red_Light =     MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Negative Light" ),  'TBL Threshold Flags'[Icon Flag] )
		VAR __Icon_Green_Light =   MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Positive Light" ),  'TBL Threshold Flags'[Icon Flag] )
		VAR __Icon_Green_Strong =  MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Positive Strong" ), 'TBL Threshold Flags'[Icon Flag] )


		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Metric ), BLANK(),
		            __Metric < 0.25,                       __Icon_Red_Strong,
		            __Metric >= 0.25 && __Metric < 0.30,   __Icon_Red_Light,
		            __Metric >= 0.30 && __Metric  < 0.40,  BLANK(),
		            __Metric >= 0.40 && __Metric < 0.45,   __Icon_Green_Light,
		            __Metric >= 0.45,                      __Icon_Green_Strong
		    )

		RETURN __Result
		```
		displayFolder: Geo\03. Actions Dots & Flags\01. Non-SVG
		dataCategory: ImageUrl
		lineageTag: 6d3f3353-c18f-43d0-8e45-8534d6da091a

	measure '_Action Flag | Non-SVG (by thresholds)' = ```


		VAR __Metric = [_Gross Margin % Perc]

		VAR __Table =
		    FILTER (
		        ALL ( 'TBL Threshold Flags' ),
		        ( ISBLANK ( 'TBL Threshold Flags'[RangeMin] ) || __Metric >= 'TBL Threshold Flags'[RangeMin] ) &&
		        ( ISBLANK ( 'TBL Threshold Flags'[RangeMax] ) || __Metric <  'TBL Threshold Flags'[RangeMax] ) && 
		        NOT ISBLANK ( 'TBL Threshold Flags'[Icon Flag] )
		    )

		// Selecting a single row (highest RangeMin wins to break overlaps)
		VAR __ThresholdRow =
		    TOPN ( 1, __Table, 'TBL Threshold Flags'[RangeMin], DESC )

		VAR __Result =
		    IF ( 
		        ISBLANK ( __Metric ), BLANK(), 
		        MAXX ( __ThresholdRow, 'TBL Threshold Flags'[Icon Circle] )
		    ) 
		         
		 RETURN __Result
		```
		displayFolder: Geo\03. Actions Dots & Flags\01. Non-SVG
		dataCategory: ImageUrl
		lineageTag: 60b1c866-915f-44f0-80d8-e31a2d970c20

