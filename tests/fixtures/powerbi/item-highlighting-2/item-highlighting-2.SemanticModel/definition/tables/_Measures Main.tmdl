	measure '_Metric Switch PY KPI Card | Static Format' = ```


		VAR __Metric_abs = [_Metric Switch Variance abs. PY]
		VAR __Metric_rel = [_Metric Switch Variance rel. Var PY]

		VAR __Format_Rel    = "+0.0%;-0.0%;0%"
		VAR __Format_pp     = "+0.0pp;-0.0pp;0.0pp"
		VAR __Local_Format  = "en-US"
		VAR __Format_Abs    = "+#,0,.0K;-#,0,.0K;0"

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )
		VAR __Formatted_Rel     = FORMAT ( __Metric_rel, __Format_Rel, __Local_Format )
		VAR __Formatatted_pp    = FORMAT ( __Metric_abs * 100, __Format_pp ) 

		VAR __Icon_Up       =  "▲ "
		VAR __Icon_Down     =  "▼ "
		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "
		VAR __Icon          =  __Space & SWITCH ( TRUE (), __Metric_abs > 0 , __Icon_Up,  __Icon_Down )

		VAR __Selected_Unit_type =  SELECTEDVALUE ( 'TBL Metric Switch'[Unit Type] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                              // IF there is no change
		        __Selected_Unit_type = "Percentage", __Space & __Formatatted_pp & __Icon,   // IF percentage points
		        ISBLANK ( __Metric_rel ), __Space & __Formatted_Abs & __Icon,               // IF Relative var. is blank
		        __Space & __Formatted_Abs & __Divider & __Formatted_Rel & __Icon            // Both abs. & rel. variances
		    )

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: 47b6aa0d-e72c-4fc3-9187-7784ccdfff7d

	measure '_Metric Switch PY KPI Card | Dynamic Format' = ```


		VAR __Metric_abs = [_Metric Switch Variance abs. PY]
		VAR __Metric_rel = [_Metric Switch Variance rel. Var PY]

		VAR __Format_Rel        = "+0.0%;-0.0%;0%"
		VAR __Format_pp         = "+0.0pp;-0.0pp;0.0pp"
		VAR __Format_Abs_K      = "+#,0,.0K;-#,0,.0K;0"
		VAR __Format_Abs_M      = "+#,0,,.00M;-#,0,,.00M;0"
		VAR __Format_Abs_None   = "+#,0;-#,0;0"

		VAR __Local_Format = "en-US"

		VAR __Format_Abs = 
		    SWITCH (
		        TRUE(),
		        ABS( __Metric_abs ) >= 10^6, __Format_Abs_M,
		        ABS( __Metric_abs ) >= 10^3, __Format_Abs_K,   
		        __Format_Abs_None                             
		    )

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )
		VAR __Formatted_Rel     = FORMAT ( __Metric_rel, __Format_Rel, __Local_Format )
		VAR __Formatatted_pp    = FORMAT ( __Metric_abs * 100, __Format_pp ) 

		VAR __Icon_Up       =  "▲ "
		VAR __Icon_Down     =  "▼ "
		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "
		VAR __Icon          =  __Space & SWITCH ( TRUE (), __Metric_abs > 0 , __Icon_Up,  __Icon_Down )

		VAR __Selected_Unit_type =  SELECTEDVALUE ( 'TBL Metric Switch'[Unit Type] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                              // IF there is no change
		        __Selected_Unit_type = "Percentage", __Space & __Formatatted_pp & __Icon,   // IF percentage points
		        ISBLANK ( __Metric_rel ), __Space & __Formatted_Abs & __Icon,               // IF Relative var. is blank
		        __Space & __Formatted_Abs & __Divider & __Formatted_Rel & __Icon            // Both abs. & rel. variances
		    )

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: d9f57539-bc7e-47c2-8928-fc8d3fe8d970

