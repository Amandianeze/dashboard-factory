	measure '_Revenue per Customer Slicer FIlter' = ```


		/* one table – one evaluation of [_Revenue] per customer */
		VAR __Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_Name] ),
		        "@Rev", [_Revenue]
		    )


		VAR __Min = MIN ( 0, MINX ( __Table, [@Rev] ) )
		VAR __Max = MAXX ( __Table, [@Rev] )


		VAR __Selected_Value = [NR Values Median Revenue Value]

		VAR __Result =
		    IF ( 
		        __Selected_Value > __Min &&
		        __Selected_Value <= __Max, 1, 0 )

		RETURN __Result

		```
		displayFolder: Segmentation & Ranking\04. Quadrant\09. Others
		lineageTag: 644a846a-e7be-4a01-8161-182ccb1ad123

	measure '_Gross Margin % Perc per Customer Slicer FIlter' = ```


		/* one table – one evaluation of [_Revenue] per customer */
		VAR __Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_Name] ),
		        "@GM%", [_Gross Margin % Perc]
		    )


		VAR __Min = MIN ( 0, MINX ( __Table, [@GM%] ) )
		VAR __Max = MROUND ( MAXX ( __Table, [@GM%] ), 0.05)


		VAR __Selected_Value = [NR Values Median GM% Value]

		VAR __Result =
		    IF ( 
		        __Selected_Value > __Min &&
		        __Selected_Value <= __Max, 1, 0 )

		RETURN __Result

