	measure '_Revenue | Relative Delta | SVG | Dot Scale' = ```


		VAR __Is_At_Item_Level =
		    ISINSCOPE ( 'DIM_Geo'[Country name - adjusted] )
		    
		VAR __Relative_Variance =
		    [_Revenue Variance rel. PY]

		VAR __Base =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@Variance_Value", [_Revenue Variance rel. PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __BaseFiltered =
		    FILTER (
		        __Base,
		        NOT ISBLANK ( [@Variance_Value] )
		    )

		//______________________________________________________________________________________
		VAR __MinV   = MINX ( __BaseFiltered, [@Variance_Value] )
		VAR __MaxV   = MAXX ( __BaseFiltered, [@Variance_Value] )
		VAR __AbsMax = MAX ( MAX ( ABS ( __MinV ), ABS ( __MaxV ) ), 0.000001 )

		//______________________________________________________________________________________
		VAR __ColorPos  = SUBSTITUTE ( [_Positive Variance color], "#", "%23" ) //% to %23 to display as "Icon section"
		VAR __ColorNeg  = SUBSTITUTE ( [_Negative Variance color], "#", "%23" ) //% to %23 to display as "Icon section"
		VAR __ColorZero = SUBSTITUTE ( "#D0D6DC", "#", "%23" )                  //% to %23 to display as "Icon section"

		VAR __Rmin = 2
		VAR __Rmax = 10
		VAR __W    = 24
		VAR __H    = 24
		VAR __CX   = DIVIDE ( __W, 2 )
		VAR __CY   = DIVIDE ( __H, 2 )

		//______________________________________________________________________________________
		VAR __RadiusRaw =
		    __Rmin
		        + DIVIDE ( ABS ( __Relative_Variance ), __AbsMax, 0 ) * ( __Rmax - __Rmin )

		VAR __Radius =
		    MIN (
		        __Rmax,
		        MAX ( __Rmin, __RadiusRaw )
		    )

		VAR __Fill =
		    SWITCH (
		        TRUE(),
		            __Relative_Variance > 0, __ColorPos,
		            __Relative_Variance < 0, __ColorNeg,
		            __ColorZero
		    )

		//______________________________________________________________________________________
		VAR __SortShift  = 1000000000000
		VAR __SortKeyNum = ROUND ( ( __Relative_Variance + __SortShift ) * 1000000, 0 )
		VAR __SortKey    = FORMAT ( __SortKeyNum, "000000000000000000" )

		VAR __SvgPrefix = "data:image/svg+xml;utf8,"

		VAR __SvgOpen =
		"<svg
		  xmlns=        'http://www.w3.org/2000/svg'
		  width=        '" & __W & "'
		  height=       '" & __H & "'
		  viewBox=      '0 0 " & __W & " " & __H & "'
		  sort=         '" & __SortKey & "'
		>"

		VAR __SvgCircle =
		"<circle
		  cx=           '" & __CX & "'
		  cy=           '" & __CY & "'
		  r=            '" & ROUND ( __Radius, 0 ) & "'
		  fill=         '" & __Fill & "'
		  stroke=       '" & __Fill & "'
		  stroke-width= '1'
		/>"

		VAR __SvgClose = "</svg>"

		//______________________________________________________________________________________
		VAR __Result =
		SWITCH (
		        TRUE(),
		            NOT __Is_At_Item_Level, BLANK(),    // Can be either hidden or shown, but requires to add logic (code) to address the scalling for total level
		            ISBLANK ( __Relative_Variance ),
		            BLANK(),
		            __SvgPrefix & __SvgOpen & __SvgCircle & __SvgClose
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\05. Relative Variance
		dataCategory: ImageUrl
		lineageTag: fd18cdef-376b-4e73-b007-9d104f3923a1

	measure '_Dot Scale | Abs Var PY | SVG' = ```


		VAR __Metric     = [_Revenue Variance abs. PY]
		VAR __Inscope    = ISINSCOPE ( DIM_Customers[Country] ) || ISINSCOPE ( DIM_Geo[Country name - adjusted] )
		VAR __Show       = __Inscope && NOT ISBLANK ( __Metric )

		VAR __ColorPos   = "%234DA6A2" // "%23008E96"
		VAR __ColorNeg   = "%23B94D4D" 
		VAR __ColorZero  = "%23D0D6DC"

		VAR __Rmin       = 2
		VAR __Rmax       = 10

		VAR __Base =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            VALUES ( DIM_Customers[Country] ),
		            "@v", [_Revenue Variance abs. PY]
		        ),
		        ALLSELECTED ( DIM_Customers[Country] ),
		        ALLSELECTED ( DIM_Geo[Country name - adjusted] )
		    )

		VAR __MinV       = MINX ( __Base , [@v] )
		VAR __MaxV       = MAXX ( __Base , [@v] )
		VAR __AbsMax     = MAX ( ABS ( __MinV ), ABS ( __MaxV ) )

		VAR __Radius =
		    __Rmin + DIVIDE ( ABS ( __Metric ), __AbsMax, 0 ) * ( __Rmax - __Rmin )

		VAR __Fill =
		    SWITCH (
		        TRUE(),
		        __Metric > 0 , __ColorPos,
		        __Metric < 0 , __ColorNeg,
		        __ColorZero
		    )

		VAR __W  = 24
		VAR __H  = 24

		// Sort Logic (optional) //
		VAR __Shift        = __AbsMax + 1
		VAR __SortKeyNum   = __Metric + __Shift 
		VAR __SortKey      = FORMAT ( __SortKeyNum , "0000000000000000" )

		VAR __SvgPrefix  = "data:image/svg+xml;utf8,"
		VAR __SvgOpen    =
		"<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  viewBox='0 0 " & __W & " " & __H & "'
		  sort='" & __SortKey & "'
		>"
		VAR __SvgCircle  =
		"<circle
		  cx='12'
		  cy='12'
		  r='"      & ROUND ( __Radius, 0 ) & "'
		  fill='"   & __Fill & "'
		  stroke='" & __Fill & "'
		  stroke-width='1'
		/>"
		VAR __SvgClose   = "</svg>"

		VAR __Result =
		    IF ( 
		        __Show, __SvgPrefix & __SvgOpen & __SvgCircle & __SvgClose 
		    )

		RETURN __Result 

		```
		displayFolder: Geo\03. Actions Dots & Flags\02. SVG
		dataCategory: ImageUrl
		lineageTag: b7d7c4be-4460-49c5-8e3d-faa4c05172ec

