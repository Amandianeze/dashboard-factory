	measure '_Row Header Geo I' = ```


		VAR __Metric = [_Revenue]
		VAR __Icon =   SELECTEDVALUE ( DIM_Geo[Image URL (round)] )

		VAR __Inscope_Check =
		    ISINSCOPE ( DIM_Geo[Country name - adjusted] )     &&
		    NOT ( ISINSCOPE ( DIM_Customers[Customer_Name] ))  &&
		    NOT ( ISINSCOPE ( DIM_Customers[Segment] ))        &&
		    NOT ( ISINSCOPE ( DIM_Customers[Business_Line] ))
		    

		VAR __Result =
		    IF (
		        ISBLANK ( __Metric ) || NOT ( __Inscope_Check ),
		        BLANK(),
		        __Icon
		    )

		RETURN __Result
