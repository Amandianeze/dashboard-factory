	measure '_Revenue TopN Tag | Date Context' = ```

		VAR __CurrentCustomer =   SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __AtCustomerLevel =   ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __AtDateLevel =       ISINSCOPE ( 'Dim_Calendar'[mmm'yy]) || ISINSCOPE ( 'Dim_Calendar'[qq'yy with space])
		VAR __TopBin =            [NR Values 1-20 | Ranking 01 | Value]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID]
		            ),
		                "@Revenue",             [_Revenue],
		                "@Revenue_All_Dates" ,  CALCULATE ( [_Revenue] , ALLSELECTED ( 'Dim_Calendar' ) )

		        ),
		        NOT ISBLANK ( [@Revenue_All_Dates] )
		    )

		/***TOP-N TABLE ***/
		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue_All_Dates], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers =  FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )

		/***REVENUE CALCULATION***/
		VAR __AllRevenue    =  SUMX ( __BaseTable , [@Revenue] )

		/***CONDITIONS & CHECKS***/
		VAR __IsInTop =  
		    CONTAINS (                      
		        __TopN_Customers,
		        DIM_Customers[Customer_Name],   __CurrentCustomer
		    )

		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT ( __AtCustomerLevel ) && NOT ( __AtDateLevel ), 4,
		            NOT ( __AtCustomerLevel ) && __AtDateLevel,         5,
		            NOT ( __AtCustomerLevel ),                          0,
		            NOT ( ISBLANK ( __AllRevenue ) ) && __IsInTop,      1,
		            NOT ( ISBLANK ( __AllRevenue ) ),                   2, 
		            BLANK()
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\04. Top in the Date Context | Global TopN
		lineageTag: 3a231678-852b-4e84-97c8-031adc088230

	measure '_Revenue Value Alt. | Others as Median' = ```


		VAR __TopBin            = [NR Values 1-20 | Ranking 01 | Value]
		VAR __AtCustomerLevel   = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )
		VAR __CurrentCustomer   = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __IsOtherRow        = __CurrentCustomer = "Others"

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers    = FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers   = FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		VAR __TopNRevenue_Total = SUMX ( __TopN_Customers ,     [@Revenue] )
		VAR __AllRevenue_Total  = SUMX ( __Table_With_Ranking , [@Revenue] )

		VAR __OthersRevenue_Med = MEDIANX ( __Other_Customers, [@Revenue])
		VAR __OthersRevenue_Sum = __AllRevenue_Total - __TopNRevenue_Total

		VAR __TopNRevenue_Per_Row =
		    SUMX (
		        FILTER (
		            __TopN_Customers,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@Revenue]
		    )

		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            NOT __AtCustomerLevel, __AllRevenue_Total,
		            __IsOtherRow  , COALESCE ( __OthersRevenue_Med, 0 ) ,
		            __TopNRevenue_Per_Row
		    )

		RETURN __Result


		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\02. Others as Median
