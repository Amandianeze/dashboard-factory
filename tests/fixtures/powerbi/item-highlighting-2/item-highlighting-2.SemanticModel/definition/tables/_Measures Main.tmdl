	measure '_Action Dot | Non-SVG | Supplemental' = ```


		VAR __Metric =  [_Margin % Perc DIM Suppl]  

		VAR __Icon_Red_Strong =    MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Negative Strong" ), 'TBL Threshold Flags'[Icon Circle] )
		VAR __Icon_Red_Light =     MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Negative Light" ), 'TBL Threshold Flags'[Icon Circle] )
		VAR __Icon_Green_Light =   MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Positive Light" ), 'TBL Threshold Flags'[Icon Circle] )
		VAR __Icon_Green_Strong =  MAXX ( FILTER ( 'TBL Threshold Flags', 'TBL Threshold Flags'[Threshold Name V1] = "Positive Strong" ), 'TBL Threshold Flags'[Icon Circle] )


		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Metric ), BLANK(),
		            __Metric < 0.25,                       __Icon_Red_Strong,
		            __Metric >= 0.25 && __Metric < 0.30,   __Icon_Red_Light,
		            __Metric >= 0.30 && __Metric  < 0.40,  BLANK(),
		            __Metric >= 0.40 && __Metric < 0.45,   __Icon_Green_Light,
		            __Metric >= 0.45,                      __Icon_Green_Strong
		    )

		RETURN __Result
		```
		displayFolder: Geo\03. Actions Dots & Flags\01. Non-SVG
		lineageTag: d92a7be1-33ab-4937-9740-c686b5b48995

