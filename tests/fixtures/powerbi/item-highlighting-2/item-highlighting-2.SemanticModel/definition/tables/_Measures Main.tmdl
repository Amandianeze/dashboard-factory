	measure '_Revenue Waterfall Basic In Period' = ```

		VAR __SelectedCategory =  SELECTEDVALUE ( 'TBL Waterfall stucture totals | PY'[Name Short])

		VAR __Breakdown_Scope_Check =       
		    ISINSCOPE ( DIM_Customers[Business_Line] )      || 
		    ISINSCOPE ( DIM_Customers[Segment] )            ||
		    ISINSCOPE ( DIM_Customers[Country] )            ||
		    ISINSCOPE ( DIM_Geo[Country name - adjusted] )  ||
		    ISINSCOPE ( DIM_Customers[Customer_Name] ) 


		VAR __Value_Variance =      [_Revenue Variance abs. PY]
		VAR __Value_Actuals =       [_Revenue]
		VAR __Value_Comparison =    COALESCE ( [_Revenue PY], 0 )

		VAR __Result =
		    SWITCH (
		        __SelectedCategory,
		            "PY", 
		                SWITCH (
		                    TRUE(),
		                        __Breakdown_Scope_Check, __Value_Variance * (-1),
		                        __Value_Comparison
		                ),
		            "AC", 
		                SWITCH (
		                    TRUE(),
		                        __Breakdown_Scope_Check, IF ( ISBLANK ( __Value_Variance ), BLANK(), 0),
		                        __Value_Actuals
		                )
		    )

		RETURN __Result

		```
		formatStringDefinition = ```

			VAR __Breakdown_Scope_Check =       
			    ISINSCOPE ( DIM_Customers[Business_Line] )    || 
			    ISINSCOPE ( DIM_Customers[Segment] )          ||
			    ISINSCOPE ( DIM_Customers[Country] )          ||
			    ISINSCOPE ( DIM_Geo[Country name - adjusted] )  ||
			    ISINSCOPE ( DIM_Customers[Customer_Name] ) 

			VAR __Format_Variance = "+#,0;-#,0"
			VAR __Format_Standard = "#,0;#,0"

			VAR __Result =
			    SWITCH (
			        TRUE(),
			            __Breakdown_Scope_Check, 
			            __Format_Variance,
			            __Format_Standard

			    )

			RETURN __Result
			```
		displayFolder: Waterfall Structure
		lineageTag: 821e3bee-28ab-4e27-91ce-8cfceb028079

	measure '_Revenue Waterfall Basic In Period | Color' = ```

		VAR __Breakdown_Scope_Check =       
		    ISINSCOPE ( DIM_Customers[Business_Line] )    || 
		    ISINSCOPE ( DIM_Customers[Segment] )          ||
		    ISINSCOPE ( DIM_Customers[Country] )          ||
		    ISINSCOPE ( DIM_Geo[Country name - adjusted] )  ||
		    ISINSCOPE ( DIM_Customers[Customer_Name] ) 

		VAR __Variance_Value = [_Revenue Variance abs. PY]

		VAR __Format_Variance = 
		    SWITCH (
		        TRUE(),
		            __Variance_Value >=0, "#308C9A",
		            "#C05B5B"
		    )

		VAR __Format_Standard = "black"

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Breakdown_Scope_Check, 
		            __Format_Variance,
		            __Format_Standard

		    )

		RETURN __Result
		```
		displayFolder: Waterfall Structure
		lineageTag: a223d7b2-ccb6-4a94-a5ca-ed30a6f4deb7

