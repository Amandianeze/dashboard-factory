	measure '_Revenue Variance PY FX Color Alt.' = ```


		VAR __Metric_abs =     [_Revenue Variance abs. PY]
		VAR __Color_Positive = [_Positive Variance color alt.]
		VAR __Color_Negative = [_Negative Variance color alt.]
		VAR __Color_Neutral =  [_Neutral Variance color]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		         __Metric_abs > 0, __Color_Positive,
		         __Metric_abs < 0, __Color_Negative,
