	measure '_Revenue Variance PY | Customer Segm. x qq''yy | Heatmap Font Color' = ```


		//Calculation specifcally for breakdown: Customer Segment x Quarter & Year      // <-- input your fields here as a comment

		VAR __Value                = [_Revenue Variance abs. PY]                        // <-- choose your measure
		VAR __Threshold            = 0.70                                               // <-- choose your threshold
		VAR __DefaultFontColor     = "#243140"                                          // <-- Color for cells below the threshold
		VAR __HighlightedFontColor = "#FFFFFF"                                          // <-- Color for cells equal or above the threshold

		//_____________________________________________________________________________

		VAR __Table =
		    CALCULATETABLE (
		        SUMMARIZECOLUMNS (
		            Dim_Calendar[qqyy],
		            DIM_Customers[Segment],
		            "@Value", [_Revenue Variance abs. PY]
		        ),
		        ALLSELECTED ()
		    )

		//_____________________________________________________________________________

		VAR __MaxPositive = MAXX ( FILTER ( __Table, [@Value] > 0 ), [@Value] )
		VAR __MinNegative = MINX ( FILTER ( __Table, [@Value] < 0 ), [@Value] )

		VAR __Scale =
		    SWITCH (
		        TRUE (),
		            __Value > 0, DIVIDE ( __Value, __MaxPositive ),
		            __Value < 0, DIVIDE ( __Value, ABS ( __MinNegative ) ),
		            0
		    )

		//_____________________________________________________________________________

		VAR __Result =
		    SWITCH (
		        TRUE (),
		            ISBLANK ( __Value ),            BLANK (),
		            ABS ( __Scale ) < __Threshold,  __DefaultFontColor     & "",
		                                            __HighlightedFontColor & ""
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\08. Heat-map Structure
		lineageTag: dcca29ab-7aee-4153-819a-1f0cdcf78364

	measure '_ABC Tag | V2' = ```


		VAR __CategoryBin           = SELECTEDVALUE ( 'TBL Segment | ABC'[Name Display] )
		VAR __CurrentCustomer       = SELECTEDVALUE ( DIM_Customers[Customer_Name] )

		VAR __IsABCBinLevel         = ISINSCOPE ( 'TBL Segment | ABC'[Name Display] )
		VAR __IsCustomerLevel       = ISINSCOPE ( DIM_Customers[Customer_Name] )

		// Classification percentages
		VAR __PercentageA           = 0.80
		VAR __PercentageB           = 0.15

		// Cumulative thresholds
		VAR __CumThresholdA         = __PercentageA
		VAR __CumThresholdB         = __PercentageA + __PercentageB

		//_____________________________________________________________________________
		// BASE TABLE
		//_____________________________________________________________________________

		VAR __Total =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS (
		            DIM_Customers[Customer_Name],
		            DIM_Customers[Sort ID]
		        )
		    )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALL (
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __WithCumulative =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@CumPercent",
		            DIVIDE (
		                SUMX (
		                    WINDOW (
		                        1, ABS,
		                        0, REL,
		                        __BaseTable,
		                        ORDERBY ( [@Revenue], DESC )
		                    ),
		                    [@Revenue]
		                ),
		                __Total
		            )
		    )

		//_____________________________________________________________________________
		// ABC THRESHOLDS
		//_____________________________________________________________________________

		VAR __MinDiffA = MINX ( __WithCumulative, ABS ( [@CumPercent] - __CumThresholdA ) )
		VAR __MinDiffB = MINX ( __WithCumulative, ABS ( [@CumPercent] - __CumThresholdB ) )

		VAR __ThresholdA =
		    MINX (
		        FILTER (
		            __WithCumulative,
		            ABS ( [@CumPercent] - __CumThresholdA ) = __MinDiffA
		        ),
		        [@CumPercent]
		    )

		VAR __ThresholdB =
		    MINX (
		        FILTER (
		            __WithCumulative,
		            ABS ( [@CumPercent] - __CumThresholdB ) = __MinDiffB
		        ),
		        [@CumPercent]
		    )

		//_____________________________________________________________________________
		// CUSTOMERS IN CURRENT ABC BIN
		//_____________________________________________________________________________

		VAR __CustomersInBin =
		    FILTER (
		        __WithCumulative,
		        VAR __CumPercent    = [@CumPercent]
		        VAR __CustomerClass =
		            SWITCH (
		                TRUE (),
		                    __CumPercent <= __ThresholdA, "A",
		                    __CumPercent <= __ThresholdB, "B",
		                    "C"
		            )
		        RETURN
		            __CustomerClass = __CategoryBin
		    )

		VAR __CustomerInBin =
		    CONTAINS (
		        __CustomersInBin,
		        DIM_Customers[Customer_Name], __CurrentCustomer
		    )

		//_____________________________________________________________________________

		VAR __Result =
		    SWITCH (
		        TRUE (),
		            ISBLANK ( __CategoryBin ),                              BLANK (),
		            __IsCustomerLevel && __CustomerInBin,                   1,
		            __IsCustomerLevel,                                      BLANK (),
		            __IsABCBinLevel && NOT ISEMPTY ( __CustomersInBin ),    1,
		                                                                    BLANK ()
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\03. ABC
		lineageTag: b42f44be-0fff-4df7-94ea-b8caee2e8ae8

	measure '_Revenue | ABC Segment' = ```


		VAR __CategoryBin       = SELECTEDVALUE ( 'TBL Segment | ABC'[Name Display] )
		VAR __IsABCBinLevel     = ISINSCOPE ( 'TBL Segment | ABC'[Name Display] )

		// Classification percentages
		VAR __PercentageA       = 0.80
		VAR __PercentageB       = 0.15

		// Cumulative thresholds
		VAR __CumThresholdA     = __PercentageA
		VAR __CumThresholdB     = __PercentageA + __PercentageB

		//_____________________________________________________________________________
		// BASE TABLE
		//_____________________________________________________________________________

		VAR __Total =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS (
		            DIM_Customers[Customer_Name],
		            DIM_Customers[Sort ID]
		        )
		    )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALL (
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __WithCumulative =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@CumPercent",
		            DIVIDE (
		                SUMX (
		                    WINDOW (
		                        1, ABS,
		                        0, REL,
		                        __BaseTable,
		                        ORDERBY ( [@Revenue], DESC )
		                    ),
		                    [@Revenue]
		                ),
		                __Total
		            )
		    )

		//_____________________________________________________________________________
		// ABC THRESHOLDS
		//_____________________________________________________________________________

		VAR __MinDiffA = MINX ( __WithCumulative, ABS ( [@CumPercent] - __CumThresholdA ) )
		VAR __MinDiffB = MINX ( __WithCumulative, ABS ( [@CumPercent] - __CumThresholdB ) )

		VAR __ThresholdA =
		    MINX (
		        FILTER (
		            __WithCumulative,
		            ABS ( [@CumPercent] - __CumThresholdA ) = __MinDiffA
		        ),
		        [@CumPercent]
		    )

		VAR __ThresholdB =
		    MINX (
		        FILTER (
		            __WithCumulative,
		            ABS ( [@CumPercent] - __CumThresholdB ) = __MinDiffB
		        ),
		        [@CumPercent]
		    )

		//_____________________________________________________________________________
		// CUSTOMERS IN CURRENT ABC BIN
		//_____________________________________________________________________________

		VAR __CustomersInBin =
		    FILTER (
		        __WithCumulative,
		        VAR __CumPercent = [@CumPercent]
		        VAR __CustomerClass =
		            SWITCH (
		                TRUE (),
		                    __CumPercent <= __ThresholdA, "A",
		                    __CumPercent <= __ThresholdB, "B",
		                    "C"
		            )
		        RETURN
		            __CustomerClass = __CategoryBin
		    )

		VAR __CustomerFilter =
		    SELECTCOLUMNS (
		        __CustomersInBin,
		        "@Customer", DIM_Customers[Customer_Name]
		    )

		//_____________________________________________________________________________
		// APPLY ABC CUSTOMER SET
		//_____________________________________________________________________________

		VAR __RevenueForABCBin =
		    CALCULATE (
		        [_Revenue],
		        KEEPFILTERS (
		            TREATAS (
		                __CustomerFilter,
		                DIM_Customers[Customer_Name]
		            )
		        )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		            __IsABCBinLevel, __RevenueForABCBin,
		            [_Revenue]
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\03. ABC
		lineageTag: 34318569-f76b-47ad-86fb-6c0ee5409a31

	measure '_Revenue | ABC Segment | Independent' = ```


		VAR __CategoryBin     = SELECTEDVALUE ( 'TBL Segment | ABC'[Name Display] )
		VAR __CurrentCustomer = SELECTEDVALUE ( DIM_Customers[Customer_Name] )

		VAR __IsCustomerLevel = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __IsABCBinLevel   = ISINSCOPE ( 'TBL Segment | ABC'[Name Display] )

		// Classification percentages
		VAR __PercentageA = 0.80
		VAR __PercentageB = 0.15

		// Cumulative thresholds
		VAR __CumThresholdA = __PercentageA
		VAR __CumThresholdB = __PercentageA + __PercentageB

		//_____________________________________________________________________________
		// BASE TABLE
		//_____________________________________________________________________________

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALL (
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __Total = SUMX ( __BaseTable, [@Revenue] )

		VAR __WithCumulative =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@CumPercent",
		            DIVIDE (
		                SUMX (
		                    WINDOW (
		                        1, ABS,
		                        0, REL,
		                        __BaseTable,
		                        ORDERBY ( [@Revenue], DESC )
		                    ),
		                    [@Revenue]
		                ),
		                __Total
		            )
		    )

		//_____________________________________________________________________________
		// ABC THRESHOLDS
		//_____________________________________________________________________________

		VAR __MinDiffA = MINX ( __WithCumulative, ABS ( [@CumPercent] - __CumThresholdA ) )
		VAR __MinDiffB = MINX ( __WithCumulative, ABS ( [@CumPercent] - __CumThresholdB ) )

		VAR __ThresholdA =
		    MINX (
		        FILTER (
		            __WithCumulative,
		            ABS ( [@CumPercent] - __CumThresholdA ) = __MinDiffA
		        ),
		        [@CumPercent]
		    )

		VAR __ThresholdB =
		    MINX (
		        FILTER (
		            __WithCumulative,
		            ABS ( [@CumPercent] - __CumThresholdB ) = __MinDiffB
		        ),
		        [@CumPercent]
		    )

		//_____________________________________________________________________________
		// CUSTOMERS IN CURRENT ABC BIN
		//_____________________________________________________________________________

		VAR __CustomersInBin =
		    FILTER (
		        __WithCumulative,
		        VAR __CumPercent = [@CumPercent]

		        VAR __CustomerClass =
		            SWITCH (
		                TRUE (),
		                    __CumPercent <= __ThresholdA, "A",
		                    __CumPercent <= __ThresholdB, "B",
		                    "C"
		            )

		        RETURN
		            __CustomerClass = __CategoryBin
		    )

		//_____________________________________________________________________________
		// CURRENT RESULT SET
		//_____________________________________________________________________________

		VAR __CustomersForResult =
		    FILTER (
		        __CustomersInBin,
		        NOT __IsCustomerLevel
		            || DIM_Customers[Customer_Name] = __CurrentCustomer
		    )

		//_____________________________________________________________________________
		// RESULT
		//_____________________________________________________________________________

		VAR __Result =
		    SWITCH (
		        TRUE (),
		            __IsCustomerLevel, SUMX ( __CustomersForResult, [@Revenue] ),
		            __IsABCBinLevel,   SUMX ( __CustomersInBin, [@Revenue] ),
		            __Total
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\03. ABC
		lineageTag: 4cbcd1de-58b3-4a26-bbe2-43de9a6ae738

