	measure '_Revenue Format Dynamic V1' = ```


		[_Revenue]
		```
		formatStringDefinition = ```
			VAR __Unit =        SELECTEDVALUE ( 'TBL Units | Nominal'[Format String Suffix] )
			VAR __Value =       SELECTEDMEASURE()
			VAR __Value_ABS =   ABS ( __Value )

			VAR __Unit_Default =    "#,0,-#,0"
			VAR __Unit_Thousands =  "#,0,.0K;-#,0,.0K"
			VAR __Unit_Millions =   "#,0,,.00M;#,0,,.00M"
			VAR __Unit_Billions =   "#,0,,,.00B;#,0,,,.00B"

			VAR __Formatted_Value = 
			    SWITCH (
			        TRUE(),
			            __Value_ABS >= 10^9, __Unit_Billions,
			            __Value_ABS >= 10^6, __Unit_Millions, 
			            __Value_Abs >= 10^3, __Unit_Thousands, 
			            __Unit_Default 
			    )

			VAR __Result = __Formatted_Value

			RETURN __Result

			```
		displayFolder: Dynamic & Custom Formats
		lineageTag: 3658e673-b1c2-4e2c-b2a9-f0bb42245e6e

	measure '_Revenue Format Dynamic V2' = ```


		[_Revenue]
		```
		formatStringDefinition = ```
			VAR __Unit =            SELECTEDVALUE ( 'TBL Units | Nominal'[Format String Suffix] )
			VAR __Value =           SELECTEDMEASURE()
			VAR __Value_ABS =       ABS ( __Value )

			VAR __Unit_Default =    CALCULATE ( MAX ( 'TBL Units | Nominal'[Format String Suffix] ), 'TBL Units | Nominal'[Name] = "Default" )
			VAR __Unit_Thousands =  CALCULATE ( MAX ( 'TBL Units | Nominal'[Format String Suffix] ), 'TBL Units | Nominal'[Name] = "Thousands" )
			VAR __Unit_Millions =   CALCULATE ( MAX ( 'TBL Units | Nominal'[Format String Suffix] ), 'TBL Units | Nominal'[Name] = "Millions" )
			VAR __Unit_Billions =   CALCULATE ( MAX ( 'TBL Units | Nominal'[Format String Suffix] ), 'TBL Units | Nominal'[Name] = "Billions" )

			VAR __Formatted_Value = 
			    SWITCH (
			        TRUE(),
			            __Value_ABS >= 10^9, __Unit_Billions,
			            __Value_ABS >= 10^6, __Unit_Millions, 
			            __Value_Abs >= 10^3, __Unit_Thousands, 
			            __Unit_Default 
			    )

			VAR __Result = __Formatted_Value

			RETURN __Result


			```
		displayFolder: Dynamic & Custom Formats
		lineageTag: 08c556ce-81f3-4570-86a4-e417c9789cf9

	measure '_Revenue Format Dynamic V3' = ```


		[_Revenue]
		```
		formatStringDefinition = ```
			VAR __Value_ABS =       CALCULATE ( ABS ( SELECTEDMEASURE() ), ALLSELECTED() )

			VAR __Unit_Default =    [_Unit_01_Nominal_Default]
			VAR __Unit_Thousands =  [_Unit_02_Nominal_Thousands]
			VAR __Unit_Millions =   [_Unit_03_Nominal_Millions]
			VAR __Unit_Billions =   [_Unit_04_Nominal_Billions]

			VAR __Formatted_Value = 
			    SWITCH (
			        TRUE(),
			            __Value_ABS >= 10^9, __Unit_Billions,
			            __Value_ABS >= 10^6, __Unit_Millions, 
			            __Value_Abs >= 10^3, __Unit_Thousands, 
			            __Unit_Default 
			    )

			VAR __Result = __Formatted_Value & ""

			RETURN __Result

			```
