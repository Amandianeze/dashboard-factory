	measure '_Revenue Variance PY FX Color Alt. v4.1 Font' = ```


		VAR __Metric_abs =     [_Revenue Variance abs. PY]
		VAR __Color_Positive = [_Positive Variance color alt. v4.1 Font]
		VAR __Color_Negative = [_Negative Variance color alt. v4]
		VAR __Color_Neutral =  [_Neutral Variance color]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		         __Metric_abs > 0, __Color_Positive,
		         __Metric_abs < 0, __Color_Negative,
		         __Metric_abs = 0, __Color_Neutral
		    ) & ""

		RETURN __Result

