	measure '_Revenue Progress Bar vs PY | SVG (Dumbbell Triangle)' = ```

		/*════════════════════════════════════
		  A) DATA PER ROW
		════════════════════════════════════*/
		VAR __Act     = [_Revenue]
		VAR __Tgt     = [_Revenue PY]
		VAR __VarAbs  = __Act - __Tgt

		/*════════════════════════════════════
		  B) CONTEXT-WIDE SCALE
		════════════════════════════════════*/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Segment] ),
		            "@Act", [_Revenue] ,
		            "@Tar", [_Revenue PY]
		        ),
		        NOT ISBLANK ( [@Act] ) || NOT ISBLANK ( [@Tar] )
		    )

		VAR __ValueTable =
		    UNION (
		        SELECTCOLUMNS ( __BaseTable , "@v" , [@Act] ),
		        SELECTCOLUMNS ( __BaseTable , "@v" , [@Tar] )
		    )

		VAR __MinRaw = MIN ( MINX ( __ValueTable , [@v] ) , 0 )
		VAR __MaxRaw = MAXX ( __ValueTable , [@v] )
		VAR __Span   = __MaxRaw - __MinRaw

		/*════════════════════════════════════
		  C) LAYOUT & CO-ORDINATES
		════════════════════════════════════*/
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __Act - __MinRaw , __Span , 0 ) * __TrackW
		VAR __X_Tar    = __BarX + DIVIDE ( __Tgt - __MinRaw , __Span , 0 ) * __TrackW

		VAR __MidY         = __BarY + __BarH / 2
		VAR __LineThick    = 6
		VAR __TriW         = 10
		VAR __TriH         = 10

		VAR __IsPos        = __VarAbs >= 0
		VAR __DiffW        = ABS ( __X_Act - __X_Tar )
		VAR __Gap          = __DiffW - __TriW
		VAR __HasGap       = __Gap > 0.5


		VAR __LineX1 =
		    IF ( __HasGap ,
		         IF ( __IsPos , __X_Tar , __X_Act + __TriW ),
		         BLANK()
		    )
		VAR __LineX2 =
		    IF ( __HasGap ,
		         IF ( __IsPos , __X_Act - __TriW , __X_Tar ),
		         BLANK()
		    )

		/*════════════════════════════════════
		  D) COLORS
		════════════════════════════════════*/
		VAR __ColorVarPos  = "#3AA6A6"   -- darker teal (positive variance)
		VAR __ColorVarNeg  = "#C05555"   -- darker red  (negative variance)
		VAR __ColorDiff    = IF ( __VarAbs >= 0 , __ColorVarPos , __ColorVarNeg )

		/*════════════════════════════════════
		  E) INDIVIDUAL SVG BLOCKS
		════════════════════════════════════*/
		VAR __SVG_Open =
		"
		data:image/svg+xml;utf8,
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Act , "00000000000" ) & "'
		>
		"

		VAR __SVG_Line =
		    IF ( __HasGap ,
		"
		  <!-- variance line -->
		  <line
		    x1='"            & __LineX1     & "'
		    y1='"            & __MidY       & "'
		    x2='"            & __LineX2     & "'
		    y2='"            & __MidY       & "'
		    stroke='"        & __ColorDiff  & "'
		    stroke-width='"  & __LineThick  & "'
		    stroke-linecap='butt'
		  />
		", "" )

		VAR __SVG_Arrow =
		"
		  <!-- arrow at AC (direction of variance) -->
		  <polygon
		    points='
		      " & __X_Act & "," & __MidY & " " &
		      IF ( __IsPos,
		           __X_Act - __TriW & "," & ( __MidY - __TriH/2 ) & " " &
		           __X_Act - __TriW & "," & ( __MidY + __TriH/2 ),
		           __X_Act + __TriW & "," & ( __MidY - __TriH/2 ) & " " &
		           __X_Act + __TriW & "," & ( __MidY + __TriH/2 )
		      ) & "'
		    fill='" & __ColorDiff & "'
		    stroke='none'
		    stroke-width='0'
		  />
		"

		VAR __SVG_Close = "</svg>"

		/*════════════════════════════════════
		  F) CONCATENATION
		════════════════════════════════════*/
		VAR __ResultSVG =
		       __SVG_Open
		    &  __SVG_Line
		    &  __SVG_Arrow
		    &  __SVG_Close

		/*════════════════════════════════════
		  G) RESULT
		════════════════════════════════════*/
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ),   BLANK(),
		            NOT ISINSCOPE ( DIM_Customers[Segment] ), BLANK(),
		        __ResultSVG
		    )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment
		isHidden
		dataCategory: ImageUrl
		lineageTag: aef2783f-0d07-4fb2-870c-185417495612

	measure '_Revenue Progress Bar vs PY | SVG (Dumbbell Circle)' = ```

		/*════════════════════════════════════
		  A) DATA PER ROW
		════════════════════════════════════*/
		VAR __Act     = [_Revenue]
		VAR __Tgt     = [_Revenue PY]
		VAR __VarAbs  = __Act - __Tgt

		/*════════════════════════════════════
		  B) CONTEXT-WIDE SCALE
		  (scale all rows within current ALLSELECTED context)
		════════════════════════════════════*/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Segment] ),
		            "@Act", [_Revenue],
		            "@Tar", [_Revenue PY]
		        ),
		        NOT ISBLANK ( [@Act] ) || NOT ISBLANK ( [@Tar] )
		    )

		VAR __ValueTable =
		    UNION (
		        SELECTCOLUMNS ( __BaseTable, "@v", [@Act] ),
		        SELECTCOLUMNS ( __BaseTable, "@v", [@Tar] )
		    )

		VAR __MinRaw = MIN ( MINX ( __ValueTable, [@v] ), 0 )
		VAR __MaxRaw = MAXX ( __ValueTable, [@v] )
		VAR __Span   = __MaxRaw - __MinRaw

		/*════════════════════════════════════
		  C) LAYOUT & CO-ORDINATES
		════════════════════════════════════*/
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __Act - __MinRaw, __Span, 0 ) * __TrackW
		VAR __X_Tar    = __BarX + DIVIDE ( __Tgt - __MinRaw, __Span, 0 ) * __TrackW

		/* line center + dot spacing */
		VAR __Cy       = __BarY + __BarH / 2
		VAR __DotR     = 5                 -- circle radius (px)
		VAR __Gap      = __DotR            -- trim line so it doesn't run under the dot

		/* line endpoints trimmed by gap */
		VAR __LineX1   = MIN ( __X_Act, __X_Tar ) + __Gap
		VAR __LineX2   = MAX ( __X_Act, __X_Tar ) - __Gap
		VAR __HasGap   = __LineX2 > __LineX1

		/*════════════════════════════════════
		  D) COLORS
		════════════════════════════════════*/
		VAR __ColorPos     = "#62BDC0"    -- positive variance
		VAR __ColorNeg     = "#BF6A6A"    -- negative variance
		VAR __ColorDiff    = IF ( __VarAbs >= 0, __ColorPos, __ColorNeg )

		/* background track kept invisible (preserves consistent box size) */
		VAR __ColorBg        = "#F2F2F2"
		VAR __ColorBgBorder  = "#D9D9D9"

		/*════════════════════════════════════
		  E) INDIVIDUAL SVG BLOCKS
		════════════════════════════════════*/
		VAR __SVG_Open =
		"
		data:image/svg+xml;utf8,
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Act, "00000000000" ) & "'
		>
		"

		VAR __SVG_Track =
		"
		  <!-- invisible track area -->
		  <rect
		    x='"                & __BarX        & "'
		    y='"                & __BarY        & "'
		    width='"            & __TrackW      & "'
		    height='"           & __BarH        & "'
		    fill='"             & __ColorBg       & "'
		    stroke='"           & __ColorBgBorder & "'
		    fill-opacity='0'
		    stroke-opacity='0'
		    stroke-width='1'
		  />
		"

		VAR __SVG_Line =
		    IF ( __HasGap,
		"
		  <!-- dumbbell line -->
		  <line
		    x1='"            & __LineX1     & "'
		    y1='"            & __Cy         & "'
		    x2='"            & __LineX2     & "'
		    y2='"            & __Cy         & "'
		    stroke='"        & __ColorDiff  & "'
		    stroke-width='4'
		    stroke-linecap='butt'
		  />
		", "" )

		/* single marker: circle at Actual (solid, no border) */
		VAR __SVG_Marker =
		"
		  <!-- marker at Actual -->
		  <circle
		    cx='"            & __X_Act      & "'
		    cy='"            & __Cy         & "'
		    r='"             & __DotR       & "'
		    fill='"          & __ColorDiff  & "'
		    stroke='none'
		  />
		"

		VAR __SVG_Close = "</svg>"

		/*════════════════════════════════════
		  F) CONCATENATION
		════════════════════════════════════*/
		VAR __ResultSVG =
		       __SVG_Open
		    &  __SVG_Track
		    &  __SVG_Line
		    &  __SVG_Marker
		    &  __SVG_Close

		/*════════════════════════════════════
		  G) RESULT
		════════════════════════════════════*/
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ), BLANK(),
		            __ResultSVG
		    )

		RETURN __Result
		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment
		isHidden
		dataCategory: ImageUrl
		lineageTag: 52c25557-fba9-4806-b0b2-0475f3ea119b

