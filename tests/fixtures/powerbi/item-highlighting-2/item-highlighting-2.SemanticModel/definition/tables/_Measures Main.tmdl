	measure '_Revenue LTM Based on Date | Datesinperiod | Suppl cal.' = ```


		VAR __EndMonth =
		    MAX ( 'Dim_Calendar'[Date] )     

		VAR __Result =
		    CALCULATE (
		        [_Revenue] , 
		        DATESINPERIOD (                                       
		            'Dim_Calendar'[Date],
		            __EndMonth   ,
		            -12 ,
		            MONTH
		        ),
		        USERELATIONSHIP ('Dim_Calendar'[Date],'Dim Calendar Suppl'[Date] )
		    )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\01.AC
		lineageTag: 99df0b6e-4e33-4f16-a20c-34f0e4b74bd7

	measure '_Revenue LTM Based on Offset | with zeros' = ```


		VAR __Selected_Month = MAX ( 'Dim_Calendar'[CurrMonthOffset]  )
		VAR __Period_Window_ToDisplay =  12

		VAR __StartMonth = ( __Selected_Month - __Period_Window_ToDisplay ) + 1

		VAR __LTM_Calculation =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonth &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		VAR __xAxis_Offset = SELECTEDVALUE ( 'Dim Calendar Suppl'[CurrMonthOffset] )

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            __xAxis_Offset >= __StartMonth &&
		            __xAxis_Offset <= __Selected_Month,
		            COALESCE ( __LTM_Calculation, 0 ),
		            __LTM_Calculation
		    )

		RETURN  __Result

		```
		formatString: #,0;-#,0;0
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\01.AC
		lineageTag: 8ba3c9ef-36f2-422e-8762-2ceb25210f85

	measure '_Revenue Last 12 Months Based on Date' = ```


		VAR __SelectedDate =        MAX ( 'Dim_Calendar'[Date] )
		VAR __EndOfSelectedMonth =  EOMONTH ( __SelectedDate, 0 )
		VAR __StartOf13thMonth =    EOMONTH ( __EndOfSelectedMonth, -12 ) + 1

		VAR __DateRange = 
		    FILTER(
		        ALLSELECTED ( 'Dim_Calendar'[Date] ), 
		        'Dim_Calendar'[Date] >= __StartOf13thMonth &&
		        'Dim_Calendar'[Date] <= __EndOfSelectedMonth
		    )

		VAR __Result = 
		    CALCULATE(
		        [_Revenue], 
		        __DateRange, 
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		RETURN __Result


		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\01.AC
		lineageTag: f9e16a77-a187-45df-9816-4d69c876eb57

