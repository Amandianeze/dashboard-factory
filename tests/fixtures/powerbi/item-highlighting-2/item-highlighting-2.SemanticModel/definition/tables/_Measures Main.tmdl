		//         __Table,
		//         ORDERBY ( [_Revenue], DESC BLANKS LAST),
		//         LAST
		//     )

		// VAR __TopN_Customers =
		//     COUNTROWS(
		//         TOPN (
		//             __TOPn_Bin,
		//             __Table,
		//             [_Revenue],
		//             DESC
		//         )
		//     )
		       
		// VAR __Result =
		//     SWITCH (
		//         TRUE(),
		//             __IsOtherSelected, __TopN_Customers + 1,
		//              ISBLANK ( __Main_Metric ), BLANK(),
		//             __Ranking
