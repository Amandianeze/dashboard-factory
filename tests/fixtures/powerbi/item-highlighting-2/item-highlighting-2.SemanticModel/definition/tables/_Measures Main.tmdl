	measure '_Quadrant Per Customer | ID' = ```


		VAR __X_Axis_metric = [_Revenue]
		VAR __Y_Axis_metric = [_Gross Margin % Perc]

		VAR __X_Axis_Avg_metric = [_Revenue Average per item]
		VAR __Y_Axis_Avg_metric = [_Gross Margin % Perc Average per item]


		VAR __SCENARIO_HH =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 

		VAR __SCENARIO_LH =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 
		 
		VAR __SCENARIO_LL =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 

		VAR __SCENARIO_HL =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 

		VAR __Result =
		        SWITCH(
		            TRUE(),
		                __SCENARIO_HH, 1, 
		                __SCENARIO_LH, 2,
		                __SCENARIO_LL, 3,
		                __SCENARIO_HL, 4,
		                BLANK()
		        )
		Return
		    __Result
		```
		formatString: 0
		displayFolder: Segmentation & Ranking\04. Quadrant\03. Quadrant Logic - Basic (Based on Main Dim)
		lineageTag: a73c44d0-409e-4298-8f5e-87f08e0e08ee

	measure '_Quadrant Per Customer Suppl' = ```


		VAR __X_Axis_metric = [_Revenue DIM Suppl]
		VAR __Y_Axis_metric = [_Margin % Perc DIM Suppl]

		VAR __X_Axis_Avg_metric = [_Revenue Average per item]
		VAR __Y_Axis_Avg_metric = [_Gross Margin % Perc Average per item]


		VAR __SCENARIO_HH =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 

		VAR __SCENARIO_LH =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 
		 
		VAR __SCENARIO_LL =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 

		VAR __SCENARIO_HL =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 


		VAR __Customer_Is_in_scope = ISINSCOPE ( 'DIM_Customers_Supplemental alt'[Customer_Name] )
		VAR __Result =
		        SWITCH(
		            TRUE(),
		                NOT ( __Customer_Is_in_scope ), "ffffffff",
		                __SCENARIO_HH,"#54AEAE", 
		                __SCENARIO_LH,"#457EB7",
		                __SCENARIO_LL,"#BF6161",
		                __SCENARIO_HL,"#E67E22",
		                "#C7CAD0"
		                )
		Return
		    __Result
		```
		displayFolder: Segmentation & Ranking\04. Quadrant\04. Quadrant Logic - Extended (Based on Suppl Dim)
		lineageTag: 5641d349-0f1f-420d-9971-404203dc7c45

	measure '_Quadrant Per Customer Suppl Extended' = ```


		VAR __X_Axis_metric = [_Revenue DIM Suppl]
		VAR __Y_Axis_metric = [_Margin % Perc DIM Suppl]

		VAR __X_Axis_Avg_metric = [_Revenue Average per item]
		VAR __Y_Axis_Avg_metric = [_Gross Margin % Perc Average per item]


		VAR __SCENARIO_HH =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 

		VAR __SCENARIO_LH =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric >= __Y_Axis_Avg_metric 
		 
		VAR __SCENARIO_LL =   __X_Axis_metric < __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 

		VAR __SCENARIO_HL =   __X_Axis_metric >= __X_Axis_Avg_metric &&
		                     __Y_Axis_metric < __Y_Axis_Avg_metric 


		VAR __Customer_Is_in_scope = ISINSCOPE ( 'DIM_Customers_Supplemental alt'[Customer_Name] )
		VAR __Quadrant_Mode =        SELECTEDVALUE ('TBL Segment | Quadrant | Short'[Short Name])
		VAR __Result =
		        SWITCH(
		            TRUE(),
		                __Quadrant_Mode = "H&H", "#54AEAE",
		                __Quadrant_Mode = "L&H", "#457EB7",
		                __Quadrant_Mode = "L&L", "#BF6161",
		                __Quadrant_Mode = "H&L", "#E67E22",

		                NOT ( __Customer_Is_in_scope ), "ffffffff",
		                
		                __SCENARIO_HH,"#54AEAE", 
		                __SCENARIO_LH,"#457EB7",
		                __SCENARIO_LL,"#BF6161",
		                __SCENARIO_HL,"#E67E22",
		                "#C7CAD0"
		                )
		Return
		    __Result
		```
