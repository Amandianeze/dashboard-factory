	measure '_Revenue L13M Based on Offset' = ```


		VAR __Selected_Month = MAX ( 'Dim_Calendar'[CurrMonthOffset]  )
		VAR __Period_Window_ToDisplay =  13

		VAR __StartMonth = ( __Selected_Month - __Period_Window_ToDisplay ) + 1

		VAR __Result =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonth &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP( 'Dim_Calendar'[Date] , 'Dim Calendar Suppl'[Date] ) 
		    )

		RETURN 
		    __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\03.Last 13
		lineageTag: f2193c0b-88d4-4f5b-89d1-c6caabb72584

	measure '_Revenue Last N Based on Offset' = ```


		VAR __Selected_MonthID  = MAX ( 'Dim_Calendar'[CurrMonthOffset]  )
		VAR __Period_Window     = [NR Values 1-24 | Last N Periods | Value]

		VAR __StartMonthID =
		    __Selected_MonthID - __Period_Window + 1

		VAR __Result =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonthID &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_MonthID,
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		RETURN  __Result

		```
