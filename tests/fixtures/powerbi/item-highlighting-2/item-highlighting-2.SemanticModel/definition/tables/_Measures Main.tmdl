	measure '_Revenue Dynamic Rank Number Simpler' = ```

		VAR __CurrentCustomer    =   SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __At_Customer_Level  =   ISINSCOPE ( DIM_Customers_Supplemental[Customer] )
		VAR __TOPn_Bin           =   [NR Values 1-20 | Ranking 01 | Value]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		//***RANKING***//
		VAR __BaseTable_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@Rank",  
		            RANK (
		                DENSE, 
		                __BaseTable,
		                ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                LAST
		            )
		    )

		VAR __Ranking           = MAXX ( FILTER ( __BaseTable_With_Ranking, DIM_Customers_Supplemental[Customer] = __CurrentCustomer ),  [@Rank] ) 
		VAR __TopN_Customers    = CONTAINS ( FILTER ( __BaseTable_With_Ranking, [@Rank] <= __TOPn_Bin ), DIM_Customers_Supplemental[Customer], __CurrentCustomer )
		    
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __CurrentCustomer = "Others", __TOPn_Bin + 1,
		            __At_Customer_Level && __TopN_Customers, __Ranking, 
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\01. Core
		lineageTag: f5ce15bb-0623-4190-8d10-8cd5fcc35814

