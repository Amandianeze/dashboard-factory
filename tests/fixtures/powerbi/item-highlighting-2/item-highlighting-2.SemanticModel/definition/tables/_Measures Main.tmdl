	measure '_Metric Scale Synchro | Max x Factor | Slicer-based' = ```


		VAR __Y_Axis_Mode = SELECTEDVALUE ( 'TBL Y-Axis Scale | Unification'[Name Key] )

		VAR __Max_Value =
		    MAXX (
		        ALLSELECTED ( 
		            'Dim_Calendar'[Start of Month], // Include Sort Column
		            'Dim_Calendar'[mmm'yy] 
		        ),
		        MAX ( [_Revenue], [_Gross Profit] )
		    )

		VAR __Max_Value_Synchronized =  __Max_Value * 1.2

		VAR __Result =
