	measure '_Revenue PY Last 13 Periods by Grain' = ```


		VAR __Grain = SELECTEDVALUE ( 'TBL Granularity'[Name Short], "M" )   -- "M","Q","Y"

		-- anchor from the main calendar (single-select mmm'yy)
		VAR __EndPeriod =
		    SWITCH (
		        __Grain,
		        "M", MAX ( 'Dim_Calendar'[CurrMonthOffset] ),
		        "Q", MAX ( 'Dim_Calendar'[CurrQuarterOffset] ),
		        "Y", MAX ( 'Dim_Calendar'[CurrYearOffset] )
		    )

		VAR __Period_Window_ToDisplay =  13

		VAR __StartPeriod = ( __EndPeriod - __Period_Window_ToDisplay ) + 1

		//____Result values____
		VAR __Result_Monthly_Grain =
		    CALCULATE (
		        [_Revenue PY],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartPeriod &&
		        'Dim_Calendar'[CurrMonthOffset] <= __EndPeriod,
		        USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __Result_Quarterly_Grain =
		    CALCULATE (
		        [_Revenue PY],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrQuarterOffset] >= __StartPeriod &&
		        'Dim_Calendar'[CurrQuarterOffset] <= __EndPeriod,
		        USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __Result_Yearly_Grain =
		    CALCULATE (
		        [_Revenue PY],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrYearOffset] >= __StartPeriod &&
		        'Dim_Calendar'[CurrYearOffset] <= __EndPeriod,
		        USERELATIONSHIP ( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __Result =
		    SWITCH (
		        __Grain,
		        "M", __Result_Monthly_Grain,
		        "Q", __Result_Quarterly_Grain,
		        "Y", __Result_Yearly_Grain
		    )

		        
		RETURN __Result



		```
