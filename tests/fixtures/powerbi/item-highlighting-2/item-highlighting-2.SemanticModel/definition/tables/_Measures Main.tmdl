	measure '_Revenue Average per item' = ```


		VAR __AVG_Per_Item =
		    AVERAGEX (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		        [_Revenue]
		    )

		VAR __Result = __AVG_Per_Item

		RETURN __Result
