	measure '_Revenue Dynamic Sort Order Ext. Selection' = ```


		VAR __Sort_Metric =         SELECTEDVALUE( 'TBL Sorting Order Alt'[Name Alt PY] )
		VAR __Sort_Direction =      SELECTEDVALUE ('TBL Ranking Order | Direction'[Name 2] )   
		VAR __Value_Actuals =       [_Revenue]
		VAR __Value_Comparison =    [_Revenue PY]
		VAR __Value_Check =
		    NOT ( ISBLANK ( __Value_Actuals ) ) ||
		    NOT ( ISBLANK ( __Value_Comparison ) )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Value_Check,
		            __Sort_Metric & "_" & __Sort_Direction,
		            BLANK()
		    )
		            
		RETURN __Result

		```
