	measure '_Revenue Alt. Rank Number | Dynamic Switch' = ```


		VAR __TopBin            = [NR Values 1-20 | Ranking 01 | Value]
		VAR __AtCustomerLevel   = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )
		VAR __CurrentCustomer   = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __IsOtherRow        = __CurrentCustomer = "Others"
		VAR __Other_Mode        = SELECTEDVALUE ( 'TBL Type of Other Bin Aggregation'[ID] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",     [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		VAR __Ranking =
		    RANK (
		        DENSE,
		        __BaseTable ,  
		        ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		        LAST
		    )
		    
		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers    = FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers   = FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		VAR __TopN_Customers_Count =
		     COUNTROWS ( __TopN_Customers)

		VAR __Current_Rank_Top_Customers =
		    MAXX (
		        FILTER (
		            __TopN_Customers ,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@Rank] 
		    )

		VAR __Current_Rank_All_Customers =
		    MAXX (
		        FILTER (
		            __Table_With_Ranking ,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@Rank] 
		    )

		 VAR __Other_Items_Rank_Switch = 
		    SWITCH (
		        __Other_Mode,
		            1, __TopN_Customers_Count + 1,
		            2, __TopN_Customers_Count + 1,
		            BLANK()
		    )

		 VAR __Top_Items_Rank_Switch = 
		    SWITCH (
		        TRUE(),
		            __Other_Mode IN {1,2,3}, __Current_Rank_Top_Customers,
		            __Current_Rank_All_Customers
		    )

		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            NOT __AtCustomerLevel, BLANK(),
		            __IsOtherRow  , __Other_Items_Rank_Switch, 
		            __Top_Items_Rank_Switch
		    )

		RETURN __Result


		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\03. Others as Sum or Median (Switch)
		lineageTag: 7262a913-7bc7-4494-a749-7b40d3587243

	measure '_Revenue Alt. Extended % of Total | Dynamic Switch' = ```


		VAR __TopBin                  = [NR Values 1-20 | Ranking 01 | Value]
		VAR __AtCustomerLevel         = ISINSCOPE ( DIM_Customers_Supplemental[Customer] )
		VAR __CurrentCustomer         = SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __CurrentCustomer_Table   = VALUES ( DIM_Customers_Supplemental[Customer] )
		VAR __IsOtherRow              = __CurrentCustomer = "Others"
		VAR __Other_Mode              = SELECTEDVALUE ( 'TBL Type of Other Bin Aggregation'[ID] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALL ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers    = FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers   = FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		/* ---------- aggregates ---------- */
		VAR __TopNRevenue_Total =   SUMX ( __TopN_Customers ,     [@Revenue] )
		VAR __OthersRevenue_Total = SUMX ( __Other_Customers ,    [@Revenue] )
		VAR __AllRevenue_Total  =   SUMX ( __BaseTable ,          [@Revenue] )

		VAR __Revenue_Per_Row =
		    SUMX (
		        FILTER (
		            __BaseTable,
		            DIM_Customers_Supplemental[Customer] IN __CurrentCustomer_Table
		        ),
		        [@Revenue]
		    )

		VAR __TopNRevenue_Per_Row =
		    SUMX (
		        FILTER (
		            __TopN_Customers,
		            DIM_Customers_Supplemental[Customer] IN __CurrentCustomer_Table
		        ),
		        [@Revenue]
		    )

		/* ---------- percent calculations ---------- */
		VAR __Item_Perc_of_Total =          DIVIDE ( __Revenue_Per_Row, __AllRevenue_Total)
		VAR __TopNTotal_Perc_of_Total =     DIVIDE ( __TopNRevenue_Total, __AllRevenue_Total)
		VAR __TopNRow_Perc_of_Total =       DIVIDE ( __TopNRevenue_Per_Row, __AllRevenue_Total)
		VAR __Others_Perc_of_Total =        DIVIDE ( __OthersRevenue_Total, __AllRevenue_Total)


		/* ---------- value to return ---------- */
		VAR __Top_Items_Switch =                                // row-level (only Topn items)
		    IF ( 
		        __Other_Mode = 4, 
		        __Item_Perc_of_Total,                           // if all items visible
		        __TopNRow_Perc_of_Total                        // other modes (prefilter using TopN table)
		    )

		 VAR __Others_Items_Switch =                            // row-level (only 'Other' item)
		    SWITCH (
		        __Other_Mode,
		            1, COALESCE ( __Others_Perc_of_Total, 0 ),   // if others as sum
		            2, BLANK(),                                  // if others as median
		            BLANK()                                      // else
		    )

		 VAR __Total_Items_Switch =                             // total level
		    SWITCH (
		        __Other_Mode,
		            1, __Item_Perc_of_Total,                    // if others as sum 
		            2, BLANK(),                                 // if others as median
		            3, __TopNTotal_Perc_of_Total,               // if only topn items visible
		            4, __Item_Perc_of_Total                     // if all items visible 
		    )

		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            NOT __AtCustomerLevel,  __Total_Items_Switch,
		            __IsOtherRow  ,         __Others_Items_Switch ,
		                                    __Top_Items_Switch
		    )

		RETURN __Result


		```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\03. Others as Sum or Median (Switch)
		lineageTag: 470b8137-1cbb-4242-8524-b9480ed739fb

	measure '_Revenue TopN Tag Non-Date Context Timeseries' = ```

		VAR __CurrentCustomer =   SELECTEDVALUE ( DIM_Customers[Customer_Name] )
		VAR __AtCustomerLevel =   ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __AtDateLevel =       ISINSCOPE ( 'Dim_Calendar'[mmm'yy]) || ISINSCOPE ( 'Dim_Calendar'[qq'yy with space])
		VAR __TopBin =            [NR Values 1-20 | Ranking 01 | Value]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID]
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		/***TOP-N TABLE ***/
		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers =  FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )

		/***REVENUE CALCULATION***/
		VAR __AllRevenue    =  SUMX ( __BaseTable , [@Revenue] )

		/***CONDITIONS & CHECKS***/
		VAR __IsInTop =  
		    CONTAINS (                      
		        __TopN_Customers,
		        DIM_Customers[Customer_Name],   __CurrentCustomer
		    )

		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT ( __AtCustomerLevel ) || NOT ( __AtDateLevel ), 0,
		            NOT ( ISBLANK ( __AllRevenue ) ) && __IsInTop, 1,
		            NOT ( ISBLANK ( __AllRevenue ) ), 2, 
		            BLANK()
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\05. Top in the Date Context | Per-Period TopN
		lineageTag: bb0bca6f-ec8c-4e53-bfeb-966496a9cc60

