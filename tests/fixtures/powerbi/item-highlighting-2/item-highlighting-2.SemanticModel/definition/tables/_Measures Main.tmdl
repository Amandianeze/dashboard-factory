	measure '3. Top Bottom N Dynamic (delta AC-PY) | Even Split' = ```

		VAR __CategoryID     = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __TopN           = SELECTEDVALUE ( 'NR Values 1-20 | Ranking 01'[Ranking Dynamic Parameter], 10 )
		VAR __Is_At_Level    = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Current_ROw    = SELECTEDVALUE ( DIM_Customers[Customer_ID] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Customer_ID],
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Delta", [_Revenue Variance abs. PY]
		        ),
		        NOT ISBLANK ( [@Delta] )
		    )

		/* Top / Bottom / All Bins  */
		VAR __Top_Items =     TOPN ( __TopN, __BaseTable, [@Delta], DESC, DIM_Customers[Sort ID], ASC )
		VAR __Bottom_Items =  TOPN ( __TopN, __BaseTable, [@Delta], ASC, DIM_Customers[Sort ID], ASC )
		VAR __All_Items =     __BaseTable

		/* Overlapped Bin Handling */
		VAR __TopOnly =     EXCEPT ( __Top_Items,      __Bottom_Items )
		VAR __BottomOnly =  EXCEPT ( __Bottom_Items,   __Top_Items )
		VAR __Others =      EXCEPT ( __All_Items,      UNION ( __TopOnly, __BottomOnly ) )

		/* Is In Group Check */
		VAR __IsTop =       CONTAINS ( __TopOnly,    DIM_Customers[Customer_ID], __Current_ROw )
		VAR __IsBottom =    CONTAINS ( __BottomOnly, DIM_Customers[Customer_ID], __Current_ROw )
		VAR __IsOther =     CONTAINS ( __Others,     DIM_Customers[Customer_ID], __Current_ROw )

		/* Final assignment */
		VAR __Result =
		    IF (
		        NOT __Is_At_Level,
		        1,
		        SWITCH (
		            __CategoryID,
		            1, IF ( __IsTop,    1, 0 ), // Top
		            2, IF ( __IsOther,  1, 0 ), // Middle (Others)
		            3, IF ( __IsBottom, 1, 0 ), // Bottom
		            0                           // Else
		        )
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		lineageTag: 1ccf0364-5dea-4ef5-bf34-87f226ed58fa

	measure '3. Top Bottom N Dynamic (delta AC-PY) | One-side Split' = ```

		VAR __CategoryID     = SELECTEDVALUE ( 'TBL Top & Bottom & Others Simple'[ID] )
		VAR __TopN           = SELECTEDVALUE ( 'NR Values 1-20 | Ranking 01'[Ranking Dynamic Parameter], 10 )
		VAR __Is_At_Level    = ISINSCOPE ( DIM_Customers[Customer_Name] )
		VAR __Current_ROw    = SELECTEDVALUE ( DIM_Customers[Customer_ID] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Customer_ID],
		                DIM_Customers[Customer_Name],
		                DIM_Customers[Sort ID]
		            ),
		            "@Delta", [_Revenue Variance abs. PY]
		        ),
		        NOT ISBLANK ( [@Delta] )
		    )

		/* Top / Bottom / All Bins  */
		VAR __Top_Items =     TOPN ( __TopN, __BaseTable, [@Delta], DESC, DIM_Customers[Sort ID], ASC )
		VAR __Bottom_Items =  TOPN ( __TopN, __BaseTable, [@Delta], ASC, DIM_Customers[Sort ID], ASC )
		VAR __All_Items =     __BaseTable

		/* Overlapped Bin Handling */
		VAR __TopOnly =   __Top_Items  
		VAR __BottomOnly =  EXCEPT ( __Bottom_Items,   __Top_Items )
		VAR __Others =      EXCEPT ( __All_Items,      UNION ( __TopOnly, __BottomOnly ) )

		/* Is In Group Check */
		VAR __IsTop =       CONTAINS ( __TopOnly,    DIM_Customers[Customer_ID], __Current_ROw )
		VAR __IsBottom =    CONTAINS ( __BottomOnly, DIM_Customers[Customer_ID], __Current_ROw )
		VAR __IsOther =     CONTAINS ( __Others,     DIM_Customers[Customer_ID], __Current_ROw )

		/* Final assignment */
		VAR __Result =
		    IF (
		        NOT __Is_At_Level,
		        1,
		        SWITCH (
		            __CategoryID,
		            1, IF ( __IsTop,    1, 0 ), // Top
		            2, IF ( __IsOther,  1, 0 ), // Middle (Others)
		            3, IF ( __IsBottom, 1, 0 ), // Bottom
		            0                           // Else
		        )
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\02.Others as Breakdown\02. Top & Middle & Bottom
		lineageTag: 4c54499e-a547-4cad-8b68-e2c787389f6c

