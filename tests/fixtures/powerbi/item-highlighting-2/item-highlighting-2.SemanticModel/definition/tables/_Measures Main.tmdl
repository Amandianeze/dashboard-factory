	measure '_Pareto Cumulative Value | By Customer' = ```


		VAR __Table =
		    FILTER ( 
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Value", [_Metric Switch Rev Gross Vol]
		        ),
		        NOT ISBLANK ( [@Value] )
		    )

		VAR __Cumulative_Window =
		        WINDOW (
		            1, ABS,
		            0, REL,
		            __Table ,
		            ORDERBY ( 
		                [@Value], DESC )
		        )


		VAR __Cumulative_Value_Final =
		    SUMX (
		       __Cumulative_window,
		       [@Value]
		    )

		VAR __Result = __Cumulative_Value_Final

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\02. Pareto
		lineageTag: 4c672562-511b-467e-8084-56301a3ffe21

	measure '_Pareto Cumulative Value % Perc' = ```


		VAR __Table =
		    FILTER ( 
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            "@Value", [_Metric Switch Rev Gross Vol]
		        ),
		        NOT ISBLANK ( [@Value] )
		    )

		VAR __Cumulative_Window =
		        WINDOW (
		            1, ABS,
		            0, REL,
		            __Table ,
		            ORDERBY ( 
		                [@Value], DESC )
		        )

		VAR __Cumulative_Value =
		    SUMX ( __Cumulative_window, [@Value] )

		VAR __Total_Value =
		    SUMX (  __Table, [@Value] )

		VAR __Result = 
		    DIVIDE (
		        __Cumulative_Value,
		        __Total_Value
		    )

		RETURN __Result


		```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Segmentation & Ranking\02. Pareto
		lineageTag: f58132e8-374c-47bc-b641-59ab6184f1c0

