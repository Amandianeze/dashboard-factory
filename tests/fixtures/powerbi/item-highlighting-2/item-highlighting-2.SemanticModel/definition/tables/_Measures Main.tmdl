	measure '_Pareto Cumulative Value % Perc | Segment' = ```


		VAR __Table =
		    FILTER ( 
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Segment] ),
		            "@Value", [_Metric Switch Rev Gross Vol]
		        ),
		        NOT ISBLANK ( [@Value] )
		    )

		VAR __Cumulative_Window =
		        WINDOW (
		            1, ABS,
		            0, REL,
		            __Table ,
		            ORDERBY ( 
		                [@Value], DESC )
		        )


		VAR __Cumulative_Value =
		    SUMX ( __Cumulative_window, [@Value] )

		VAR __Total_Value =
		    SUMX (  __Table, [@Value] )

		VAR __Result = 
		    DIVIDE (
		        __Cumulative_Value,
		        __Total_Value
		    )

		RETURN __Result


		```
		displayFolder: Segmentation & Ranking\02. Pareto
		lineageTag: 1ac5ac19-c1a7-44b2-8fb0-80e745f21664

	measure '_Pareto Cumulative Value | By Segment' = ```


		VAR __Table =
