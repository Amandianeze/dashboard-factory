	measure '_Metric Switch PY KPI Card' = ```


		VAR __Metric_abs = [_Metric Switch Variance abs. PY]
		VAR __Metric_rel = [_Metric Switch Variance rel. Var PY]

		VAR __Format_Rel        = "+0.0%;-0.0%;0%"
		VAR __Format_pp         = "+0.0pp;-0.0pp;0.0pp"
		VAR __Format_Abs_K      = "+#,0,.0K;-#,0,.0K;0"
		VAR __Format_Abs_M      = "+#,0,,.0M;-#,0,,.0M;0"
		VAR __Format_Abs_None   = "+#,0;-#,0;0"

		VAR __Local_Format = "en-US"

		VAR __Format_Abs = "+#,0,.0K;-#,0,.0K;0"
		    // SWITCH (
		    //     TRUE(),
		    //     ABS( __Metric_abs ) >= 10^6, __Format_Abs_M,
		    //     ABS( __Metric_abs ) >= 10^3, __Format_Abs_K,   
		    //     __Format_Abs_None                             
		    // )

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )
		VAR __Formatted_Rel     = FORMAT ( __Metric_rel, __Format_Rel, __Local_Format )
		VAR __Formatatted_pp    = FORMAT ( __Metric_abs * 100, __Format_pp ) 

		VAR __Icon_Up       =  "▲ "
		VAR __Icon_Down     =  "▼ "
		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "
		VAR __Icon          =  __Space & SWITCH ( TRUE (), __Metric_abs > 0 , __Icon_Up,  __Icon_Down )

		VAR __Selected_Unit_type =  SELECTEDVALUE ( 'TBL Metric Switch'[Unit Type] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                              // IF there is no change
		        __Selected_Unit_type = "Percentage", __Space & __Formatatted_pp & __Icon,   // IF percentage points
		        ISBLANK ( __Metric_rel ), __Space & __Formatted_Abs & __Icon,               // IF Relative var. is blank
		        __Space & __Formatted_Abs & __Divider & __Formatted_Rel & __Icon            // Both abs. & rel. variances
		    )

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: e68a011e-6cab-433a-8632-7fa7e0441c67

	measure '_Metric Switch PY KPI Card FX Color' = ```


		VAR __Metric_abs =     [_Metric Switch Variance abs. PY]
		VAR __Color_Positive = [_Positive Variance color]
		VAR __Color_Negative = [_Negative Variance color]
		VAR __Color_Neutral =  [_Neutral Variance color]

		VAR __Is_Cost = SELECTEDVALUE( 'TBL Metric Switch'[Type] ) = "Negative"

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        
		        __Is_Cost && __Metric_abs > 0, __Color_Negative,
		        __Is_Cost && __Metric_abs < 0, __Color_Positive,

		        NOT(__Is_Cost) && __Metric_abs > 0, __Color_Positive,
		        NOT(__Is_Cost) && __Metric_abs < 0, __Color_Negative,

		        __Metric_abs = 0, __Color_Neutral
		    ) & ""

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: 3316e808-b18a-4e37-ada9-d69218655ba4

	measure '_Revenue PY KPI Card' = ```


		VAR __Metric_abs = [_Revenue Variance abs. PY]
		VAR __Metric_rel = [_Revenue Variance rel. PY]

		VAR __Format_Rel =  "+0.0%;-0.0%;0%"
		VAR __Format_Abs =  "+#,0,K;-#,0,K;0" // Fixed as Thousands without decimals

		VAR __Local_Format = "en-US"

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )
		VAR __Formatted_Rel     = FORMAT ( __Metric_rel, __Format_Rel, __Local_Format )

		VAR __Icon_Up       =  "▲ "
		VAR __Icon_Down     =  "▼ "
		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "
		VAR __Icon          =  __Space & SWITCH ( TRUE (), __Metric_abs > 0 , __Icon_Up,  __Icon_Down )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                         
		        ISBLANK ( __Metric_rel ), __Space & __Formatted_Abs & __Icon,         
		        __Space & __Formatted_Abs & __Divider & __Formatted_Rel & __Icon     
		    )

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: 1dfe2a30-9320-4e44-b3c5-77b67dd93902

	measure '_Revenue Variance PY FX Color' = ```


		VAR __Metric_abs =     [_Revenue Variance abs. PY]
		VAR __Color_Positive = [_Positive Variance color]
		VAR __Color_Negative = [_Negative Variance color]
		VAR __Color_Neutral =  [_Neutral Variance color]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		         __Metric_abs > 0, __Color_Positive,
		         __Metric_abs < 0, __Color_Negative,
		         __Metric_abs = 0, __Color_Neutral
		    ) & ""

		RETURN __Result

		```
		displayFolder: KPI Cards & Variance Highlighting
		lineageTag: bf908738-b8e1-4a67-b404-74e9a96e64cb

