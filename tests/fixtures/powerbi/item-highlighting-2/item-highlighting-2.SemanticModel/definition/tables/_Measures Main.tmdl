		        FILTER ( __WithCumulative, DIM_Customers[Customer_Name] = __Current_Customer ),
		        [@CumPercent]
		    )
		        
		// Classify customer
		VAR __CustomerClass = 
		    SWITCH (
		        TRUE(),
		            __CurrentCumPercent <= __ThresholdA, "A",
		            __CurrentCumPercent <= __ThresholdB, "B",
		            "C"

		        )
		    
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            NOT __Is_Customer || ISBLANK (__Current_Revenue ), BLANK(),
		            __CustomerClass = __Category_Bin, __CustomerClass,
		            BLANK()
		     )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\03. ABC
		lineageTag: 3ee74314-9555-4633-8e36-0eb7d07ebd16

	measure '_Revenue Heatmap Dynamic Threshold | Font Color | Customer' = ```

		//Calculation to be used when displaying breakdown by QQ'YY in combination with Customer (DIM_Customer)

		VAR __Value = [_Revenue]   

		VAR __Table =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[qqyy],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)
		    
		VAR __MIN =  MIN ( 0, MINX ( __Table, [@Revenue] ) )
		VAR __MAX =  MAXX ( __Table, [@Revenue] )
		       
		VAR __Span = __MAX - __MIN
		VAR __Scale = DIVIDE ( __Value - __MIN, __Span )

		VAR __Threshold = 0.8 // Font change above the threshold

		VAR __Default_Font_Colour = "#3D5671"
		VAR __Highlighted_Font_Colour = "#FFFFFF" 

		VAR __Result = 
		    SWITCH (
		        TRUE(), 
		            __Scale < __Threshold,      __Default_Font_Colour,
		            __Highlighted_Font_Colour
		    )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\08. Heat-map Structure
		lineageTag: f79b783b-2577-492d-b69a-33ca27071c1b

