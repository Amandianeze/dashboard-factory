	measure '_Action Dot | SVG' = ```


		VAR __Metric = [_Gross Margin % Perc]
		VAR __Show   = NOT ISBLANK ( __Metric )

		// thresholds (fractions). adjust if needed
		VAR __T1 = 0.25   // ≤ 25%   -> dark red   
		VAR __T2 = 0.30   // (25,30] -> light red  
		VAR __T3 = 0.40   // (30,40) -> transparent 
		VAR __T4 = 0.45   // [40,45) -> light green
		                  // ≥ 45%   -> dark green 

		/* colors */
		VAR __Green = "%234DA6A2"
		VAR __Red   = "%23B94D4D"

		/* pick color & opacity by band (5 steps) */
		VAR __Fill =
		    SWITCH (
		        TRUE(),
		        __Metric <= __T2 , __Red,
		        __Metric <  __T4 , __Green,
		        __Green
		    )

		VAR __Opacity =
		    SWITCH (
		        TRUE(),
		        __Metric <= __T1 , 1.0,   // dark red   
		        __Metric <= __T2 , 0.5,   // light red   
		        __Metric <  __T3 , 0.0,   // hidden     
		        __Metric <  __T4 , 0.5,   // light green
		        1.0                       // dark green  
		    )

		/* geometry */
		VAR __W = 24
		VAR __H = 24
		VAR __R = 8

		/* svg */
		VAR __SvgPrefix = "data:image/svg+xml;utf8,"
		VAR __SvgOpen =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"  & __W & "'
		  height='" & __H & "'
		  viewBox='0 0 " & __W & " " & __H & "'
		>
		"
		VAR __SvgDot =
		"
		  <circle
		    cx='12'
		    cy='12'
		    r='" & __R & "'
		    fill='" & __Fill & "'
		    fill-opacity='" & __Opacity & "'
		    stroke='" & __Fill & "'
		    stroke-opacity='" & __Opacity & "'
		    stroke-width='1'
		  />
		"
		VAR __SvgClose = "</svg>"

		/* result */
		VAR __Result =
		    IF ( __Show, __SvgPrefix & __SvgOpen & __SvgDot & __SvgClose )

		RETURN __Result
		```
		displayFolder: Geo\03. Actions Dots & Flags\02. SVG
		lineageTag: 072f6022-e024-45a7-bb08-4e2d47591291

	measure '_Gross Margin % Perc Duplic.' = ```

		[_Gross Margin % Perc]
