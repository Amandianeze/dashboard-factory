	measure '_Filters | Group Items Business Unit | Adv.' = ```

		// Adjust the DIM Name by using CTRL + SHIFT + L shortcut

		VAR __Filters_cap =     9 // Pick a value which is no greater than [number of rows minus 1]
		VAR __Filter_Row_ID =   SELECTEDVALUE ( 'TBL Filter Display Extended | Rows'[ID] )
		// VAR __Max_Row_ID =   MAXX ( ALLSELECTED ( 'TBL Filter Display Extended | Rows'[ID] ), 'TBL Filter Display Extended | Rows'[ID] )

		VAR __BusinessLine = 
		    SWITCH (
		        TRUE(),
		            NOT ( ISFILTERED ( DIM_Customers[Business_Line] ) ) && __Filter_Row_ID = 1, "- Not filtered 🛇",
		            ISFILTERED ( DIM_Customers[Business_Line] ),
		            --------------------------------------------------------
		                VAR __Table_Items    = VALUES ( DIM_Customers[Business_Line] ) 
		                VAR __Disctinct_No   = COUNTROWS (__Table_Items )
		                VAR __Items_Cap_diff = __Disctinct_No - __Filters_cap
		                VAR __Rank_Items =        
		                        ADDCOLUMNS ( 
		                            __Table_Items, "Rank", 
		                            RANKX ( 
		                                ALLSELECTED ( DIM_Customers[Business_Line] ), 
		                                DIM_Customers[Business_Line],, ASC, DENSE 
		                            ) 
		                        )

		                VAR __Items_TOPN    = TOPN (__Disctinct_No, __Rank_Items, [Rank] )
		                VAR __Filtered_Item = FILTER ( __Items_TOPN, [Rank] = __Filter_Row_ID )
		                VAR __Items_conca =       
		                        CONCATENATEX ( 
		                            FILTER ( 
		                                __Filtered_Item, __Filter_Row_ID <= __Filters_cap 
		                            ), 
		                            "- " & DIM_Customers[Business_Line]
		                        )

		                VAR __Items_conca_final = 
		                        SWITCH ( 
		                            TRUE(), 
		                            __Items_Cap_diff > 0  && __Filter_Row_ID =  __Filters_cap + 1, 
		                            "- and " & __Items_Cap_diff & IF ( __Items_Cap_diff = 1, " more item", " more items" ),
		                            __Items_conca
		                        )

		                RETURN __Items_conca_final
		    )

		VAR __Result = __BusinessLine

		RETURN __Result
		```
		displayFolder: Filter Display\04. Advanced Lvl. II
		lineageTag: 363a1e92-2cea-461c-818b-924d3bcc7bd2

	measure '_Filters | Group Items Segment | Ext' = ```


		VAR __Filters_cap = 10
		VAR __Filter_Row_ID =   SELECTEDVALUE ( 'TBL Filter Display Extended | Rows'[ID] )
		VAR __Filter_Col_Name = SELECTEDVALUE ( 'TBL Filter Display Extended | Column'[Name] )

		VAR __BusinessLine = 
		SWITCH (
		    TRUE(),
		        NOT ( ISFILTERED ( DIM_Customers[Segment] ) ) && __Filter_Row_ID = 1, "- Not filtered 🛇",
		        ISFILTERED ( DIM_Customers[Segment] ),
		        --------------------------------------------------------
		            VAR __Table_Items    = VALUES ( DIM_Customers[Segment] ) 
		            VAR __Disctinct_No   = COUNTROWS (__Table_Items )
		            VAR __Items_Cap_diff = __Disctinct_No - __Filters_cap
		            VAR __Rank_Items =        
		                    ADDCOLUMNS ( 
		                        __Table_Items, "Rank", 
		                        RANKX ( 
		                            ALLSELECTED ( DIM_Customers[Segment] ), 
		                            DIM_Customers[Segment],, ASC, DENSE 
		                        ) 
		                    )
		            VAR __Items_TOPN    = TOPN (__Disctinct_No, __Rank_Items, [Rank] )
		            VAR __Filtered_Item = FILTER ( __Items_TOPN, [Rank] = __Filter_Row_ID )
		            VAR __Items_conca =       
		                    CONCATENATEX ( 
		                        FILTER ( 
		                            __Filtered_Item, __Filter_Row_ID <= __Filters_cap 
		                        ), 
		                        "- " & DIM_Customers[Segment]
		                    )
		            VAR __Items_conca_final = 
		                    SWITCH ( 
		                        TRUE(), 
		                        --__Items_Cap_diff >= 0 && __Filter_Row_ID <= __Filters_cap , __Items_conca, 
		                        __Items_Cap_diff > 0  && __Filter_Row_ID =  __Filters_cap + 1, "- and " & __Items_Cap_diff & IF ( __Items_Cap_diff = 1, " more item", " more items" ),
		                        __Items_conca
		                    )

		            
		            RETURN __Items_conca_final
		)

		VAR __Result = __BusinessLine

		RETURN __Result
		```
		displayFolder: Filter Display\04. Advanced Lvl. II
		lineageTag: 643e34ea-a317-4261-ae32-aaeeed9ce413

