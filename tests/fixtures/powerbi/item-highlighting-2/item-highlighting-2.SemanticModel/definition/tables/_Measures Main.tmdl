		displayFolder: Segmentation & Ranking\04. Quadrant\01. Components (avg/medians per item)\01. Revenue
		lineageTag: fc8e3ee1-bfd0-48f7-89c6-d41376ef524a

	measure '_Revenue Average per item Alt.' = ```


		VAR __Table_Customer =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers_Supplemental[Customer], DIM_Customers_Supplemental[Customer_Sort_ID] ), 
		            "@Rev",  [_Revenue] 
		        ),
		        NOT ( ISBLANK ( [@Rev] ) )
		    )

		VAR __Average_per_item =
		    AVERAGEX (
		        __Table_Customer,
		        [@Rev]
		    )

		VAR __Result = __Average_per_item

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\04. Quadrant\01. Components (avg/medians per item)\01. Revenue
		lineageTag: 0ec6b6eb-e023-4aee-b311-1d1297835d2f

	measure '_Revenue Max x multiplier per item' = ```


		VAR __Max_Per_Item=
		    MAXX (
		        ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		        [_Revenue]
		    )

		VAR __Multiplier =  1.15
		VAR __Result =      __Max_Per_Item * __Multiplier

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\04. Quadrant\01. Components (avg/medians per item)\01. Revenue
		lineageTag: b6e46908-9eb1-4bb3-8873-4fc418595a8c

	measure '_Revenue Min x multiplier per item' = ```


		VAR __MIN_Per_Item =
		    MIN ( 
		        MINX (
		            ALLSELECTED ( DIM_Customers[Customer_Name], DIM_Customers[Sort ID] ),
		            [_Revenue]
		        ),
		        0
		    )
		    
		VAR __Multiplier =  1.15
		VAR __Result =      __MIN_Per_Item *  __Multiplier

		RETURN
		    __Result
		```
