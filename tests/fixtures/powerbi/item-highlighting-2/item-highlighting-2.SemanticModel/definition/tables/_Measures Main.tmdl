		VAR __IsOtherRow        = __CurrentCustomer = "Others"
		VAR __Other_Mode        = SELECTEDVALUE ( 'TBL Type of Other Bin Aggregation'[ID] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue",             [_Revenue],
		                "@Revenues_LTM",        [_Revenue LTM Based on Date | Datesinperiod],
		                "@Volume_LTM",          [_Volume LTM Based on Date | Datesinperiod],
		                "@Avg_Unit_Price_LTM",  [_Unit Price LTM Based on Date | Datesinperiod]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __Table_With_Ranking =
		    ADDCOLUMNS (
		        __BaseTable,
		            "@Rank",
		                RANK (
		                    DENSE,
		                    __BaseTable ,  
		                    ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		                    LAST
		            )
		    )

		VAR __TopN_Customers    =       FILTER ( __Table_With_Ranking, [@Rank] <= __TopBin )
		VAR __Other_Customers   =       FILTER ( __Table_With_Ranking, [@Rank] > __TopBin )

		VAR __TopNRevenue_Total =       SUMX ( __TopN_Customers ,     [@Revenues_LTM] )
		VAR __OthersRevenue_Total =     SUMX ( __Other_Customers ,    [@Revenues_LTM] )
		VAR __AllRevenue_Total  =       SUMX ( __Table_With_Ranking , [@Revenues_LTM] )

		VAR __TopNVolume_Total =        SUMX ( __TopN_Customers ,     [@Volume_LTM] )
		VAR __OthersVolume_Total =      SUMX ( __Other_Customers ,    [@Volume_LTM] )
		VAR __AllVolume_Total  =        SUMX ( __Table_With_Ranking , [@Volume_LTM] )

		VAR __TopNAvgUnitPrice_Total =   DIVIDE ( __TopNRevenue_Total, __TopNVolume_Total )
		VAR __OthersAvgUnitPrice_Total = DIVIDE ( __OthersRevenue_Total, __OthersVolume_Total )
		VAR __AllAvgUnitPrice_Total =    DIVIDE ( __AllRevenue_Total, __AllVolume_Total )

		VAR __OthersAvgUnitPrice_Med =   MEDIANX ( __Other_Customers, [@Avg_Unit_Price_LTM])

		VAR __TopNAvgUnitPrice_Per_Row =
		    MAXX (
		        FILTER (
		            __TopN_Customers,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@Avg_Unit_Price_LTM]
		    )

		VAR __AvgUnitPrice_Per_Row =
		    MAXX (
		        FILTER (
		            __BaseTable,
		            DIM_Customers_Supplemental[Customer] = __CurrentCustomer
		        ),
		        [@Avg_Unit_Price_LTM]
		    )

		VAR __Top_Items_Switch =
		    IF ( 
		        __Other_Mode = 4, __AvgUnitPrice_Per_Row,                   // If all items visible
		        __TopNAvgUnitPrice_Per_Row                                  // Otherwise (take into account the TopN prefiltered table)
		    )

		 VAR __Others_Items_Switch = 
		    SWITCH (
		        __Other_Mode,
		            1, COALESCE ( __OthersAvgUnitPrice_Total, 0 ),           // if others as sum (retrieving 0 is optional)
		            2, COALESCE ( __OthersAvgUnitPrice_Med, 0),              // if others as median (retrieving 0 is optional)
		            BLANK()                                                  // of other modes it should be blank
		    )   

		 VAR __Total_Items_Switch =                                         // total row
		    SWITCH (
		        __Other_Mode,
		            1, __AllAvgUnitPrice_Total,                             // Show total value
		            2, BLANK(),                                             // if others are show as median - do not show
		            3, __TopNAvgUnitPrice_Total,                            // if only TopN items are visible - show total for these items
		            4, __AllAvgUnitPrice_Total                              // if all items are visible - show grand total (all items)
		    )

		VAR __Result =
		    SWITCH (
		        TRUE() ,
		            NOT __AtCustomerLevel,  __Total_Items_Switch,           // outcome for total row
		            __IsOtherRow  ,         __Others_Items_Switch ,         // outcome for others row
		                                    __Top_Items_Switch              // else (for non-total row and not for Others row)
		    )

		RETURN __Result


		```
