	measure '_Revenue Dynamic Others as % | Card' = ```


		VAR __TopBin  = [NR Values 1-20 | Ranking 01 | Value]

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers[Customer_Name], 
		                DIM_Customers[Sort ID]
		            ),
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __TopN_Customers =
		    TOPN (
		        __TopBin ,
		        __BaseTable ,
		        [@Revenue] ,DESC,
		        DIM_Customers[Sort ID], ASC // Optional
		    )

		VAR __AllRevenue_Total      = SUMX ( __BaseTable , [@Revenue] )
		VAR __TopNRevenue_Total     = SUMX ( __TopN_Customers , [@Revenue] )
		VAR __OthersRevenue         = __AllRevenue_Total - __TopNRevenue_Total
		VAR __Others_Percentage     = DIVIDE ( __OthersRevenue, __AllRevenue_Total )

		VAR __Result = __Others_Percentage  
		    
		RETURN __Result





		```
