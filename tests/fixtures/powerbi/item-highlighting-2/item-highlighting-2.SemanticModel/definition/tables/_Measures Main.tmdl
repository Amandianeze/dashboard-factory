	measure '_Revenue Check Bin Value Matrix Customer | Quarterly' = ```


		VAR __Table =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[Start of Quarter],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)

		VAR __Bin =             [NR Values 1-20 | Ranking 01 | Value]
		VAR __TopN_Table =      TOPN ( __Bin, __Table,  [@Revenue], DESC )     
		VAR __BottomN_Table =   TOPN ( __Bin, __Table,  [@Revenue], ASC ) 

		VAR __Min_TopN =        MINX ( __TopN_Table,    [@Revenue] )
		VAR __Max_BottomN =     MAXX ( __BottomN_Table, [@Revenue] )

		VAR __Current_Value =   [_Revenue]
		 
		VAR __Result =   
		    SWITCH (
		        TRUE(),
		            __Current_Value >=  __Min_TopN ,      1,  // Top 3
		            __Current_Value <=  __Max_BottomN ,   2,  // Bottom 3
		            0                                         // Other Values
		    )

		RETURN __Result

		```
		formatString: 0
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\04. Two Dimensional Min & Max\02. Tag & Color CF
		lineageTag: d85e2898-4ef0-49c1-aca2-2b7e6c461115

	measure '_Revenue Top List Matrix Customer | Quarterly' = ```


		VAR __Table =
		CALCULATETABLE (
		    FILTER ( 
		        SUMMARIZECOLUMNS ( 
		            'Dim_Calendar'[Start of Quarter],
		            DIM_Customers[Customer_Name],
		            "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    ),
		    ALLSELECTED()
		)

		VAR __Bin =          [NR Values 1-20 | Ranking 01 | Value]
		VAR __TopN_Table =   TOPN ( __Bin, __Table,  [@Revenue], DESC )     
		VAR __Result =       CONCATENATEX ( __TopN_Table, FORMAT ( [@Revenue], "#,0,.0K;-#,0,.0K;0" ), " | ", [@Revenue], DESC ) 

		RETURN __Result

		```
		displayFolder: Markers & Data Points & Factors\01. Data Points (Markers)\04. Two Dimensional Min & Max\01. Values & Card Display
