	measure '_Revenue Dynamic Rank Value Only Bottom' = ```


		VAR __Ranking_Bin_Number =  [NR Values 1-20 | Ranking 01 | Value]
		    
		VAR __Revenue_of_all =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( DIM_Customers_Supplemental[Customer], 'DIM_Customers_Supplemental'[Customer_Sort_ID] )
		    )

		VAR __Revenue_of_top =
		    SUMX (
		        TOPN (
		            __Ranking_Bin_Number,
		            FILTER (
		                ADDCOLUMNS (
		                    ALLSELECTED ( DIM_Customers_Supplemental[Customer], 'DIM_Customers_Supplemental'[Customer_Sort_ID] ),
		                    "@Revenue", [_Revenue]
		                ),
		            NOT ISBLANK ( [_Revenue] )
		            ),
		            [@Revenue]
		        ),  
		        [@Revenue]
		    )

		VAR __Revenue_of_others = 
		    __Revenue_of_all - __Revenue_of_top

		VAR __Result = 
		    ROUND ( __Revenue_of_others, 0 )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\03.General & Totals\Aggregated & Totals\Archieved
		lineageTag: 2606481e-3b55-46c6-9dc7-ab81add94f74

	measure '_Revenue Dynamic Rank Value Only Bottom Alt.' = ```


		VAR __Ranking_Bin_Number = [NR Values 1-20 | Ranking 01 | Value]

		VAR __Revenue_of_all =
		    CALCULATE (
		        [_Revenue],
		        REMOVEFILTERS ( DIM_Customers_Supplemental[Customer] )
		    )

		VAR __Table =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers_Supplemental[Customer] ),
		        "@Ranking",
		        RANK (
		            DENSE, 
		            ALLSELECTED ( DIM_Customers_Supplemental[Customer] ), 
		            ORDERBY ( [_Revenue], DESC BLANKS LAST ),
		            LAST
		        )
		    )

		VAR __TOP =
		    SUMX (
		        FILTER ( __Table, [@Ranking] <= __Ranking_Bin_Number ),
		        [_Revenue]
		    )

		VAR __Result = 
		    ROUND ( __Revenue_of_all - __TOP, 0 )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\03.General & Totals\Aggregated & Totals\Archieved
		lineageTag: e80d0111-a674-4473-8c8c-2a070c010a2e

