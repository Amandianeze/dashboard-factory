	measure '_Revenue PY L13M' = ```


		VAR __Selected_Month = MAX ( 'Dim_Calendar'[CurrMonthOffset]  )
		VAR __Period_Window_ToDisplay =  13

		VAR __StartMonth = ( __Selected_Month - __Period_Window_ToDisplay ) + 1

		VAR __Result =
		    CALCULATE (
		        [_Revenue PY],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonth &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		RETURN 
		    __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\02.PY
		lineageTag: 12aeca16-88a2-467a-ae90-2b41065995ed

	measure '_Revenue PY Last N' = ```


		VAR __Selected_Month =
		    MAX ( 'Dim_Calendar'[CurrMonthOffset]  )

		VAR __Period_Window = [NR Values 1-24 | Last N Periods | Value]

		VAR __StartMonth =
		    __Selected_Month - __Period_Window + 1

		VAR __Result =
		    CALCULATE (
		        [_Revenue PY],
		        REMOVEFILTERS ( 'Dim_Calendar' ),
		        'Dim_Calendar'[CurrMonthOffset] >= __StartMonth &&
		        'Dim_Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP( 'Dim_Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		RETURN 
		    __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\02. Date Intelligence\02.LTM\02.PY
		lineageTag: 357813b0-c6ab-459e-88dd-e37c425f660e

