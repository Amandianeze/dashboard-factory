	measure '_Revenue Progress Bar vs PY | SVG | With Total' = ```


		// A) DATA PER ROW
		VAR __Act     = [_Revenue]
		VAR __Tgt     = [_Revenue PY]
		VAR __VarAbs  = __Act - __Tgt

		// B) CONTEXT SCALE
		VAR __BaseTable =
		    CALCULATETABLE (
		        ADDCOLUMNS (
		            FILTER (
		                VALUES ( DIM_Customers[Segment] ),
		                NOT ISBLANK ( [_Revenue] ) || NOT ISBLANK ( [_Revenue PY] )
		            ),
		            "@Act", [_Revenue] ,
		            "@Tar", [_Revenue PY]
		        ),
		        ALLSELECTED ( DIM_Customers )
		    )


		/*Segment Level)*/
		VAR __MaxRaw_Row_Level =
		    MAXX (
		        __BaseTable,
		        COALESCE ( MAX ( [@Act], [@Tar] ), [@Act], [@Tar] )
		    )

		VAR __MinRaw_Row_Level =
		    MIN (
		        MINX (
		            __BaseTable,
		            COALESCE ( MIN ( [@Act], [@Tar] ), [@Act], [@Tar] )
		        ),
		        0
		    )

		/*Total Level*/
		VAR __MinRaw_Total  = MIN ( 0 , COALESCE ( MIN ( __Act , __Tgt ), __Act, __Tgt ) )
		VAR __MaxRaw_Total  = COALESCE ( MAX ( __Act , __Tgt ), __Act, __Tgt )

		/*Switched Level*/
		VAR __IsTotal = NOT ISINSCOPE ( DIM_Customers[Segment] )
		VAR __MinRaw  = IF ( __IsTotal , __MinRaw_Total , __MinRaw_Row_Level )
		VAR __MaxRaw  = IF ( __IsTotal , __MaxRaw_Total , __MaxRaw_Row_Level )
		VAR __Span    = __MaxRaw - __MinRaw

		// C) LAYOUT & CO‑ORDINATES
		VAR __W        = 180
		VAR __H        = 35
		VAR __BarX     = 18
		VAR __BarY     = 8
		VAR __BarH     = 18
		VAR __TrackW   = __W - __BarX - 10

		VAR __X_Act    = __BarX + DIVIDE ( __Act - __MinRaw , __Span , 0 ) * __TrackW
		VAR __X_Tar    = __BarX + DIVIDE ( __Tgt - __MinRaw , __Span , 0 ) * __TrackW
		VAR __MainW    = MAX ( __X_Act - __BarX , 0 )

		VAR __DiffStart = MIN ( __X_Act , __X_Tar )
		VAR __DiffW     = ABS ( __X_Act - __X_Tar )
		VAR __DiffH     = __BarH * 0.6
		VAR __DiffY     = __BarY

		// D) COLORS
		VAR __ColorBg        = "#F2F2F2"   -- track background
		VAR __ColorBgBorder  = "#D9D9D9"   -- track border
		VAR __ColorActual    = "#5A6A81"   -- "#B2CEFB"   --"#A9ADB1"   -- actual bar

		VAR __ColorVarPos    = "#62BDC0"   -- "#2461C4"   -- positive Variance: Blue || Change to: "#308C9A" to show green
		VAR __ColorVarNeg    = "#BF6A6A"   -- "#B34E4E"   -- negative variance
		VAR __ColorDiff      = IF ( __VarAbs >= 0 , __ColorVarPos , __ColorVarNeg )

		// E) INDIVIDUAL SVG BLOCKS
		VAR __SVG_Prefix = "data:image/svg+xml;utf8,"
		VAR __SVG_Open =
		"
		<svg
		  xmlns='http://www.w3.org/2000/svg'
		  width='"              & __W & "'
		  height='"             & __H & "'
		  sort='"               & FORMAT ( __Act , "00000000000" ) & "'
		>
		"

		VAR __SVG_Track =
		"
		  <!-- track -->
		  <rect
		    x='"                & __BarX        & "'
		    y='"                & __BarY        & "'
		    width='"            & __TrackW      & "'
		    height='"           & __BarH        & "'
		    fill='"             & __ColorBg       & "'    
		    stroke='"           & __ColorBgBorder & "'  
		    fill-opacity=       '"   & 0 & "'
		    stroke-opacity=     '"   & 0 & "'       
		    stroke-width=       '1'
		  />
		"

		VAR __SVG_Actual =
		"
		  <!-- actual -->
		  <rect
		    x='"                & __BarX       & "'
		    y='"                & __BarY       & "'
		    width='"            & __MainW      & "'
		    height='"           & __BarH       & "'
		    fill='"             & __ColorActual  & "'
		  />
		"

		VAR __SVG_Variance =
		    IF ( __DiffW > 0 ,
		"
		  <!-- variance -->
		  <rect
		    x='"                & __DiffStart  & "'
		    y='"                & __DiffY      & "'
		    width='"            & __DiffW      & "'
		    height='"           & __DiffH      & "'
		    fill='"             & __ColorDiff    & "'
		  />
		", "" )

		VAR __SVG_Target =
		"
		  <!-- target -->
		  <line
		    x1='"            & __X_Tar                 & "'
		    y1='"            & ( __BarY - 4 )          & "'
		    x2='"            & __X_Tar                 & "'
		    y2='"            & ( __BarY + __BarH + 4 ) & "'
		    stroke='#4C4C4C'
		    stroke-width='1.5'
		    stroke-dasharray='0'
		  />
		"

		VAR __SVG_Close = "</svg>"

		// F) CONCATENATION
		VAR __ResultSVG =
		        __SVG_Prefix
		    &   __SVG_Open
		    &   __SVG_Track
		    &   __SVG_Actual
		    &   __SVG_Variance
		    &   __SVG_Target
		    &   __SVG_Close


		// G) RESULT
		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Act ) && ISBLANK ( __Tgt ),     BLANK(),
		            // NOT ISINSCOPE ( DIM_Customers[Segment] ),   BLANK(),
		        __ResultSVG
		    )

		RETURN __Result

		```
		displayFolder: 02. Base Variants\01.Revenue\04. Variances\SVG Metrics\01. Context: Segment or Country\09. Others
