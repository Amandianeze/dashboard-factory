	measure '_Revenue Dynamic Sort Order Basic' = ```


		VAR __Sort_Metric =         SELECTEDVALUE( 'TBL Sorting Order'[Name] )
		VAR __Value_Actual =        [_Revenue]
		VAR __Value_Comparative =   [_Revenue Variance abs. PY]

		VAR __Result =
		    SWITCH(
		        TRUE(),
		        __Sort_Metric = "Negative Variance",  __Value_Comparative * (-1),
		        __Sort_Metric = "Positive Variance",  __Value_Comparative,
		        __Sort_Metric = "Actuals",            __Value_Actual,
		        BLANK()
		    )

		RETURN __Result

		```
		displayFolder: Slicer Based Dynamic Sorting
		lineageTag: 028600b3-4915-4ee4-9d99-c2455b1c1e2a

	measure '_Revenue Dynamic Sort Order Ext. Business Line' = ```


		VAR __Sort_Metric =                 SELECTEDVALUE( 'TBL Sorting Order Alt'[Name Alt PY] )
		VAR __Sort_Direction =              SELECTEDVALUE ('TBL Ranking Order | Direction'[Name 2] )   
		VAR __Value_Actuals =               [_Revenue]
		VAR __Value_Comparison =            [_Revenue PY]
		VAR __Value_Comparison_Variance =   [_Revenue Variance abs. PY]

		VAR __Name_Category_ASC =          
		    RANK (
		        DENSE,
		        ALLSELECTED ( DIM_Customers[Business_Line] ),
		        ORDERBY ( DIM_Customers[Business_Line], ASC BLANKS LAST )
		    )

		VAR __Sort_DESC =
		    SWITCH (
		        TRUE(),
		            __Sort_Metric = "Name", __Name_Category_ASC,
		            __Sort_Metric = "AC",   __Value_Actuals,
		            __Sort_Metric = "PY",   __Value_Comparison,        
		            __Sort_Metric = "VAR",  __Value_Comparison_Variance,
		            BLANK()
		    )

		VAR __Sort_ASC =
		    __Sort_DESC * (-1)

		VAR __Result =
		    SWITCH (
		        __Sort_Direction,
		            "Desc.", __Sort_DESC,
		            "Asc.",  __Sort_ASC
		    )
		            
		RETURN __Result



		```
		displayFolder: Slicer Based Dynamic Sorting
		lineageTag: 2af23312-4b75-404e-8f68-2858e982664b

