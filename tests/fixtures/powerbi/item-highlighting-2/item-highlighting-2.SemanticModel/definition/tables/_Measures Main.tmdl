	measure '_Revenue Dynamic Rank Filter' = ```

		VAR __IsOtherSelected =    SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] ) = "Others"
		VAR __TOPn_Bin =           [NR Values 1-20 | Ranking 01 | Value]
		VAR __Main_Metric =        [_Revenue]
		VAR __Ranking =            [_Revenue Dynamic Rank Number]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            NOT ( __IsOtherSelected ) && ISBLANK ( __Main_Metric ), BLANK(),
		           __IsOtherSelected || __Ranking  <= __TOPn_Bin,
		           1,
		           0
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\01. Core
		lineageTag: d5ef3cc0-c26b-4b1f-9905-43e6a3595838

	measure '_Revenue Dynamic Rank Gradient Color' = ```


		VAR __Current_Customer  = SELECTEDVALUE ( 'DIM_Customers_Supplemental'[Customer] )
		VAR __IsOthers          = SELECTEDVALUE ( 'DIM_Customers_Supplemental'[Customer] ) = "Others"
		VAR __IsInScope         = ISINSCOPE ( 'DIM_Customers_Supplemental'[Customer] )
		VAR __TopBin            = [NR Values 1-20 | Ranking 01 | Value]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		    )

		VAR __Min_Value =  MINX ( __BaseTable , [@Revenue] )
		VAR __Max_Value =  MAXX ( __BaseTable , [@Revenue] )

		VAR __Value_Customer = 
		    MAXX ( FILTER ( __BaseTable, DIM_Customers_Supplemental[Customer] = __Current_Customer ), [@Revenue] )

		VAR __Span =  __Max_Value - __Min_Value
		VAR __Normalized =  
		    IF (
		        __Span > 0,
		        DIVIDE ( __Value_Customer - __Min_Value, __Span ),
		        0.5
		    )

		VAR __Hue = 210
		VAR __Lighntess_Cap = 10
		VAR __Lightness = 
		    IF (
		        __TopBin = 1, 30, 
		        90 - ROUND ( __Normalized * 60, 0 )
		    )

		VAR __Gradient_Color = "hsla(" & __Hue & ", 50%, " & __Lightness & "%, 0.9)"
		VAR __Others_Color   = "#CCCCCC"

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            NOT ( __IsInScope ), BLANK(),
		            __IsOthers, __Others_Color,  
		            __Gradient_Color 
		    )

		RETURN __Result
		```
		displayFolder: Segmentation & Ranking\01. Top & Ranking\01.Others as row\01. Core
		lineageTag: ceada3cb-cac3-4e68-8e6b-cbb48959d61f

	measure '_Revenue Dynamic Rank Number' = ```

		VAR __IsOtherSelected =      SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] ) = "Others"
		VAR __CurrentCustomer =      SELECTEDVALUE ( DIM_Customers_Supplemental[Customer] )
		VAR __Distincount =          DISTINCTCOUNT ( DIM_Customers_Supplemental[Customer] )
		VAR __TOPn_Bin =             [NR Values 1-20 | Ranking 01 | Value]
		VAR __Main_Metric =          [_Revenue]

		/***BASE TABLE***/
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		             ALLSELECTED ( 
		                DIM_Customers_Supplemental[Customer], 
		                DIM_Customers_Supplemental[Customer_Sort_ID] 
		            ),
		                "@Revenue", [_Revenue]
		        ),
		        NOT ISBLANK ( [@Revenue] ) 
		        // && DIM_Customers_Supplemental[Customer]  <> BLANK()
		    )

		/***TOP-N TABLE ***/
		VAR __TopN_Customers =
		    TOPN (
		        __TOPn_Bin ,
		        __BaseTable ,
		        [@Revenue] ,
		        DESC
		        // DIM_Customers_Supplemental[Customer_Sort_ID], ASC
		    )

		//***RANKING***//
		VAR __Ranking =
		    RANK (
		        DENSE, 
		        __BaseTable,
		        ORDERBY ( [_Revenue], DESC BLANKS LAST),
		        LAST
		    )

		/***COUTNS & CONDITIONS & CHECKS***/
		VAR __Count_of_Topn_Customers =
		    COUNTROWS ( __TopN_Customers )

		VAR __Count_of_Other_Customers =
		    COUNTROWS ( EXCEPT ( __BaseTable , __TopN_Customers ) )

		VAR __Has_Others =
		    __Count_of_Other_Customers > 0

		VAR __IsOtherRow =
		    __CurrentCustomer = "Others"

		VAR __CustomerInTopN =
		    CONTAINS (                      
		        __TopN_Customers,
		        DIM_Customers_Supplemental[Customer],   __CurrentCustomer
		    )

		//***RESULT***//
		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __IsOtherRow && __Has_Others, __Count_of_Topn_Customers + 1,
		            __CustomerInTopN, __Ranking, 
		            BLANK()
		    )

		RETURN __Result


		/*** PREVIOUS SOLUTION ***/
