	measure '_Metric Switch Variance abs. PY' = ```


		VAR __AC_Value = [_Metric Switch AC]
		VAR __PY_Value = [_Metric Switch PY]

		VAR __Result = __AC_Value - __PY_Value

		RETURN __Result
		```
		displayFolder: Metric Switch
		lineageTag: ee69d744-a9d0-422b-8ba9-2c306838e664

	measure '_Metric Switch Variance rel. Var PY' = ```


		VAR __AC_Value = [_Metric Switch AC]
		VAR __PY_Value = [_Metric Switch PY]

		VAR __Check = 
		    ISBLANK ( __AC_Value ) || 
		    ISBLANK ( __PY_Value ) ||
		    __AC_Value <= 0 || 
		    __PY_Value <= 0

		VAR __Relative_Variance = 
		    DIVIDE ( 
		        __AC_Value - __PY_Value,
		        __PY_Value
		    )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		           __Check, BLANK(),
		           __Relative_Variance
		    )

		RETURN __Result
		```
		displayFolder: Metric Switch
		lineageTag: 3f8c9443-547a-4f3d-a387-2d7b79107a40

