table 'TBL Scenario Selection'
	lineageTag: 256fa912-ecc9-4f58-9ab3-f915460f2e8f

	measure '_Selected Scenario | Card Reference Title V1' = ```

		VAR __Selected_Scenario = SELECTEDVALUE ( 'TBL Scenario Selection'[Display Name] ) 

		VAR __Result =
		    IF (
		        NOT ISBLANK ( __Selected_Scenario ),
		        __Selected_Scenario & ":",
		        " "
		    )

		RETURN __Result
		```
		displayFolder: 01. Text & Annotations
		lineageTag: 71b34581-c014-4721-aff3-9c1dab904909

	measure '_Selected Scenario | Card Reference Title V2' = ```


		VAR __Selected_Scenario = SELECTEDVALUE ( 'TBL Scenario Selection'[Display Name] ) 

		VAR __Result =
		    "vs " & __Selected_Scenario & ":"

		RETURN __Result
		```
		displayFolder: 01. Text & Annotations
		lineageTag: a88a1cd0-14d4-4b56-a829-83e748042f3b

	measure '_Selected Scenario (Multiple options) Title V1' = ```


		VAR __Selected_Scenario = SELECTEDVALUE ( 'TBL Scenario Selection'[Name] )

		VAR __Concatenated_Scenarios =
		    CONCATENATEX (
		        'TBL Scenario Selection',
		        'TBL Scenario Selection'[Name], ", ",
		        'TBL Scenario Selection'[ID], ASC
		    )

		VAR __Result =
		    IF (
		        ISBLANK ( __Selected_Scenario ),
		        __Concatenated_Scenarios,
		        __Selected_Scenario
		    )

		RETURN __Result
		```
		displayFolder: 01. Text & Annotations
		lineageTag: 0a227fed-0f03-4708-aa6c-9dbccdeed6c2

	measure '_Selected Scenario (Multiple options) Title V2' = ```


		VAR __Selected_Scenario = SELECTEDVALUE ( 'TBL Scenario Selection'[Name] )

		VAR __Concatenated_Scenarios =
		    CONCATENATEX (
		        'TBL Scenario Selection',
		        'TBL Scenario Selection'[Name], ", ",
		        'TBL Scenario Selection'[ID], ASC
		    )

		VAR __Result =
		"AC" & ", " &
		    IF (
		        ISBLANK ( __Selected_Scenario ),
		        __Concatenated_Scenarios,
		        __Selected_Scenario
		    )

		RETURN __Result
		```
		displayFolder: 01. Text & Annotations
		lineageTag: c990a53d-6e34-44b0-b087-5673e1606ac8

	measure '_Scenario PY Suppression | Basic | Color' = ```


		VAR __Scenario_Name     = "PY"
		// VAR __Is_Filtered_Check = ISCROSSFILTERED ( 'TBL Scenario Selection'[Name] )

		VAR __Scenario_Check = 
		    COUNTROWS ( 
		        FILTER ( 
		            'TBL Scenario Selection', 'TBL Scenario Selection'[Name] IN { __Scenario_Name } 
		        ) 
		    )

		VAR __Result = 
		    IF (
		        __Scenario_Check = 0 || ISBLANK ( __Scenario_Check ),
		        [_Transparent Color]
		    )

		RETURN __Result
		```
		displayFolder: 02. Color
		lineageTag: 3cb5524c-7e4e-4766-bdff-a7b34dac222d

	measure '_Scenario PY Suppression | Basic | Name' = ```


		VAR __Scenario_Name     = "PY"
		// VAR __Is_Filtered_Check = ISCROSSFILTERED ( 'TBL Scenario Selection'[Name] )

		VAR __Scenario_Check = 
