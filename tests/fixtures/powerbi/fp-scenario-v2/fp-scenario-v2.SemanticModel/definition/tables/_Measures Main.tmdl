	measure '_Normalized with PY Variance | Segment' = ```

		VAR __Table =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Segment] ),
		        "@PY", [_Revenue Variance abs. PY] ,
		        "@TG", [_Revenue Variance abs. Target]
		    )
		    
		VAR __MinValue =
		    MINX (
		        __Table,
		        MINX ( { [@PY], [@TG] }, [Value] )
		    )

		VAR __MaxValue =
		    MAXX (
		        __Table,
		        MAXX ( { [@PY], [@TG] }, [Value] )
		    )

		VAR __AbsMax =
		    MAX ( ABS ( __MinValue ), ABS ( __MaxValue ) )

		VAR __Result =
		    DIVIDE ( [_Revenue Variance abs. PY], __AbsMax )

		RETURN __Result

