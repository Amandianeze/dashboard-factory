	measure '_Customer Revenue | Retained (YoY) | Threshold' = ```


		VAR __Threshold = 0.05

		VAR __Base_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC],
		        "@Rev_PY",      [_Revenue PY | Equalized]
		    )

		VAR __Stable_Customers =
		ADDCOLUMNS (
		    FILTER (
		        __Base_Table,
		        NOT ISBLANK ( [@Rev_Current] ) &&
		        NOT ISBLANK ( [@Rev_PY] ) &&
		        ABS ( DIVIDE ( [@Rev_Current] - [@Rev_PY], [@Rev_PY] ) ) <= __Threshold
		    ),
		    "@Variance", [@Rev_Current] - [@Rev_PY]
		)

		VAR __Result =
		    SUMX ( __Stable_Customers, [@Variance] )

		RETURN __Result
		```
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\02. Customer Revenue or Variance
		lineageTag: b97f9f1a-a3e3-4b92-8613-6d86066ec41c

	measure '_Customer YoY Var | Growing (YoY) | Threshold' = ```


		VAR __Threshold = 0.05

		VAR __Base_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC],
		        "@Rev_PY",      [_Revenue PY | Equalized]
		    )

		VAR __Growing_Customers =
		    ADDCOLUMNS (
		        FILTER (
		            __Base_Table,
		            NOT ISBLANK ( [@Rev_Current] ) &&
		            NOT ISBLANK ( [@Rev_PY] ) &&
		            DIVIDE ( [@Rev_Current] - [@Rev_PY], [@Rev_PY] ) > __Threshold
		        ),
