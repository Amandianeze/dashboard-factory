	measure '_Dot Plot | Dynamic Data Label' = ```


		VAR __AC           = [_Revenue AC]
		VAR __PY           = [_Revenue PY | Equalized]
		VAR __DeltaNominal = __AC - __PY

		VAR __ValidRelative =
		    NOT ISBLANK ( __AC ) &&
		    NOT ISBLANK ( __PY ) &&
		    __AC > 0 &&
		    __PY > 0

		VAR __DeltaRelative = IF ( __ValidRelative, DIVIDE ( __DeltaNominal, __PY ) )

		VAR __SelectedMetrics = VALUES ( 'TBL Metric Display'[Name] )
		VAR __ShowValue = CONTAINSROW ( __SelectedMetrics, "Value" )

		VAR __DeltaOptions =
		    FILTER (
		        UNION (
		            ROW (
		                "@Metric", "Delta Nominal",
		                "@Sort", 2,
		                "@Value", __DeltaNominal,
		                "@Format", [_Variance Format]
		            ),
		            ROW (
		                "@Metric", "Delta Relative",
		                "@Sort", 3,
		                "@Value", __DeltaRelative,
		                "@Format", "+0%;-0%;0%"
		            )
		        ),
		        CONTAINSROW ( __SelectedMetrics, [@Metric] ) &&
		        NOT ISBLANK ( [@Value] )
		    )

		VAR __DeltaText =
		    CONCATENATEX (
		        __DeltaOptions,
		        FORMAT ( [@Value], [@Format] ),
		        " | ",
		        [@Sort],
		        ASC
		    )

		VAR __Label =
		    IF ( __ShowValue, "AC: " & FORMAT ( __AC, [_Value Format] ), "" ) &
		    IF (
		        __DeltaText <> "",
		        IF ( __ShowValue, " ", "" ) & "(" & __DeltaText & ")",
		        ""
		    )

		VAR __DisplayText =
		    IF (
		        NOT ISFILTERED ( 'TBL Metric Display'[Name] ),
		        UNICHAR ( 8206 ),
		        __Label
		    )

		VAR __Result = """" & __DisplayText & """"

		RETURN __Result

		```
		displayFolder: 09. Technical\09. Others
		lineageTag: f231db50-4158-4dae-ae27-817c3eb6ce4e

