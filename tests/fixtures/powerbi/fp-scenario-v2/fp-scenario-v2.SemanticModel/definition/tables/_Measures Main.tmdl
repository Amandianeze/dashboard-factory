	measure '_Revenue Target Suppression | Extended | Legend Circle' = ```


		VAR __Scenario_Legend_Text   = "  🞅TG" // UNICHAR(128901)
		VAR __Scenario_Name          = "TG"
		VAR __Is_Filtered            = ISFILTERED ( 'TBL Scenario Selection'[Name] )

		VAR __Scenario_Check = 
		    COUNTROWS ( 
		        FILTER ( 'TBL Scenario Selection', 'TBL Scenario Selection'[Name] IN { __Scenario_Name } ) 
