	measure '_Revenue PY KPI Card | Simplified V2' = ```

		// Icon Indicator on the right side

		VAR __Metric_abs = [_Revenue Variance abs. PY]
		VAR __Metric_rel = [_Revenue Variance rel. PY]

		VAR __Format_Rel =  "+0.0%;-0.0%;0%"
		VAR __Format_Abs =  "+#,0,K;-#,0,K;0" // Fixed as Thousands without decimals

		VAR __Local_Format = "en-US"

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )
		VAR __Formatted_Rel     = FORMAT ( __Metric_rel, __Format_Rel, __Local_Format )

		VAR __Icon_Up       =  "▲ "
		VAR __Icon_Down     =  "▼ "
		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "
		VAR __Icon          =  __Space & SWITCH ( TRUE (), __Metric_abs > 0 , __Icon_Up,  __Icon_Down )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                         
		        ISBLANK ( __Metric_rel ), __Space & __Formatted_Abs & __Icon,         
		        __Space & __Formatted_Abs & __Divider & __Formatted_Rel & __Icon     
		    )

		RETURN __Result
		```
		displayFolder: 02. Supplemental Calculations\02. Variances\01. PY\02. Supplemental
		lineageTag: 6715e9f2-3fec-4bf4-a2b5-e31f76b3ccd0

	measure '_Revenue Variance abs. Target' = ```


		VAR __Current =  [_Revenue AC]
		VAR __Target  =  [_Revenue Target]
		VAR __Result  =  __Current - __Target

		RETURN __Result
		```
		formatStringDefinition = ```
			[_Variance Format] & ""

			// "+#,0;-#,0;0"
			```
		displayFolder: 02. Supplemental Calculations\02. Variances\02. Target\01. Core
		lineageTag: dd5aa9f9-e6c6-43d6-92ad-2f84208a2713

	measure '_Revenue Variance rel. Target' = ```


		VAR __AC_Value = [_Revenue AC]
		VAR __Target_Value = [_Revenue Target]

		VAR __Check = 
		    ISBLANK ( __AC_Value ) || 
		    ISBLANK ( __Target_Value ) ||
		    __AC_Value <= 0 || 
		    __Target_Value <= 0

		VAR __Relative_Variance = 
		    DIVIDE ( 
		        __AC_Value - __Target_Value,
		        __Target_Value
		    )

		VAR __Result =
		    IF (
		        __Check, BLANK(),
		        __Relative_Variance
		    )

		RETURN __Result
		```
		formatString: +0.0%;-0.0%;0%
		displayFolder: 02. Supplemental Calculations\02. Variances\02. Target\01. Core
		lineageTag: 040aba2e-b938-442e-b625-cf2baa43a9d7

	measure '_Revenue Target KPI Card | Simplified V1' = ```

		// Icon Indicator on the left side

		VAR __Metric_abs = [_Revenue Variance abs. Target]
