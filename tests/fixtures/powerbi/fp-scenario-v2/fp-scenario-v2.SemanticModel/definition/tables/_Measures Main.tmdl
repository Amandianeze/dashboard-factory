	measure '_Customer Count | Extended (YoY) Name | Threshold' = ```


		VAR __Selected_Segment = VALUES ( 'TBL Customer Breakdown'[Name] )
		VAR __Threshold = 0.05

		VAR __Customer_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC],
		        "@Rev_PY",      [_Revenue PY | Equalized]
		    )

		VAR __Customer_Table_With_Variance =
		    ADDCOLUMNS (
		        __Customer_Table,
		        "@Variance", DIVIDE ( [@Rev_Current] - [@Rev_PY], [@Rev_PY] )
		    )

		VAR __Customer_Table_Segment =
		    ADDCOLUMNS (
		        __Customer_Table_With_Variance,
		        "@Segment",
		            SWITCH (
		                TRUE(),
		                    NOT ISBLANK ( [@Rev_Current] ) && ISBLANK ( [@Rev_PY] ),                                        "New",
		                    ISBLANK ( [@Rev_Current] )     && NOT ISBLANK ( [@Rev_PY] ),                                    "Lost",

		                    NOT ISBLANK ( [@Rev_Current] ) && NOT ISBLANK ( [@Rev_PY] ) && [@Variance] > __Threshold,       "Growing",
		                    NOT ISBLANK ( [@Rev_Current] ) && NOT ISBLANK ( [@Rev_PY] ) && [@Variance] < -__Threshold,      "Declining",

		                    NOT ISBLANK ( [@Rev_Current] ) && NOT ISBLANK ( [@Rev_PY] ),                                    "Stable"
		            )
		    )
		    
		VAR __Customer_Table_Segment_Filtered =
		    FILTER (
		        __Customer_Table_Segment,
		        [@Segment] IN __Selected_Segment
		    )

		VAR __Result = 
		    IF (
		        ISINSCOPE ( DIM_Customers[Customer_Name] ),
		        MAXX ( __Customer_Table_Segment_Filtered, [@Segment] )
		    )

		RETURN __Result
		```
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\03. Logic Based on YoY
		lineageTag: 9c941021-6bd4-4184-8e1f-9dcfb5719e61

	measure '_Customer Count | Extended (YoY) | Threshold' = ```


		VAR __Selected_Segment = VALUES ( 'TBL Customer Breakdown'[Name] )
		VAR __Threshold = 0.05

		VAR __Customer_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC],
		        "@Rev_PY",      [_Revenue PY | Equalized]
		    )

		VAR __Customer_Table_With_Variance =
		    ADDCOLUMNS (
		        __Customer_Table,
		        "@Variance", DIVIDE ( [@Rev_Current] - [@Rev_PY], [@Rev_PY] )
		    )

		VAR __Customer_Table_Segment =
		    ADDCOLUMNS (
		        __Customer_Table_With_Variance,
		        "@Segment",
		            SWITCH (
		                TRUE (),
		                NOT ISBLANK ( [@Rev_Current] ) && ISBLANK ( [@Rev_PY] ),                                   "New",
		                ISBLANK ( [@Rev_Current] )     && NOT ISBLANK ( [@Rev_PY] ),                               "Lost",

		                NOT ISBLANK ( [@Rev_Current] ) && NOT ISBLANK ( [@Rev_PY] ) && [@Variance] > __Threshold,  "Growing",
		                NOT ISBLANK ( [@Rev_Current] ) && NOT ISBLANK ( [@Rev_PY] ) && [@Variance] < -__Threshold, "Declining",

		                NOT ISBLANK ( [@Rev_Current] ) && NOT ISBLANK ( [@Rev_PY] ),                               "Stable"
		                        
		            )
		    )

		VAR __Customer_Table_Segment_Filtered =
		    FILTER (
		        __Customer_Table_Segment,
		        [@Segment] IN __Selected_Segment
		    )

		VAR __Result = 
		    COUNTROWS ( __Customer_Table_Segment_Filtered )

