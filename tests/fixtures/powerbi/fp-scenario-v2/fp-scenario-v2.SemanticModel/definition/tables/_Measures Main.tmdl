	measure '_Customer Count | Lost' = ```

		VAR __Current_Dates =
		    VALUES ( 'Dim Calendar'[Date] )

		VAR __Base_Table =
		    CALCULATETABLE (                  
		        ADDCOLUMNS (                        
		            VALUES ( DIM_Customers[Customer_ID] ), 
		            "@Last_Date", 
		                CALCULATE ( 
		                    EOMONTH ( MAX ( FCT_Summarized_Data[Date] ), 1 ),  
		                    REMOVEFILTERS ( 'Dim Calendar' )
		                    )
		                ),
		        REMOVEFILTERS ( 'Dim Calendar' )
		    )
		    
		VAR __Lost_Customers =
		    FILTER (
		        __Base_Table,
		        [@Last_Date] IN __Current_Dates
		    )

		VAR __Result =
		    COUNTROWS ( __Lost_Customers )

		RETURN __Result

		```
		formatString: #,0;-#,0;
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\02. Logic Based on Dates
		lineageTag: f0af6d72-8f1d-4d6a-8a6e-3299662e6953

	measure '_Customer Count | New' = ```

		VAR __Current_Dates =
		    VALUES ( 'Dim Calendar'[Date] )

		VAR __Base_Table =
		    CALCULATETABLE (                  
		        ADDCOLUMNS (                        
		            VALUES ( DIM_Customers[Customer_ID] ), 
		            "@First_Date", 
		                CALCULATE ( 
		                    MIN ( FCT_Summarized_Data[Date] ), 
		                    REMOVEFILTERS ( 'Dim Calendar' )
		                    )
		                ),
		        REMOVEFILTERS ( 'Dim Calendar' )
		    )
		    
		VAR __New_Customers =
		    FILTER (
		        __Base_Table,
		        [@First_Date] IN __Current_Dates
		    )

		VAR __Result =
		    COALESCE ( COUNTROWS ( __New_Customers ), 0 )

		RETURN __Result



		```
		formatString: #,0;-#,0;
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\02. Logic Based on Dates
		lineageTag: b458dbb2-35cc-46f5-96b1-55e3c2f3d38c

	measure '_Customer Count | Growing (YoY)' = ```

