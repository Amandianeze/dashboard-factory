	measure '_Dot Plot | Revenue Rank by Business Line | alt' = ```


		VAR __BusinessLineTable =
		    CALCULATETABLE (
		        SUMMARIZECOLUMNS (
		            DIM_Customers[Business_Line],
		            "@BusinessMetric", [_Revenue AC]
		        ),
		        ALLSELECTED (
		            DIM_Customers[Business_Line],
		            DIM_Customers[Segment]
		        )
		    )

		VAR __SegmentTable =
		    CALCULATETABLE (
		        SUMMARIZECOLUMNS (
		            DIM_Customers[Business_Line],
		            DIM_Customers[Segment],
		            "@SegmentMetric", [_Revenue AC]
		        ),
		        ALLSELECTED (
		            DIM_Customers[Business_Line],
		            DIM_Customers[Segment]
		        )
		    )

		VAR __RankingTable =
		    NATURALLEFTOUTERJOIN (
		        __SegmentTable,
		        __BusinessLineTable
		    )

		VAR __SegmentRank =
		    RANK (
		        DENSE,
		        __RankingTable,
		        ORDERBY (
		            [@BusinessMetric], DESC,
		            [@SegmentMetric], DESC,
		            DIM_Customers[Business_Line], ASC,
		            DIM_Customers[Segment], ASC
		        ),
		        LAST,
		        ,
		        MATCHBY (
		            DIM_Customers[Business_Line],
		            DIM_Customers[Segment]
		        )
		    )

		VAR __BusinessLineRank =
		    RANK (
		        DENSE,
		        __BusinessLineTable,
		        ORDERBY (
		            [@BusinessMetric], DESC,
		            DIM_Customers[Business_Line], ASC
		        ),
		        LAST,
		        ,
		        MATCHBY ( DIM_Customers[Business_Line] )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        ISINSCOPE ( DIM_Customers[Segment] ), __SegmentRank,
		        ISINSCOPE ( DIM_Customers[Business_Line] ), __BusinessLineRank,
		        BLANK ()
		    )

		RETURN __Result

		```
		formatString: 0
		displayFolder: 09. Technical\09. Others
		lineageTag: b1d65758-5657-4a33-9699-ec020b3bc9e7

	measure '_Dot Plot | Revenue Rank by Top Segment' = ```


		VAR __SegmentTable =
		    CALCULATETABLE (
		        SUMMARIZECOLUMNS (
		            DIM_Customers[Business_Line],
		            DIM_Customers[Segment],
		            "@SegmentMetric", [_Revenue AC]
		        ),
		        ALLSELECTED (
		            DIM_Customers[Business_Line],
		            DIM_Customers[Segment]
		        )
		    )

		VAR __BusinessLineTable =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Business_Line] ),
		        "@TopSegmentMetric",
		            VAR __BusinessLine = DIM_Customers[Business_Line]
		            VAR __Result =
		                MAXX (
		                    FILTER (
		                        __SegmentTable,
		                        DIM_Customers[Business_Line] = __BusinessLine
		                    ),
		                    [@SegmentMetric]
		                )
		            RETURN __Result
		    )

		VAR __RankingTable =
		    NATURALLEFTOUTERJOIN (
		        __SegmentTable,
		        __BusinessLineTable
		    )

		VAR __SegmentRank =
		    RANK (
		        DENSE,
		        __RankingTable,
		        ORDERBY (
		            [@TopSegmentMetric], DESC,
		            [@SegmentMetric], DESC,
		            DIM_Customers[Business_Line], ASC,
		            DIM_Customers[Segment], ASC
		        ),
		        LAST,
		        ,
		        MATCHBY (
		            DIM_Customers[Business_Line],
		            DIM_Customers[Segment]
		        )
		    )

		VAR __BusinessLineRank =
		    RANK (
		        DENSE,
		        __BusinessLineTable,
		        ORDERBY (
		            [@TopSegmentMetric], DESC,
		            DIM_Customers[Business_Line], ASC
		        ),
		        LAST,
		        ,
		        MATCHBY ( DIM_Customers[Business_Line] )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        ISINSCOPE ( DIM_Customers[Segment] ), __SegmentRank,
		        ISINSCOPE ( DIM_Customers[Business_Line] ), __BusinessLineRank,
		        BLANK ()
		    )

		RETURN __Result

		```
