	measure '_Dot plot | AC < FC | Factor' = ```


		VAR __Base_Table =

		CALCULATETABLE (
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Segment] ),
		        "@AC", [_Revenue AC],
		        "@PY", [_Revenue PY | Equalized]
		    ),
		    ALLSELECTED ( DIM_Customers )
		)

		VAR __Max_Value =
		    MAXX ( __Base_Table, MAX ( [@AC], [@PY] )  )

		VAR __Result = __Max_Value * 1.6

