	measure '_Standard Cal. Date Range | Multiple periods' = ```


		VAR __Min_date      =  MIN ( 'Dim Calendar'[Date] )
		VAR __Max_date      =  MAX ( 'Dim Calendar'[Date] )

		VAR __Min_date_F    =  FORMAT ( __Min_date , "mmm'yy")
		VAR __Max_date_F    =  FORMAT ( __Max_date, "mmm'yy")

		VAR __Total_months_Count    = DATEDIFF ( __Min_date, __Max_date, MONTH) + 1
		VAR __Selected_Months_Count = DISTINCTCOUNT ( 'Dim Calendar'[CurrMonthOffset] )

		VAR __Result =
		        SWITCH(
		            TRUE(),
		                __Max_date_F = __Min_date_F, __Max_date_F,
		                __Total_months_Count <> __Selected_Months_Count, "Multiple periods",
		                __Min_date_F & " - " & __Max_date_F
		        )

		RETURN __Result



		// VAR __Max_date      =  CALCULATE ( MAX ( 'Dim Calendar'[Date] ), KEEPFILTERS ( 'Dim Calendar'[_Is Closed Period] = 1 ) )
		// VAR __Max_date      =  [_Standard Cal. Max Date] -- Based on the Last Invoice Date // Optionally change to -> MAX ( 'Dim Calendar'[Date] )
		```
		displayFolder: 09. Technical\09. Others\Selected Items & Units & Granularities & Date Ranges
		lineageTag: e5d50382-a8a6-42a9-9398-7f0f6207ddfc

	measure '_Revenue PY KPI Card | Simplified V1' = ```

		// Icon Indicator on the left side

		VAR __Metric_abs = [_Revenue Variance abs. PY]
		VAR __Metric_rel = [_Revenue Variance rel. PY]

		VAR __Format_Rel     =  "+0.0%;-0.0% ;0%"
		VAR __Format_Abs     =  "▲ +#,0,K;▼ -#,0,K;0" // Fixed as Thousands without decimals

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs )
		VAR __Formatted_Rel     = FORMAT ( __Metric_rel, __Format_Rel )

		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        __Metric_abs = 0, "no change",                                         
		        ISBLANK ( __Metric_rel ), __Space & __Formatted_Abs & __Space,          
		        __Space & __Formatted_Abs & __Divider & __Formatted_Rel & __Space 
		    )

		RETURN __Result















