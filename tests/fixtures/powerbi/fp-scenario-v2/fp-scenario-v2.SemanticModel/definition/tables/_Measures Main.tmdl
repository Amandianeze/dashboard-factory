	measure '_Revenue | LTM Based on Offset | with zeros' = ```


		VAR __Selected_Month = MAX ( 'Dim Calendar'[CurrMonthOffset]  )
		VAR __Period_Window_ToDisplay =  12

		VAR __StartMonth = ( __Selected_Month - __Period_Window_ToDisplay ) + 1

		VAR __LTM_Calculation =
		    CALCULATE (
		        [_Revenue AC],
		        REMOVEFILTERS ( 'Dim Calendar' ),
		        'Dim Calendar'[CurrMonthOffset] >= __StartMonth &&
		        'Dim Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP( 'Dim Calendar'[Date], 'Dim Calendar Suppl'[Date] ) 
		    )

		VAR __xAxis_Offset = SELECTEDVALUE ( 'Dim Calendar Suppl'[CurrMonthOffset] )

		VAR __Result = 
		    SWITCH (
		        TRUE(),
		            __xAxis_Offset >= __StartMonth &&
		            __xAxis_Offset <= __Selected_Month,
		            COALESCE ( __LTM_Calculation, 0 ),
		            __LTM_Calculation
		    )

		RETURN  __Result

		```
		displayFolder: 01. Basic Calculations\01. Core
		lineageTag: 057a1d6a-8ac6-4492-83ed-48e59c81fe38

	measure '_Revenue | LTM Based on Offset | With zeros | All' = ```


		VAR __Selected_Month            = MAX ( 'Dim Calendar'[CurrMonthOffset] )
		VAR __Period_Window_ToDisplay   = 12
		VAR __StartMonth                = __Selected_Month - __Period_Window_ToDisplay + 1

		VAR __xAxis_Offset              = SELECTEDVALUE ( 'Dim Calendar Suppl'[CurrMonthOffset] )
		VAR __IsXAxisCell               = NOT ISBLANK ( __xAxis_Offset )

		VAR __IsVisibleMonth            =
		    __xAxis_Offset >= __StartMonth &&
		    __xAxis_Offset <= __Selected_Month

		VAR __HasAnyValueInLTM =
		    NOT ISBLANK (
		        CALCULATE (
		            [_Revenue AC],
		            REMOVEFILTERS ( 'Dim Calendar' ),
		            REMOVEFILTERS ( 'Dim Calendar Suppl' ),
		            'Dim Calendar'[CurrMonthOffset] >= __StartMonth,
		            'Dim Calendar'[CurrMonthOffset] <= __Selected_Month
		        )
		    )

		VAR __Value_CurrentContext =
		    CALCULATE (
		        [_Revenue AC],
		        REMOVEFILTERS ( 'Dim Calendar' ),
		        'Dim Calendar'[CurrMonthOffset] >= __StartMonth,
		        'Dim Calendar'[CurrMonthOffset] <= __Selected_Month,
		        USERELATIONSHIP ( 'Dim Calendar'[Date], 'Dim Calendar Suppl'[Date] )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        NOT __HasAnyValueInLTM,                 BLANK (),
		        __IsXAxisCell && NOT __IsVisibleMonth,  BLANK (),
		        __IsXAxisCell,                          COALESCE ( __Value_CurrentContext, 0 ),
		        __Value_CurrentContext
		    )

		RETURN __Result
		```
		displayFolder: 01. Basic Calculations\01. Core
		lineageTag: 29d291a2-835d-4315-b6d7-8a5d8d232265

	measure '_Customer Above Average | Flag' = ```


		VAR __CurrentCustomer   = MAX ( DIM_Customers[Customer_Name] )
		VAR __IsAtCustomerLevel = ISINSCOPE ( DIM_Customers[Customer_Name] )

		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name] ),
		            "@TotalRev",
		                CALCULATE (
		                    [_Revenue AC],
		                    ALLSELECTED ( 'Dim Calendar' )
		                )
		        ),
		        NOT ISBLANK ( [@TotalRev] )
		    )

		VAR __AvgTotalRev       = 
		    AVERAGEX ( __BaseTable, [@TotalRev] )

		VAR __AboveAvgCustomers = 
		    FILTER ( __BaseTable, [@TotalRev] > __AvgTotalRev )

		VAR __IsAboveAverage    = 
		    CONTAINS ( __AboveAvgCustomers, DIM_Customers[Customer_Name], __CurrentCustomer )

		VAR __Result =
		    IF (
		        __IsAtCustomerLevel && __IsAboveAverage,
		        1,
		        BLANK ()
		    )

		RETURN __Result
		```
		formatString: 0
		displayFolder: 02. Supplemental Calculations\07. Highlighting
		lineageTag: 9819a0a0-699f-47ad-a4e2-d4c4d8145c9f

	measure '_Revenue AC | Above Average Only' = ```


		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name] ),
		            "@TotalRev",
		                CALCULATE (
		                    [_Revenue AC],
		                    ALLSELECTED ( 'Dim Calendar' )
		                )
		        ),
		        NOT ISBLANK ( [@TotalRev] )
		    )

		VAR __AvgTotalRev =
		    AVERAGEX (
		        __BaseTable,
		        [@TotalRev]
		    )

		VAR __AboveAvgCustomers =
		    FILTER (
		        __BaseTable,
		        [@TotalRev] > __AvgTotalRev
		    )

		VAR __AboveAvgCustomerNames =
		    SELECTCOLUMNS (
		        __AboveAvgCustomers,
		        "Customer_Name", DIM_Customers[Customer_Name]
		    )

		VAR __RevenueAboveAverage =
		    CALCULATE (
		        [_Revenue AC],
		        KEEPFILTERS (
		            TREATAS (
		                __AboveAvgCustomerNames,
		                DIM_Customers[Customer_Name]
		            )
		        )
		    )

		VAR __Result = __RevenueAboveAverage

		RETURN __Result
		```
		displayFolder: 02. Supplemental Calculations\07. Highlighting
		lineageTag: 90896cca-f6ec-49f8-9179-141dcf10f10e

