	measure '_% Share | Data Points | Monthly Gran.' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim Calendar'[CurrMonthOffset] ),
		                "@Value", [_% Share | AC | DIM Customer Context]
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim Calendar' )
		    )

		VAR __Min_Date_Offset   =  MINX ( __Table, 'Dim Calendar'[CurrMonthOffset] )       // First Date Point
		VAR __Max_Date_Offset   =  MAXX ( __Table, 'Dim Calendar'[CurrMonthOffset] )       // Last Date Point
		VAR __Min_Val           =  MINX ( FILTER ( __Table, [@Value] <> 0 ), [@Value] )    // Min Value
		VAR __Max_Val           =  MAXX ( __Table, [@Value] )                              // Max Value

		VAR __Xaxis_Date_Offset =  SELECTEDVALUE ( 'Dim Calendar'[CurrMonthOffset] )       // Current X-axis Date Point
		VAR __Xaxis_Val         =  MAXX ( FILTER ( __Table, 'Dim Calendar'[CurrMonthOffset] = __Xaxis_Date_Offset  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Date_Offset IN { __Min_Date_Offset, __Max_Date_Offset } ||
		            __Xaxis_Val  IN { __Min_Val, __Max_Val },
		            __Xaxis_Val,
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: 09. Technical\09. Others\04. Data Points
		lineageTag: 805e5fa0-aae3-450d-a820-f69e7466ce73

	measure '_% Share Data Points | Monthly Gran. | Last' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim Calendar'[CurrMonthOffset] ),
		                "@Value", [_% Share | AC | DIM Customer Context]
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim Calendar' )
		    )

		VAR __Max_Date =    MAXX ( __Table, 'Dim Calendar'[CurrMonthOffset] )  // Last Date Point
		VAR __Xaxis_Date =  SELECTEDVALUE ( 'Dim Calendar'[CurrMonthOffset] ) // Current X-axis Date Point
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Date IN { __Max_Date },
		            __Xaxis_Val,
		            BLANK()
		    )

		RETURN __Result

		```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 09. Technical\09. Others\04. Data Points
		lineageTag: 608fabde-fa91-40b9-8081-50d53468e5b6

	measure '_Customer Count' = ```


		VAR __Table =
		    ADDCOLUMNS (                               
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev AC", [_Revenue AC]                            
		    )

		VAR __Result =
		    COUNTROWS ( 
		        FILTER ( 
		            __Table, 
		            NOT ISBLANK ( [@Rev AC] )
		        )
		    )

		RETURN __Result
		```
		formatString: 0
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\01. General
		lineageTag: 8ba2a6fe-a67e-40e4-a34e-40d02a702214

	measure '_Customer Count | Lost (YoY)' = ```

		VAR __Base_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC] ,
		        "@Rev_PY",      [_Revenue PY | Equalized] 
		    )

		VAR __Churned_Customers =
		    FILTER (
		        __Base_Table,
		        ISBLANK ( [@Rev_Current] )  &&
		        NOT ISBLANK ( [@Rev_PY] )       
		    )

		VAR __Result =
		    COUNTROWS ( __Churned_Customers )

		RETURN __Result
		```
		formatString: 0
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\03. Logic Based on YoY
		lineageTag: a759e2fa-2b22-4aea-86a2-a0634a10f043

	measure '_Customer Count | Downsell (YoY)' = ```

		VAR __Base_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC] ,
		        "@Rev_PY",      [_Revenue PY | Equalized] 
		    )

		VAR __Downsell_Customers =
		    FILTER (
		        __Base_Table,
		        NOT ISBLANK ( [@Rev_Current] )  &&
		        NOT ISBLANK ( [@Rev_PY] )       &&
		        [@Rev_Current] < [@Rev_PY]
		    )

		VAR __Result =
		    COUNTROWS ( __Downsell_Customers )

		RETURN __Result
		```
