	measure '_Customer Revenue | Lost (YoY)' = ```

		VAR __Base_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC] ,
		        "@Rev_PY",      [_Revenue PY | Equalized] 
		    )

		VAR __Lost_Customers =
		    FILTER (
		        __Base_Table,
		        ISBLANK ( [@Rev_Current] )  &&
		        NOT ISBLANK ( [@Rev_PY] )       
		    )

		VAR __Result =
		    SUMX ( __Lost_Customers, [@Rev_PY] *-1 )

		RETURN __Result
		```
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\02. Customer Revenue or Variance
		lineageTag: 9c78bfe3-97a4-4a80-a3c4-fae31f09d4b0

	measure '_Customer YoY Var | Declining (YoY)' = ```

		VAR __Base_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC] ,
		        "@Rev_PY",      [_Revenue PY | Equalized] 
		    )

		VAR __Declining_Customers =
		ADDCOLUMNS ( 
		    FILTER (
		        __Base_Table,
		        NOT ISBLANK ( [@Rev_Current] )  &&
		        NOT ISBLANK ( [@Rev_PY] )       &&
		        [@Rev_Current] < [@Rev_PY]
		    ),
		    "Variance", [_Revenue AC] - [@Rev_PY]
		)

		VAR __Result =
		    SUMX ( __Declining_Customers, [Variance] )

		RETURN __Result
		```
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\02. Customer Revenue or Variance
		lineageTag: 561b96b3-aba3-4667-a7f7-ee5b893c38f5

