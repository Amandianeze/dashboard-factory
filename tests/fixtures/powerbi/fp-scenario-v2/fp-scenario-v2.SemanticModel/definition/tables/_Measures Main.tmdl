	measure '_Revenue Variance rel. PY Suppression' = ```


		VAR __AC_Value       = [_Revenue AC]
		VAR __Scenario_Value = [_Revenue PY Suppression | Basic]

		VAR __Check = 
		    ISBLANK ( __AC_Value ) || 
		    ISBLANK ( __Scenario_Value ) ||
		    __AC_Value <= 0 || 
		    __Scenario_Value <= 0

		VAR __Relative_Variance = 
		    DIVIDE ( 
		        __AC_Value - __Scenario_Value,
		        __Scenario_Value
		    )

		VAR __Result =
		    IF (
		        __Check, BLANK(),
		        __Relative_Variance
		    )

		RETURN __Result
		```
		displayFolder: 02. Supplemental Calculations\02. Variances\04. PY Suppression\01. Core
		lineageTag: 250a8e3f-1f0c-4a2c-afb9-76077efa4c10

	measure '_Revenue Variance rel. Target Suppression' = ```


		VAR __AC_Value       = [_Revenue AC]
		VAR __Scenario_Value = [_Revenue Target Suppression | Basic]

		VAR __Check = 
		    ISBLANK ( __AC_Value ) || 
		    ISBLANK ( __Scenario_Value ) ||
		    __AC_Value <= 0 || 
		    __Scenario_Value <= 0

		VAR __Relative_Variance = 
		    DIVIDE ( 
		        __AC_Value - __Scenario_Value,
		        __Scenario_Value
		    )

		VAR __Result =
		    IF (
		        __Check, BLANK(),
		        __Relative_Variance
		    )

		RETURN __Result
		```
		displayFolder: 02. Supplemental Calculations\02. Variances\05. Target Suppression\01. Core
		lineageTag: eba2585f-614b-4691-a7fe-dd38e10f9b35

	measure '_Revenue PY Suppression KPI Card | Simplified V1' = ```

		// Icon Indicator on the left side

		VAR __Metric_abs = [_Revenue Variance abs. PY Suppression]
		VAR __Metric_rel = [_Revenue Variance rel. PY Suppression]

		VAR __Format_Rel     =  "+0.0% ;-0.0% ;0%"
		VAR __Format_Abs     =  "▲ +#,0,K;▼ -#,0,K;0" // Fixed as Thousands without decimals
		VAR __Local_Format   =  "en-US"

		VAR __Formatted_Abs     = FORMAT ( __Metric_abs, __Format_Abs, __Local_Format )
		VAR __Formatted_Rel     = FORMAT ( __Metric_rel, __Format_Rel, __Local_Format )

		VAR __Divider       =  " 𝄀 "
		VAR __Space         =  " "

		VAR __Result =
		    SWITCH (
		        TRUE(),
		        ISBLANK ( __Metric_abs ), BLANK(),
		        __Metric_abs = 0, "no change",                                         
		        ISBLANK ( __Metric_rel ), __Space & __Formatted_Abs & __Space,          
		        __Space & __Formatted_Abs & __Divider & __Formatted_Rel & __Space 
		    )

		RETURN __Result





		```
		displayFolder: 02. Supplemental Calculations\02. Variances\04. PY Suppression\02. Supplemental
		lineageTag: 7b55555d-5dcd-4d01-8369-06fa0dcf7422

