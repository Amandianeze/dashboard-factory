	measure '_Max value x Factor | AC & PY & Target | Alt.' = ```


		VAR __Base_Table =

		CALCULATETABLE (
		    ADDCOLUMNS (
		        VALUES ( 'Dim Calendar'[MonthnYear] ),
		        "@AC",      [_Revenue AC],
		        "@PY",      [_Revenue PY | Equalized],
		        "@PY Alt.", [_Revenue Target]
		    ),
		    ALLSELECTED ( 'Dim Calendar' )
		)

		VAR __Max_Value =
		    MAXX ( 
		        __Base_Table, 
		        MAXX ( 
		            {[@AC], [@PY], [@PY Alt.]}, 
		            [Value] 
		        ) 
		    )

		VAR __Result = __Max_Value * 1.3

		RETURN __Result


