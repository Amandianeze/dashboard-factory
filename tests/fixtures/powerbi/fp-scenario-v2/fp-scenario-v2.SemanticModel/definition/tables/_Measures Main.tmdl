	measure '_Revenue Variance rel. PY' = ```


		VAR __AC_Value = [_Revenue AC]
		VAR __PY_Value = [_Revenue PY | Equalized]

		VAR __Check = 
		    ISBLANK ( __AC_Value ) || 
		    ISBLANK ( __PY_Value ) ||
		    __AC_Value <= 0 || 
		    __PY_Value <= 0

		VAR __Relative_Variance = 
		    DIVIDE ( 
		        __AC_Value - __PY_Value,
		        __PY_Value
		    )

		VAR __Result =
		    IF (
		        __Check, BLANK(),
		        __Relative_Variance
		    )

		RETURN __Result
		```
		formatString: +0.0%;-0.0%;0%
		displayFolder: 02. Supplemental Calculations\02. Variances\01. PY\01. Core
		lineageTag: a253f59e-117e-466d-8efc-ef35103bef69

	measure '_Max value x Factor | AC & PY' = ```


		VAR __Base_Table =

		CALCULATETABLE (
		    ADDCOLUMNS (
		        VALUES ( 'Dim Calendar'[MonthnYear] ),
		        "@Value", MAX ( [_Revenue AC], [_Revenue PY | Equalized] )
		    ),
		    ALLSELECTED ( 'Dim Calendar' )
		)

		VAR __Max_Value =
		    MAXX ( __Base_Table, [@Value] )

		VAR __Result = __Max_Value * 1.3

		RETURN __Result




		```
		displayFolder: 09. Technical\09. Others\02. Max Values x Factor
		lineageTag: 1af3f13b-afd1-45b2-891d-c1fc4671b2dd

