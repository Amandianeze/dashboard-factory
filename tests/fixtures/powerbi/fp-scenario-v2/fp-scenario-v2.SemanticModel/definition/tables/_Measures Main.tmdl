	measure '_Revenue Variance abs. Scenario' = ```


		VAR __Current  =  [_Revenue AC]
		VAR __Scenario =  [_Revenue Scenario]
		VAR __Result   =  __Current - __Scenario

		RETURN __Result
		```
		formatString: +#,0;-#,0;0
