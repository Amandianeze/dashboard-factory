	measure '_Max value x Factor | AC & PY | Alt.' = ```


		VAR __Base_Table =

		CALCULATETABLE (
		    ADDCOLUMNS (
		        VALUES ( 'Dim Calendar'[MonthnYear] ),
		        "@AC", [_Revenue AC],
		        "@PY", [_Revenue PY | Equalized]
		    ),
		    ALLSELECTED ( 'Dim Calendar' )
		)

		VAR __Max_Value =
		    MAXX ( __Base_Table, MAX ( [@AC], [@PY] )  )

		VAR __Result = __Max_Value * 1.3

		RETURN __Result

		// MAXX (
