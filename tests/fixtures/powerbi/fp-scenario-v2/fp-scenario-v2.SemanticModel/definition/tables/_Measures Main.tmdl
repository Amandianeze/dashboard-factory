	measure '_Max value | AC, Delta PY & Target' = ```


		VAR __Base_Table =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Segment] ),
		        "@AC",           [_Revenue AC],
		        "@Delta_PY",     [_Revenue Variance abs. PY],
		        "@Delta_Target", [_Revenue Variance abs. Target]
		    )

		VAR __Result =
		    MAXX ( 
		        __Base_Table, 
		        MAXX ( 
		            {[@AC], [@Delta_PY], [@Delta_Target] }, 
		            [Value] 
		        ) 
		    ) * 1.3

		RETURN __Result



		// CALCULATETABLE (
		//     ADDCOLUMNS (
		//         VALUES ( DIM_Customers[Segment] ),
		//         "@AC",           [_Revenue AC],
		//         "@Delta_PY",     [_Revenue Variance abs. PY],
		//         "@Delta_Target", [_Revenue Variance abs. Target]
		//     ),
		//     ALLSELECTED ( DIM_Customers[Segment] )
		// )
		```
		displayFolder: 09. Technical\09. Others\01. Min & Max Values
		lineageTag: ae16d36b-8fbc-45df-9caa-4ec1f64049c3

	measure '_Min value | AC, Delta PY & Target' = ```


