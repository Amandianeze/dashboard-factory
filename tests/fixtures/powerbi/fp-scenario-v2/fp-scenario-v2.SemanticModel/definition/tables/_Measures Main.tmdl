	measure '_Revenue AC | Total Normalized' = ```


		VAR __Row_Breakdown_InScope    = 
		    ISINSCOPE ( DIM_Customers[Segment] )

		VAR __Column_Breakdown_InScope = 
		    ISINSCOPE ( 'Dim Calendar'[mmm'yy] ) ||
		    ISINSCOPE ( 'Dim Calendar'[qq'yy] )

		VAR __IsGrand_Total  = 
		    NOT ( __Column_Breakdown_InScope ) && 
		    NOT __Row_Breakdown_InScope

		VAR __IsHidden =
		    ( __Column_Breakdown_InScope )  

		//____________________________________________________________
		VAR __MaxAbs =
		    MAXX (
		        ALLSELECTED ( DIM_Customers[Segment] ),
		        ABS ( CALCULATE ( [_Revenue AC] ) )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        __IsHidden, BLANK (),
		        __IsGrand_Total, 0,
		        DIVIDE ( [_Revenue AC], __MaxAbs )
		    )

		RETURN __Result

		```
		formatStringDefinition = ```
			// ";;;"
			// """" & [_Perc % of Grand Total | AC] & """"

			VAR __Percentage_Of_Total =
			    DIVIDE (
			        [_Revenue AC],
			        CALCULATE (
			            [_Revenue AC],
			            ALLSELECTED()
			        )
			    )

			VAR __Result =
			    """" & FORMAT ( __Percentage_Of_Total, "0.0%" ) & """"

			RETURN __Result
			```
		displayFolder: 09. Technical\09. Others
		lineageTag: 7c3b0b00-4766-40ee-9d8f-cf26a6999ee9

	measure '_Revenue Variance Target | Total Normalized' = ```


		VAR __Row_Breakdown_InScope    = 
		    ISINSCOPE ( DIM_Customers[Segment] )

		VAR __Column_Breakdown_InScope = 
		    ISINSCOPE ( 'Dim Calendar'[mmm'yy] ) ||
		    ISINSCOPE ( 'Dim Calendar'[qq'yy] )

		VAR __IsGrand_Total  = 
		    NOT ( __Column_Breakdown_InScope ) && 
		    NOT __Row_Breakdown_InScope

		VAR __IsHidden =
		    ( __Column_Breakdown_InScope )  

		//____________________________________________________________
		VAR __MaxAbs =
		    MAXX (
		        ALLSELECTED ( DIM_Customers[Segment] ),
		        ABS ( CALCULATE ( [_Revenue Variance abs. Target] ) )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        __IsHidden, BLANK (),
		        __IsGrand_Total, BLANK(),
		        DIVIDE ( [_Revenue Variance abs. Target], __MaxAbs )
		    )

		RETURN __Result

		```
		formatString: ;;;
		displayFolder: 09. Technical\09. Others
		lineageTag: 37fcba68-0ad7-43c2-ba9f-8d681dd93119

	measure '_Revenue Variance Target | Heatmap Font Color | Segment x qq''yy' = ```


		VAR __Value              = [_Revenue Variance abs. Target]
		VAR __Threshold          = 0.70
		VAR __Default_Color      = "#30465F"
		VAR __Highlighting_Color = "#FFFFFF"
		VAR __Positive_Color     = "#308C9A"
		VAR __Negative_Color     = "#B34E4E"

		VAR __Row_InScope        = ISINSCOPE ( DIM_Customers[Segment] )
		VAR __Column_InScope     = ISINSCOPE ( 'Dim Calendar'[qq'yy] )
		VAR __IsTotal            = NOT __Row_InScope || NOT __Column_InScope

		//__________________________________________________________________________________________

		VAR __Table =
		    CALCULATETABLE (
		        SUMMARIZECOLUMNS (
		            DIM_Customers[Segment],
		            'Dim Calendar'[qq'yy],
		            "@Value", [_Revenue Variance abs. Target]
		        ),
		        ALLSELECTED ()
		    )

		VAR __Max_Positive =
		    MAXX ( FILTER ( __Table, [@Value] > 0 ), [@Value] )

		VAR __Min_Negative =
		    MINX ( FILTER ( __Table, [@Value] < 0 ), [@Value] )

		VAR __NormalizedValue =
		    SWITCH (
		        TRUE (),
		        __Value > 0, DIVIDE ( __Value, __Max_Positive ),
		        __Value < 0, DIVIDE ( ABS ( __Value ), ABS ( __Min_Negative ) ),
		        0
		    )

		//__________________________________________________________________________________________

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        ISBLANK ( __Value ),               BLANK (),
		        __IsTotal && __Value > 0,          __Positive_Color,
		        __IsTotal && __Value < 0,          __Negative_Color,
		        __IsTotal,                         __Default_Color,
		        __NormalizedValue >= __Threshold,  __Highlighting_Color,
		        __Default_Color
		    )

		RETURN __Result

		```
		displayFolder: 09. Technical\09. Others
		lineageTag: 9167e8d0-3411-4672-816f-8b9399262023

