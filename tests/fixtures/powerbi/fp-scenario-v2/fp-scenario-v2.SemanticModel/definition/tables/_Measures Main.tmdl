table '_Measures Main'
	lineageTag: b6fb4e86-38de-41f9-b238-fe0954a17f59

	measure '_Revenue AC' = ```


		DIVIDE ( 
		    SUM  ( FCT_Summarized_Data[Revenue] ),
		    [_Denominator]
		)

		```
		formatStringDefinition = [_Value Format] & ""
		displayFolder: 01. Basic Calculations\01. Core
		lineageTag: a30f2fa8-c45a-44aa-80e4-fb303b4e407d

	measure '_Revenue PY | Equalized' = ```


		VAR __Last_Closed_Period =
		    MAXX ( 
		        CALCULATETABLE (
		            FILTER ( 
		                ADDCOLUMNS (
		                    ALL ( 'Dim Calendar'[Date] ),
		                    "Value", [_Revenue AC]
		                ),
		                NOT ISBLANK ( [Value] )
		            ),
		            REMOVEFILTERS()
		        ),
		        'Dim Calendar'[Date]
		    )

		VAR __Date_Table = 
		    VALUES ( 'Dim Calendar'[Date] )

		VAR __Dates_Till_Closed = 
		    FILTER ( 
		        __Date_Table, 
		        'Dim Calendar'[Date] <= __Last_Closed_Period
		    )

		VAR __Result = 
		    CALCULATE ( 
		        [_Revenue AC],
		        DATEADD ( __Dates_Till_Closed, -1, YEAR )
		    )

		RETURN __Result

		// CALCULATE ( 
		//     [_Revenue AC],
		//     DATEADD ('Dim Calendar'[Date], -1, YEAR )
		// )

		//----or Alternatively-----//
		// CALCULATE (
		//     [_Revenue],
		//     SAMEPERIODLASTYEAR ( 'Dim Calendar'[Date] )
		// )
		```
		formatStringDefinition = [_Value Format] & ""
		displayFolder: 01. Basic Calculations\01. Core
		lineageTag: aae14113-4556-47a3-9241-03ac4cd0f09a

	measure '_Revenue Variance abs. PY' = ```


		VAR __Current =         [_Revenue AC]
		VAR __Previous_Year =   [_Revenue PY | Equalized]
		VAR __Result =          __Current - __Previous_Year

		RETURN __Result
		```
		formatStringDefinition = [_Variance Format] & ""
		displayFolder: 02. Supplemental Calculations\02. Variances\01. PY\01. Core
		lineageTag: 9a0989a7-b189-473a-8fda-b4d6cd7f961d

	measure '_Revenue Variance abs. PY FX Color' = ```


		VAR __Variance = [_Revenue Variance abs. PY]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Variance ), [_Transparent Color],
		            __Variance > 0,         [_Positive Variance color],
		            __Variance = 0,         [_Neutral Variance color],
		            __Variance < 0,         [_Negative Variance color]
		    )

		RETURN __Result
		```
		displayFolder: 02. Supplemental Calculations\02. Variances\01. PY\02. Supplemental
		lineageTag: 80de4a7b-7586-4f90-b8e2-3a4b2b1e7a0c

