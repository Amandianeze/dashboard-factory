	measure '_Revenue Variance abs. PY Suppresion FX Color' = ```


		VAR __Variance = [_Revenue Variance abs. PY Suppression]

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            ISBLANK ( __Variance ), [_Transparent Color],
		            __Variance > 0,         [_Positive Variance color],
		            __Variance = 0,         [_Neutral Variance color],
		            __Variance < 0,         [_Negative Variance color]
		    )

		RETURN __Result
