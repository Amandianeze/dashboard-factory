	measure '_Customer Above Threshold | Basic | Based on Value' = ```


		VAR __Threshold = [NPR Revenue Threshold Value]

		VAR __CurrentCustomer       = MAX ( DIM_Customers[Customer_Name] )
		VAR __Is_at_Customer_Level  = ISINSCOPE ( DIM_Customers[Customer_Name] )

		VAR __BaseTable =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Customer_Name] ),
		        "@TotalRev", 
		            CALCULATE (
		                [_Revenue AC],
		                ALLSELECTED ( 'Dim Calendar'[Date] )
		            )
		    )

		VAR __CustomerTotalRev =
		    MAXX (
		        FILTER ( __BaseTable, [Customer_Name] = __CurrentCustomer ),
		        [@TotalRev]
		    )

		VAR __Result =
		    IF (
		        NOT ISBLANK ( __CustomerTotalRev ) && __Is_at_Customer_Level &&__CustomerTotalRev >= __Threshold,
		        1,
		        BLANK()
		    )

		RETURN __Result
		```
		formatString: 0
		displayFolder: 02. Supplemental Calculations\07. Highlighting
		lineageTag: ddb89a04-7e65-43e3-95e1-087d596a557c

	measure '_Customer Above Threshold | Basic | Based on Customer Table' = ```


		VAR __Threshold             = [NPR Revenue Threshold Value]
		VAR __CurrentCustomer       = MAX ( DIM_Customers[Customer_Name] )
		VAR __Is_at_Customer_Level  = ISINSCOPE ( DIM_Customers[Customer_Name] )

		// Build table of customers with their total revenue across all selected periods
		VAR __CustomerTotals =
		    ADDCOLUMNS (
		        ALLSELECTED ( DIM_Customers[Customer_Name] ),
		        "@TotalRev",
		            CALCULATE (
		                [_Revenue AC],
		                ALLSELECTED ( 'Dim Calendar' )
		            )
		    )

		// Filter to only customers above threshold
		VAR __CustomersAbove =
		    FILTER (
		        __CustomerTotals,
		        [@TotalRev] >= __Threshold
		    )

		// Check if current customer is in the list
		VAR __IsAbove =
		    COUNTROWS (
		        FILTER ( __CustomersAbove, [Customer_Name] = __CurrentCustomer )
		    ) > 0

		VAR __Result =
		    IF ( __IsAbove && __Is_at_Customer_Level, 1, BLANK() )

		RETURN __Result
		```
		formatString: 0
		displayFolder: 02. Supplemental Calculations\07. Highlighting
		lineageTag: 23212ff3-4f6a-44da-8d67-39874b08e676

