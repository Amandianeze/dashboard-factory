	measure '_Revenue AC | 3M Moving Avg. | Monthly | Extended' = ```


		VAR __MA_Months             = 3
		VAR __Date_Context          = MAX ( 'Dim Calendar'[Date] )
		VAR __Min_Anchor_Date       = [_First FCT Date (by nonblank)]
		VAR __Max_Anchor_Date       = EDATE ( [_Last FCT Date (by nonblank)], 0 )

		VAR __MinDate_Anchor        = EOMONTH ( __Min_Anchor_Date, -1 ) + 1
		VAR __MinDate_Cutoff_Global = EDATE   (__MinDate_Anchor, ( __MA_Months ) )
		VAR __MaxDate_Anchor        = EOMONTH ( MIN ( __Max_Anchor_Date, __Date_Context ) , 0 )

		VAR __Window =
		    DATESINPERIOD (
		        'Dim Calendar'[Date],
		        EOMONTH ( __Date_Context , 0 ),
		        - __MA_Months,
		        MONTH
		    )

		VAR __MonthsInWindow =
		    CALCULATETABLE (
		        SUMMARIZE ( 
		            'Dim Calendar', 'Dim Calendar'[Start of Month],
		             "@Metric", [_Revenue AC]
		        ),
		        __Window
		    )

		VAR __Value_Per_Period =
		    AVERAGEX ( __MonthsInWindow, [@Metric] )

		VAR __Result =
		    IF (
		        __Date_Context >= __MinDate_Cutoff_Global &&
		        __Date_Context <= __MaxDate_Anchor ,   
		        __Value_Per_Period
		        )

		RETURN __Result

		```
		displayFolder: 02. Supplemental Calculations\04. Error bar Techniques
		lineageTag: 812d59a8-dc24-4c5a-a342-70152113e8a4

	measure '_First FCT Date (by nonblank)' = ```

		VAR __FirstDate =
		    MINX (
		        FILTER (
		            ALL ( 'Dim Calendar'[Date] ),
		            NOT ISBLANK ( [_Revenue AC]  )
		        ),
		        'Dim Calendar'[Date]
		    )
		RETURN __FirstDate
		```
		formatString: General Date
		displayFolder: 09. Technical\09. Others\01. Min & Max Values
		lineageTag: 6deea618-5443-451e-8580-0c5f7019bb5d

	measure '_Customer % of Total | Basic | Based on Customer Table' = ```


		VAR __ShareThreshold    = [NRP TopN Bin By Cumulative % Share Value]  // dynamic pareto threshold (e.g. 0.8 = 80%)
		VAR __CurrentCustomer   = MAX ( DIM_Customers[Customer_Name] )
		VAR __IsAtCustomerLevel = ISINSCOPE ( DIM_Customers[Customer_Name] )

		//__________________________________________________________________________________________
		// Build base table with total revenue per customer across all selected periods
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name] ),
		            "@TotalRev",
		                CALCULATE (
		                    [_Revenue AC],
		                    ALLSELECTED ( 'Dim Calendar' )
		                )
		        ),
		        NOT ISBLANK ( [@TotalRev] )
		    )

		//__________________________________________________________________________________________
		// Cumulative revenue ordered DESC by total — standard pareto ranking
		VAR __TableWithCumulative =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@CumulativeRev",
		            SUMX (
		                WINDOW (
		                    1, ABS,
		                    0, REL,
		                    __BaseTable,
		                    ORDERBY ( [@TotalRev], DESC )
		                ),
		                [@TotalRev]
		            )
		    )

		VAR __TotalRevenue =
		    SUMX ( __BaseTable, [@TotalRev] )

		//__________________________________________________________________________________________
		// Cumulative share per customer
		VAR __TableWithShare =
		    ADDCOLUMNS (
		        __TableWithCumulative,
		        "@CumulativeShare",
		            DIVIDE ( [@CumulativeRev], __TotalRevenue )
		    )

		// Customers within the pareto threshold
		VAR __ParetoCustomers =
		    FILTER (
		        __TableWithShare,
		        [@CumulativeShare] <= __ShareThreshold
		    )

		//__________________________________________________________________________________________
		// Check if current customer falls within pareto group
		VAR __IsInPareto =
		    CONTAINS (
		        __ParetoCustomers,
		        DIM_Customers[Customer_Name], __CurrentCustomer
		    )

		VAR __Result =
		    IF ( __IsInPareto && __IsAtCustomerLevel, 1, BLANK () )

		RETURN __Result
		```
		formatString: 0
		displayFolder: 02. Supplemental Calculations\07. Highlighting
		lineageTag: 1b51558b-eb76-4d95-9eab-686cbc5818a2

	measure '_Revenue AC | Pareto Only' = ```


		VAR __ShareThreshold    = [NRP TopN Bin By Cumulative % Share Value]
		VAR __CurrentCustomer   = MAX ( DIM_Customers[Customer_Name] )
		VAR __IsAtCustomerLevel = ISINSCOPE ( DIM_Customers[Customer_Name] )

		//__________________________________________________________________________________________
		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Customer_Name] ),
		            "@TotalRev",
		                CALCULATE (
		                    [_Revenue AC],
		                    ALLSELECTED ( 'Dim Calendar' )
		                )
		        ),
		        NOT ISBLANK ( [@TotalRev] )
		    )

		VAR __TableWithCumulative =
		    ADDCOLUMNS (
		        __BaseTable,
		        "@CumulativeRev",
		            SUMX (
		                WINDOW (
		                    1, ABS,
		                    0, REL,
		                    __BaseTable,
		                    ORDERBY ( [@TotalRev], DESC )
		                ),
		                [@TotalRev]
		            )
		    )

		VAR __TotalRevenue   = SUMX ( __BaseTable, [@TotalRev] )

		VAR __TableWithShare =
		    ADDCOLUMNS (
		        __TableWithCumulative,
		        "@CumulativeShare",
		            DIVIDE ( [@CumulativeRev], __TotalRevenue )
		    )

		VAR __ParetoCustomers =
		    FILTER (
		        __TableWithShare,
		        [@CumulativeShare] <= __ShareThreshold
		    )

		// List of pareto customer names for filtering
		VAR __ParetoCustomerNames =
		    SELECTCOLUMNS (
		        __ParetoCustomers,
		        "Customer_Name", DIM_Customers[Customer_Name]
		    )

		//__________________________________________________________________________________________
		VAR __IsInPareto =
		    CONTAINS (
		        __ParetoCustomers,
		        DIM_Customers[Customer_Name], __CurrentCustomer
		    )

		VAR __ParetoTotalInPeriod =
		    CALCULATE (
		        [_Revenue AC],
		        KEEPFILTERS (
		            DIM_Customers[Customer_Name] IN __ParetoCustomerNames
		        )
		    )

		VAR __Result = __ParetoTotalInPeriod 

		RETURN __Result
		```
		displayFolder: 02. Supplemental Calculations\07. Highlighting
		lineageTag: 365390b0-5f3f-4f16-9e65-0b8ba9771a03

