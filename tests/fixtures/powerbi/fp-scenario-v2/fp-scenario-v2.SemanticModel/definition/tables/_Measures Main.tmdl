	measure '_Customer FX Font' = ```


		IF (
		    ISINSCOPE ( DIM_Customers[Customer_Name] ),
		        SWITCH (
		            TRUE(),
		            [_Customer Count | Lost] >=1, "#ffffff",
		            [_Customer Count | New] >=1, "#ffffff",
		            "#3D5671"
		        ),
		    "#3D5671"
		)
		```
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\02. Logic Based on Dates
		lineageTag: e7560822-e43d-48c2-a3e1-73cc093c572d

	measure '_Customer Count | Lost Or New' = ```

		VAR __Metric = [_Revenue AC]
		VAR __Current_Dates =
		    VALUES ( 'Dim Calendar'[Date] )

		VAR __Base_Table =
		    CALCULATETABLE (                  
		        ADDCOLUMNS (                        
		            VALUES ( DIM_Customers[Customer_ID] ), 
		            "@First_Date", 
		                CALCULATE ( 
		                    MIN ( FCT_Summarized_Data[Date] ), 
		                    REMOVEFILTERS ( 'Dim Calendar' )
		                ),
		            "@Last_Date", 
		                CALCULATE ( 
		                    EOMONTH ( MAX ( FCT_Summarized_Data[Date] ), 1 ),  
		                    REMOVEFILTERS ( 'Dim Calendar' )
		                    )
		                ),
		        REMOVEFILTERS ( 'Dim Calendar' )
		    )

		VAR __New_Customers         = FILTER ( __Base_Table, [@First_Date] IN __Current_Dates )
		VAR __Lost_Customers        = FILTER ( __Base_Table, [@Last_Date] IN __Current_Dates )
		VAR __New_Customers_Count   = COUNTROWS ( __New_Customers )
		VAR __Lost_Customers_Count  = COUNTROWS ( __Lost_Customers )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __New_Customers_Count  >=1,  1,
		            __Lost_Customers_Count >=1,  2,
		            NOT ISBLANK ( __Metric ),    3,
		            BLANK()
		    )

		RETURN __Result




		```
		formatString: 0
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\02. Logic Based on Dates
		lineageTag: ebbb99bc-17d7-4067-81b4-6b6796879aff

	measure '_Customer Count | Extended (YoY)' = ```

		VAR __Selected_Segment = VALUES ( 'TBL Customer Breakdown'[Name] )
		VAR __Customer_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC],
		        "@Rev_PY",      [_Revenue PY | Equalized]
		    )

		VAR __Customer_Table_Segment =
		    ADDCOLUMNS (
		     __Customer_Table,
		        "@Segment",
		            SWITCH (
		                TRUE(),
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] > [@Rev_PY], "Growing",
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] < [@Rev_PY], "Declining",
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] = [@Rev_PY], "Stable",
		                    NOT ISBLANK ( [@Rev_Current] )  && ISBLANK ( [@Rev_PY] ),                                   "New",
		                    ISBLANK ( [@Rev_Current] )      && NOT ISBLANK ( [@Rev_PY] ),                               "Lost"
		            )
		    )

		VAR __Customer_Table_Segment_Filtered =
		    FILTER (
		        __Customer_Table_Segment,
		        [@Segment] IN __Selected_Segment
		    )

		VAR __Result = COUNTROWS ( __Customer_Table_Segment_Filtered )

		RETURN __Result
		```
		formatString: 0
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\03. Logic Based on YoY
		lineageTag: 23c381a8-5752-438a-bfc2-8cb79fe58d05

	measure '_Customer Rev | Extended (YoY)' = ```

		VAR __Selected_Segment = VALUES ( 'TBL Customer Breakdown'[Name] )
		VAR __Customer_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", CALCULATE ( [_Revenue AC], ALLSELECTED ( 'Dim Calendar' ) ) ,
		        "@Rev_PY",      CALCULATE ( [_Revenue PY | Equalized], ALLSELECTED ( 'Dim Calendar' ) ),
		        "@Rev", [_Revenue AC]
		    )

		VAR __Customer_Table_Segment =
		    ADDCOLUMNS (
		     __Customer_Table,
		        "@Segment",
		            SWITCH (
		                TRUE(),
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] > [@Rev_PY], "Growing",
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] < [@Rev_PY], "Declining",
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] = [@Rev_PY], "Stable",
		                    NOT ISBLANK ( [@Rev_Current] )  && ISBLANK ( [@Rev_PY] ),                                   "New",
		                    ISBLANK ( [@Rev_Current] )      && NOT ISBLANK ( [@Rev_PY] ),                               "Lost"
		            )
		    )

		VAR __Customer_Table_Segment_Filtered =
		    FILTER (
		        __Customer_Table_Segment,
		        [@Segment] IN __Selected_Segment
		    )

		VAR __Result = SUMX ( __Customer_Table_Segment_Filtered, [@Rev] )

		RETURN __Result
		```
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\Customer Segmentation\01. Customer Count\03. Logic Based on YoY
		lineageTag: c3ee52cd-f686-4695-a1e1-c29bbbc37373

	measure '_Customer Count | Extended (YoY) Name' = ```

		VAR __Selected_Segment = VALUES ( 'TBL Customer Breakdown'[Name] )
		VAR __Customer_Table =
		    ADDCOLUMNS (
		        VALUES ( DIM_Customers[Customer_ID] ),
		        "@Rev_Current", [_Revenue AC],
		        "@Rev_PY",      [_Revenue PY | Equalized]
		    )

		VAR __Customer_Table_Segment =
		    ADDCOLUMNS (
		     __Customer_Table,
		        "@Segment",
		            SWITCH (
		                TRUE(),
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] > [@Rev_PY], "Growing",
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] < [@Rev_PY], "Declining",
		                    NOT ISBLANK ( [@Rev_Current] )  && NOT ISBLANK ( [@Rev_PY] ) && [@Rev_Current] = [@Rev_PY], "Stable",
		                    NOT ISBLANK ( [@Rev_Current] )  && ISBLANK ( [@Rev_PY] ),                                   "New",
		                    ISBLANK ( [@Rev_Current] )      && NOT ISBLANK ( [@Rev_PY] ),                               "Lost"
		            )
		    )

		VAR __Customer_Table_Segment_Filtered =
		    FILTER (
		        __Customer_Table_Segment,
		        [@Segment] IN __Selected_Segment
		    )

		VAR __Result = 
		    IF (
		        ISINSCOPE ( DIM_Customers[Customer_Name] ),
		        MAXX ( __Customer_Table_Segment_Filtered, [@Segment] )
		    )

		RETURN __Result
		```
