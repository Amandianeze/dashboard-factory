	measure '_Normalized with PY Variance | Summarize' = ```

		VAR __Current_Segment= SELECTEDVALUE ( DIM_Customers[Segment] )
		VAR __Main_Metric = [_Revenue Variance abs. PY]
		VAR __Table =
		    CALCULATETABLE(
		        FILTER (
		            SUMMARIZECOLUMNS (
		                DIM_Customers[Business_Line],
		                DIM_Customers[Segment],
		                "@VariancePY", [_Revenue Variance abs. PY],
		                "@VarianceTG", [_Revenue Variance abs. Target]
		            ),
		            NOT ISBLANK ( [@VariancePY] ) || NOT ISBLANK ( [@VarianceTG] )
		        ),
		        ALLSELECTED()
		    )
		    
		VAR __MinVal =
		    MINX (
		        __Table,
		        VAR _Variance_PY = [@VariancePY]
		        VAR _Variance_TG = [@VarianceTG]
		        RETURN COALESCE ( MIN ( _Variance_PY, _Variance_TG ), _Variance_PY, _Variance_TG )   
		    )
		 
		VAR __MaxVal =
		    MAXX (
		        __Table,
		        VAR _Variance_PY = [@VariancePY]
		        VAR _Variance_TG = [@VarianceTG]
		        RETURN COALESCE ( MAX ( _Variance_PY, _Variance_TG ), _Variance_PY, _Variance_TG )       
		    )

		VAR __AbsMax =
		    MAX ( ABS ( __MinVal ), ABS ( __MaxVal ) )

		VAR __Variance_Current_Row =  
		    // MAXX ( FILTER ( __Table, DIM_Customers[Segment] = __Current_Segment ), [@VariancePY])
		    __Main_Metric
		VAR __NormValue = 
		    DIVIDE ( 
		         __Variance_Current_Row,
		         __AbsMax
		    )

		VAR __Result = __NormValue

		RETURN __Result

		```
		displayFolder: 09. Technical\09. Others\99. Not assigned yet or To Be Verified\09. Other
		lineageTag: 24e551cc-5d22-45af-af31-0c6cb716c8db

