	measure '_Revenue PY Suppression | Basic' = ```


		VAR __Scenario_Value    = [_Revenue PY | Equalized]
		VAR __Scenario_Name     = "PY"

		VAR __Scenario_Check = 
		    COUNTROWS ( 
		        FILTER ( 
		            'TBL Scenario Selection', 'TBL Scenario Selection'[Name] IN { __Scenario_Name } 
		        ) 
		    )

		VAR __Result = 
		    IF (
		        __Scenario_Check > 0,
		        __Scenario_Value
		    )

		RETURN __Result
