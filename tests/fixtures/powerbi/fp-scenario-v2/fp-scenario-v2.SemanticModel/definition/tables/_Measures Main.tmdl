	measure '_Dot Plot | Variance Layers' = ```


		VAR __AC = [_Revenue AC]
		VAR __PY = [_Revenue PY | Equalized]

		VAR __Valid =
		    NOT ISBLANK ( __AC ) &&
		    NOT ISBLANK ( __PY ) &&
		    __AC >= 0 &&
		    __PY >= 0

		VAR __Delta = __AC - __PY
		VAR __Upper = MAX ( __AC, __PY )
		VAR __Lower = MIN ( __AC, __PY )
		VAR __Layer = SELECTEDVALUE ( 'TBL Dot Plot Layers'[Layer] )

		VAR __Result =
		    IF (
		        __Valid,
		        SWITCH (
		            TRUE (),
		            __Layer = "Increase" && __Delta > 0, __Upper,
		            __Layer = "Decrease" && __Delta < 0, __Upper,
		            __Layer = "Cover", __Lower,
		            __Layer = "Label Increase" && __Delta >= 0, __AC,
		            __Layer = "Label Decrease" && __Delta < 0, __AC,
		            BLANK ()
		        )
		    )

		RETURN __Result

		```
		formatStringDefinition = [_Dot Plot | Dynamic Data Label] & ""
		displayFolder: 09. Technical\09. Others
		lineageTag: 2b25b591-0cf4-4a4e-bffd-7a331f4daad5

	measure '_Dot Plot | Data Label Color' = ```


		VAR __AC    = [_Revenue AC]
		VAR __PY    = [_Revenue PY | Equalized]
		VAR __Layer = SELECTEDVALUE ( 'TBL Dot Plot Layers'[Layer] )

		VAR __ShowLabel =
		    SWITCH (
		        TRUE (),
		        __Layer = "Increase" && __AC > __PY, TRUE (),
		        __Layer = "Cover" && __AC <= __PY, TRUE (),
		        FALSE ()
		    )

		VAR __Result = IF ( __ShowLabel, "#30465F", "#FFFFFF00" )

		RETURN __Result

		```
