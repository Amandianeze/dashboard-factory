	measure '_Revenue | Data Points | Monthly Gran.' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim Calendar'[CurrMonthOffset] ),
		                "@Value", [_Revenue AC]
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim Calendar' )
		    )

		VAR __Min_Date =    MINX ( __Table, 'Dim Calendar'[CurrMonthOffset] )       // First Date Point
		VAR __Max_Date =    MAXX ( __Table, 'Dim Calendar'[CurrMonthOffset] )       // Last Date Point
		VAR __Min_Val =     MINX ( FILTER ( __Table, [@Value] <> 0 ), [@Value] )    // Min Value
		VAR __Max_Val =     MAXX ( __Table, [@Value] )                              // Max Value

		VAR __Xaxis_Date =  SELECTEDVALUE ( 'Dim Calendar'[CurrMonthOffset] ) // Current X-axis Date Point
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Date IN { __Min_Date, __Max_Date } ||
		            __Xaxis_Val  IN { __Min_Val, __Max_Val },
		            __Xaxis_Val,
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: 09. Technical\09. Others\04. Data Points
		lineageTag: 8b4235dd-beb1-4f69-b5cb-9a2132e0cc2d

	measure '_Revenue | Data Points | Monthly Gran. AVG' = ```


		VAR __Table =
		    CALCULATETABLE ( 
		        FILTER ( 
		            ADDCOLUMNS ( 
		                VALUES ( 'Dim Calendar'[CurrMonthOffset] ),
		                "@Value", [_% Share | AC | DIM Customer Context]
		            ),
		            NOT ISBLANK ( [@Value] )
		        ),
		        ALLSELECTED ( 'Dim Calendar' )
		    )

		VAR __Min_Date =    MINX ( __Table, 'Dim Calendar'[CurrMonthOffset] )       // First Date Point
		VAR __Max_Date =    MAXX ( __Table, 'Dim Calendar'[CurrMonthOffset] )       // Last Date Point

		VAR __Avg_Val =     AVERAGEX ( __Table, [@Value] )                              // Max Value

		VAR __Xaxis_Date =  SELECTEDVALUE ( 'Dim Calendar'[CurrMonthOffset] ) // Current X-axis Date Point
		VAR __Xaxis_Val =   MAXX ( FILTER ( __Table, 'Dim Calendar'[CurrMonthOffset] = __Xaxis_Date  ), [@Value] )

		VAR __Result =
		    SWITCH (
		        TRUE(),
		            __Xaxis_Date >= __Min_Date  && __Xaxis_Date <= __Max_Date ,
		            __Avg_Val ,
		            BLANK()
		    )

		RETURN __Result

		```
		displayFolder: 09. Technical\09. Others\03. Averages
		lineageTag: 8538ee3d-7474-4b09-b855-6c396e2e7d28

	measure '_Unit And Date Range and Scenario Multi-select' = ```


		VAR __Unit          = "USD"
		VAR __Date_Range    = [_Standard Cal. Date Range | Multiple periods]
		VAR __Scenario      = [_Selected Scenario (Multiple options) Title]

		VAR __Result =
		    __Unit & " | " & __Date_Range & " | " & __Scenario

		RETURN __Result
		```
