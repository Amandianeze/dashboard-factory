	measure '_Dot Plot | Revenue Rank by Business Line' = ```


		VAR __BaseTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Business_Line],
		                DIM_Customers[Segment]
		            ),
		            "@Revenue", [_Revenue AC]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __Rank =
		    RANK (
		        DENSE,
		        __BaseTable,
		        ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		        LAST,
		        PARTITIONBY ( DIM_Customers[Business_Line] ),
		        MATCHBY ( DIM_Customers[Segment] )
		    )

		VAR __Result =
		    IF (
		        ISINSCOPE ( DIM_Customers[Segment] ),
		        __Rank
		    )

		RETURN __Result

		```
		formatString: 0
		displayFolder: 09. Technical\09. Others
		lineageTag: 335268e2-3ba8-42c4-90c8-0bb12a6faa43

	measure '_Dot Plot | Revenue Rank by Business Line and Segment' = ```


		VAR __SegmentTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED (
		                DIM_Customers[Business_Line],
		                DIM_Customers[Segment]
		            ),
		            "@Revenue", [_Revenue AC]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __SegmentRank =
		    RANK (
		        DENSE,
		        __SegmentTable,
		        ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		        LAST,
		        PARTITIONBY ( DIM_Customers[Business_Line] ),
		        MATCHBY ( DIM_Customers[Segment] )
		    )

		VAR __BusinessLineTable =
		    FILTER (
		        ADDCOLUMNS (
		            ALLSELECTED ( DIM_Customers[Business_Line] ),
		            "@Revenue", [_Revenue AC]
		        ),
		        NOT ISBLANK ( [@Revenue] )
		    )

		VAR __BusinessLineRank =
		    RANK (
		        DENSE,
		        __BusinessLineTable,
		        ORDERBY ( [@Revenue], DESC BLANKS LAST ),
		        LAST,
		        ,
		        MATCHBY ( DIM_Customers[Business_Line] )
		    )

		VAR __Result =
		    SWITCH (
		        TRUE (),
		        ISINSCOPE ( DIM_Customers[Segment] ), __SegmentRank,
		        ISINSCOPE ( DIM_Customers[Business_Line] ), __BusinessLineRank,
		        BLANK ()
		    )

		RETURN __Result

		```
