	partition 'FP Scenario Variances' = calculated
		mode: import
		source = ```

			{
			    ("ΔPY",     NAMEOF([_Revenue Variance abs. PY]),                0, "PY", "Abs. Var"),
			    ("ΔPY ",    NAMEOF([_Revenue Variance abs. PY | Data Bar]),     1, "PY", "Abs. Var"),
			    ("ΔPY%",    NAMEOF([_Revenue Variance rel. PY]),                2, "PY", "Rel. Var"),

			    ("ΔTG",     NAMEOF([_Revenue Variance abs. Target]),            3, "TG", "Abs. Var"),
			    ("ΔTG ",    NAMEOF([_Revenue Variance abs. Target Data Bar]),   4, "TG", "Abs. Var"),
			    ("ΔTG%",    NAMEOF([_Revenue Variance rel. Target]),            5, "TG", "Rel. Var")
			}
			```
