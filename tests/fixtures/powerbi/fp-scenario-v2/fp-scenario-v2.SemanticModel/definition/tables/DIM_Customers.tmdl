	measure '_Image URL | Country Flag Circle | Inscope' = ```


		IF (
		    ISINSCOPE ( DIM_Customers[Country Name] )   || 
		    ISINSCOPE ( DIM_Customers[Country] )        || 
		    ISINSCOPE ( DIM_Customers[Country Name PBI Adjusted] ),
		    
		    SELECTEDVALUE ( DIM_Customers[Flag URL (Circle SVG)] ),
		    BLANK()
		)

