{
  "kpi": {
    "value": {
      "typography": {
        "$type": "typography",
        "$value": "{typography.display}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}"
      }
    },
    "delta": {
      "positive": {
        "text": {
          "$type": "color",
          "$value": "{color.data.positive}"
        }
      },
      "negative": {
        "text": {
          "$type": "color",
          "$value": "{color.data.negative}"
        }
      }
    }
  }
}
