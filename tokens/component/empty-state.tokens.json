{
  "empty-state": {
    "title": {
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}"
      },
      "typography": {
        "$type": "typography",
        "$value": "{typography.body-strong}"
      }
    },
    "description": {
      "text": {
        "$type": "color",
        "$value": "{color.text.muted}"
      },
      "typography": {
