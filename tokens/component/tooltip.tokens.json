{
  "tooltip": {
    "bg": {
      "$type": "color",
      "$value": "{color.bg.surface-raised}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.primary}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.subtle}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.mark}"
    },
    "padding": {
      "x": {
        "$type": "dimension",
        "$value": "{space.inline.sm}"
      },
      "y": {
        "$type": "dimension",
        "$value": "{space.stack.2xs}"
      }
    },
    "max-width": {
      "$type": "dimension",
      "$value": "{dimension.280}"
    },
    "offset": {
      "$type": "dimension",
      "$value": "{dimension.6}"
    },
    "typography": {
      "$type": "typography",
      "$value": "{typography.caption}"
    }
  }
}
