{
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Reduced motion maps every duration to 0 (generated CSS). Values are provisional until the Phase 6 motion pass.",
      "instant": {
        "$value": {
          "value": 0,
          "unit": "ms"
        }
      },
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [0.23, 1, 0.32, 1],
        "$description": "Enter: decelerate."
      },
      "in-out": {
        "$value": [0.65, 0, 0.35, 1],
        "$description": "Move on screen."
      },
      "spring": {
        "$value": [0.34, 1.56, 0.64, 1],
        "$description": "Small overshoot; use sparingly."
      }
    },
    "distance": {
      "$type": "dimension",
      "sm": {
        "$value": "{dimension.4}"
      },
      "md": {
        "$value": "{dimension.8}"
      }
    }
  }
}
