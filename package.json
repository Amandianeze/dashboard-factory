{
  "name": "dashboard-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spec-first dashboard factory: YAML dashboard specs rendered with Vega-Lite, D3 and Plotly on React + Vite, built with a Claude Code harness.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "spec:validate": "tsx scripts/validate-specs.ts",
    "spec:schema": "tsx scripts/export-schema.ts",
    "new:dashboard": "tsx scripts/new-dashboard.ts",
    "data:fixtures": "tsx scripts/generate-fixtures.ts",
    "verify": "npm run typecheck && npm run lint && npm run spec:validate && npm run test",
    "panel:render": "tsx scripts/render-panel.ts",
    "data:profile": "tsx scripts/profile-fixture.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "flint-chart": "1.0.1",
    "plotly.js-basic-dist-min": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
