{
  "name": "dashboard-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spec-first dashboard factory: YAML dashboard specs rendered with Vega-Lite, D3 and Plotly on React + Vite, built with a Claude Code harness.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "test:e2e": "playwright test",
    "spec:validate": "tsx scripts/validate-specs.ts",
    "spec:schema": "tsx scripts/export-schema.ts",
    "new:dashboard": "tsx scripts/new-dashboard.ts",
    "data:fixtures": "tsx scripts/generate-fixtures.ts",
    "data:yahoo": "tsx scripts/fetch-yahoo-sp500.ts",
    "panel:render": "tsx scripts/render-panel.ts",
    "data:profile": "tsx scripts/profile-fixture.ts",
    "tokens:build": "tsx scripts/tokens/build.ts",
    "tokens:validate": "tsx scripts/tokens/validate.ts",
    "lint:no-raw-values": "tsx scripts/inventory/code-inventory.ts --check",
    "inventory:code": "tsx scripts/inventory/code-inventory.ts --summary",
    "design:build": "tsx scripts/design-md/cli.ts build",
    "design:check": "tsx scripts/design-md/cli.ts check",
    "design:lint": "tsx scripts/design-md/cli.ts lint",
    "design:diff": "tsx scripts/design-md/cli.ts diff",
    "design:taste": "tsx scripts/design-md/cli.ts taste",
    "catalog:build": "tsx scripts/catalog/build.ts",
    "lld:check": "tsx scripts/lld/check.ts",
    "registry:build": "tsx scripts/registry/build.ts",
    "verify": "npm run typecheck && npm run lint && npm run lint:no-raw-values && npm run tokens:validate -- --quiet && npm run tokens:build -- --check && npm run design:check && npm run design:lint && npm run design:diff && npm run lld:check && npm run catalog:build -- --check && npm run registry:build -- --check && npm run spec:validate && npm run test && npm run test:stories"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3": "^7.9.0",
    "flint-chart": "1.0.1",
    "lucide-react": "1.77.0",
    "plotly.js-basic-dist-min": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-mcp": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "shadcn": "4.23.0",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
